	|		КОГДА Данные.ВидДвиженияНакопления = ЕСТЬNULL(Партии.ВидДвижения, Данные.ВидДвиженияНакопления)
	|			ТОГДА ЕСТЬNULL(Партии.Количество, Данные.Количество)
	|		ИНАЧЕ -Партии.Количество
	|	КОНЕЦ                                                                 КАК Количество,
	|	ВЫБОР
	|		КОГДА Данные.ВидДвиженияНакопления = ЕСТЬNULL(Партии.ВидДвижения, Данные.ВидДвиженияНакопления)
	|			ТОГДА ЕСТЬNULL(Партии.СтоимостьРегл - Партии.ПостояннаяРазница - Партии.ВременнаяРазница, Данные.СуммаНУ)
	|		ИНАЧЕ -(Партии.СтоимостьРегл - Партии.ПостояннаяРазница - Партии.ВременнаяРазница)
	|	КОНЕЦ                                                                 КАК СуммаНУ,
	|	ВЫБОР
	|		КОГДА Данные.ВидДвиженияНакопления = ЕСТЬNULL(Партии.ВидДвижения, Данные.ВидДвиженияНакопления)
	|			ТОГДА ЕСТЬNULL(Партии.ПостояннаяРазница, Данные.СуммаПР)
	|		ИНАЧЕ -Партии.ПостояннаяРазница
	|	КОНЕЦ                                                                 КАК СуммаПР,
	|	ВЫБОР
	|		КОГДА Данные.ВидДвиженияНакопления = ЕСТЬNULL(Партии.ВидДвижения, Данные.ВидДвиженияНакопления)
	|			ТОГДА ЕСТЬNULL(Партии.ВременнаяРазница, Данные.СуммаВР)
	|		ИНАЧЕ -Партии.ВременнаяРазница
	|	КОНЕЦ                                                                 КАК СуммаВР
	|
	|ПОМЕСТИТЬ ДетальныеДанныеПроизводства
	|ИЗ
	|	ВтДетальныеДанныеПроизводства_Предварительная КАК Данные
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		ВТПартииПродукцииСоСтатьямиКалькуляции КАК Партии
	|	ПО
	|		Данные.Ссылка = Партии.Регистратор
	|		И Данные.Период = Партии.Период
	|		И Данные.Организация = Партии.Организация
	|		И Данные.ИдентификаторСтроки = Партии.ИдентификаторФинЗаписи
	|		И Данные.НастройкаХозяйственнойОперации = Партии.НастройкаХозяйственнойОперации
	|		И Данные.ПодразделениеСебестоимости = Партии.Подразделение
	|		И Данные.НаправлениеДеятельностиНазначения = Партии.НаправлениеДеятельности
	|		И Данные.Номенклатура = Партии.Номенклатура
	|		И Данные.ПартияПроизводства = Партии.ПартияПроизводства
	|		И ТИПЗНАЧЕНИЯ(Партии.ПартияНоменклатуры) = ТИП(Справочник.ПартииПроизводства)
	|		И Данные.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НезавершенноеПроизводство)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Данные.Ссылка                                                         КАК Ссылка,
	|	Данные.Период                                                         КАК Период,
	|	Данные.Организация                                                    КАК Организация,
	|	Данные.ИдентификаторСтроки                                            КАК ИдентификаторСтроки,
	|
	|	0                                                                     КАК Сумма,
	|	0                                                                     КАК СуммаУУ,
	|
	|	Данные.ВидДвижения                                                    КАК ВидДвижения,
	|	Данные.ВидСчета                                                       КАК ВидСчета,
	|	Данные.КорВидСчета                                                    КАК КорВидСчета,
	|	Данные.Подразделение                                                  КАК Подразделение,
	|	Данные.НаправлениеДеятельности                                        КАК НаправлениеДеятельности,
	|	Данные.АналитикаУчета                                                 КАК АналитикаУчета,
	|	Данные.Продукция                                                      КАК Номенклатура,
	|	Данные.ПартияНоменклатуры                                             КАК ПартияНоменклатуры,
	|	Данные.ДопКорАналитика                                                КАК ДопКорАналитика,
	|	КорДанные.НастройкаХозяйственнойОперации                              КАК НастройкаХозяйственнойОперации,
	|	
	|	Данные.Субконто1                                                      КАК Субконто1,
	|	Данные.Субконто2                                                      КАК Субконто2,
	|	Данные.Субконто3                                                      КАК Субконто3,
	|
	|	0                                                                     КАК Количество,
	|	0                                                                     КАК СуммаНУ,
	|	0                                                                     КАК СуммаПР,
	|	0                                                                     КАК СуммаВР
	|ИЗ
	|	ВтДетальныеДанныеПроизводства_Предварительная КАК Данные
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ВтДетальныеДанныеПроизводства_Предварительная КАК КорДанные
	|		ПО Данные.Ссылка = КорДанные.Ссылка
	|			И Данные.Организация = КорДанные.Организация
	|			И Данные.Период = КорДанные.Период
	|			И Данные.Подразделение = КорДанные.Подразделение
	|			И Данные.НаправлениеДеятельности = КорДанные.НаправлениеДеятельности
	|			И Данные.ИдентификаторСтроки = КорДанные.ИдентификаторСтроки
	|			И Данные.ПартияНоменклатуры = КорДанные.ПартияНоменклатуры
	|
	|ГДЕ
	|	Данные.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НезавершенноеПроизводство)
	|		И КорДанные.Количество <> 0 И КорДанные.Сумма = 0 И КорДанные.СуммаУУ = 0 И КорДанные.СуммаПР = 0 И КорДанные.СуммаВР = 0
	|		И КорДанные.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.МатериалыИРаботыВПодразделении)
	|		И КорДанные.НастройкаХозяйственнойОперации <> Данные.НастройкаХозяйственнойОперации
	|		И НЕ (Данные.Сумма = 0 И Данные.СуммаУУ = 0 И Данные.СуммаПР = 0 И Данные.СуммаВР = 0)
	|";
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти

	Если НЕ РежимОтладки Тогда
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДанныеПроводокПроизводстваДт");
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДанныеПроводокПроизводстваКт");
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДанныеПроизводства");
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДанныеОтбораПроизводства");
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтВыпускПродукции");
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДетальныеДанныеПроизводства_Предварительная");
	КонецЕсли;

	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	Возврат ТекстЗапроса;

КонецФункции

// Возвращает текст получения детальных данных при учете продаж по партиям номенклатуры.
//
// Параметры:
//  СоздаватьСубконто - Булево - 
//  ЗамещатьНастройкиНалогообложения - Булево - 
//  РежимОтладки - Булево - 
// 
// Возвращаемое значение:
//  Строка - сформированный текст запроса.
//
Функция ТекстДетальныеДанныеПродаж(СоздаватьСубконто, ЗамещатьНастройкиНалогообложения, РежимОтладки = Ложь) Экспорт
	
	ТекстыЗапроса = Новый Массив;
	
	Если НЕ СоздаватьСубконто Тогда
		ТекстыЗапроса.Добавить(ТекстВтДанныеПродаж(ЗамещатьНастройкиНалогообложения));
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Данные.Ссылка                                                         КАК Ссылка,
	|	Данные.Период                                                         КАК Период,
	|	Данные.Организация                                                    КАК Организация,
	|	Данные.ИдентификаторСтроки                                            КАК ИдентификаторСтроки,
	|
	|	ВЫБОР
	|		КОГДА Данные.Сумма * ЕСТЬNULL(ЕСТЬNULL(Партии.СтоимостьРегл, ПартииНДС.НДСРегл), 0) >= 0
	|			ТОГДА ЕСТЬNULL(ЕСТЬNULL(Партии.СтоимостьРегл, ПартииНДС.НДСРегл), Данные.Сумма)
	|		ИНАЧЕ -ЕСТЬNULL(ЕСТЬNULL(Партии.СтоимостьРегл, ПартииНДС.НДСРегл), Данные.Сумма)
	|	КОНЕЦ                                                                 КАК Сумма,
	|	ВЫБОР
	|		КОГДА Данные.СуммаУУ * ЕСТЬNULL(ЕСТЬNULL(Партии.СтоимостьУпр, ПартииНДС.НДСУпр), 0) >= 0
	|			ТОГДА ЕСТЬNULL(ЕСТЬNULL(Партии.СтоимостьУпр, ПартииНДС.НДСУпр), Данные.СуммаУУ)
	|		ИНАЧЕ -ЕСТЬNULL(ЕСТЬNULL(Партии.СтоимостьУпр, ПартииНДС.НДСУпр), Данные.СуммаУУ)
	|	КОНЕЦ                                                                 КАК СуммаУУ,
	|
	|	Данные.ВидДвижения                                                    КАК ВидДвижения,
	|	Данные.ВидСчета                                                       КАК ВидСчета,
	|	Данные.КорВидСчета                                                    КАК КорВидСчета,
	|	Данные.Подразделение                                                  КАК Подразделение,
	|	Данные.НаправлениеДеятельности                                        КАК НаправлениеДеятельности,
	|	Данные.АналитикаУчета                                                 КАК АналитикаУчета,
	|	Данные.Номенклатура                                                   КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Данные.ПартияНоменклатуры <> НЕОПРЕДЕЛЕНО
	|			ТОГДА Данные.ПартияНоменклатуры
	|		ИНАЧЕ Данные.Ссылка
	|	КОНЕЦ                                                                 КАК ПартияНоменклатуры,
	|	ЕСТЬNULL(ПартииНДС.ДокументПоступления, Данные.ДопКорАналитика)       КАК ДопКорАналитика,
	|	Данные.НастройкаХозяйственнойОперации                                 КАК НастройкаХозяйственнойОперации,
	|	
	|	ЕСТЬNULL(ПартииРеализованнойНоменклатуры.ПартияРеализованнойНоменклатуры, НЕОПРЕДЕЛЕНО) КАК Субконто1,
	|	НалогообложенияРеализаций.Ссылка                                      КАК Субконто2,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчета В (&ВидыСчетовДетализацииПродажВыручка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА Данные.ВидСчета В (&ВидыСчетовДетализацииПродажСебестоимость)
	|			ТОГДА ЕСТЬNULL(ЕСТЬNULL(Партии.СтатьяКалькуляции, ПартииНДС.СтатьяКалькуляции),
	|				ЗНАЧЕНИЕ(Справочник.СтатьиКалькуляции.ПустаяСсылка))
	|		КОГДА Данные.ВидСчета В (
	|			&ВидыСчетовДетализацииПродажРасходыНаПродажу,
	|			&ВидыСчетовДетализацииПродажСписаниеРасходов)
	|			ТОГДА Данные.СтатьяРасходов
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ                                                                 КАК Субконто3,
	|
	|	ВЫБОР
	|		КОГДА Данные.Сумма * ЕСТЬNULL(ЕСТЬNULL(Партии.СтоимостьРегл, ПартииНДС.НДСРегл), 0) >= 0
	|			ТОГДА ЕСТЬNULL(ЕСТЬNULL(Партии.Количество, ПартииНДС.Количество * 0), Данные.Количество)
	|		ИНАЧЕ -ЕСТЬNULL(ЕСТЬNULL(Партии.Количество, ПартииНДС.Количество * 0), Данные.Количество)
	|	КОНЕЦ                                                                 КАК Количество,
	|	ВЫБОР
	|		КОГДА Данные.Сумма * ЕСТЬNULL(ЕСТЬNULL(Партии.СтоимостьРегл, ПартииНДС.НДСРегл), 0) >= 0
	|			ТОГДА ЕСТЬNULL(Партии.СтоимостьРегл - Партии.ПостояннаяРазница - Партии.ВременнаяРазница, Данные.СуммаНУ)
	|		ИНАЧЕ -ЕСТЬNULL(Партии.СтоимостьРегл - Партии.ПостояннаяРазница - Партии.ВременнаяРазница, Данные.СуммаНУ)
	|	КОНЕЦ                                                                 КАК СуммаНУ,
	|	ВЫБОР
	|		КОГДА Данные.Сумма * ЕСТЬNULL(ЕСТЬNULL(Партии.СтоимостьРегл, ПартииНДС.НДСРегл), 0) >= 0
	|			ТОГДА ЕСТЬNULL(ЕСТЬNULL(Партии.ПостояннаяРазница, ПартииНДС.ПостояннаяРазница * 0), Данные.СуммаПР)
	|		ИНАЧЕ -ЕСТЬNULL(ЕСТЬNULL(Партии.ПостояннаяРазница, ПартииНДС.ПостояннаяРазница * 0), Данные.СуммаПР)
	|	КОНЕЦ                                                                 КАК СуммаПР,
	|	ВЫБОР
	|		КОГДА Данные.Сумма * ЕСТЬNULL(ЕСТЬNULL(Партии.СтоимостьРегл, ПартииНДС.НДСРегл), 0) >= 0
	|			ТОГДА ЕСТЬNULL(ЕСТЬNULL(Партии.ВременнаяРазница, ПартииНДС.ВременнаяРазница * 0), Данные.СуммаВР)
	|		ИНАЧЕ -ЕСТЬNULL(ЕСТЬNULL(Партии.ВременнаяРазница, ПартииНДС.ВременнаяРазница * 0), Данные.СуммаВР)
	|	КОНЕЦ                                                                 КАК СуммаВР
	|
	|ПОМЕСТИТЬ ДетальныеДанныеПродаж
	|ИЗ
	|	ВтДанныеПродаж КАК Данные
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрСведений.ПартииРеализованнойНоменклатуры КАК ПартииРеализованнойНоменклатуры
	|	ПО
	|		Данные.ДокументРеализации = ПартииРеализованнойНоменклатуры.ДокументРеализации
	|		И Данные.Номенклатура = ПартииРеализованнойНоменклатуры.Номенклатура
	|		И Данные.ПартияНоменклатуры = ПартииРеализованнойНоменклатуры.ПартияНоменклатуры
	|		И Данные.Контрагент = ПартииРеализованнойНоменклатуры.Контрагент
	|		И Данные.Договор = ПартииРеализованнойНоменклатуры.Договор
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Справочник.ВариантыНалогообложенияРеализации КАК НалогообложенияРеализаций
	|	ПО
	|		Данные.СтавкаНДС = НалогообложенияРеализаций.СтавкаНДС
	|		И Данные.ВариантНалогообложенияПрибыли = НалогообложенияРеализаций.ВариантНалогообложенияПрибыли
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		ВТПартииПродукцииСоСтатьямиКалькуляции КАК Партии
	|	ПО
	|		Данные.Ссылка = Партии.Регистратор
	|		И Данные.Период = Партии.Период
	|		И Данные.Организация = Партии.Организация
	|		И Данные.НастройкаХозяйственнойОперации = Партии.НастройкаХозяйственнойОперации
	|		И Данные.ИдентификаторСтроки = Партии.ИдентификаторФинЗаписи
	|		И Данные.Подразделение = Партии.Подразделение
	|		И Данные.НаправлениеДеятельностиНоменклатуры = Партии.НаправлениеДеятельности
	|		И Данные.Номенклатура = Партии.Номенклатура
	|		И Данные.ПартияНоменклатуры = Партии.ПартияНоменклатуры
	|		И Данные.ВидСчета В (&ВидыСчетовДетализацииПродажСебестоимость)
	|		И Данные.НастройкаХозяйственнойОперации <> ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ВключениеНДСВСтоимость)
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		ВТПартииПродукцииСоСтатьямиКалькуляции КАК ПартииНДС
	|	ПО
	|		Данные.Ссылка = ПартииНДС.Регистратор
	|		И Данные.Период = ПартииНДС.Период
	|		И Данные.Организация = ПартииНДС.Организация
	|		И Данные.ИдентификаторСтроки = ПартииНДС.ИдентификаторФинЗаписи
	|		И Данные.Подразделение = ПартииНДС.Подразделение
	|		И Данные.НаправлениеДеятельностиНоменклатуры = ПартииНДС.НаправлениеДеятельности
	|		И Данные.Номенклатура = ПартииНДС.Номенклатура
	|		И Данные.ПартияНоменклатуры = ПартииНДС.ПартияНоменклатуры
	|		И Данные.ВидСчета В (&ВидыСчетовДетализацииПродажСебестоимость)
	|		И Данные.НастройкаХозяйственнойОперации = ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ВключениеНДСВСтоимость)
	|		И НЕ (ПартииНДС.НДСРегл = 0 И ПартииНДС.НДСУпр = 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Период,
	|	Организация,
	|	ИдентификаторСтроки
	|";
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
	Если НЕ РежимОтладки Тогда
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДанныеПроводокПродажДт");
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДанныеПроводокПродажКт");
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДанныеРегистраПродаж");
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтСтатьиРасходовПродаж");
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДанныеПродаж_Предварительная");
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДанныеПродаж");
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДанныеОтбораПродаж");
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	Возврат ТекстЗапроса;
	
КонецФункции

// Возвращает текст запроса временной таблицы ВтДанныеПродаж.
// 
// Параметры:
//  ЗамещатьТаблицуНастройкиНалогообложенияПрибыли - Булево - 
// 
// Возвращаемое значение:
//  Строка - сформированный текст запроса.
//
Функция ТекстВтДанныеПродаж(ЗамещатьТаблицуНастройкиНалогообложенияПрибыли) Экспорт
		
	ТекстыЗапроса = Новый Массив;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Период КАК Период,
	|	Данные.Организация КАК Организация,
	|	ВЫРАЗИТЬ(СТРОКА(Данные.ИдентификаторСтроки) КАК СТРОКА(36)) КАК ИдентификаторСтроки,
	|	Данные.ВидСчетаДт КАК ВидСчета,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчетаКт В (&КорВидыСчетовДетализации)
	|			ТОГДА Данные.ВидСчетаКт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка)
	|	КОНЕЦ КАК КорВидСчета,
	|	Данные.ПодразделениеДт КАК Подразделение,
	|	ЕСТЬNULL(Данные.НаправлениеДеятельностиДт,
	|		ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) КАК НаправлениеДеятельности,
	|	Данные.АналитикаУчетаДт КАК АналитикаУчета,
	|	ВЫБОР
	|		КОГДА Данные.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВыпускПродукции)
	|			ТОГДА Данные.СубконтоКт1
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДопКорАналитика,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчетаКт = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НДСПоПриобретеннымЦенностям)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоВключениеВСтоимостьНДС,
	|	СУММА(Данные.Сумма) КАК Сумма,
	|	СУММА(Данные.СуммаУУ) КАК СуммаУУ,
	|	СУММА(Данные.СуммаНУДт) КАК СуммаНУ,
	|	СУММА(Данные.СуммаПРДт) КАК СуммаПР,
	|	СУММА(Данные.СуммаВРДт) КАК СуммаВР
	|ПОМЕСТИТЬ ВтДанныеПроводокПродажДт
	|ИЗ
	|	Данные КАК Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константы КАК Константы
	|		ПО (ИСТИНА)
	|ГДЕ
	|	Данные.Период >= Константы.ДатаНачалаРеглУчетаПродажПоПартиямРеализованнойНоменклатуры
	|	И Данные.ВидСчетаДт В(&ВидыСчетовДетализацииПродаж)
	|	И ТИПЗНАЧЕНИЯ(Данные.ИдентификаторСтроки) = ТИП(СТРОКА)
	|	И Данные.ИдентификаторСтроки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Ссылка,
	|	Данные.Период,
	|	Данные.Организация,
	|	Данные.ИдентификаторСтроки,
	|	Данные.ВидСчетаДт,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчетаКт В (&КорВидыСчетовДетализации)
	|			ТОГДА Данные.ВидСчетаКт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка)
	|	КОНЕЦ,
	|	Данные.ПодразделениеДт,
	|	ЕСТЬNULL(Данные.НаправлениеДеятельностиДт,
	|		ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)),
	|	Данные.АналитикаУчетаДт,
	|	ВЫБОР
	|		КОГДА Данные.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВыпускПродукции)
	|			ТОГДА Данные.СубконтоКт1
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчетаКт = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НДСПоПриобретеннымЦенностям)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Период,
	|	Организация,
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	АналитикаУчета,
	|	ИдентификаторСтроки,
	|	ЭтоВключениеВСтоимостьНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Период КАК Период,
	|	Данные.Организация КАК Организация,
	|	ВЫРАЗИТЬ(СТРОКА(Данные.ИдентификаторСтроки) КАК СТРОКА(36)) КАК ИдентификаторСтроки,
	|	Данные.ВидСчетаКт КАК ВидСчета,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчетаДт В (&КорВидыСчетовДетализации)
	|			ТОГДА Данные.ВидСчетаДт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка)
	|	КОНЕЦ КАК КорВидСчета,
	|	Данные.ПодразделениеКт КАК Подразделение,
	|	ЕСТЬNULL(Данные.НаправлениеДеятельностиКт,
	|		ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) КАК НаправлениеДеятельности,
	|	Данные.АналитикаУчетаКт КАК АналитикаУчета
	|ПОМЕСТИТЬ ВтДанныеПроводокПродажКт
	|ИЗ
	|	Данные КАК Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константы КАК Константы
	|		ПО (ИСТИНА)
	|ГДЕ
	|	Данные.Период >= Константы.ДатаНачалаРеглУчетаПродажПоПартиямРеализованнойНоменклатуры
	|	И Данные.ВидСчетаКт В(&ВидыСчетовДетализацииПродаж)
	|	И ТИПЗНАЧЕНИЯ(Данные.ИдентификаторСтроки) = ТИП(СТРОКА)
	|	И Данные.ИдентификаторСтроки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Ссылка,
	|	Данные.Период,
	|	Данные.Организация,
	|	Данные.ИдентификаторСтроки,
	|	Данные.ВидСчетаКт,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчетаДт В (&КорВидыСчетовДетализации)
	|			ТОГДА Данные.ВидСчетаДт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка)
	|	КОНЕЦ,
	|	Данные.ПодразделениеКт,
	|	ЕСТЬNULL(Данные.НаправлениеДеятельностиКт,
	|		ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)),
	|	Данные.АналитикаУчетаКт
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Период,
	|	Организация,
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	АналитикаУчета,
	|	ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеОтбора.Ссылка,
	|	ДанныеОтбора.Организация
	|ПОМЕСТИТЬ ВтДанныеОтбораПродаж
	|ИЗ (ВЫБРАТЬ
	|		Данные.Ссылка КАК Ссылка,
	|		Данные.Организация КАК Организация
	|	ИЗ
	|		ВтДанныеПроводокПродажДт КАК Данные
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Данные.Ссылка,
	|		Данные.Организация КАК Организация
	|	ИЗ
	|		ВтДанныеПроводокПродажКт КАК Данные) КАК ДанныеОтбора
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Период КАК Период,
	|	Строки.Регистратор КАК Регистратор,
	|	Строки.ИдентификаторФинЗаписи КАК ИдентификаторФинЗаписи,
	|	Строки.Подразделение КАК Подразделение,
	|	Строки.НаправлениеДеятельностиКонтрагента КАК НаправлениеДеятельности,
	|	Строки.НаправлениеДеятельностиНоменклатуры КАК НаправлениеДеятельностиНоменклатуры,
	|	ВЫБОР
	|		КОГДА АналитикаНоменклатуры.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа) ТОГДА
	|			АналитикаНоменклатуры.Номенклатура.ГруппаФинансовогоУчета
	|		КОГДА &ФормироватьВидыЗапасовПоГруппамФинансовогоУчета
	|			ТОГДА ВидыЗапасов.ГруппаФинансовогоУчета
	|		ИНАЧЕ АналитикаНоменклатуры.Номенклатура.ГруппаФинансовогоУчета
	|	КОНЕЦ КАК АналитикаУчета,
	|	ВЫБОР
	|		КОГДА Строки.РазделУчета <> ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ВыпускПродукции)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА Строки.НастройкаХозяйственнойОперации = ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.СписаниеОтклоненийНаСебестоимостьПродажОтклонения)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА Строки.РасчетСебестоимости
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСтоимости.Отклонение)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСтоимости.Плановая)
	|	КОНЕЦ КАК ДопКорАналитика,
	|	ВЫБОР
	|		КОГДА Строки.Партия <> НЕОПРЕДЕЛЕНО
	|			ТОГДА Строки.Партия
	|		КОГДА КорСтроки.КорПартия <> НЕОПРЕДЕЛЕНО
	|			ТОГДА КорСтроки.КорПартия
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Партия,
	|	Строки.СтавкаНДС КАК СтавкаНДС,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Строки.ЗаказКлиента) В (&ТипыДокументовРеализации)
	|			ТОГДА Строки.ЗаказКлиента
	|		КОГДА ТИПЗНАЧЕНИЯ(Строки.Регистратор) В (&ТипыДокументовРеализации)
	|			ТОГДА Строки.Регистратор
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДокументРеализации,
	|	Строки.НастройкаХозяйственнойОперации КАК НастройкаХозяйственнойОперации,
	|	ВЫБОР
	|		КОГДА Строки.НастройкаХозяйственнойОперации = ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ВключениеНДСВСтоимость)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоВключениеВСтоимостьНДС,
	|	АналитикаНоменклатуры.Номенклатура КАК Номенклатура,
	|	АналитикаПартнера.Организация КАК Организация,
	|	АналитикаПартнера.Договор КАК Договор,
	|	АналитикаПартнера.Контрагент КАК Контрагент,
	|	СУММА(Строки.Количество) КАК Количество,
	|	СУММА(Строки.СуммаВыручкиСНДСРегл - Строки.СуммаВыручкиРегл) КАК СуммаНДСРегл,
	|	СУММА(Строки.СуммаАкцизаРегл) КАК СуммаАкцизаРегл,
	|	СУММА(Строки.СтоимостьРегл + Строки.ДопРасходыРегл + Строки.ПостатейныеПостоянныеРегл + Строки.ПостатейныеПеременныеРегл + Строки.ТрудозатратыРегл) КАК СебестоимостьРегл,
	|	СУММА(Строки.СуммаВыручкиСНДСРегл) КАК СуммаВыручкиРегл,
	|	СУММА(Строки.СуммаВыручкиРегл - ВыручкаПостояннаяРазница - ВыручкаВременнаяРазница) КАК СуммаВыручкиНУ,
	|	СУММА(Строки.ВыручкаПостояннаяРазница) КАК СуммаВыручкиПР,
	|	СУММА(Строки.ВыручкаВременнаяРазница) КАК СуммаВыручкиВР,
	|	СУММА(Строки.РасходыНаПродажуРегл) КАК РасходыНаПродажуРегл,
	|	СУММА(Строки.РезервПодОбесценениеРегл) КАК РезервПодОбесценениеРегл,
	|	СУММА(Строки.СуммаВыручки - Строки.СуммаВыручкиБезНДС) КАК СуммаНДСУпр,
	|	СУММА(Строки.СуммаАкцизаУпр) КАК СуммаАкцизаУпр,
	|	СУММА(Строки.СтоимостьУпр + Строки.ДопРасходыУпр + Строки.ПостатейныеПостоянныеУпр + Строки.ПостатейныеПеременныеУпр + Строки.ТрудозатратыУпр) КАК СебестоимостьУпр,
	|	СУММА(Строки.СуммаВыручки) КАК СуммаВыручкиУпр,
	|	СУММА(Строки.РасходыНаПродажуУпр) КАК РасходыНаПродажуУпр,
	|	СУММА(Строки.РезервПодОбесценениеУпр) КАК РезервПодОбесценениеУпр,
	|	СУММА(Строки.СтоимостьРегл + Строки.ДопРасходыРегл + Строки.ПостатейныеПостоянныеРегл + Строки.ПостатейныеПеременныеРегл + Строки.ТрудозатратыРегл - Строки.ПостояннаяРазница - Строки.ВременнаяРазница) КАК СуммаНУ,
	|	СУММА(Строки.ПостояннаяРазница) КАК СуммаПР,
	|	СУММА(Строки.ВременнаяРазница) КАК СуммаВР
	|ПОМЕСТИТЬ ВтДанныеРегистраПродаж
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК Строки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтДанныеОтбораПродаж КАК ДанныеОтбора
	|		ПО Строки.Регистратор = ДанныеОтбора.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК АналитикаНоменклатуры
	|		ПО Строки.АналитикаУчетаНоменклатуры = АналитикаНоменклатуры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаПоПартнерам КАК АналитикаПартнера
	|		ПО Строки.АналитикаУчетаПоПартнерам = АналитикаПартнера.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗапасов КАК ВидыЗапасов
	|		ПО Строки.ВидЗапасов = ВидыЗапасов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СебестоимостьТоваров КАК КорСтроки
	|		ПО Строки.Регистратор = КорСтроки.Регистратор
	|			И Строки.Период = КорСтроки.Период
	|			И АналитикаПартнера.Организация = КорСтроки.Организация
	|			И Строки.ХозяйственнаяОперация = КорСтроки.ХозяйственнаяОперация
	|			И Строки.НастройкаХозяйственнойОперации = КорСтроки.НастройкаХозяйственнойОперации
	|			И Строки.ИдентификаторФинЗаписи = КорСтроки.ИдентификаторФинЗаписи
	|			И Строки.РасчетСебестоимости = КорСтроки.РасчетСебестоимости
	|			И Строки.РазделУчета = КорСтроки.РазделУчета
	|			И КорСтроки.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			И Строки.Партия = НЕОПРЕДЕЛЕНО
	|ГДЕ
	|	Строки.Активность
	|	И НЕ Строки.Сторно
	|
	|СГРУППИРОВАТЬ ПО
	|	Строки.Период,
	|	Строки.НаправлениеДеятельностиКонтрагента,
