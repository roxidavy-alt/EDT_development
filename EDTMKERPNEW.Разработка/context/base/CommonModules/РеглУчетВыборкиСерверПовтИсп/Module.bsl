Функция ТекстВтДанныеИНВ(ЗамещатьТаблицуНастройкиНалогообложенияПрибыли) Экспорт
		
	ТекстыОтражения = Новый Массив;
	ДокументыПоИНВ = Новый Массив;
	ДокументыПоИНВ.Добавить("Документ.ПринятиеКУчетуОС2_4");
	ДокументыПоИНВ.Добавить("Документ.МодернизацияОС2_4");
	ДокументыПоИНВ.Добавить("Документ.ПринятиеКУчетуНМА2_4");
	ДокументыПоИНВ.Добавить("Документ.УлучшениеНМА");
	ДокументыПоИНВ.Добавить("Документ.ПризнаниеРасходовПоИсследованиямИРазработкам");
	ДокументыПоИНВ.Добавить("Документ.ВыкупАрендованныхОС");
	ДокументыПоИНВ.Добавить("Документ.ВводОстатковВнеоборотныхАктивов2_4");
	
	ШаблонЗапросаДокументыИНВ =
	"ВЫБРАТЬ
	|	ДокументИНВ.Ссылка КАК Ссылка
	|ИЗ
	|	&ИмяДокументаИНВ КАК ДокументИНВ
	|ГДЕ
	|	ДокументИНВ.Ссылка В
	|		(ВЫБРАТЬ
	|			Данные.СубконтоДт2
	|		ИЗ
	|			Данные
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Данные.СубконтоКт2
	|		ИЗ
	|			Данные)";
	ТекстыДокументыИНВ = Новый Массив;
	ТекстыДокументыИНВ.Добавить("ВЫБРАТЬ ПЕРВЫЕ 0
	|	NULL КАК Ссылка
	|ПОМЕСТИТЬ ДокументыИНВ");
	Для Каждого ИмяДокументаИНВ Из ДокументыПоИНВ Цикл
		ТекстыДокументыИНВ.Добавить(СтрЗаменить(ШаблонЗапросаДокументыИНВ, "&ИмяДокументаИНВ", ИмяДокументаИНВ));
	КонецЦикла;
	ТекстыОтражения.Добавить(СтрСоединить(ТекстыДокументыИНВ, ОбщегоНазначения.ТекстОбъединитьВсе()));
	
	АмортизируемоеИмущество = Новый Массив;
	АмортизируемоеИмущество.Добавить("Справочник.ОбъектыЭксплуатации");
	АмортизируемоеИмущество.Добавить("Справочник.НематериальныеАктивы");
	АмортизируемоеИмущество.Добавить("Справочник.ТемыЭтапыИсследованийИРазработок");
	
	ШаблонЗапросаАмортизируемоеИмущество =
	"ВЫБРАТЬ
	|	АмортизируемоеИмущество.Ссылка КАК Ссылка
	|ИЗ
	|	&ИмяАмортизируемоеИмущество КАК АмортизируемоеИмущество
	|ГДЕ
	|	АмортизируемоеИмущество.Ссылка В
	|		(ВЫБРАТЬ
	|			Данные.СубконтоДт1
	|		ИЗ
	|			Данные
	|
	|		ОБЪЕДИНИТЬ ВСЕ
	|
	|		ВЫБРАТЬ
	|			Данные.СубконтоКт1
	|		ИЗ
	|			Данные)";
	ТекстыАмортизируемоеИмущество = Новый Массив;
	ТекстыАмортизируемоеИмущество.Добавить("ВЫБРАТЬ ПЕРВЫЕ 0
	|	NULL КАК Ссылка
	|ПОМЕСТИТЬ АмортизируемоеИмущество");
	Для Каждого ИмяАмортизируемоеИмущество Из АмортизируемоеИмущество Цикл
		ТекстыАмортизируемоеИмущество.Добавить(СтрЗаменить(ШаблонЗапросаАмортизируемоеИмущество, 
			"&ИмяАмортизируемоеИмущество", ИмяАмортизируемоеИмущество));
	КонецЦикла;
	ТекстыОтражения.Добавить(СтрСоединить(ТекстыАмортизируемоеИмущество, ОбщегоНазначения.ТекстОбъединитьВсе()));
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Период КАК Период,
	|	Данные.Организация КАК Организация,
	|	ВЫРАЗИТЬ(СТРОКА(Данные.ИдентификаторСтроки) КАК СТРОКА(36)) КАК ИдентификаторСтроки,
	|	Данные.ВидСчетаДт КАК ВидСчета,
	|	Данные.ВидСчетаКт КАК КорВидСчета,
	|	Данные.СчетДт КАК Счет,
	|	Данные.СчетКт КАК КорСчет,
	|	Данные.ПодразделениеДт КАК Подразделение,
	|	Данные.АналитикаУчетаДт КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК ДопКорАналитика,
	|	ЕСТЬNULL(Данные.НаправлениеДеятельностиДт,
	|		ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) КАК НаправлениеДеятельности,
	|	АмортизируемоеИмущество.Ссылка КАК АмортизируемоеИмущество,
	|	ДокументыИНВ.Ссылка КАК ДокументИНВ,
	|	ВидыРасходовПоИнвестиционномуВычету.Ссылка КАК ВидРасходовНаАмортизируемоеИмущество,
	|	СУММА(Данные.КоличествоДт) КАК Количество,
	|	СУММА(Данные.Сумма) КАК Сумма,
	|	СУММА(Данные.СуммаУУ) КАК СуммаУУ,
	|	СУММА(Данные.СуммаНУДт) КАК СуммаНУ,
	|	СУММА(Данные.СуммаПРДт) КАК СуммаПР,
	|	СУММА(Данные.СуммаВРДт) КАК СуммаВР
	|ПОМЕСТИТЬ ВтДанныеПроводокИНВДт
	|ИЗ
	|	Данные КАК Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АмортизируемоеИмущество КАК АмортизируемоеИмущество
	|		ПО Данные.СубконтоДт1 = АмортизируемоеИмущество.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыИНВ КАК ДокументыИНВ
	|		ПО Данные.СубконтоДт2 = ДокументыИНВ.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Перечисление.ВидыРасходовПоИнвестиционномуВычету КАК ВидыРасходовПоИнвестиционномуВычету
	|		ПО Данные.СубконтоДт3 = ВидыРасходовПоИнвестиционномуВычету.Ссылка
	|ГДЕ
	|	Данные.СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ИнвестиционныйНалоговыйВычет))
	|	И ТИПЗНАЧЕНИЯ(Данные.ИдентификаторСтроки) = ТИП(СТРОКА)
	|	И Данные.ИдентификаторСтроки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Ссылка,
	|	Данные.Период,
	|	Данные.Организация,
	|	Данные.ИдентификаторСтроки,
	|	Данные.СчетДт,
	|	Данные.СчетКт,
	|	Данные.ВидСчетаДт,
	|	Данные.ВидСчетаКт,
	|	Данные.ПодразделениеДт,
	|	Данные.АналитикаУчетаДт,
	|	ЕСТЬNULL(Данные.НаправлениеДеятельностиДт,
	|		ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)),
	|	АмортизируемоеИмущество.Ссылка,
	|	ДокументыИНВ.Ссылка,
	|	ВидыРасходовПоИнвестиционномуВычету.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Период,
	|	Организация,
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	АмортизируемоеИмущество,
	|	ДокументИНВ,
	|	ВидРасходовНаАмортизируемоеИмущество,
	|	ИдентификаторСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Период КАК Период,
	|	Данные.Организация КАК Организация,
	|	ВЫРАЗИТЬ(СТРОКА(Данные.ИдентификаторСтроки) КАК СТРОКА(36)) КАК ИдентификаторСтроки,
	|	Данные.ВидСчетаКт КАК ВидСчета,
	|	Данные.ВидСчетаДт КАК КорВидСчета,
	|	Данные.СчетКт КАК Счет,
	|	Данные.СчетДт КАК КорСчет,
	|	Данные.ПодразделениеКт КАК Подразделение,
	|	Данные.АналитикаУчетаКт КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК ДопКорАналитика,
	|	ЕСТЬNULL(Данные.НаправлениеДеятельностиКт,
	|		ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) КАК НаправлениеДеятельности,
	|	ОбъектыЭксплуатации.Ссылка КАК АмортизируемоеИмущество,
	|	ДокументыИНВ.Ссылка КАК ДокументИНВ,
	|	ВидыРасходовПоИнвестиционномуВычету.Ссылка КАК ВидРасходовНаАмортизируемоеИмущество,
	|	СУММА(Данные.КоличествоКт) КАК Количество,
	|	СУММА(Данные.Сумма) КАК Сумма,
	|	СУММА(Данные.СуммаУУ) КАК СуммаУУ,
	|	СУММА(Данные.СуммаНУКт) КАК СуммаНУ,
	|	СУММА(Данные.СуммаПРКт) КАК СуммаПР,
	|	СУММА(Данные.СуммаВРКт) КАК СуммаВР
	|ПОМЕСТИТЬ ВтДанныеПроводокИНВКт
	|ИЗ
	|	Данные КАК Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыЭксплуатации КАК ОбъектыЭксплуатации
	|		ПО Данные.СубконтоКт1 = ОбъектыЭксплуатации.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыИНВ КАК ДокументыИНВ
	|		ПО Данные.СубконтоКт2 = ДокументыИНВ.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Перечисление.ВидыРасходовПоИнвестиционномуВычету КАК ВидыРасходовПоИнвестиционномуВычету
	|		ПО Данные.СубконтоКт3 = ВидыРасходовПоИнвестиционномуВычету.Ссылка
	|ГДЕ
	|	Данные.СчетКт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ИнвестиционныйНалоговыйВычет))
	|	И ТИПЗНАЧЕНИЯ(Данные.ИдентификаторСтроки) = ТИП(СТРОКА)
	|	И Данные.ИдентификаторСтроки <> """"
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Ссылка,
	|	Данные.Период,
	|	Данные.Организация,
	|	Данные.ИдентификаторСтроки,
	|	Данные.ВидСчетаКт,
	|	Данные.ВидСчетаДт,
	|	Данные.СчетКт,
	|	Данные.СчетДт,
	|	Данные.ПодразделениеКт,
	|	Данные.АналитикаУчетаКт,
	|	ЕСТЬNULL(Данные.НаправлениеДеятельностиКт,
	|		ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)),
	|	ОбъектыЭксплуатации.Ссылка,
	|	ДокументыИНВ.Ссылка,
	|	ВидыРасходовПоИнвестиционномуВычету.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Период,
	|	Организация,
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	АмортизируемоеИмущество,
	|	ДокументИНВ,
