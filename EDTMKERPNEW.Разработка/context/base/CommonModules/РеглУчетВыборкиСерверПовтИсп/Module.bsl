	|";
	
	#КонецОбласти

	#Область ВключениеНДСОтклонениеВСтоимости
	
	ТекстВключениеНДСОтклонениеВСтоимости =
	"ВЫБРАТЬ //// Включение НДС при отклонении от плановой стоимости (Дт 41.ОТ :: Кт 19)
