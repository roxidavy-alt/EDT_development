Процедура ДобавитьНастройку(НастройкиОтраженияНДС, ВидЦенности, Налогообложение, СчетУчета)
	
	ШаблонНастройки = "
	|	ВЫБРАТЬ
	|		ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПустаяСсылка) КАК АналитикаУчета,
	|		ЗНАЧЕНИЕ(Перечисление.ВидыЦенностей.Товары)                КАК МестоУчета,
	|		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.НДСпоПриобретеннымМПЗ)    КАК СчетУчета
	|
	|";
	ШаблонНастройки = СтрЗаменить(ШаблонНастройки, "ПустаяСсылка",          Налогообложение);
	ШаблонНастройки = СтрЗаменить(ШаблонНастройки, "Товары",                ВидЦенности);
	ШаблонНастройки = СтрЗаменить(ШаблонНастройки, "НДСпоПриобретеннымМПЗ", СчетУчета);
	
	НастройкиОтраженияНДС.Добавить(ШаблонНастройки);
	
КонецПроцедуры

Функция ТекстНастроекОтраженияСчетовУчета(МассивВидовСчетов = Неопределено)
	
	ТекстВозврата =
	"ВЫБРАТЬ
	|	ПорядокУчета.Период КАК НачалоДействия,
	|	МИНИМУМ(ЕСТЬNULL(ПорядокУчетаСледующий.Период, ДАТАВРЕМЯ(1,1,1))) КАК ОкончаниеДействия,
	|	ПорядокУчета.Организация КАК Организация,
	|	ПорядокУчета.АналитикаУчета КАК АналитикаУчета,
	|	ПорядокУчета.МестоУчета КАК МестоУчета,
	|	ПорядокУчета.Долгосрочный КАК Долгосрочный,
	|	ПорядокУчета.ВидСчета КАК ВидСчетаРеглУчета,
	|	ПорядокУчета.СчетУчета КАК СчетУчета,
	|	НЕ ВидыСубконто.Ссылка ЕСТЬ NULL КАК ИспользоватьСубконто,
	|	ЕСТЬNULL(ВидыСубконто.ВидСубконто, НЕОПРЕДЕЛЕНО) КАК ВидСубконто,
	|	ВЫБОР
	|		КОГДА ПорядокУчета.Субконто = НЕОПРЕДЕЛЕНО И НЕ ВидыСубконто.Ссылка ЕСТЬ NULL
	|		ТОГДА ПорядокУчета.АналитикаУчета
	|		ИНАЧЕ ПорядокУчета.Субконто
	|	КОНЕЦ КАК Субконто
	|ИЗ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ПорядокУчета
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный.ВидыСубконто КАК ВидыСубконто
	|	ПО ПорядокУчета.СчетУчета = ВидыСубконто.Ссылка
	|		И ВидыСубконто.ВидСубконто В (
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.СтатьиЗатрат),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ПрочиеДоходыИРасходы),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.РасходыБудущихПериодов),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.БанковскиеСчета))
	|		И (ТИПЗНАЧЕНИЯ(ПорядокУчета.Субконто) В (ТИП(ПланВидовХарактеристик.СтатьиРасходов),
	|												ТИП(ПланВидовХарактеристик.СтатьиДоходов))
	|		ИЛИ ВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.БанковскиеСчета)
	|			И ПорядокУчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ДенежныеСредства))
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ПорядокУчетаСледующий
	|	ПО ПорядокУчета.Организация = ПорядокУчетаСледующий.Организация
	|		И ПорядокУчета.АналитикаУчета = ПорядокУчетаСледующий.АналитикаУчета
	|		И ПорядокУчета.МестоУчета = ПорядокУчетаСледующий.МестоУчета
	|		И ПорядокУчета.Долгосрочный = ПорядокУчетаСледующий.Долгосрочный
	|		И ПорядокУчета.ВидСчета = ПорядокУчетаСледующий.ВидСчета
	|		И ПорядокУчета.Период < ПорядокУчетаСледующий.Период
	|ГДЕ
	|	&УсловиеОтбораВидовСчетов
	|СГРУППИРОВАТЬ ПО
	|	ПорядокУчета.Период,
	|	ПорядокУчета.Организация,
	|	ПорядокУчета.АналитикаУчета,
	|	ПорядокУчета.МестоУчета,
	|	ПорядокУчета.Долгосрочный,
	|	ПорядокУчета.ВидСчета,
	|	ПорядокУчета.СчетУчета,
	|	НЕ ВидыСубконто.Ссылка ЕСТЬ NULL,
	|	ЕСТЬNULL(ВидыСубконто.ВидСубконто, НЕОПРЕДЕЛЕНО),
	|	ВЫБОР
	|		КОГДА ПорядокУчета.Субконто = НЕОПРЕДЕЛЕНО И НЕ ВидыСубконто.Ссылка ЕСТЬ NULL
	|		ТОГДА ПорядокУчета.АналитикаУчета
	|		ИНАЧЕ ПорядокУчета.Субконто
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПорядокУчета.Период КАК НачалоДействия,
	|	МИНИМУМ(ЕСТЬNULL(ПорядокУчетаСледующий.Период, ДАТАВРЕМЯ(1,1,1))) КАК ОкончаниеДействия,
	|	ПорядокУчета.Организация КАК Организация,
	|	ПорядокУчета.АналитикаУчета КАК АналитикаУчета,
	|	ПорядокУчета.МестоУчета КАК МестоУчета,
	|	ЛОЖЬ КАК Долгосрочный,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НДСПриДоходах) КАК ВидСчетаРеглУчета,
	|	(ВЫБОР
	|		КОГДА ПорядокУчета.СчетУчета = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПрочиеДоходы) ТОГДА
	|			ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПрочиеРасходы)
	|		КОГДА ПорядокУчета.СчетУчета В (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВыручкаНеЕНВД), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВыручкаРаздельныйНУ)) ТОГДА
	|			ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Продажи_НДС)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка)
	|	КОНЕЦ) КАК СчетУчета,
	|	ЛОЖЬ КАК ИспользоватьСубконто,
	|	НЕОПРЕДЕЛЕНО КАК ВидСубконто,
	|	НЕОПРЕДЕЛЕНО КАК Субконто
	|ИЗ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ПорядокУчета
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПорядокОтраженияНаСчетахУчета КАК ПорядокУчетаСледующий
	|	ПО ПорядокУчета.Организация = ПорядокУчетаСледующий.Организация
	|		И ПорядокУчета.АналитикаУчета = ПорядокУчетаСледующий.АналитикаУчета
	|		И ПорядокУчета.МестоУчета = ПорядокУчетаСледующий.МестоУчета
	|		И ПорядокУчета.Долгосрочный = ПорядокУчетаСледующий.Долгосрочный
	|		И ПорядокУчета.ВидСчета = ПорядокУчетаСледующий.ВидСчета
	|		И ПорядокУчета.Период < ПорядокУчетаСледующий.Период
	|ГДЕ
	|	ПорядокУчета.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.Доходы)
	|	И ПорядокУчета.СчетУчета В (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПрочиеДоходы), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВыручкаНеЕНВД), ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВыручкаРаздельныйНУ))
	|
	|СГРУППИРОВАТЬ ПО
	|	ПорядокУчета.Период,
	|	ПорядокУчета.Организация,
	|	ПорядокУчета.АналитикаУчета,
	|	ПорядокУчета.МестоУчета,
	|	ПорядокУчета.СчетУчета";
	
	УсловиеОтбораВидовСчетов = "ПорядокУчета.ВидСчета <> ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка)";
	Если МассивВидовСчетов <> Неопределено Тогда
		ШаблонСтрокиВидаСчета = "ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.%1)";
		МассивСтрокВидовСчетов = Новый Массив;
		Для каждого ВидСчетаРегл Из МассивВидовСчетов Цикл
			МассивСтрокВидовСчетов.Добавить(СтрШаблон(ШаблонСтрокиВидаСчета, XMLСтрока(ВидСчетаРегл)));
		КонецЦикла;
		Разделитель = Символы.ПС + Символы.Таб + Символы.Таб;
		УсловиеОтбораВидовСчетов = "ПорядокУчета.ВидСчета В (" + СтрСоединить(МассивСтрокВидовСчетов, Разделитель) + ")";
	КонецЕсли;
	
	ТекстВозврата = СтрЗаменить(ТекстВозврата, "&УсловиеОтбораВидовСчетов", УсловиеОтбораВидовСчетов);
	
	Возврат ТекстВозврата;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ДетализацияУчета

// Текст запроса описания таблицы ДетальныеДанные.
// 
// Возвращаемое значение:
//  Строка - Текст запроса.
//
Функция ТекстДетальныеДанныеОписание() Экспорт
	
	ТекстОписанияДанных = 
	"ВЫБРАТЬ ПЕРВЫЕ 0
	|	Данные.Регистратор                                                    КАК Ссылка,
	|	Данные.Период                                                         КАК Период,
	|	Данные.Организация                                                    КАК Организация,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(36))                                         КАК ИдентификаторСтроки,
	|
	|	Данные.Сумма                                                          КАК Сумма,
	|	Данные.СуммаУУ                                                        КАК СуммаУУ,
	|
	|	ЗНАЧЕНИЕ(ВидДвиженияБухгалтерии.Дебет)                                КАК ВидДвижения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка)               КАК ВидСчета,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка)               КАК КорВидСчета,
	|	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)                КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)             КАК НаправлениеДеятельности,
	|	НЕОПРЕДЕЛЕНО                                                          КАК АналитикаУчета,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)                        КАК Номенклатура,
	|	НЕОПРЕДЕЛЕНО                                                          КАК ПартияНоменклатуры,
	|	НЕОПРЕДЕЛЕНО                                                          КАК ДопКорАналитика,
	|	ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ПустаяСсылка)      КАК НастройкаХозяйственнойОперации,
	|
	|	Данные.СубконтоДт1                                                    КАК Субконто1,
	|	Данные.СубконтоДт2                                                    КАК Субконто2,
	|	Данные.СубконтоДт3                                                    КАК Субконто3,
	|
	|	Данные.КоличествоДт                                                   КАК Количество,
	|	Данные.СуммаНУДт                                                      КАК СуммаНУ,
	|	Данные.СуммаПРДт                                                      КАК СуммаПР,
	|	Данные.СуммаВРДт                                                      КАК СуммаВР
	|
	|ПОМЕСТИТЬ ДетальныеДанные
	|
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК Данные
	|";
	
	Возврат ТекстОписанияДанных;
	
КонецФункции

// Возвращает текст получения детальных данных при учете характеристик применения ИНВ.
//
// Параметры:
//  СоздаватьСубконто - Булево - 
//  ЗамещатьНастройкиНалогообложения - Булево - 
//  РежимОтладки - Булево - 
// 
// Возвращаемое значение:
//  Строка - сформированный текст запроса.
//
Функция ТекстДетальныеДанныеИНВ(СоздаватьСубконто, ЗамещатьНастройкиНалогообложения, РежимОтладки = Ложь) Экспорт
	
	ТекстыЗапроса = Новый Массив;
	
	Если НЕ СоздаватьСубконто Тогда
		ТекстыЗапроса.Добавить(ТекстВтДанныеИНВ(ЗамещатьНастройкиНалогообложения));
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Данные.Ссылка                                                         КАК Ссылка,
	|	Данные.Период                                                         КАК Период,
	|	Данные.Организация                                                    КАК Организация,
	|	Данные.ИдентификаторСтроки                                            КАК ИдентификаторСтроки,
	|
	|	Данные.Сумма                                                          КАК Сумма,
	|	Данные.СуммаУУ                                                        КАК СуммаУУ,
	|
	|	Данные.ВидДвижения                                                    КАК ВидДвижения,
	|	Данные.ВидСчета                                                       КАК ВидСчета,
	|	Данные.КорВидСчета                                                    КАК КорВидСчета,
	|	Данные.Подразделение                                                  КАК Подразделение,
	|	Данные.НаправлениеДеятельности                                        КАК НаправлениеДеятельности,
	|	НЕОПРЕДЕЛЕНО                                                          КАК АналитикаУчета,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)                        КАК Номенклатура,
	|	НЕОПРЕДЕЛЕНО                                                          КАК ПартияНоменклатуры,
	|	НЕОПРЕДЕЛЕНО                                                          КАК ДопКорАналитика,
	|	ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ПустаяСсылка)      КАК НастройкаХозяйственнойОперации,
	|	
	|	Данные.АмортизируемоеИмущество                                        КАК Субконто1,
	|	Данные.ДокументИНВ                                                    КАК Субконто2,
	|	МАКСИМУМ(ЕСТЬNULL(ХарактеристикиПримененияИНВ.Ссылка, НЕОПРЕДЕЛЕНО))  КАК Субконто3,
	|
	|	Данные.Количество                                                     КАК Количество,
	|	Данные.СуммаНУ                                                        КАК СуммаНУ,
	|	Данные.СуммаПР                                                        КАК СуммаПР,
	|	Данные.СуммаВР                                                        КАК СуммаВР
	|
	|ПОМЕСТИТЬ ДетальныеДанныеИНВ
	|ИЗ
	|	ВтДанныеИНВ КАК Данные
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		Справочник.ХарактеристикиПримененияИНВ КАК ХарактеристикиПримененияИНВ
	|	ПО
	|		Данные.ВидРасходовНаАмортизируемоеИмущество = ХарактеристикиПримененияИНВ.ВидРасходовНаАмортизируемоеИмущество
	|		И Данные.ВариантНалогообложенияПрибыли = ХарактеристикиПримененияИНВ.ВариантНалогообложенияПрибыли
	|		И Данные.РегистрацияВНалоговомОргане = ХарактеристикиПримененияИНВ.РегистрацияВНалоговомОргане
	|		И Данные.НалоговыйПериод = ХарактеристикиПримененияИНВ.НалоговыйПериод
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Ссылка,
	|	Данные.Период,
	|	Данные.Организация,
	|	Данные.ИдентификаторСтроки,
	|	Данные.Сумма,
	|	Данные.СуммаУУ,
	|	Данные.ВидДвижения,
	|	Данные.ВидСчета,
	|	Данные.КорВидСчета,
	|	Данные.Счет,
	|	Данные.КорСчет,
	|	Данные.Подразделение,
	|	Данные.НаправлениеДеятельности,
	|	Данные.АмортизируемоеИмущество,
	|	Данные.ДокументИНВ,
	|	Данные.Количество,
	|	Данные.СуммаНУ,
	|	Данные.СуммаПР,
	|	Данные.СуммаВР
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Период,
	|	Организация,
	|	ИдентификаторСтроки
	|";
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
	Если НЕ РежимОтладки Тогда
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ ВтДанныеИНВ");
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаРегистрацииВНалоговомОрганеПоОрганизацииИПодразделению()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РегистрацииВНалоговомОргане.Организация КАК Организация,
	|	РегистрацииВНалоговомОргане.Подразделение КАК Подразделение,
	|	МАКСИМУМ(РегистрацииВНалоговомОргане.Период) КАК Период
	|ПОМЕСТИТЬ ПериодыРегистрацииВНалоговомОргане
	|ИЗ
	|	РазрезыКОтражению КАК РазрезыКОтражению
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	|		ПО РазрезыКОтражению.Организация = РегистрацииВНалоговомОргане.Организация
	|		И РазрезыКОтражению.ДатаОтражения >= РегистрацииВНалоговомОргане.Период
	|СГРУППИРОВАТЬ ПО
	|	РегистрацииВНалоговомОргане.Организация,
	|	РегистрацииВНалоговомОргане.Подразделение
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РегистрацииВНалоговомОргане.Организация КАК Организация,
	|	РегистрацииВНалоговомОргане.Подразделение КАК Подразделение,
	|	РегистрацииВНалоговомОргане.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	РегистрацииВНалоговомОргане.РегистрацияВНалоговомОргане.КодРегиона КАК КодРегиона
	|ПОМЕСТИТЬ ТекущиеРегистрацииВНалоговомОргане
	|ИЗ
	|	ПериодыРегистрацииВНалоговомОргане КАК ПериодыРегистрацииВНалоговомОргане
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	|		ПО ПериодыРегистрацииВНалоговомОргане.Организация = РегистрацииВНалоговомОргане.Организация
	|		И ПериодыРегистрацииВНалоговомОргане.Подразделение = РегистрацииВНалоговомОргане.Подразделение
	|		И ПериодыРегистрацииВНалоговомОргане.Период = РегистрацииВНалоговомОргане.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НастройкиУчетаНалогаНаПрибыльГруппОбособленныхПодразделений.Организация КАК Организация,
	|	НастройкиУчетаНалогаНаПрибыльГруппОбособленныхПодразделений.КодРегиона КАК КодРегиона,
	|	МАКСИМУМ(НастройкиУчетаНалогаНаПрибыльГруппОбособленныхПодразделений.Период) КАК Период
	|ПОМЕСТИТЬ ПериодыНастройкиУчетаНалогаНаПрибыльГруппОбособленныхПодразделений
	|ИЗ
	|	РазрезыКОтражению КАК РазрезыКОтражению
