	|	0 КАК СуммаПРДт,
	|	0 КАК СуммаВРДт,
	|
	|	// Кт ///////////////////////////////////////////////////////////////////////////////////////////
	|
	|	ВЫБОР
	|		КОГДА НЕ ТаблицаНалогообложенияПрибыли.Организация ЕСТЬ NULL
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ВыручкаРаздельныйНУ)
	|		ИНАЧЕ СтрокиКт.ВидСчетаВыручки
	|	КОНЕЦ КАК ВидСчетаКт,
	|	СтрокиКт.ГруппаФинансовогоУчета КАК АналитикаУчетаКт,
	|	СтрокиКт.Склад КАК МестоУчетаКт,
	|
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаКт,
	|	СтрокиКт.Подразделение КАК ПодразделениеКт,
	|	СтрокиКт.НДВыручки КАК НаправлениеДеятельностиКт,
	|
	|	ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПустаяСсылка) КАК СчетКт,
	|	СтрокиКт.Номенклатура КАК СубконтоКт1,
	|	СтрокиКт.СтавкаНДС КАК СубконтоКт2,
	|	ЕСТЬNULL(ТаблицаНалогообложенияПрибыли.ВариантНалогообложенияПрибыли, НЕОПРЕДЕЛЕНО) КАК СубконтоКт3,
	|
	|	0 КАК ВалютнаяСуммаКт,
	|	СтрокиКт.Количество КАК КоличествоКт,
	|
	|	СтрокиКт.СуммаБезНДСРегл - СтрокиКт.СуммаАкцизаРегл КАК СуммаНУДКт,
	|	0 КАК СуммаПРКт,
	|	0 КАК СуммаВРКт,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СтрокиДт.Ссылка) = ТИП(Документ.АктВыполненныхРабот)
	|			ТОГДА ""Отражение задолженности покупателя""
	//++ НЕ УТКА
	|		КОГДА ТИПЗНАЧЕНИЯ(СтрокиДт.Ссылка) = ТИП(Документ.ОтчетДавальцу)
