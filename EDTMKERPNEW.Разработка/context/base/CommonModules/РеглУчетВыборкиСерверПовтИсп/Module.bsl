	#КонецОбласти
	
	ТекстыСозданияВременныхТаблиц = Новый Массив;
	ТекстыСозданияВременныхТаблиц.Добавить(ТекстУчетнаяПолитика());
	Если ЭтоДокументСебестоимости Тогда
		ТекстыСозданияВременныхТаблиц.Добавить(ТекстСебестоимость());
		ТекстыСозданияВременныхТаблиц.Добавить(ТекстВключениеНДСВСебестоимость);
	Иначе
		ТекстыСозданияВременныхТаблиц.Добавить(ТекстВключениеНДСВСебестоимостьПустая);
	КонецЕсли;
	ТекстыСозданияВременныхТаблиц.Добавить(ТекстВключениеНДСПрочиеРасходы);
	ТекстыСозданияВременныхТаблиц.Добавить(ТекстВключениеНДСАктивыПассивы);
	ТекстыСозданияВременныхТаблиц.Добавить(ТекстВключениеНДССебестоимостьПродаж);
	ТекстыСозданияВременныхТаблиц.Добавить(ТекстВключениеНДСОтклонениеВСтоимости);
	ТекстыСозданияВременныхТаблиц.Добавить(ТекстВключениеВСтоимостьПоТаблицеПартий);
	
	ЗапросДанныеНДСВключениеВСтоимость = Новый Запрос(СтрСоединить(ТекстыСозданияВременныхТаблиц));
	
	РеглУчетПроведениеСервер.ЗаполнениеПараметровЗапросаИПрочихФункциональныхОпций(
		ЗапросДанныеНДСВключениеВСтоимость,
		ПараметрыОтраженияРеглУчетаПоУмолчанию(ДетализацияПроводок));
		
	Возврат ЗапросДанныеНДСВключениеВСтоимость;
	
