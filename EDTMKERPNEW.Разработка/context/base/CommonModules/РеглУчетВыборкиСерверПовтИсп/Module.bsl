Функция ТекстВыручкаОтРеализации() Экспорт
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////////////////////////
	|// Выручка от реализации товара (Дт 62.01 :: Кт 90.01)
	|ВЫБРАТЬ
	|	СтрокиКт.Ссылка КАК Ссылка,
