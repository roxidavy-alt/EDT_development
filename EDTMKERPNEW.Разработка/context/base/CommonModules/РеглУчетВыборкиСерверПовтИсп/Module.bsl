// Функция возвращает текст получения детальных данных при учете незавершенного производства в разрезе партий
//
// Параметры:
//  РежимОтладки - Булево - 
//  
// Возвращаемое значение:
//	Строка - сформированный текст запроса.
//
Функция ТекстДетальныеДанныеПроизводства(РежимОтладки = Ложь) Экспорт

	ТекстыЗапроса = Новый Массив;

	#Область ИсходныеДанные
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Период КАК Период,
	|	Данные.Организация КАК Организация,
	|	ВЫРАЗИТЬ(СТРОКА(Данные.ИдентификаторСтроки) КАК СТРОКА(36)) КАК ИдентификаторСтроки,
	|	Данные.ВидСчетаДт КАК ВидСчета,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчетаКт В (&КорВидыСчетовДетализации)
	|			ТОГДА Данные.ВидСчетаКт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка)
	|	КОНЕЦ КАК КорВидСчета,
	|	ВЫБОР
	|		КОГДА Данные.ПодразделениеДт <> НЕОПРЕДЕЛЕНО
	|			ТОГДА Данные.ПодразделениеДт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ЕСТЬNULL(Данные.НаправлениеДеятельностиДт,
	|		ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) КАК НаправлениеДеятельности,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчетаДт В (
	|			ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РезервыПодОбесценениеНезавершенногоПроизводства),
	|			ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.РезервыПодОбесценениеМатериаловВПодразделении))
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		КОГДА Данные.АналитикаУчетаДт = НЕОПРЕДЕЛЕНО
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ГруппыАналитическогоУчетаНоменклатуры.ПустаяСсылка)
	|		ИНАЧЕ Данные.АналитикаУчетаДт
	|	КОНЕЦ КАК АналитикаУчета,
	|	ВЫБОР
	|		КОГДА Данные.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ВыпускПродукции)
	|			ТОГДА Данные.СубконтоКт1
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ДопКорАналитика,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчетаКт = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НДСПоПриобретеннымЦенностям)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоВключениеВСтоимостьНДС,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчетаКт = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ОтклоненияВСтоимости)
	|			ТОГДА ИСТИНА
