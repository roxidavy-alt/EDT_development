	|	ВЫБОР
	|		КОГДА Данные.ВидСчета В (&ВидыСчетовДетализацииПродажВыручка)
	|			И Строки.СуммаВыручкиНУ = 0
	|			И Строки.СуммаВыручкиПР <> 0 ТОГДА
	|			Строки.СуммаВыручкиПР - Строки.СуммаАкцизаРегл
	|		КОГДА Данные.ВидСчета В (&ВидыСчетовДетализацииПродажВыручка)
	|			ТОГДА Строки.СуммаВыручкиПР
	|		КОГДА Данные.ВидСчета В (&ВидыСчетовДетализацииПродажСебестоимость) ТОГДА
	|			Строки.СуммаПР
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаПР,
	|	ВЫБОР
	|		КОГДА Данные.ВидСчета В (&ВидыСчетовДетализацииПродажВыручка) ТОГДА
	|			Строки.СуммаВыручкиВР
	|		КОГДА Данные.ВидСчета В (&ВидыСчетовДетализацииПродажСебестоимость) ТОГДА
	|			Строки.СуммаВР
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаВР
	|ИЗ
	|	ВтДанныеПроводокПродажКт КАК Данные
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		ВтДанныеРегистраПродаж КАК Строки
	|	ПО
	|		Данные.Ссылка = Строки.Регистратор
	|		И Данные.Период = Строки.Период
	|		И Данные.Организация = Строки.Организация
	|		И Данные.Подразделение = Строки.Подразделение
	|		И Данные.ИдентификаторСтроки = Строки.ИдентификаторФинЗаписи
	|		И НЕ Строки.ЭтоВключениеВСтоимостьНДС
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		ВтСтатьиРасходовПродаж КАК ПрочиеРасходы
	|	ПО
	|		Данные.Ссылка = ПрочиеРасходы.Регистратор
	|		И Данные.Период = ПрочиеРасходы.Период
	|		И Данные.Организация = ПрочиеРасходы.Организация
	|		И Данные.ИдентификаторСтроки = ПрочиеРасходы.ИдентификаторФинЗаписи
	|
	|ГДЕ
	|	НЕ Данные.ВидСчета В (&ВидыСчетовДетализацииПродажСписаниеРасходов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Период КАК Период,
	|	Данные.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(ВидДвиженияБухгалтерии.Дебет) КАК ВидДвижения,
	|	Данные.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.КорВидСчета КАК КорВидСчета,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК ДопКорАналитика,
	|	
	|	НЕОПРЕДЕЛЕНО КАК ДокументРеализации,
	|	НЕОПРЕДЕЛЕНО КАК Номенклатура,
	|	НЕОПРЕДЕЛЕНО КАК ПартияНоменклатуры,
	|	НЕОПРЕДЕЛЕНО КАК Контрагент,
	|	НЕОПРЕДЕЛЕНО КАК Договор,
	|	ЗНАЧЕНИЕ(Справочник.НастройкиХозяйственныхОпераций.ПустаяСсылка) КАК НастройкаХозяйственнойОперации,
	|	НЕОПРЕДЕЛЕНО КАК НаправлениеДеятельностиНоменклатуры,
	|
	|	ЗНАЧЕНИЕ(Справочник.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	|	
	|	ЕСТЬNULL(ПрочиеРасходы.СтатьяРасходов,
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)) КАК СтатьяРасходов,
	|
	|	0 КАК Количество,
	|	Данные.Сумма КАК Сумма,
	|	Данные.СуммаУУ КАК СуммаУУ,
	|	Данные.СуммаНУ КАК СуммаНУ,
	|	Данные.СуммаПР КАК СуммаПР,
	|	Данные.СуммаВР КАК СуммаВР
	|
	|ИЗ
	|	ВтДанныеПроводокПродажДт КАК Данные
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		ВтСтатьиРасходовПродаж КАК ПрочиеРасходы
	|	ПО
	|		Данные.Ссылка = ПрочиеРасходы.Регистратор
	|		И Данные.Период = ПрочиеРасходы.Период
	|		И Данные.Организация = ПрочиеРасходы.Организация
	|		И Данные.ИдентификаторСтроки = ПрочиеРасходы.ИдентификаторФинЗаписи
	|
	|ГДЕ
	|	Данные.ВидСчета В (&ВидыСчетовДетализацииПродажСписаниеРасходов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Период,
	|	Организация,
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	АналитикаУчета
	|";
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Период КАК Период,
	|	Данные.Организация КАК Организация,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТПолученияНалогообложенияПрибылиПоДаннымПродаж
	|ИЗ
	|	ВтДанныеПродаж_Предварительная КАК Данные
	|	
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|		УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|	ПО 
	|		УчетнаяПолитикаОрганизаций.Ссылка = Данные.Ссылка
	|		И УчетнаяПолитикаОрганизаций.Организация = Данные.Организация
	|		И УчетнаяПолитикаОрганизаций.ДатаОтражения = НАЧАЛОПЕРИОДА(Данные.Период, ДЕНЬ)
	|		И УчетнаяПолитикаОрганизаций.РаздельныйУчетПоНалогуНаПрибыль
	|";
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
	Если ЗамещатьТаблицуНастройкиНалогообложенияПрибыли Тогда
		ТекстыЗапроса.Добавить("УНИЧТОЖИТЬ РаздельныйУчет_НастройкиНалогообложенияПрибыли");
	КонецЕсли;
	
	ПараметрыПолученияНалогообложенияПрибыли = РаздельныйУчетПоНалогуНаПрибыль.НовыйПараметрыПолученияТаблицыНастроекНалогообложенияПрибыли();
	ПараметрыПолученияНалогообложенияПрибыли.ИмяТаблицы = "ВТПолученияНалогообложенияПрибылиПоДаннымПродаж";
	ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_Период = "Период";
	ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_Организация = "Организация";
	ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_Подразделение = "Подразделение";
	ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_НаправлениеДеятельности = "НаправлениеДеятельности";
	ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_ОбъектУчета = "Номенклатура";
	ТекстыЗапроса.Добавить(РаздельныйУчетПоНалогуНаПрибыль.ТекстЗапроса_НастройкиНалогообложенияПрибыли(ПараметрыПолученияНалогообложенияПрибыли));
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Данные.Ссылка                                                         КАК Ссылка,
	|	Данные.Период                                                         КАК Период,
	|	Данные.Организация                                                    КАК Организация,
	|	Данные.ИдентификаторСтроки                                            КАК ИдентификаторСтроки,
	|
	|	Данные.Сумма                                                          КАК Сумма,
	|	Данные.СуммаУУ                                                        КАК СуммаУУ,
	|
	|	Данные.ВидДвижения                                                    КАК ВидДвижения,
	|	Данные.ВидСчета                                                       КАК ВидСчета,
	|	Данные.КорВидСчета                                                    КАК КорВидСчета,
	|	Данные.Подразделение                                                  КАК Подразделение,
	|	Данные.НаправлениеДеятельности                                        КАК НаправлениеДеятельности,
	|	Данные.АналитикаУчета                                                 КАК АналитикаУчета,
	|	Данные.ДопКорАналитика                                                КАК ДопКорАналитика,
	|	Данные.НастройкаХозяйственнойОперации                                 КАК НастройкаХозяйственнойОперации,
	|	
	|	Данные.ДокументРеализации                                             КАК ДокументРеализации,
	|	Данные.Номенклатура                                                   КАК Номенклатура,
	|	Данные.ПартияНоменклатуры                                             КАК ПартияНоменклатуры,
	|	Данные.НаправлениеДеятельностиНоменклатуры                            КАК НаправлениеДеятельностиНоменклатуры,
	|	Данные.Контрагент                                                     КАК Контрагент,
	|	Данные.Договор                                                        КАК Договор,
	|	ЗНАЧЕНИЕ(Справочник.СтатьиКалькуляции.ПустаяСсылка)                   КАК СтатьяКалькуляции,
	|	ВЫБОР
	|		КОГДА СправочникНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|			ТОГДА ИСТИНА
	//++ НЕ УТКА
	|		КОГДА СправочникНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|			И ТИПЗНАЧЕНИЯ(Данные.ПартияНоменклатуры) В (
	|				ТИП(Документ.ОтчетДавальцу),
	|				ТИП(Документ.ОтчетДавальцу2_5),
	|				ТИП(Документ.ОтчетДавальцуМеждуОрганизациями))
	|			ТОГДА ИСТИНА
	|		КОГДА СправочникНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|			И Данные.ПартияНоменклатуры = НЕОПРЕДЕЛЕНО
	|			И ТИПЗНАЧЕНИЯ(Данные.ДокументРеализации) В (
	|				ТИП(Документ.ОтчетДавальцу),
	|				ТИП(Документ.ОтчетДавальцу2_5),
	|				ТИП(Документ.ОтчетДавальцуМеждуОрганизациями))
	|			ТОГДА ИСТИНА
	//-- НЕ УТКА
	|		КОГДА СправочникНоменклатура.ТипНоменклатуры В (
	|				ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар),
	|				ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара),
	|				ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))
	|			ТОГДА ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(Данные.ПартияНоменклатуры) В (
	//++ НЕ УТКА
	|					ТИП(Документ.ЭтапПроизводства2_2),
	//-- НЕ УТКА
	|					ТИП(Документ.ПроизводствоБезЗаказа),
	|					ТИП(Документ.ВыпускПродукции),
	|					ТИП(Документ.РаспределениеВозвратныхОтходов),
	|					ТИП(Документ.ОтчетПереработчика2_5),
	|					ТИП(Документ.ОтчетПереработчика))
	|					ТОГДА ИСТИНА
	|				КОГДА ТИПЗНАЧЕНИЯ(Данные.ПартияНоменклатуры) = ТИП(Документ.СборкаТоваров)
	|					И ЕСТЬNULL(УчетнаяПолитикаОрганизаций.СборкаТоваровЧерезСчет20, ЛОЖЬ)
	|					ТОГДА ИСТИНА
	|				КОГДА ТИПЗНАЧЕНИЯ(Данные.ПартияНоменклатуры) = ТИП(Документ.ПервичныйДокумент)
	|					ТОГДА ВЫБОР
	|						КОГДА ВЫРАЗИТЬ(Данные.ПартияНоменклатуры КАК Документ.ПервичныйДокумент).ТипПервичногоДокумента В (
	|							ЗНАЧЕНИЕ(Перечисление.ТипыПервичныхДокументов.ВнутренняяНакладная),
	|							ЗНАЧЕНИЕ(Перечисление.ТипыПервичныхДокументов.ОтчетПереработчика))
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ЛОЖЬ
	|					КОНЕЦ
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ                                                                 КАК ТоварыРаботыУслугиСобственногоПроизводства,
	|
	|	Данные.СтавкаНДС                                                      КАК СтавкаНДС,
	|	ЕСТЬNULL(ТаблицаНалогообложенияПрибыли.ВариантНалогообложенияПрибыли,
	|		ЗНАЧЕНИЕ(Справочник.ВариантыНалогообложенияПрибыли.ПустаяСсылка)) КАК ВариантНалогообложенияПрибыли,
	|	
	|	
	|	Данные.СтатьяРасходов                                                 КАК СтатьяРасходов,
	|
	|	Данные.Количество                                                     КАК Количество,
	|	Данные.СуммаНУ                                                        КАК СуммаНУ,
	|	Данные.СуммаПР                                                        КАК СуммаПР,
	|	Данные.СуммаВР                                                        КАК СуммаВР
	|
	|ПОМЕСТИТЬ ВтДанныеПродаж
	|
	|ИЗ
	|	ВтДанныеПродаж_Предварительная КАК Данные
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РаздельныйУчет_НастройкиНалогообложенияПрибыли КАК ТаблицаНалогообложенияПрибыли
	|	ПО 
	|		ТаблицаНалогообложенияПрибыли.Период = Данные.Период
	|		И ТаблицаНалогообложенияПрибыли.Организация = Данные.Организация
	|		И ТаблицаНалогообложенияПрибыли.Подразделение = Данные.Подразделение
	|		И ТаблицаНалогообложенияПрибыли.ОбъектУчета = Данные.Номенклатура
	|		И ТаблицаНалогообложенияПрибыли.НаправлениеДеятельности = Данные.НаправлениеДеятельности
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|	ПО
	|		Данные.Ссылка = УчетнаяПолитикаОрганизаций.Ссылка
	|		И Данные.Организация = УчетнаяПолитикаОрганизаций.Организация
	|		И НАЧАЛОПЕРИОДА(Данные.Период, ДЕНЬ) = УчетнаяПолитикаОрганизаций.ДатаОтражения
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		Справочник.Номенклатура КАК СправочникНоменклатура
	|	ПО
	|		Данные.Номенклатура = СправочникНоменклатура.Ссылка
	|
	|ГДЕ
	|	НЕ (Данные.Сумма = 0
	|		И Данные.СуммаУУ = 0
	|		И Данные.СуммаНУ = 0
	|		И Данные.СуммаПР = 0
	|		И Данные.СуммаВР = 0
	|		И Данные.Количество = 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументРеализации,
	|	Номенклатура,
	|	ПартияНоменклатуры,
	|	Контрагент,
	|	Договор,
	|	СтавкаНДС,
	|	НаправлениеДеятельностиНоменклатуры
	|";
	ТекстыЗапроса.Добавить(ТекстЗапроса); 
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстДанныеДетально()
	
