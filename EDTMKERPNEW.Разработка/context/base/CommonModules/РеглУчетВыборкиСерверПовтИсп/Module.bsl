Функция ТекстПеремещениеМеждуФилиалами() Экспорт
	
	ТекстыПеремещения = Новый Массив;
	ТекстЗапроса = "
	|ВЫБРАТЬ //// Перемещение товаров между филиалами (Дт ХХ.ХХ :: Кт 20, 41.01, 76.06)
	|
	|	Стоимости.Ссылка КАК Ссылка,
