	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Период КАК Период,
	|	Данные.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(ВидДвиженияБухгалтерии.Дебет) КАК ВидДвижения,
	|	Данные.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Данные.ВидСчета КАК ВидСчета,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка) КАК КорВидСчета,
	|	Данные.Счет КАК Счет,
	|	Данные.КорСчет КАК КорСчет,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	Данные.ДопКорАналитика КАК ДопКорАналитика,
	|
	|	Данные.АмортизируемоеИмущество КАК АмортизируемоеИмущество,
	|	Данные.ДокументИНВ КАК ДокументИНВ,
	|	Данные.ВидРасходовНаАмортизируемоеИмущество КАК ВидРасходовНаАмортизируемоеИмущество,
	|
	|	Данные.Количество КАК Количество,
	|	Данные.Сумма КАК Сумма,
	|	Данные.СуммаУУ КАК СуммаУУ,
	|	Данные.СуммаНУ КАК СуммаНУ,
	|	Данные.СуммаПР КАК СуммаПР,
	|	Данные.СуммаВР КАК СуммаВР
	|ПОМЕСТИТЬ ВтДанныеИНВ_Предварительная
	|ИЗ
	|	ВтДанныеПроводокИНВДт КАК Данные
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Период КАК Период,
	|	Данные.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(ВидДвиженияБухгалтерии.Кредит) КАК ВидДвижения,
	|	Данные.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Данные.ВидСчета КАК ВидСчета,
	|	Данные.КорВидСчета КАК КорВидСчета,
	|	Данные.Счет КАК Счет,
	|	Данные.КорСчет КАК КорСчет,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	НЕОПРЕДЕЛЕНО КАК ДопКорАналитика,
	|
	|	Данные.АмортизируемоеИмущество КАК АмортизируемоеИмущество,
	|	Данные.ДокументИНВ КАК ДокументИНВ,
	|	Данные.ВидРасходовНаАмортизируемоеИмущество КАК ВидРасходовНаАмортизируемоеИмущество,
	|
	|	Данные.Количество КАК Количество,
	|	Данные.Сумма КАК Сумма,
	|	Данные.СуммаУУ КАК СуммаУУ,
	|	Данные.СуммаНУ КАК СуммаНУ,
	|	Данные.СуммаПР КАК СуммаПР,
	|	Данные.СуммаВР КАК СуммаВР
	|ИЗ
	|	ВтДанныеПроводокИНВКт КАК Данные
	|
    |ИНДЕКСИРОВАТЬ ПО НАБОРАМ
    |(
    |	(Организация,
    |	ДокументИНВ),
    |	(
	|	Период,
	|	Организация,
	|	Подразделение,
	|	НаправлениеДеятельности
	|	)
   	|)
	|";
	
	ТекстыОтражения.Добавить(ТекстЗапроса);
	
	Если ЗамещатьТаблицуНастройкиНалогообложенияПрибыли Тогда
		ТекстыОтражения.Добавить("УНИЧТОЖИТЬ РаздельныйУчет_НастройкиНалогообложенияПрибыли");
	КонецЕсли;
	
	ПараметрыПолученияНалогообложенияПрибыли = РаздельныйУчетПоНалогуНаПрибыль.НовыйПараметрыПолученияТаблицыНастроекНалогообложенияПрибыли();
	ПараметрыПолученияНалогообложенияПрибыли.ИмяТаблицы = "ВтДанныеИНВ_Предварительная";
	ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_Период = "Период";
	ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_Организация = "Организация";
	ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_Подразделение = "Подразделение";
	ПараметрыПолученияНалогообложенияПрибыли.ИмяПоля_НаправлениеДеятельности = "НаправлениеДеятельности";
	ТекстыОтражения.Добавить(РаздельныйУчетПоНалогуНаПрибыль.ТекстЗапроса_НастройкиНалогообложенияПрибыли(ПараметрыПолученияНалогообложенияПрибыли));
	
	ТекстыОтражения.Добавить(НалоговыйУчет.ТекстЗапросаВТ_ДатыВозникновенияПраваПримененияИнвестиционногоВычета("ВтДанныеИНВ_Предварительная", 
		"АмортизируемоеИмущество", "ДокументИНВ"));
		
	ТекстыОтражения.Добавить(ТекстЗапросаРегистрацииВНалоговомОрганеПоОрганизацииИПодразделению());
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Данные.Ссылка                                                         КАК Ссылка,
	|	Данные.Период                                                         КАК Период,
	|	Данные.Организация                                                    КАК Организация,
	|	Данные.ИдентификаторСтроки                                            КАК ИдентификаторСтроки,
	|
	|	Данные.Сумма                                                          КАК Сумма,
	|	Данные.СуммаУУ                                                        КАК СуммаУУ,
	|
	|	Данные.ВидДвижения                                                    КАК ВидДвижения,
	|	Данные.ВидСчета                                                       КАК ВидСчета,
	|	Данные.КорВидСчета                                                    КАК КорВидСчета,
	|	Данные.Счет                                                           КАК Счет,
	|	Данные.КорСчет                                                        КАК КорСчет,
	|	Данные.Подразделение                                                  КАК Подразделение,
	|	Данные.НаправлениеДеятельности                                        КАК НаправлениеДеятельности,
	|	Данные.АналитикаУчета                                                 КАК АналитикаУчета,
	|	Данные.ДопКорАналитика                                                КАК ДопКорАналитика,
	|	
	|	Данные.АмортизируемоеИмущество                                        КАК АмортизируемоеИмущество,
	|	Данные.ДокументИНВ                                                    КАК ДокументИНВ,
	|	Данные.ВидРасходовНаАмортизируемоеИмущество                           КАК ВидРасходовНаАмортизируемоеИмущество,
	|
	|	ЕСТЬNULL(НАЧАЛОПЕРИОДА(ДатыДокументов.ДатаВозникновенияПрава, ГОД),
	|		ДАТАВРЕМЯ(1, 1, 1))                                               КАК НалоговыйПериод,
	|	ВЫБОР
	|		КОГДА НЕ УчетнаяПолитикаОрганизаций.РаздельныйУчетПоНалогуНаПрибыль
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВариантыНалогообложенияПрибыли.ПустаяСсылка)
	|		ИНАЧЕ ЕСТЬNULL(ТаблицаНалогообложенияПрибыли.ВариантНалогообложенияПрибыли,
	|		ЗНАЧЕНИЕ(Справочник.ВариантыНалогообложенияПрибыли.ПустаяСсылка))
	|	КОНЕЦ                                                                 КАК ВариантНалогообложенияПрибыли,
	|	ВЫБОР
	|		КОГДА НЕ РегистрацииПодразделений.РегистрацияВНалоговомОргане ЕСТЬ NULL
	|			ТОГДА РегистрацииПодразделений.РегистрацияВНалоговомОргане
	|		КОГДА НЕ РегистрацияОрганизации.РегистрацияВНалоговомОргане ЕСТЬ NULL
	|			ТОГДА РегистрацияОрганизации.РегистрацияВНалоговомОргане
	|		ИНАЧЕ Организации.РегистрацияВНалоговомОргане
	|	КОНЕЦ                                                                 КАК РегистрацияВНалоговомОргане,
	|	
	|	Данные.Количество                                                     КАК Количество,
	|	Данные.СуммаНУ                                                        КАК СуммаНУ,
	|	Данные.СуммаПР                                                        КАК СуммаПР,
	|	Данные.СуммаВР                                                        КАК СуммаВР
	|
	|ПОМЕСТИТЬ ВтДанныеИНВ
	|
	|ИЗ
	|	ВтДанныеИНВ_Предварительная КАК Данные
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ 
	|		УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|	ПО 
	|		УчетнаяПолитикаОрганизаций.Ссылка = Данные.Ссылка
	|		И УчетнаяПолитикаОрганизаций.Организация = Данные.Организация
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РаздельныйУчет_НастройкиНалогообложенияПрибыли КАК ТаблицаНалогообложенияПрибыли
	|	ПО 
	|		ТаблицаНалогообложенияПрибыли.Период = Данные.Период
	|		И ТаблицаНалогообложенияПрибыли.Организация = Данные.Организация
	|		И ТаблицаНалогообложенияПрибыли.Подразделение = Данные.Подразделение
	|		И ТаблицаНалогообложенияПрибыли.НаправлениеДеятельности = Данные.НаправлениеДеятельности
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		ВТ_ДатыВозникновенияПраваПримененияИнвестиционногоВычета КАК ДатыДокументов
	|	ПО 
	|		Данные.ДокументИНВ = ДатыДокументов.ДокументВычета
	|		И Данные.Организация = ДатыДокументов.Организация
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрацииВНалоговомОрганеПоОрганизацииИПодразделению КАК РегистрацииПодразделений
	|	ПО 
	|		Данные.Организация = РегистрацииПодразделений.Организация
	|		И Данные.Подразделение = РегистрацииПодразделений.Подразделение
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		РегистрацииВНалоговомОрганеПоОрганизацииИПодразделению КАК РегистрацияОрганизации
	|	ПО 
	|		Данные.Организация = РегистрацияОрганизации.Организация
	|		И РегистрацияОрганизации.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ
	|		Справочник.Организации КАК Организации
	|	ПО 
	|		Данные.Организация = Организации.Ссылка
	|
	|ГДЕ
	|	НЕ (Данные.Сумма = 0
	|		И Данные.СуммаУУ = 0
	|		И Данные.СуммаНУ = 0
	|		И Данные.СуммаПР = 0
	|		И Данные.СуммаВР = 0
	|		И Данные.Количество = 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	АмортизируемоеИмущество,
	|	ДокументИНВ,
	|	ВидРасходовНаАмортизируемоеИмущество,
	|	НалоговыйПериод,
	|	ВариантНалогообложенияПрибыли,
	|	РегистрацияВНалоговомОргане
	|";
	ТекстыОтражения.Добавить(ТекстЗапроса); 
	
	ТекстыОтражения.Добавить("УНИЧТОЖИТЬ ВтДанныеПроводокИНВДт");
	ТекстыОтражения.Добавить("УНИЧТОЖИТЬ ВтДанныеПроводокИНВКт");
	ТекстыОтражения.Добавить("УНИЧТОЖИТЬ ВтДанныеОтбораИНВ");
	ТекстыОтражения.Добавить("УНИЧТОЖИТЬ ВтДанныеИНВ_Предварительная");
	
	ТекстЗапроса = СтрСоединить(ТекстыОтражения, ОбщегоНазначения.РазделительПакетаЗапросов());
	Возврат ТекстЗапроса;
	
КонецФункции

// Функция возвращает текст запроса получения детальных данных при учете ТМЦ по партиям номенклатуры
//
// Параметры:
//  РежимОтладки - Булево - 
//  
// Возвращаемое значение:
//	Строка - сформированный текст запроса.
//
Функция ТекстДетальныеДанныеНоменклатуры(РежимОтладки = Ложь) Экспорт
	
	ТекстыЗапроса = Новый Массив;
	
	#Область ИсходныеДанные
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Период КАК Период,
	|	Данные.Организация КАК Организация,
	|	Данные.ВидСчета КАК ВидСчета,
	|	ВЫБОР
	|		КОГДА Данные.КорВидСчета В (&КорВидыСчетовДетализации)
	|			ТОГДА Данные.КорВидСчета
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.ПустаяСсылка)
	|	КОНЕЦ КАК КорВидСчета,
	|	ВЫБОР КОГДА Данные.КорВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.НДСПоПриобретеннымЦенностям)
	|		ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоВключениеВСтоимостьНДС,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Данные.Ссылка) = ТИП(Документ.ВнутреннееПотребление)
	|			ТОГДА ЛОЖЬ
	|		КОГДА Данные.КорВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.Расходы)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоРасходы,
	|	ВЫБОР
	|		КОГДА Данные.КорВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовРеглУчета.Доходы)
	|			ТОГДА ИСТИНА
	|		КОГДА Данные.КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ПрочиеДоходы)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоДоходы,
	|	ВЫБОР
	|		КОГДА Данные.Подразделение <> НЕОПРЕДЕЛЕНО
	|			ТОГДА Данные.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ЕСТЬNULL(Данные.НаправлениеДеятельности,
	|		ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)) КАК НаправлениеДеятельности,
	|	Данные.АналитикаУчета КАК АналитикаУчета,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Данные.Субконто1) = ТИП(Справочник.Контрагенты)
	|			ТОГДА Данные.Субконто1
	|		КОГДА ТИПЗНАЧЕНИЯ(Данные.Субконто2) = ТИП(Справочник.Контрагенты)
	|			ТОГДА Данные.Субконто2
	|		КОГДА ТИПЗНАЧЕНИЯ(Данные.Субконто3) = ТИП(Справочник.Контрагенты)
	|			ТОГДА Данные.Субконто3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Контрагент,
	|	Данные.ИдентификаторСтроки КАК ИдентификаторСтроки
	|ПОМЕСТИТЬ ВтДанныеПроводокНоменклатурыДт
	|ИЗ
	|	(ВЫБРАТЬ
	|		Данные.Ссылка КАК Ссылка,
	|		Данные.Период КАК Период,
	|		Данные.Организация КАК Организация,
	|		Данные.ВидСчетаДт КАК ВидСчета,
	|		Данные.ВидСчетаКт КАК КорВидСчета,
	|		Данные.СчетКт КАК КорСчет,
	|		Данные.ПодразделениеДт КАК Подразделение,
	|		Данные.НаправлениеДеятельностиДт КАК НаправлениеДеятельности,
	|		Данные.АналитикаУчетаДт КАК АналитикаУчета,
	|		Данные.СубконтоДт1 КАК Субконто1,
	|		Данные.СубконтоДт2 КАК Субконто2,
	|		Данные.СубконтоДт3 КАК Субконто3,
	|		ВЫРАЗИТЬ(СТРОКА(Данные.ИдентификаторСтроки) КАК СТРОКА(36)) КАК ИдентификаторСтроки
	|	ИЗ
	|		Данные КАК Данные
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константы КАК Константы
	|			ПО ИСТИНА
	|	ГДЕ
	|		Константы.РеглУчетТоваровИМатериаловПоПартиямПриобретения
	|		И Данные.Период >= Константы.ДатаНачалаРеглУчетаТоваровИМатериаловПоПартиямПриобретения
	|		И Данные.ВидСчетаДт В (&ВидыСчетовДетализацииТМЦ)
	|		И ТИПЗНАЧЕНИЯ(Данные.ИдентификаторСтроки) = ТИП(СТРОКА)
	|		И Данные.ИдентификаторСтроки <> """"
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Данные.Ссылка КАК Ссылка,
	|		Данные.Период КАК Период,
	|		Данные.Организация КАК Организация,
	|		Данные.ВидСчетаДт КАК ВидСчета,
	|		Данные.ВидСчетаКт КАК КорВидСчета,
	|		Данные.СчетКт КАК КорСчет,
	|		Данные.ПодразделениеДт КАК Подразделение,
	|		Данные.НаправлениеДеятельностиДт КАК НаправлениеДеятельности,
	|		Данные.АналитикаУчетаДт КАК АналитикаУчета,
	|		Данные.СубконтоДт1 КАК Субконто1,
