	ВидыСчетовДетализацииПродажСписаниеРасходов.Добавить(Перечисления.ВидыСчетовРеглУчета.РасходыТекущегоПериода);
	
	Возврат ВидыСчетовДетализацииПродажСписаниеРасходов;
	
КонецФункции

// Виды счетов производства, для которых выполняется детализация по партиям.
// 
// Возвращаемое значение:
//  Массив Из ПеречислениеСсылка.ВидыСчетовРеглУчета
Функция ВидыСчетовДетализацииПроизводства() Экспорт
	
	ВидыСчетовДетализацииПроизводства = Новый Массив;
	
	ВидыСчетовДетализацииПроизводства.Добавить(Перечисления.ВидыСчетовРеглУчета.МатериалыИРаботыВПодразделении);
	ВидыСчетовДетализацииПроизводства.Добавить(Перечисления.ВидыСчетовРеглУчета.НезавершенноеПроизводство);
	ВидыСчетовДетализацииПроизводства.Добавить(Перечисления.ВидыСчетовРеглУчета.РезервыПодОбесценениеНезавершенногоПроизводства);
	ВидыСчетовДетализацииПроизводства.Добавить(Перечисления.ВидыСчетовРеглУчета.РезервыПодОбесценениеМатериаловВПодразделении);
	
	Возврат ВидыСчетовДетализацииПроизводства;
	
КонецФункции

// Виды счетов, для которых выполняется детализация по партиям ТМЦ.
// 
// Возвращаемое значение:
//  Массив Из ПеречислениеСсылка.ВидыСчетовРеглУчета - Виды счетов детализации по партиям ТМЦ
Функция ВидыСчетовДетализацииТМЦ() Экспорт
	
	ВидыСчетовДетализацииТМЦ = Новый Массив;
	
	ВидыСчетовДетализацииТМЦ.Добавить(Перечисления.ВидыСчетовРеглУчета.НаСкладе);
	ВидыСчетовДетализацииТМЦ.Добавить(Перечисления.ВидыСчетовРеглУчета.РеализацияБезПереходаПраваСобственности);
	ВидыСчетовДетализацииТМЦ.Добавить(Перечисления.ВидыСчетовРеглУчета.ПередачаВПереработку);
	ВидыСчетовДетализацииТМЦ.Добавить(Перечисления.ВидыСчетовРеглУчета.НоменклатураПереданная);
	
	Возврат ВидыСчетовДетализацииТМЦ;
	
КонецФункции

// Виды кор. счетов, использующиеся при детализации проводок
// 
// Возвращаемое значение:
//  Массив Из ПеречислениеСсылка.ВидыСчетовРеглУчета
Функция КорВидыСчетовДетализации() Экспорт
	
	КорВидыСчетовДетализации = Новый Массив;
	
	КорВидыСчетовДетализации.Добавить(Перечисления.ВидыСчетовРеглУчета.НДСПоПриобретеннымЦенностям);
	КорВидыСчетовДетализации.Добавить(Перечисления.ВидыСчетовРеглУчета.Расходы);
	КорВидыСчетовДетализации.Добавить(Перечисления.ВидыСчетовРеглУчета.РезервыПодОбесценениеПереданные);
	КорВидыСчетовДетализации.Добавить(Перечисления.ВидыСчетовРеглУчета.РезервыПодОбесценениеТМЦ);
	КорВидыСчетовДетализации.Добавить(Перечисления.ВидыСчетовРеглУчета.РезервыПодОбесценениеМатериаловВПодразделении);
	КорВидыСчетовДетализации.Добавить(Перечисления.ВидыСчетовРеглУчета.РезервыПодОбесценениеНезавершенногоПроизводства);
	КорВидыСчетовДетализации.Добавить(Перечисления.ВидыСчетовРеглУчета.ОтклоненияВСтоимости);
	
	Возврат КорВидыСчетовДетализации;
	
КонецФункции

