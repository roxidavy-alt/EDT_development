	//++ Локализация

	//++ НЕ УТ
	
	ДатаНачалаРасширеннойДетализации = МинимальныйПериодИспользованияДетализации(РасширеннаяДетализацияВключена);
	Если РасширеннаяДетализацияВключена Тогда
		Для Каждого Запись Из НаборЗаписей Цикл
			Если Запись.Период >= ДатаНачалаРасширеннойДетализации 
				И Запись.МетодОценкиСтоимостиТоваров = Перечисления.МетодыОценкиСтоимостиТоваров.СредняяЗаМесяц 
				Или Запись.МетодОценкиСтоимостиТоваров = Перечисления.МетодыОценкиСтоимостиТоваров.Среднескользящая
				Или Запись.УчетГотовойПродукцииПоПлановойСтоимости Тогда
				ФорматнаяСтрока = СтрШаблон("ДЛФ=D; ДП=%1;", НСтр("ru = 'начала учета';
																	|en = 'accounting start date'"));
				ПредставлениеДаты = Формат(ДатаНачалаРасширеннойДетализации, ФорматнаяСтрока);
				ТекстСообщения = НСтр("ru = 'Включена расширенная детализация регламентированного учета. По организации ""%1"" с %2 должен использоваться
											|метод оценки стоимости ""ФИФО"" и не должен использоваться выпуск по плановой стоимости.';
											|en = 'Detailed local accounting is enabled. For the ""%1"" company since %2, the FIFO cost evaluation method must be used and the release at standard cost must not be used.'");
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстСообщения, Запись.Организация, ПредставлениеДаты));
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//-- НЕ УТ
	
	//-- Локализация
КонецПроцедуры

// Организации перед записью.
// 
// Параметры:
//  Объект - СправочникОбъект.Организации - объект справочника организации
//  Отказ - Булево - Отказ
Процедура Организации_ПередЗаписью(Объект, Отказ) Экспорт
	Перем РасширеннаяДетализацияВключена;

	//++ Локализация

	//++ НЕ УТ
	
	УстановитьПривилегированныйРежим(Истина);
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Если Объект.Статус = Перечисления.СтатусыОрганизацийПодразделений.НеДействует 
		Или Объект.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	ДатаНачалаРасширеннойДетализации = МинимальныйПериодИспользованияДетализации(РасширеннаяДетализацияВключена);
	
	Если Не РасширеннаяДетализацияВключена Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&ДатаВключенияДетализации КАК Период,
	|	УчетнаяПолитика.Организация КАК Организация,
	|	УчетнаяПолитика.МетодОценкиСтоимостиТоваров КАК МетодОценкиСтоимости,
	|	УчетнаяПолитика.УчетГотовойПродукцииПоПлановойСтоимости КАК ПоПлановойСтоимости
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаФинансовогоУчета.СрезПоследних(&ДатаВключенияДетализации,
	|		Организация = &Организация) КАК УчетнаяПолитика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ 
	|	УчетнаяПолитика.Период КАК Период,
	|	УчетнаяПолитика.Организация КАК Организация,
	|	УчетнаяПолитика.МетодОценкиСтоимостиТоваров КАК МетодОценкиСтоимости,
	|	УчетнаяПолитика.УчетГотовойПродукцииПоПлановойСтоимости КАК ПоПлановойСтоимости
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаФинансовогоУчета КАК УчетнаяПолитика
	|ГДЕ
	|	УчетнаяПолитика.Период > &ДатаВключенияДетализации
	|	И УчетнаяПолитика.Организация = &Организация
	|	И (УчетнаяПолитика.МетодОценкиСтоимостиТоваров В (&МетодыОценкиСтоимости)
	|		ИЛИ УчетнаяПолитика.УчетГотовойПродукцииПоПлановойСтоимости)";
	Запрос.УстановитьПараметр("ДатаВключенияДетализации", ДатаНачалаРасширеннойДетализации);
	Запрос.УстановитьПараметр("Организация", Объект.Ссылка);
	МетодыОценкиСтоимости = Новый Массив;
	МетодыОценкиСтоимости.Добавить(Перечисления.МетодыОценкиСтоимостиТоваров.СредняяЗаМесяц);
	МетодыОценкиСтоимости.Добавить(Перечисления.МетодыОценкиСтоимостиТоваров.Среднескользящая);
	Запрос.УстановитьПараметр("МетодыОценкиСтоимости", МетодыОценкиСтоимости);
	РеквизитыДоИзменения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Ссылка, "ПометкаУдаления, Статус");
	ИзмененСтатус = Объект.Статус <> РеквизитыДоИзменения.Статус;
	ИзмененаПометкаУдаления = Объект.ПометкаУдаления <> РеквизитыДоИзменения.ПометкаУдаления;
	Выборка = Запрос.Выполнить().Выбрать();
	ТекстОшибки = "";
	Если ИзмененСтатус Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'У организации ""%1"" статус не может быть установлен в значение ""Действует""';
									|en = 'The status of the ""%1"" company cannot be set to ""Active""'"),
				Объект.Ссылка);
	КонецЕсли;
	Если ИзмененаПометкаУдаления Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'У организации ""%1"" не может быть снята пометка удаления';
									|en = 'Cannot clear the deletion mark for the ""%1"" company'"),
				Объект.Ссылка);
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Включена детализация регламентированного учета';
													|en = 'Detailed local accounting is enabled'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	Пока Выборка.Следующий() Цикл
		Если МетодыОценкиСтоимости.Найти(Выборка.МетодОценкиСтоимости) <> Неопределено Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'на дату %1 используется метод оценки ""%2""';
										|en = 'as of %1, the ""%2"" evaluation method is used'"),
								Формат(Выборка.Период, "ДФ=dd.MM.yyyy"),
								Выборка.МетодОценкиСтоимости);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,,Отказ);
		КонецЕсли;
		Если Выборка.ПоПлановойСтоимости Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'на дату %1 используется выпуск готовой продукции по плановой стоимости';
										|en = 'as of %1, finished product release by standard cost is used'"),
								Формат(Выборка.Период, "ДФ=dd.MM.yyyy"));
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,,Отказ);
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	//-- НЕ УТ
	
	//-- Локализация
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//++ Локализация

//++ НЕ УТ

Функция ДанныеПериодовДетализацииУчета()
	
	ПериодыДетализацииУчета = Новый Структура;
	ПериодыДетализацииУчета.Вставить("ИспользуетсяДетализация", Ложь);
	ПериодыДетализацииУчета.Вставить("ДанныеБезДетализации", Ложь);
	ПериодыДетализацииУчета.Вставить("ДанныеСДетализацией", Ложь);
	ПериодыДетализацииУчета.Вставить("НачалоПериодаБезДетализации", Дата(1, 1, 1));
	ПериодыДетализацииУчета.Вставить("КонецПериодаБезДетализации", Дата(1, 1, 1));
	ПериодыДетализацииУчета.Вставить("НачалоПериодаДанныеСДетализацией", Дата(1, 1, 1));
	ПериодыДетализацииУчета.Вставить("КонецПериодаДанныеСДетализацией", Дата(1, 1, 1));
	
	Возврат ПериодыДетализацииУчета;
	
КонецФункции

Функция НовыйСтруктураТребуетсяПерерасчетНалога()
	
	ТребуетсяПерерасчетНалога = Новый Структура();
	
	ТребуетсяПерерасчетНалога.Вставить("ТребуетсяПерерасчетПредыдущихПериодов", Ложь);
	ТребуетсяПерерасчетНалога.Вставить("ТребуетсяПерерасчетПредыдущихНаборовКорректировокТекущегоПериода", Ложь);
	
	Возврат ТребуетсяПерерасчетНалога;
	
КонецФункции

#Область ФормированиеЗаданийКЗакрытиюМесяцаСлужебные

Функция СоответствиеЗапросовКонтрольнымРегистрам(Запрос, ИменаВременныхТаблиц)
	
	СоответствиеТекстовЗапросов = Новый Соответствие();
	
	СоответствиеТекстовЗапросов.Вставить("ТаблицаИзмененийРасчетыСКлиентами", ТекстЗапросаРасчетыСКлиентами(Запрос, ИменаВременныхТаблиц));
	СоответствиеТекстовЗапросов.Вставить("ТаблицаИзмененийРасчетыСПоставщиками", ТекстЗапросаРасчетыСПоставщиками(Запрос, ИменаВременныхТаблиц));
	СоответствиеТекстовЗапросов.Вставить("ТаблицаИзмененийРасчетыПоФинансовымИнструментам", ТекстЗапросаРасчетыПоФинансовымИнструментам(Запрос, ИменаВременныхТаблиц));
	СоответствиеТекстовЗапросов.Вставить("ТаблицаИзмененийГрафикОплатУслугПоАренде", ТекстЗапросаГрафикОплатУслугПоАренде(Запрос, ИменаВременныхТаблиц));
	СоответствиеТекстовЗапросов.Вставить("ТаблицаИзмененийГрафикОплатКредитовИДепозитов", ТекстЗапросаГрафикОплатКредитовИДепозитов(Запрос, ИменаВременныхТаблиц));
	СоответствиеТекстовЗапросов.Вставить("ТаблицаИзмененийПрочиеДоходы", ТекстЗапросаПрочиеДоходы(Запрос, ИменаВременныхТаблиц));

	Возврат СоответствиеТекстовЗапросов;
	
КонецФункции

Функция ТекстЗапросаРасчетыСКлиентами(Запрос, ИменаВременныхТаблиц)
	
	ВременнаяТаблица = "втПериодыИзменений_РасчетыСКлиентами";
	
	Если СтрНайти(ИменаВременныхТаблиц, ВременнаяТаблица) = 0 Тогда
	
		ТекстЗапросаВременныхТаблиц = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаИзменений.Месяц КАК Месяц,
		|	ТаблицаИзменений.Организация КАК Организация,
		|	ТаблицаИзменений.Документ Документ
		|ПОМЕСТИТЬ втПериодыИзменений_РасчетыСКлиентами
		|ИЗ 
		|	ТаблицаИзмененийРасчетыСКлиентами КАК ТаблицаИзменений
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Месяц,
		|	Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";
	
	Иначе
		ТекстЗапросаВременныхТаблиц = "";
	КонецЕсли;
	
	ТекстЗапроса = ОбщийТекстЗапросаЗаданияПоРеклассификации(ВременнаяТаблица);
	
	СтруктураТекстовЗапросов = ЗакрытиеМесяцаСервер.ИнициализироватьСтруктуруТекстовЗапросов(
		ТекстЗапроса, ТекстЗапросаВременныхТаблиц, ВременнаяТаблица);
	
	Возврат СтруктураТекстовЗапросов;
	
КонецФункции

