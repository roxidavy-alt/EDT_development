// Периоды детализации учета.
// 
// Параметры:
//  НачалоПериода - Дата - Начало периода
//  КонецПериода - Дата - Конец периода
//  ВидДетализацииУчета - Строка - См. ВидыДетализацииУчета()
// 
// Возвращаемое значение:
//  Структура - Периоды детализации учета:
//   * ИспользуетсяДетализация - Булево - 
//   * ДанныеБезДетализации - Булево - 
//   * ДанныеСДетализацией - Булево - 
//   * НачалоПериодаБезДетализации - Дата - 
//   * КонецПериодаБезДетализации - Дата - 
//   * НачалоПериодаДанныеСДетализацией - Дата - 
//   * КонецПериодаДанныеСДетализацией - Дата - 
Функция ПериодыДетализацииУчета(Знач НачалоПериода, Знач КонецПериода, Знач ВидДетализацииУчета) Экспорт

	ПериодыДетализацииУчета = ДанныеПериодовДетализацииУчета();
	
	ПериодыДетализацииУчета.ИспользуетсяДетализация = ИспользуетсяДетализацияУчета(ВидДетализацииУчета);
	
	Если ПериодыДетализацииУчета.ИспользуетсяДетализация Тогда
		ДатаНачалаДетализацииУчета = ДатаНачалаДетализацииУчета(ВидДетализацииУчета);	
		
		Если ДатаНачалаДетализацииУчета > НачалоМесяца(КонецПериода) Тогда			
			ПериодыДетализацииУчета.ДанныеБезДетализации = Истина;
			ПериодыДетализацииУчета.НачалоПериодаБезДетализации = НачалоПериода;
			ПериодыДетализацииУчета.КонецПериодаБезДетализации = КонецПериода;
		ИначеЕсли ДатаНачалаДетализацииУчета <= НачалоМесяца(НачалоПериода) Тогда							
			ПериодыДетализацииУчета.ДанныеСДетализацией = Истина;
			ПериодыДетализацииУчета.НачалоПериодаБезДетализации = Дата(1, 1, 1);
			ПериодыДетализацииУчета.КонецПериодаБезДетализации = Дата(1, 1, 1);
			ПериодыДетализацииУчета.НачалоПериодаДанныеСДетализацией = НачалоПериода;
			ПериодыДетализацииУчета.КонецПериодаДанныеСДетализацией = КонецПериода;
		Иначе
			ПериодыДетализацииУчета.ДанныеБезДетализации = Истина;
			ПериодыДетализацииУчета.ДанныеСДетализацией = Истина;
			ПериодыДетализацииУчета.НачалоПериодаБезДетализации = НачалоПериода;
			ПериодыДетализацииУчета.КонецПериодаБезДетализации = ДатаНачалаДетализацииУчета - 1;
			ПериодыДетализацииУчета.НачалоПериодаДанныеСДетализацией = ДатаНачалаДетализацииУчета;				
			ПериодыДетализацииУчета.КонецПериодаДанныеСДетализацией = КонецПериода;			
		КонецЕсли;
	Иначе
		ПериодыДетализацииУчета.ДанныеБезДетализации = Истина;
		ПериодыДетализацииУчета.НачалоПериодаБезДетализации = НачалоПериода;
		ПериодыДетализацииУчета.КонецПериодаБезДетализации = КонецПериода;				
	КонецЕсли;
			
	Возврат ПериодыДетализацииУчета;
	
КонецФункции

