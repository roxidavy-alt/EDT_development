Процедура ДобавитьФрагментыПроводок_ПроизводствоБезЗаказаЛокализация(ФрагментыПроводок)

	ОписаниеФрагмента = ОписаниеФрагментаПроводокДляНесколькихДокументов();
	ОписаниеФрагмента.ТестЗапроса = ПроизводствоБезЗаказаЛокализация.ТекстСписаниеТоваровНаСтатьиАктивовПассивов();
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ВнутреннееПотребление.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.КорректировкаРеализации.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ОтчетОСписанииТоваровСХранения.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ОтчетПереработчика2_5.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.РаспределениеПроизводственныхЗатрат.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.СписаниеНедостачТоваров.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.СписаниеОтгруженныхТоваров.Имя);
	
	//++ НЕ УТКА
	
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ОтчетДавальцу2_5.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ОтчетДавальцуМеждуОрганизациями.Имя);
	
	//-- НЕ УТКА
	
	ФрагментыПроводок.Добавить(ОписаниеФрагмента);

	ОписаниеФрагмента = ОписаниеФрагментаПроводокДляНесколькихДокументов();
	ОписаниеФрагмента.ТестЗапроса = ПроизводствоБезЗаказаЛокализация.ТекстСписаниеТоваровЗаБалансом();
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ВыкупПринятыхНаХранениеТоваров.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ВыкупТоваровХранителем.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ДвижениеПродукцииИМатериалов.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ОтгрузкаТоваровСХранения.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ОтчетОСписанииТоваровСХранения.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ОтчетПереработчика2_5.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ПередачаТоваровМеждуОрганизациями.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ПеремещениеТоваров.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ПересортицаТоваров.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ПересортицаТоваровУХранителя.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ПорчаТоваров.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ПорчаТоваровУХранителя.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.РаспределениеВозвратныхОтходов.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.РаспределениеПроизводственныхЗатрат.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.РегистраторРасчетаСебестоимости.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.СборкаТоваров.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.СписаниеНедостачТоваров.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ПроизводствоБезЗаказа.Имя);

	//++ НЕ УТКА

