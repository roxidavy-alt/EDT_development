	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ЭтапПроизводства2_2.Имя);
	
	//-- НЕ УТКА

	ФрагментыПроводок.Добавить(ОписаниеФрагмента);

	ОписаниеФрагмента = ОписаниеФрагментаПроводокДляНесколькихДокументов();
	ОписаниеФрагмента.ТестЗапроса = ПроизводствоБезЗаказаЛокализация.ТекстПриходТоваровЗаБалансом();
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ДвижениеПродукцииИМатериалов.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.КорректировкаПриобретения.Имя);
