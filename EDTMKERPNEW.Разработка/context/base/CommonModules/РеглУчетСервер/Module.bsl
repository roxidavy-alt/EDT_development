	ИначеЕсли СчетУчета = ПланыСчетов.Хозрасчетный.ЕдиныйНалоговыйСчет Тогда
	    ТипНалога = Справочники.ВидыНалоговВзносов.ЕдиныйНалоговыйПлатеж;
	Иначе
		ТипНалога = Справочники.ВидыНалоговВзносов.ПустаяСсылка();
	КонецЕсли;
	//-- НЕ УТ

