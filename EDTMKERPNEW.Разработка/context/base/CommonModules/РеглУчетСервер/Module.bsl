// Общие фрагменты проводок.
// 
// Возвращаемое значение:
//  Массив из Строка - Общие фрагменты проводок
Функция ОбщиеФрагментыПроводок() Экспорт
	
	ОбщиеФрагментыПроводок = Новый Массив;

	ТаблицаДокумента = "ДокументИмя";
	
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстИнициализации());
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстЗачетАвансов(ТаблицаДокумента));
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстВосстановлениеРасчетовПоСторно(ТаблицаДокумента));
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстПереносАвансовМеждуФилиалами(ТаблицаДокумента));
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстПереносПлатежаМеждуФилиалами(ТаблицаДокумента));
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстПереносДолгаМеждуФилиалами(ТаблицаДокумента));
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстСторноВзаиморасчетов(ТаблицаДокумента));
	
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстРаспределениеРасходов(ТаблицаДокумента));
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстСписаниеРасходовУОрганизацииИсточника(ТаблицаДокумента));
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстРегистрацияРасходовУОрганизацииПолучателя(ТаблицаДокумента));
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстПереносРезервовПодОбесценение());
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстСписаниеСтоимостиНаСтатьиАктивовПассивов(,, Истина));
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстПеремещениеМеждуФилиалами());
	
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстНДСПоДаннымФинпартий());
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстНДСПоНДСПредъявленный());

	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстПереносОбесцененияВНА());
	ОбщиеФрагментыПроводок.Добавить(РеглУчетВыборкиСерверПовтИсп.ТекстВосстановлениеОбесцененияВНА());
	
	Возврат ОбщиеФрагментыПроводок;
		
КонецФункции

// Общие фрагменты проводок для нескольких документов.
// 
// Возвращаемое значение:
//  Массив из Строка - Общие фрагменты проводок для нескольких документов
Функция ФрагментыПроводокДляНесколькихДокументов() Экспорт

	ФрагментыПроводок = Новый Массив;
		
	ДобавитьФрагментыПроводок_РеглУчетВыборкиСерверПовтИсп(ФрагментыПроводок);	
	ДобавитьФрагментыПроводок_ВнеоборотныеАктивыЛокализация(ФрагментыПроводок);
	ДобавитьФрагментыПроводок_ПроизводствоБезЗаказаЛокализация(ФрагментыПроводок);
	ДобавитьФрагментыПроводок_РегистраторРасчетаСебестоимостиЛокализация(ФрагментыПроводок);
	
	//ВзаимозачетЗадолженностиЛокализация
	ОписаниеФрагмента = ОписаниеФрагментаПроводокДляНесколькихДокументов();
	ОписаниеФрагмента.ТестЗапроса = ВзаимозачетЗадолженностиЛокализация.ТекстВзаимозачетаСФилиалами();
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ВзаимозачетЗадолженности.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ПоступлениеБезналичныхДенежныхСредств.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ПриходныйКассовыйОрдер.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.РасходныйКассовыйОрдер.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.СписаниеБезналичныхДенежныхСредств.Имя);
	ФрагментыПроводок.Добавить(ОписаниеФрагмента);
	//ВзаимозачетЗадолженностиЛокализация
	
	//ВозвратТоваровПоставщикуЛокализация
	ОписаниеФрагмента = ОписаниеФрагментаПроводокДляНесколькихДокументов();
	ОписаниеФрагмента.ТестЗапроса = ВозвратТоваровПоставщикуЛокализация.ТекстПереносПретензииНаРасчетыНовыеВзаиморасчеты();
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ВозвратТоваровМеждуОрганизациями.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ВозвратТоваровПоставщику.Имя);
	ФрагментыПроводок.Добавить(ОписаниеФрагмента);
	//ВозвратТоваровПоставщикуЛокализация


	//КорректировкаПриобретенияЛокализация
	ОписаниеФрагмента = ОписаниеФрагментаПроводокДляНесколькихДокументов();
	ОписаниеФрагмента.ТестЗапроса = КорректировкаПриобретенияЛокализация.ТекстРегистрацияОтклоненийПлановойСтоимости();
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.ТаможеннаяДекларацияИмпорт.Имя);
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.КорректировкаПриобретения.Имя);
	ФрагментыПроводок.Добавить(ОписаниеФрагмента);	
	//КорректировкаПриобретенияЛокализация
	
	//УчетНМА
	ОписаниеФрагмента = ОписаниеФрагментаПроводокДляНесколькихДокументов();
	ОписаниеФрагмента.ТестЗапроса = УчетНМА.ТекстОтраженияВРеглУчетеНачисленнойАмортизации();
	ОписаниеФрагмента.Документы.Добавить(Метаданные.Документы.АмортизацияНМА.Имя);
