// Параметры последнего набора расчета по дате подписи.
// 
// Возвращаемое значение:
//  Структура - Параметры последнего набора расчета по дате подписи:
// * Организация - СправочникСсылка.Организации - 
// * МесяцРасчета - Дата - 
// * ДатаНачалаПодготовкиДекларации - Дата - 
// * ПолноеИмяРегистраРасчета - Строка - 
Функция ПараметрыПоследнегоНабораРасчетаПоДатеПодписи() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Параметры.Вставить("МесяцРасчета", Дата(1, 1, 1));
	Параметры.Вставить("ДатаНачалаПодготовкиДекларации", Дата(1, 1, 1));
	Параметры.Вставить("ПолноеИмяРегистраРасчета", "");
	
	Возврат Параметры;
	
КонецФункции

// Последний набор расчета по дате подписи декларации.
