// Состояние сдачи деклараций наборов.
// 
// Параметры:
//  НаборыКорректировок - Массив из СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Наборы корректировок
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Состояние сдачи деклараций наборов:
//   * Ключ - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - 
//   * Значение - Булево - Все отчета набора сданы
Функция СостояниеСдачиДекларацийНаборов(НаборыКорректировок) Экспорт
	
	СостояниеСдачиДекларацийНаборов = Новый Соответствие;
	
	ДекларацииНаборов = ДекларацииНаборов(НаборыКорректировок);
	
	ВсеДекларации = Новый Массив;
	
	Для Каждого ДанныеДекларации Из ДекларацииНаборов Цикл
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеДекларации, ДанныеДекларации.Значение);	
	КонецЦикла;
	
	СостояниеСдачиОтчетов = ИнтерфейсыВзаимодействияБРО.СостояниеСдачиОтчетов(ВсеДекларации);
	
	Для Каждого Набор Из НаборыКорректировок Цикл
		СданыВсеДекларацииНабора = Истина;
		
		Декларации = ДекларацииНаборов.Получить(Набор);		
		
		Если Декларации <> Неопределено 
			И ВсеДекларацииНабораСформированы(Декларации) Тогда
			
			Для Каждого Декларация Из Декларации Цикл
				ОтчетСдан = СостояниеСдачиОтчетов.Получить(Декларация);
				
				Если ОтчетСдан = Неопределено 
					ИЛИ НЕ ОтчетСдан Тогда
					СданыВсеДекларацииНабора = Ложь;
				КонецЕсли;	

			КонецЦикла;
			
		Иначе
			СданыВсеДекларацииНабора = Ложь;	
		КонецЕсли;
		
		СостояниеСдачиДекларацийНаборов.Вставить(Набор, СданыВсеДекларацииНабора);
	КонецЦикла;
	
	Возврат СостояниеСдачиДекларацийНаборов;
	
КонецФункции

// Все декларации по набору сданы.
// 
// Параметры:
//  НаборКорректировок - СправочникСсылка.КорректировкиПрошлыхПериодовНУ - Набор корректировок
// 
// Возвращаемое значение:
//  Булево - Все декларации по набору сданы
Функция ВсеДекларацииПоНаборуСданы(Знач НаборКорректировок) Экспорт
	
	ВсеДекларацииПоНаборуСданы = Ложь;
	
	Если НЕ ЗначениеЗаполнено(НаборКорректировок) Тогда
		Возврат ВсеДекларацииПоНаборуСданы;	
	КонецЕсли;
	
	НаборыКорректировок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НаборКорректировок);
	СостояниеСдачиДеклараций = СостояниеСдачиДекларацийНаборов(НаборыКорректировок);
	
	ВсеДекларацииСданы = СостояниеСдачиДеклараций.Получить(НаборКорректировок);
	Если ВсеДекларацииСданы <> Неопределено
		И ВсеДекларацииСданы Тогда
		ВсеДекларацииПоНаборуСданы = Истина;
	КонецЕсли;
		
	Возврат ВсеДекларацииПоНаборуСданы;
	
КонецФункции

