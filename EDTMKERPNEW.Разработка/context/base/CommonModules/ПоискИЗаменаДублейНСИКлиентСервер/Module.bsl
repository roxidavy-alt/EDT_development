#Область СлужебныеПроцедурыИФункции

// Возвращает строковое представление статуса.
//
// Возвращаемое значение:
//   Строка
//
Функция СтатусДубльЗаменить() Экспорт
	Возврат НСтр("ru = 'Дубль, заменить ссылки и удалить';
				|en = 'Duplicate, replace links and delete'");
КонецФункции

