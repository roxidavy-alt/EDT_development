Функция ТекстПереносНДССРеализацииСобственныхТоваров()
	
	ТекстПереносНДССРеализацииСобственныхТоваров = "
	|ВЫБРАТЬ  //// Перенос НДС (Дт 68.02 :: Кт 19.09)
	|
	|	Операция.Ссылка КАК Ссылка,
	|	Операция.Дата КАК Период,
