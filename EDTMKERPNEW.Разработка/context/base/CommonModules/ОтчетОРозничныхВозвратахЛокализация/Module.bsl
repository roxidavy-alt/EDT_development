Функция ТекстСторноНДССРеализации()
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////////////////////////
	|// Сторно НДС с реализации (Дт 90.03 :: Кт 68.02)
	|ВЫБРАТЬ
	|	СтрокиДт.Ссылка КАК Ссылка,
