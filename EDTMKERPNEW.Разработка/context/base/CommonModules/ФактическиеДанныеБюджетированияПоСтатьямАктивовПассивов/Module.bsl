	Возврат ПоляВыборки;
	
КонецФункции

Функция СтрокиВыборкиПолейПоОписаниюОбъектаУчета(СтрокиОбъектовУчета, ПараметрыОтраженияДвижений, ПараметрыЗапроса)
	
	СписокПолей = СтрСоединить(ПоляВыборкиПоОписаниюОбъектаУчета(), ",");
	
	ПоляВыборкиОбъектаУчета = ФинансовыйУчетПоДаннымБалансовыхРегистров.СтрокиВыборкиПолейПоОписаниюОбъектаУчета(
		СтрокиОбъектовУчета, ПараметрыОтраженияДвижений, ПараметрыЗапроса, СписокПолей);
	
	Возврат ПоляВыборкиОбъектаУчета;
	
КонецФункции

#КонецОбласти

#Область ОтборКорреспонденцийПоНастройкамСхемыКомпоновкиДанных

Функция ПоляВыбораКомпоновкиДанных(ПараметрыЗапроса)
	
	ПоляВыбора = Новый Структура();
	ПоляВыбора.Вставить("НомерЗаписи", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0, ДопустимыйЗнак.Неотрицательный));
	ПоляВыбора.Вставить("ПравилоПолученияФакта", Новый ОписаниеТипов("СправочникСсылка.ПравилаПолученияФактаПоСтатьямБюджетов"));
	
	Возврат ПоляВыбора;
	
КонецФункции

Функция ТаблицаРезультатовКомпоновкиДанных(ПоляВыбораКомпоновкиДанных)
	
	ТаблицаРезультатов = Новый ТаблицаЗначений();
	
	Для Каждого ПолеВыбора Из ПоляВыбораКомпоновкиДанных Цикл
		ТаблицаРезультатов.Колонки.Добавить(ПолеВыбора.Ключ, ПолеВыбора.Значение);
	КонецЦикла;
	
	Возврат ТаблицаРезультатов;
	
КонецФункции

Функция КлючПравилаОтбора(ВыборкаПравилаОтбора)
	
	КлючПравила = Новый Структура();
	КлючПравила.Вставить("ПравилоПолученияФакта", ВыборкаПравилаОтбора.ПравилоПолученияФакта);
	
	Если ЗначениеЗаполнено(ВыборкаПравилаОтбора.ОбъектУчетаДт) Тогда
		КлючПравила.Вставить("ОбъектУчетаДт", ВыборкаПравилаОтбора.ОбъектУчетаДт);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаПравилаОтбора.ОбъектУчетаКт) Тогда
		КлючПравила.Вставить("ОбъектУчетаКт", ВыборкаПравилаОтбора.ОбъектУчетаКт);
	КонецЕсли;
	
	Возврат КлючПравила;
	
КонецФункции

Процедура ДобавитьКлючПравилаВОтборКомпоновкиДанных(КлючПравила, ОтборПриемник)
	
	Для Каждого КлючИЗначение Из КлючПравила Цикл
		НовыйЭлемент = ОтборПриемник.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(КлючИЗначение.Ключ);
		НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НовыйЭлемент.ПравоеЗначение = КлючИЗначение.Значение;
		НовыйЭлемент.Использование = Истина;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьОтборПравилаВОтборКомпоновкиДанных(ОтборИсточник, ИнверсияИсточниковДанных, ОтборПриемник)
	
	ПостфиксыПоИменамПапокПолей = Новый Структура();
	ПостфиксыПоИменамПапокПолей.Вставить(
		ИсточникиДанныхСервер.ИмяПапкиПолейИсточникаДанных(),
		?(ИнверсияИсточниковДанных, "Кт", "Дт"));
	ПостфиксыПоИменамПапокПолей.Вставить(
		ИсточникиДанныхСервер.ИмяПапкиПолейКорИсточникаДанных(),
		?(ИнверсияИсточниковДанных, "Дт", "Кт"));
	
	Для Каждого ЭлементОтбораИсточника Из ОтборИсточник.Элементы Цикл
		Если НЕ ЭлементОтбораИсточника.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		ТипЭлементаОтбора = ТипЗнч(ЭлементОтбораИсточника);
		ЭлементОтбораПриемника = ОтборПриемник.Элементы.Добавить(ТипЭлементаОтбора);
		
		Если ТипЭлементаОтбора = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			ПутьКДанным = Строка(ЭлементОтбораИсточника.ЛевоеЗначение);
			ЧастиПутиКДанным = СтрРазделить(ПутьКДанным, ".");
			ИмяПапкиПолей = ЧастиПутиКДанным[0];
			Постфикс = "";
			
			Если ПостфиксыПоИменамПапокПолей.Свойство(ИмяПапкиПолей, Постфикс) Тогда
				ЧастиПутиКДанным.Удалить(0);
			Иначе
				Постфикс = ?(ИнверсияИсточниковДанных, "Кт", "Дт");
			КонецЕсли;
			
			Если ИмяПапкиПолей = ИсточникиДанныхСервер.ИмяПапкиПолейКорИсточникаДанных() Тогда
				ПрефиксИменПолей = ИсточникиДанныхСервер.ПрефиксИменПолейКорИсточникаДанных();
				ДлинаПрефиксаИмен = СтрДлина(ПрефиксИменПолей);
				Если Лев(ЧастиПутиКДанным[0], ДлинаПрефиксаИмен) = ПрефиксИменПолей Тогда
					ЧастиПутиКДанным[0] = Сред(ЧастиПутиКДанным[0], ДлинаПрефиксаИмен + 1);
				КонецЕсли;
			КонецЕсли;
			
			ЧастиПутиКДанным[0] = ЧастиПутиКДанным[0] + Постфикс;
			ПутьКДанным = СтрСоединить(ЧастиПутиКДанным, ".");
			ЗаполнитьЗначенияСвойств(ЭлементОтбораПриемника, ЭлементОтбораИсточника,, "ЛевоеЗначение");
			ЭлементОтбораПриемника.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным);
		Иначе
			ЗаполнитьЗначенияСвойств(ЭлементОтбораПриемника, ЭлементОтбораИсточника);
			ДобавитьОтборПравилаВОтборКомпоновкиДанных(ОтборИсточник, ИнверсияИсточниковДанных, ОтборПриемник);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПолучениеАналитикиКорреспонденций

Функция ВыраженияАналитикиРегистра(ВыборкаИмяРегистра, ПараметрыЗапроса)
	
	ВыраженияАналитикиРегистра = Новый Массив();
	ВыборкаВыраженияАналитики = ВыборкаИмяРегистра.Выбрать();
	МаксимальноеКоличествоАналитик = БюджетированиеКлиентСервер.МаксимальноеКоличествоАналитик();
	
	Пока ВыборкаВыраженияАналитики.Следующий() Цикл
		Для НомерВыражения = 1 По МаксимальноеКоличествоАналитик Цикл
			ВыражениеАналитики = ВыборкаВыраженияАналитики["ВыражениеАналитики" + НомерВыражения];
			Если ЗначениеЗаполнено(ВыражениеАналитики) Тогда
				НормализоватьВыражениеАналитики(ВыражениеАналитики, ПараметрыЗапроса);
				Если ВыраженияАналитикиРегистра.Найти(ВыражениеАналитики) = Неопределено Тогда
					ВыраженияАналитикиРегистра.Добавить(ВыражениеАналитики);
				КонецЕсли;
				Если ПараметрыЗапроса.ВсеВыраженияАналитики[ВыражениеАналитики] = Неопределено Тогда
					ИмяВыражения = "Выражение" + СтрЗаменить(ВыражениеАналитики, ".", "");
					ПараметрыЗапроса.ВсеВыраженияАналитики.Вставить(ВыражениеАналитики, ИмяВыражения);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ВыраженияАналитикиРегистра;
	
КонецФункции

Процедура НормализоватьВыражениеАналитики(ВыражениеАналитики, ПараметрыЗапроса)
	
	Если СтрНачинаетсяС(ВыражениеАналитики, ПараметрыЗапроса.ИмяПапкиПолей) Тогда
		ВыражениеАналитики = Сред(ВыражениеАналитики, ПараметрыЗапроса.ДлинаИмениПапкиПолей + 2);
	КонецЕсли;
	
	Если СтрНачинаетсяС(ВыражениеАналитики, ПараметрыЗапроса.ИмяПапкиКорПолей) Тогда
		ВыражениеАналитики = Сред(ВыражениеАналитики, ПараметрыЗапроса.ДлинаИмениПапкиКорПолей + 2);
		Если СтрНачинаетсяС(ВыражениеАналитики, ПараметрыЗапроса.ПрефиксИменКорПолей) Тогда
			ВыражениеАналитики = Сред(ВыражениеАналитики, ПараметрыЗапроса.ДлинаПрефиксаИменКорПолей + 1);
		КонецЕсли;
	КонецЕсли;
	
	ВыражениеАналитики = СтрЗаменить(ВыражениеАналитики, "_", ".");
	
КонецПроцедуры

Процедура ЗаполнитьСтрокиВыборкиВыражений(ВыборкаПолей, ГруппировкаПолей, ВыраженияАналитикиРегистра, ВсеВыраженияАналитики)
	
	Для Каждого ВыражениеАналитики Из ВыраженияАналитикиРегистра Цикл
		ПутьКДанным = ФинансовыйУчетПоДаннымБалансовыхРегистров.ПутьКДаннымСПсевдонимомИсточника(ВыражениеАналитики);
		ПсевдонимВыражения = ВсеВыраженияАналитики[ВыражениеАналитики];
		ВыборкаПолей.Добавить(ПутьКДанным + " КАК " + ПсевдонимВыражения);
		ГруппировкаПолей.Добавить(ПутьКДанным);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСтрокиВыборкиРесурсов(ВыборкаРесурсов, ВыборкаИмяИсточника)
	
	ВыборкаИменаРесурсов = ВыборкаИмяИсточника.Выбрать();
	
	Пока ВыборкаИменаРесурсов.Следующий() Цикл
		ИмяРесурса = ВыборкаИменаРесурсов.ИмяРесурса;
		ПутьКДанным = ФинансовыйУчетПоДаннымБалансовыхРегистров.ПутьКДаннымСПсевдонимомИсточника(ИмяРесурса);
		ПсевдонимРесурса = "Ресурс" + ИмяРесурса;
		ВыборкаРесурсов.Добавить(СтрШаблон("СУММА(%1) КАК %2", ПутьКДанным, ПсевдонимРесурса));
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеТаблицыФактическихДанных

Функция ТаблицаЗапросаАналитики(РезультатЗапроса)
	
	ТаблицаЗапроса = РезультатЗапроса.Выгрузить();
	ОбязательныеПоляИндекса = "Период,Регистратор,ИдентификаторФинЗаписи,ИдентификаторСтроки,ИмяРегистра,ОбъектУчета,Организация,РеквизитСторно";
	
	ТаблицаЗапроса.Индексы.Добавить(ОбязательныеПоляИндекса + ",ЭтоДебет,ЭтоСторно");
	ТаблицаЗапроса.Индексы.Добавить(ОбязательныеПоляИндекса + ",ЭтоКредит,ЭтоСторно");
	ТаблицаЗапроса.Индексы.Добавить(ОбязательныеПоляИндекса + ",НастройкаХозОперации,ЭтоДебет,ЭтоСторно");
	ТаблицаЗапроса.Индексы.Добавить(ОбязательныеПоляИндекса + ",НастройкаХозОперации,ЭтоКредит,ЭтоСторно");
	
	Возврат ТаблицаЗапроса;
	
КонецФункции

Функция СтрокиАналитикиДвижения(ВыборкаКорреспонденции,
		ВыборкаЗначенияАналитики, ВыборкаВыраженияАналитики, ТаблицыАналитики, ПараметрыЗапроса, ДтКт)
	
	ИмяРегистра = ВыборкаКорреспонденции["ИмяРегистра" + ДтКт];
	ЭтоИсточникДанных = ВыборкаКорреспонденции.ИсточникДанныхКорреспонденции = ДтКт;
	
	Если ЭтоИсточникДанных ИЛИ ВыборкаКорреспонденции.ПолучитьКорАналитику Тогда
		СтруктураПоиска = Новый Структура();
		СтруктураПоиска.Вставить("Период", ВыборкаКорреспонденции.Период);
		СтруктураПоиска.Вставить("Регистратор", ВыборкаКорреспонденции.Регистратор);
		СтруктураПоиска.Вставить("ИдентификаторФинЗаписи", ВыборкаКорреспонденции.ИдентификаторФинЗаписи);
		СтруктураПоиска.Вставить("ИдентификаторСтроки", ВыборкаКорреспонденции["ИдентификаторСтроки" + ДтКт]);
		СтруктураПоиска.Вставить("ИмяРегистра", ИмяРегистра);
		СтруктураПоиска.Вставить("ОбъектУчета", ВыборкаКорреспонденции["ОбъектУчета" + ДтКт]);
		СтруктураПоиска.Вставить("Организация", ВыборкаКорреспонденции.Организация);
		СтруктураПоиска.Вставить("РеквизитСторно", ВыборкаКорреспонденции.РеквизитСторно);
		
		Если ВыборкаКорреспонденции.УчитыватьХозОперацию Тогда
			СтруктураПоиска.Вставить("НастройкаХозОперации", ВыборкаКорреспонденции.НастройкаХозОперации);
		КонецЕсли;
		
		Если ДтКт = "Дт" Тогда
			СтруктураПоиска.Вставить("ЭтоКредит", Ложь);
		Иначе
			СтруктураПоиска.Вставить("ЭтоДебет", Ложь);
		КонецЕсли;
		
		СтруктураПоиска.Вставить("ЭтоСторно", ВыборкаКорреспонденции["ЭтоСторно" + ДтКт]);
		СтрокиАналитики = ТаблицыАналитики[ИмяРегистра].Скопировать(СтруктураПоиска); // ТаблицаЗначений -
		
		ВыполнитьДополнительныйОтборСтрокАналитики(ВыборкаКорреспонденции, СтрокиАналитики, ДтКт);
		
		Если ЭтоИсточникДанных Тогда
			ВыборкаЗначенияАналитики.Сбросить();
			СтруктураПоиска = Новый Структура("ПравилоПолученияФакта", ВыборкаКорреспонденции.ПравилоПолученияФакта);
			ПолучитьЗначенияАналитики = ВыборкаЗначенияАналитики.НайтиСледующий(СтруктураПоиска);
		Иначе
			ПолучитьЗначенияАналитики = Ложь;
		КонецЕсли;
		
		ВыборкаВыраженияАналитики.Сбросить();
		СтруктураПоиска = Новый Структура(
			"ПравилоПолученияФакта,ОбъектУчетаДт,ОбъектУчетаКт",
			ВыборкаКорреспонденции.ПравилоПолученияФакта,
			ВыборкаКорреспонденции.ОбъектУчетаДт,
			ВыборкаКорреспонденции.ОбъектУчетаКт);
		ПолучитьВыраженияАналитики = ВыборкаВыраженияАналитики.НайтиСледующий(СтруктураПоиска);
		
		МаксимальноеКоличествоАналитик = БюджетированиеКлиентСервер.МаксимальноеКоличествоАналитик();
		ИменаКолонокАналитики = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("Подразделение");
		
		Для НомерАналитики = 1 По МаксимальноеКоличествоАналитик Цикл
			ИмяКолонкиАналитика = "Аналитика" + НомерАналитики;
			СтрокиАналитики.Колонки.Добавить(ИмяКолонкиАналитика);
			
			Если ПолучитьЗначенияАналитики Тогда
				ЗначениеАналитики = ВыборкаЗначенияАналитики["ЗначениеАналитики" + НомерАналитики];
			Иначе
				ЗначениеАналитики = Null;
			КонецЕсли;
			
			Если ЗначениеАналитики = Null И ПолучитьВыраженияАналитики Тогда
				ВыражениеАналитики = ВыборкаВыраженияАналитики["ВыражениеАналитики" + НомерАналитики];
				КорИсточникАналитики = ВыборкаВыраженияАналитики["КорИсточникАналитики" + НомерАналитики];
				
				Если ЗначениеЗаполнено(ВыражениеАналитики)
				 И (ЭтоИсточникДанных И НЕ КорИсточникАналитики 
					ИЛИ НЕ ЭтоИсточникДанных И КорИсточникАналитики) Тогда
					НормализоватьВыражениеАналитики(ВыражениеАналитики, ПараметрыЗапроса);
					ИмяКолонкиВыражения = ПараметрыЗапроса.ВсеВыраженияАналитики[ВыражениеАналитики];
				Иначе
					ИмяКолонкиВыражения = Null;
				КонецЕсли;
			Иначе
				ИмяКолонкиВыражения = Null;
			КонецЕсли;
			
			Для Каждого СтрокаАналитики Из СтрокиАналитики Цикл
				Если ЗначениеАналитики <> Null Тогда
					СтрокаАналитики[ИмяКолонкиАналитика] = ЗначениеАналитики;
				ИначеЕсли ЗначениеЗаполнено(ИмяКолонкиВыражения) Тогда
					Если ЗначениеЗаполнено(СтрокаАналитики[ИмяКолонкиВыражения]) Тогда
						СтрокаАналитики[ИмяКолонкиАналитика] = СтрокаАналитики[ИмяКолонкиВыражения];
					Иначе
						СтрокаАналитики[ИмяКолонкиАналитика] = Неопределено;
					КонецЕсли;
				Иначе
					СтрокаАналитики[ИмяКолонкиАналитика] = Неопределено;
				КонецЕсли;
				
				Если НомерАналитики = 1 И НЕ ЗначениеЗаполнено(СтрокаАналитики.Подразделение) Тогда
					СтрокаАналитики.Подразделение = Неопределено;
				КонецЕсли;
			КонецЦикла;
			ИменаКолонокАналитики.Добавить(ИмяКолонкиАналитика);
		КонецЦикла;
		
		Если СтрокиАналитики.Количество() > 1 Тогда
			ИменаКолонокРесурсов = Новый Массив();
			Для Каждого Колонка Из СтрокиАналитики.Колонки Цикл
				Если Колонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
					ИменаКолонокРесурсов.Добавить(Колонка.Имя);
				КонецЕсли;
			КонецЦикла;
			КолонкиГруппировки = СтрСоединить(ИменаКолонокАналитики, ",");
			КолонкиСуммирования = СтрСоединить(ИменаКолонокРесурсов, ",");
			СтрокиАналитики.Свернуть(КолонкиГруппировки, КолонкиСуммирования);
			ВыполнитьОтборСтрокАналитикиПоСуммам(ВыборкаКорреспонденции, СтрокиАналитики, ДтКт);
		КонецЕсли;
	Иначе
		СтрокиАналитики = Новый ТаблицаЗначений();
	КонецЕсли;
	
	Возврат СтрокиАналитики;
	
КонецФункции

// Условия отбора в этой процедуре должны соответствовать дополнительным условиям соединения записей в процедуре формирования корреспонденций
//
Процедура ВыполнитьДополнительныйОтборСтрокАналитики(ВыборкаКорреспонденции, СтрокиАналитики, ДтКт)
	
	Если НЕ ВыборкаКорреспонденции.УчитыватьХозОперацию Тогда
		КоличествоСтрок = СтрокиАналитики.Количество();
		Для ОбратныйИндекс = 1 По КоличествоСтрок Цикл
			СтрокаАналитики = СтрокиАналитики[КоличествоСтрок - ОбратныйИндекс];
			Если ЗначениеЗаполнено(СтрокаАналитики.НастройкаХозОперации)
				И СтрокаАналитики.НастройкаХозОперации <> ВыборкаКорреспонденции.НастройкаХозОперации Тогда
				СтрокиАналитики.Удалить(СтрокаАналитики);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ВыполнитьОтборСтрокАналитикиПоСуммам(ВыборкаКорреспонденции, СтрокиАналитики, ДтКт);
	
КонецПроцедуры

Процедура ВыполнитьОтборСтрокАналитикиПоСуммам(ВыборкаКорреспонденции, СтрокиАналитики, ДтКт)
	
	Если СтрокиАналитики.Количество() > 1
	И НЕ ВыборкаКорреспонденции["СложнаяПроводка" + ДтКт] Тогда
		АналитикаССуммамиДвижения = Новый Массив();
		
		Для Каждого СтрокаАналитики Из СтрокиАналитики Цикл
			Если СтрокаАналитики.СуммаУпр = ВыборкаКорреспонденции["СуммаДвиженияУпр" + ДтКт]
			   И СтрокаАналитики.СуммаРегл = ВыборкаКорреспонденции["СуммаДвиженияРегл" + ДтКт] Тогда
				АналитикаССуммамиДвижения.Добавить(СтрокаАналитики);
			КонецЕсли;
		КонецЦикла;
		
		Если АналитикаССуммамиДвижения.Количество() = 1 Тогда
			КоличествоСтрок = СтрокиАналитики.Количество();
			Для ОбратныйИндекс = 1 По КоличествоСтрок Цикл
				СтрокаАналитики = СтрокиАналитики[КоличествоСтрок - ОбратныйИндекс];
				Если СтрокаАналитики <> АналитикаССуммамиДвижения[0] Тогда
					СтрокиАналитики.Удалить(СтрокаАналитики);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ОписаниеПоказателяИсточникаДанных(ВыборкаРесурсыПоказателей, ОписаниеПравила)
	
	ОписаниеПоказателя = ПланыВидовХарактеристик.СтатьиАктивовПассивов.НовоеОписаниеПоказателя();
	
	СтруктураПоиска = Новый Структура("ОбъектУчета,Показатель",
		ОписаниеПравила.ИсточникДанных, ОписаниеПравила.ИсточникСуммыОперации);
	
	ВыборкаРесурсыПоказателей.Сбросить();
	
	Пока ВыборкаРесурсыПоказателей.НайтиСледующий(СтруктураПоиска) Цикл
		ТаблицаРесурсов = ОписаниеПоказателя[ВыборкаРесурсыПоказателей.ГруппаРесурсов]; // ТаблицаЗначений -
		ЗаполнитьЗначенияСвойств(ТаблицаРесурсов.Добавить(), ВыборкаРесурсыПоказателей);
	КонецЦикла;
	
	Возврат ОписаниеПоказателя;
	
КонецФункции

Функция БалансныйПоказательИсточника(ОписаниеПоказателя)
	
	БалансныйПоказательИсточника = Истина;
	
	Для Каждого КлючИЗначение Из ОписаниеПоказателя Цикл
		ТаблицаРесурсов = КлючИЗначение.Значение;
		Если ТаблицаРесурсов.Количество() > 0 Тогда
			БалансныйПоказательИсточника = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат БалансныйПоказательИсточника;
	
КонецФункции

Функция ЗначенияРесурсовПоказателя(ВыборкаКорреспонденции, ОписаниеПоказателя, АналитикаИсточникаДанных, ПараметрыПолученияФакта, ДтКт)
	
	ЗначенияРесурсов = НовыеЗначенияРесурсовПоказателя(ПараметрыПолученияФакта);
	БалансныйПоказательИсточника = БалансныйПоказательИсточника(ОписаниеПоказателя);
	
	Если БалансныйПоказательИсточника И АналитикаИсточникаДанных.Количество() = 1 Тогда
		НоваяСтрока = ЗначенияРесурсов.Добавить();
		НоваяСтрока.СуммаУпр = ВыборкаКорреспонденции.СуммаУпр;
		НоваяСтрока.СуммаРегл = ВыборкаКорреспонденции.СуммаРегл;
		НоваяСтрока.СуммаВал = ВыборкаКорреспонденции["СуммаВал" + ДтКт];
		НоваяСтрока.Количество = ВыборкаКорреспонденции["Количество" + ДтКт];
	Иначе
		Для Каждого СтрокаАналитики Из АналитикаИсточникаДанных Цикл
			НоваяСтрока = ЗначенияРесурсов.Добавить();
			Если БалансныйПоказательИсточника Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАналитики);
			Иначе
				Для Каждого КлючИЗначение Из ОписаниеПоказателя Цикл
					ГруппаРесурсов = КлючИЗначение.Ключ;
					ТаблицаРесурсов = КлючИЗначение.Значение;
					ЗначениеРесурсов = 0;
					
					Для Каждого СтрокаРесурса Из ТаблицаРесурсов Цикл
						ИмяКолонкиРесурса = "Ресурс" + СтрокаРесурса.ИмяРесурса;
						ЗначениеРесурса = СтрокаАналитики[ИмяКолонкиРесурса] * СтрокаРесурса.Коэффициент;
						ЗначениеРесурсов = ЗначениеРесурсов + ЗначениеРесурса;
					КонецЦикла;
					
					Если ВыборкаКорреспонденции["ЭтоСторно" + ДтКт] И ЗначениеРесурсов < 0 Тогда
						ЗначениеРесурсов = - ЗначениеРесурсов;
					КонецЕсли;
					
					ИмяЗначения = ИмяЗначенияГруппыРесурсов(ГруппаРесурсов);
					НоваяСтрока[ИмяЗначения] = ЗначениеРесурсов;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ЗначенияРесурсов.ЗаполнитьЗначения(ВыборкаКорреспонденции["Валюта" + ДтКт], "Валюта");
	
	Возврат ЗначенияРесурсов;
	
КонецФункции

Процедура ПересчитатьРесурсыНебалансногоПоказателяСложнойКорреспонденции(ВыборкаКорреспонденции, ВыборкаСложныеКорреспонденции, ЗначенияРесурсов)
	
	КоэффициентыРаспределенияУпр = Новый Массив();
	КоэффициентыРаспределенияРегл = Новый Массив();
	ИндексТекущейКорреспонденции = 0;
	
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("Период", ВыборкаКорреспонденции.Период);
	СтруктураПоиска.Вставить("Регистратор", ВыборкаКорреспонденции.Регистратор);
	СтруктураПоиска.Вставить("ИдентификаторФинЗаписи", ВыборкаКорреспонденции.ИдентификаторФинЗаписи);
	СтруктураПоиска.Вставить("Организация", ВыборкаКорреспонденции.Организация);
	СтруктураПоиска.Вставить("РеквизитСторно", ВыборкаКорреспонденции.РеквизитСторно);
	
	Если ВыборкаКорреспонденции.УчитыватьХозОперацию Тогда
		СтруктураПоиска.Вставить("НастройкаХозОперации", ВыборкаКорреспонденции.НастройкаХозОперации);
	КонецЕсли;
	
	ВыборкаСложныеКорреспонденции.Сбросить();
	
	Пока ВыборкаСложныеКорреспонденции.НайтиСледующий(СтруктураПоиска) Цикл
		Если ВыборкаСложныеКорреспонденции.СуммаДвиженияУпр <> 0 Тогда
			КоэффициентыРаспределенияУпр.Добавить(ВыборкаСложныеКорреспонденции.СуммаУпр);
		Иначе
			КоэффициентыРаспределенияУпр.Добавить(ВыборкаСложныеКорреспонденции.СуммаРегл);
		КонецЕсли;
			
		Если ВыборкаСложныеКорреспонденции.СуммаДвиженияРегл <> 0 Тогда
			КоэффициентыРаспределенияРегл.Добавить(ВыборкаСложныеКорреспонденции.СуммаРегл);
		Иначе
			КоэффициентыРаспределенияРегл.Добавить(ВыборкаСложныеКорреспонденции.СуммаУпр);
		КонецЕсли;
		
		Если ВыборкаКорреспонденции.НомерЗаписи = ВыборкаСложныеКорреспонденции.НомерЗаписи Тогда
			ИндексТекущейКорреспонденции = КоэффициентыРаспределенияУпр.Количество() - 1;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Колонка Из ЗначенияРесурсов.Колонки Цикл
		Если Колонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
			ИтогРесурса = ЗначенияРесурсов.Итог(Колонка.Имя);
			ТочностьРаспределения = Колонка.ТипЗначения.КвалификаторыЧисла.РазрядностьДробнойЧасти;
			
			Если Колонка.Имя = "СуммаРегл" Тогда
				КоэффициентыРаспределения = КоэффициентыРаспределенияРегл;
			Иначе
				КоэффициентыРаспределения = КоэффициентыРаспределенияУпр;
			КонецЕсли;
			
			Если ИтогРесурса <> 0 Тогда
				РаспределениеИтога = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					ИтогРесурса, КоэффициентыРаспределения, ТочностьРаспределения);
			Иначе
				РаспределениеИтога = Неопределено;
			КонецЕсли;
			
			Если РаспределениеИтога = Неопределено Тогда
				РаспределениеРесурса = Неопределено;
			Иначе
				ЗначениеРесурса = РаспределениеИтога[ИндексТекущейКорреспонденции];
				Если ЗначениеРесурса <> 0 Тогда
					РаспределениеРесурса = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
						ЗначениеРесурса, ЗначенияРесурсов.ВыгрузитьКолонку(Колонка.Имя), ТочностьРаспределения);
				Иначе
					РаспределениеРесурса = Неопределено;
				КонецЕсли;
			КонецЕсли;
			
			Если РаспределениеРесурса = Неопределено Тогда
				ЗначенияРесурсов.ЗаполнитьЗначения(0, Колонка.Имя);
			Иначе
				ЗначенияРесурсов.ЗагрузитьКолонку(РаспределениеРесурса, Колонка.Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПересчитатьРесурсыБалансногоПоказателяСложнойКорреспонденции(ВыборкаКорреспонденции, ЗначенияРесурсов, ДтКт)
	
	Для Каждого Колонка Из ЗначенияРесурсов.Колонки Цикл
		Если Колонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
			Если Колонка.Имя = "СуммаВал" ИЛИ Колонка.Имя = "Количество" Тогда
				СуффиксИмениРесурса = ДтКт;
			Иначе
				СуффиксИмениРесурса = "";
			КонецЕсли;
			
			ЗначениеРесурса = ВыборкаКорреспонденции[Колонка.Имя + СуффиксИмениРесурса];
			ТочностьРаспределения = Колонка.ТипЗначения.КвалификаторыЧисла.РазрядностьДробнойЧасти;
			
			Если ЗначениеРесурса <> 0 Тогда
				РаспределениеРесурса = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					ЗначениеРесурса, ЗначенияРесурсов.ВыгрузитьКолонку(Колонка.Имя), ТочностьРаспределения);
			Иначе
				РаспределениеРесурса = Неопределено;
			КонецЕсли;
			
			Если РаспределениеРесурса = Неопределено Тогда
				ЗначенияРесурсов.ЗаполнитьЗначения(0, Колонка.Имя);
			Иначе
				ЗначенияРесурсов.ЗагрузитьКолонку(РаспределениеРесурса, Колонка.Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьДанныеПростойАналитики(ВыборкаКорреспонденции, ТаблицаФактическихДанных, ЗначенияРесурсов,
	АналитикаИсточникаДанных, АналитикаКорИсточникаДанных, ПараметрыПолученияФакта, ОписаниеПравила)
	
	ДтКт = ВыборкаКорреспонденции.ИсточникДанныхКорреспонденции;
	СтрокаАналитикиИсточника = АналитикаИсточникаДанных[0];
	СтрокаАналитикиКорИсточника = ?(ВыборкаКорреспонденции.ПолучитьКорАналитику,
		АналитикаКорИсточникаДанных[0], Неопределено);
	СтрокаЗначенийРесурсов = ЗначенияРесурсов[0];
	
	СтрокаФактическихДанных = ТаблицаФактическихДанных.Добавить();
	
	ЗаполнитьРеквизитыФактическихДанных(СтрокаФактическихДанных, ВыборкаКорреспонденции, ОписаниеПравила);
	ЗаполнитьАналитикуФактическихДанных(СтрокаФактическихДанных, СтрокаАналитикиИсточника, СтрокаАналитикиКорИсточника, ОписаниеПравила);
	ЗаполнитьРесурсыФактическихДанных(СтрокаФактическихДанных, ВыборкаКорреспонденции, СтрокаЗначенийРесурсов, ПараметрыПолученияФакта, ОписаниеПравила);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыФактическихДанных(СтрокаФактическихДанных, ВыборкаКорреспонденции, ОписаниеПравила)
	
	ЗаполнитьЗначенияСвойств(СтрокаФактическихДанных, ВыборкаКорреспонденции, "Период,Регистратор,Организация");
	ЗаполнитьЗначенияСвойств(СтрокаФактическихДанных, ОписаниеПравила);
	
	СтрокаФактическихДанных.ПериодКурса = ВыборкаКорреспонденции.Период;
	СтрокаФактическихДанных.Сценарий = Справочники.Сценарии.ФактическиеДанные;
	
КонецПроцедуры

Процедура ЗаполнитьАналитикуФактическихДанных(СтрокаФактическихДанных, СтрокаАналитикиИсточника, СтрокаАналитикиКорИсточника, ОписаниеПравила)
	
	МаксимальноеКоличествоАналитик = БюджетированиеКлиентСервер.МаксимальноеКоличествоАналитик();
	
	Для НомерАналитики = 1 По МаксимальноеКоличествоАналитик Цикл
		ИмяКолонкиАналитика = "Аналитика" + НомерАналитики;
		ИмяКолонкиВидАналитики = "ВидАналитики" + НомерАналитики;
		
		Если НЕ ЗначениеЗаполнено(ОписаниеПравила[ИмяКолонкиВидАналитики]) Тогда
			СтрокаФактическихДанных[ИмяКолонкиАналитика] = Неопределено;
		ИначеЕсли ЗначениеЗаполнено(СтрокаАналитикиИсточника[ИмяКолонкиАналитика]) Тогда
			СтрокаФактическихДанных[ИмяКолонкиАналитика] = СтрокаАналитикиИсточника[ИмяКолонкиАналитика];
		ИначеЕсли СтрокаАналитикиКорИсточника <> Неопределено
			И ЗначениеЗаполнено(СтрокаАналитикиКорИсточника[ИмяКолонкиАналитика]) Тогда
			СтрокаФактическихДанных[ИмяКолонкиАналитика] = СтрокаАналитикиКорИсточника[ИмяКолонкиАналитика];
		Иначе
			СтрокаФактическихДанных[ИмяКолонкиАналитика] = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаФактическихДанных.Подразделение = СтрокаАналитикиИсточника.Подразделение;
	
КонецПроцедуры

Процедура ЗаполнитьРесурсыФактическихДанных(СтрокаФактическихДанных, ВыборкаКорреспонденции, СтрокаЗначенийРесурсов, ПараметрыПолученияФакта, ОписаниеПравила)
	
	ВалютыОперативногоУчета = ФинансовыйУчетПоДаннымБалансовыхРегистров.ВалютыОперативногоУчета(ВыборкаКорреспонденции.Организация);
	ФункциональнаяСумма = ФункциональнаяСумма(СтрокаЗначенийРесурсов, ВалютыОперативногоУчета, ПараметрыПолученияФакта);
	КоэффициентПравила = КоэффициентПравила(ВыборкаКорреспонденции, ОписаниеПравила);
	
	СтрокаФактическихДанных.ВалютаФункциональная = ФункциональнаяСумма.Валюта;
	СтрокаФактическихДанных.СуммаВФункциональнойВалюте = ФункциональнаяСумма.Сумма * КоэффициентПравила;
	
	СтрокаФактическихДанных.СуммаУпр = СтрокаЗначенийРесурсов.СуммаУпр * КоэффициентПравила;
	СтрокаФактическихДанных.СуммаРегл = СтрокаЗначенийРесурсов.СуммаРегл * КоэффициентПравила;
	
	СтрокаФактическихДанных.Валюта = СтрокаЗначенийРесурсов.Валюта;
	СтрокаФактическихДанных.СуммаВВалюте = СтрокаЗначенийРесурсов.СуммаВал * КоэффициентПравила;
	СтрокаФактическихДанных.Количество = СтрокаЗначенийРесурсов.Количество * КоэффициентПравила;
	
	СтрокаФактическихДанных.ВалютаХранения = СтрокаЗначенийРесурсов.Валюта;
	СтрокаФактическихДанных.СуммаВВалютеХранения = СтрокаЗначенийРесурсов.СуммаВал * КоэффициентПравила;
	
КонецПроцедуры

Функция ФункциональнаяСумма(ЗначенияРесурсов, ВалютыОперативногоУчета, ПараметрыПолученияФакта)
	
	Если ПараметрыПолученияФакта.ФункциональнаяВалюта = Перечисления.ВидыУчетаВФункциональнойВалюте.ВВалютеУпр Тогда
		Сумма = ЗначенияРесурсов.СуммаУпр;
		ВалютаРесурса = ВалютыОперативногоУчета.ВалютаУпр;
	Иначе //ПараметрыПолученияФакта.ФункциональнаяВалюта = Перечисления.ВидыУчетаВФункциональнойВалюте.ВВалютеРегл
		Сумма = ЗначенияРесурсов.СуммаРегл;
		ВалютаРесурса = ВалютыОперативногоУчета.ВалютаРегл;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Сумма", Сумма);
	Результат.Вставить("Валюта", ВалютаРесурса);
	
	Возврат Результат;
	
КонецФункции

Функция КоэффициентПравила(ВыборкаКорреспонденции, ОписаниеПравила)
	
	Если ВыборкаКорреспонденции.ИнверсияФактическихДанных
		И ВыборкаКорреспонденции.ИнвертироватьКорреспонденцию Тогда
		КоэффициентПравила = ОписаниеПравила.Коэффициент;
	ИначеЕсли ВыборкаКорреспонденции.ИнверсияФактическихДанных
		ИЛИ ВыборкаКорреспонденции.ИнвертироватьКорреспонденцию Тогда
		КоэффициентПравила = - ОписаниеПравила.Коэффициент;
	Иначе 
		КоэффициентПравила = ОписаниеПравила.Коэффициент;
	КонецЕсли;
	
	Возврат КоэффициентПравила;
	
КонецФункции

Процедура ПолучитьДанныеСложнойАналитики(ВыборкаКорреспонденции, ТаблицаФактическихДанных, ЗначенияРесурсов,
	АналитикаИсточникаДанных, АналитикаКорИсточникаДанных, ПараметрыПолученияФакта, ОписаниеПравила)
	
	ДтКт = ВыборкаКорреспонденции.ИсточникДанныхКорреспонденции;
	КорДтКт = ВыборкаКорреспонденции.КорИсточникДанныхКорреспонденции;
	
	Если АналитикаИсточникаДанных.Количество() > 1 Тогда
		МногоАналитик = Новый Структура("ДтКт,СтрокиАналитики", ДтКт, АналитикаИсточникаДанных);
		СтрокаАналитикиКорИсточника = ?(ВыборкаКорреспонденции.ПолучитьКорАналитику,
			АналитикаКорИсточникаДанных[0], Неопределено);
		ОднаАналитика = Новый Структура("ДтКт,СтрокаАналитики", КорДтКт, СтрокаАналитикиКорИсточника);
		РесурсыИсточникаДанных = ЗначенияРесурсов;
	Иначе
		МногоАналитик = Новый Структура("ДтКт,СтрокиАналитики", КорДтКт, АналитикаКорИсточникаДанных);
		ОднаАналитика = Новый Структура("ДтКт,СтрокаАналитики", ДтКт, АналитикаИсточникаДанных[0]);
		
		ПустойПоказатель = ПланыВидовХарактеристик.СтатьиАктивовПассивов.НовоеОписаниеПоказателя();
		ЗначенияКорРесурсов = ЗначенияРесурсовПоказателя(ВыборкаКорреспонденции, ПустойПоказатель, АналитикаКорИсточникаДанных, ПараметрыПолученияФакта, КорДтКт);
		
		Если ВыборкаКорреспонденции["СложнаяПроводка" + КорДтКт] Тогда
			ПересчитатьРесурсыБалансногоПоказателяСложнойКорреспонденции(ВыборкаКорреспонденции, ЗначенияКорРесурсов, КорДтКт);
		КонецЕсли;
		
		РаспределитьРесурсыПоказателяСложнойАналитики(ЗначенияРесурсов, ЗначенияКорРесурсов);
		РесурсыИсточникаДанных = ЗначенияКорРесурсов;
	КонецЕсли;
	
	ИндексСтрокиРесурсов = 0;
	
	Для Каждого СтрокаАналитики Из МногоАналитик.СтрокиАналитики Цикл
		СтрокаФактическихДанных = ТаблицаФактическихДанных.Добавить();
		СтрокаЗначенийРесурсов = РесурсыИсточникаДанных[ИндексСтрокиРесурсов];
		
		Если МногоАналитик.ДтКт = ДтКт Тогда
			СтрокаАналитикиИсточника = СтрокаАналитики;
			СтрокаАналитикиКорИсточника = ОднаАналитика.СтрокаАналитики;
		Иначе
			СтрокаАналитикиИсточника = ОднаАналитика.СтрокаАналитики;
			СтрокаАналитикиКорИсточника = СтрокаАналитики;
		КонецЕсли;
		
		ЗаполнитьРеквизитыФактическихДанных(СтрокаФактическихДанных, ВыборкаКорреспонденции, ОписаниеПравила);
		ЗаполнитьАналитикуФактическихДанных(СтрокаФактическихДанных, СтрокаАналитикиИсточника, СтрокаАналитикиКорИсточника, ОписаниеПравила);
		ЗаполнитьРесурсыФактическихДанных(СтрокаФактическихДанных, ВыборкаКорреспонденции, СтрокаЗначенийРесурсов, ПараметрыПолученияФакта, ОписаниеПравила);
		
		ИндексСтрокиРесурсов = ИндексСтрокиРесурсов + 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьРесурсыПоказателяСложнойАналитики(ЗначенияРесурсов, ЗначенияКорРесурсов)
	
	СтрокаЗначенийРесурсов = ЗначенияРесурсов[0];
	КоэффициентыРаспределенияУпр = ЗначенияКорРесурсов.ВыгрузитьКолонку("СуммаУпр");
	КоэффициентыРаспределенияРегл = ЗначенияКорРесурсов.ВыгрузитьКолонку("СуммаРегл");
	
	Если ЗначенияКорРесурсов.Итог("СуммаУпр") = 0 Тогда
		КоэффициентыРаспределенияУпр = КоэффициентыРаспределенияРегл;
	КонецЕсли;
	
	Если ЗначенияКорРесурсов.Итог("СуммаРегл") = 0 Тогда
		КоэффициентыРаспределенияРегл = КоэффициентыРаспределенияУпр;
	КонецЕсли;
	
	Для Каждого Колонка Из ЗначенияКорРесурсов.Колонки Цикл
		Если Колонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
			ЗначениеРесурса = СтрокаЗначенийРесурсов[Колонка.Имя];
			ТочностьРаспределения = Колонка.ТипЗначения.КвалификаторыЧисла.РазрядностьДробнойЧасти;
			
			Если Колонка.Имя = "СуммаРегл" Тогда
				КоэффициентыРаспределения = КоэффициентыРаспределенияРегл;
			Иначе
				КоэффициентыРаспределения = КоэффициентыРаспределенияУпр;
			КонецЕсли;
			
			Если ЗначениеРесурса <> 0 Тогда
				РаспределениеРесурса = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					ЗначениеРесурса, КоэффициентыРаспределения, ТочностьРаспределения);
			Иначе
				РаспределениеРесурса = Неопределено;
			КонецЕсли;
			
			Если РаспределениеРесурса = Неопределено Тогда
				ЗначенияКорРесурсов.ЗаполнитьЗначения(0, Колонка.Имя);
			Иначе
				ЗначенияКорРесурсов.ЗагрузитьКолонку(РаспределениеРесурса, Колонка.Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЗначенияКорРесурсов.ЗаполнитьЗначения(СтрокаЗначенийРесурсов.Валюта, "Валюта");
	
КонецПроцедуры

Функция НовыеЗначенияРесурсовПоказателя(ПараметрыПолученияФакта)
	
	ОписаниеТипаСуммы = ОбщегоНазначения.ОписаниеТипаЧисло(
		ПараметрыПолученияФакта.ДлинаСуммы, ПараметрыПолученияФакта.ТочностьСуммы);
	ОписаниеТипаКоличества = ОбщегоНазначения.ОписаниеТипаЧисло(
		ПараметрыПолученияФакта.ДлинаКоличества, ПараметрыПолученияФакта.ТочностьКоличества);
	
	ЗначенияРесурсов = Новый ТаблицаЗначений();
	ЗначенияРесурсов.Колонки.Добавить("СуммаУпр", ОписаниеТипаСуммы);
	ЗначенияРесурсов.Колонки.Добавить("СуммаРегл", ОписаниеТипаСуммы);
	ЗначенияРесурсов.Колонки.Добавить("СуммаВал", ОписаниеТипаСуммы);
	ЗначенияРесурсов.Колонки.Добавить("Количество", ОписаниеТипаКоличества);
	ЗначенияРесурсов.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	Возврат ЗначенияРесурсов;
	
КонецФункции

