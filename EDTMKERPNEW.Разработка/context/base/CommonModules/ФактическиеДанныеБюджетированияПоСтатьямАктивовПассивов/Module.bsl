				Иначе
					ПравилоОтбора = ПравилаОтбора;
				КонецЕсли;
				
				КомпоновщикНастроекПравила = Новый КомпоновщикНастроекКомпоновкиДанных();
				КомпоновщикНастроекПравила.ЗагрузитьНастройки(ВыборкаПравилаОтбора.КомпоновщикНастроек.Получить());
