			КонецЕсли;
			
			Если ПустаяСтрока(ВыборкаИмяРегистраДт.ИмяРегистраДт)
			 ИЛИ НЕ ДоступныеПоляРегистров.Свойство(ВыборкаИмяРегистраДт.ИмяРегистраДт, ДоступныеПоляРегистраДт) Тогда
				ДоступныеПоляРегистраДт = Новый Массив();
			КонецЕсли;
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПоляОтбораТаблицыДт",
				ФинансовыйУчетПоДаннымБалансовыхРегистров.ТекстВыборкиПолей(
					ДоступныеПоляРегистраДт, СуществующиеПоляВыборки, ПоляОтбораРегистраДт, "Дт", "ТаблицаДт"));
			
			ПоляОтбораРегистраКт = Неопределено;
			ДоступныеПоляРегистраКт = Неопределено;
			
			Если ПустаяСтрока(ВыборкаИмяРегистраКт.ИмяРегистраКт)
			 ИЛИ НЕ ПоляОтбораРегистров.Свойство(ВыборкаИмяРегистраКт.ИмяРегистраКт, ПоляОтбораРегистраКт) Тогда
				ПоляОтбораРегистраКт = Новый Массив();
			КонецЕсли;
			
			Если ПустаяСтрока(ВыборкаИмяРегистраКт.ИмяРегистраКт)
			 ИЛИ НЕ ДоступныеПоляРегистров.Свойство(ВыборкаИмяРегистраКт.ИмяРегистраКт, ДоступныеПоляРегистраКт) Тогда
				ДоступныеПоляРегистраКт = Новый Массив();
			КонецЕсли;
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПоляОтбораТаблицыКт",
				ФинансовыйУчетПоДаннымБалансовыхРегистров.ТекстВыборкиПолей(
					ДоступныеПоляРегистраКт, СуществующиеПоляВыборки, ПоляОтбораРегистраКт, "Кт", "ТаблицаКт"));
			
			СхемаКомпоновкиДанных = ФинансовыйУчетПоДаннымБалансовыхРегистров.НоваяСхемаКомпоновкиДанных(ТекстЗапроса);
			АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, АдресХранилищаКомпоновкиДанных);
			КомпоновщикНастроек = ФинансовыйУчетПоДаннымБалансовыхРегистров.НовыйКомпоновщикНастроекКомпоновкиДанных(
				АдресСхемыКомпоновкиДанных, ПоляВыбораКомпоновкиДанных, Запрос.Параметры);
			КомпоновкаДанныхКлиентСервер.СкопироватьЭлементы(КомпоновщикНастроек.Настройки.Отбор, ОтборКорреспонденций.Отбор);
			
			ФинансовыйУчетПоДаннымБалансовыхРегистров.ДобавитьРезультатКомпоновкиВТаблицу(СхемаКомпоновкиДанных, КомпоновщикНастроек,
				Запрос.МенеджерВременныхТаблиц, ТаблицаРезультатовКомпоновкиДанных);
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ПоляОтбораРегистров Цикл
		ИмяТаблицыРегистра = КлючИЗначение.Ключ;
		ТаблицаДляПомещения = "вт" + ИмяТаблицыРегистра;
		Если ИмяТаблицыРегистра <> ФинансовыйУчетПоДаннымБалансовыхРегистров.ИмяРегистраСлужебныхОбъектовУчета() Тогда
			ФинансовыйУчетПоДаннымБалансовыхРегистров.ДобавитьЗапросУдаленияВременнойТаблицы(ТекстыЗапросов, ТаблицаДляПомещения);
		КонецЕсли;
	КонецЦикла;
	
	ЕстьКорреспонденцииСОтбором = ТаблицаРезультатовКомпоновкиДанных <> Неопределено
		И ТаблицаРезультатовКомпоновкиДанных.Количество() > 0;
	
	Если ЕстьКорреспонденцииСОтбором Тогда
		ТекстыЗапросов.Добавить("
		|ВЫБРАТЬ
		|	ТаблицаРезультатовКомпоновки.НомерЗаписи КАК НомерЗаписи,
		|	ТаблицаРезультатовКомпоновки.ПравилоПолученияФакта КАК ПравилоПолученияФакта
		|ПОМЕСТИТЬ втКорреспонденцииСОтбором
		|ИЗ
		|	&ТаблицаРезультатовКомпоновкиДанных КАК ТаблицаРезультатовКомпоновки
		|ИНДЕКСИРОВАТЬ ПО
		|	НомерЗаписи,
		|	ПравилоПолученияФакта
		|");
		
		Запрос.УстановитьПараметр("ТаблицаРезультатовКомпоновкиДанных", ТаблицаРезультатовКомпоновкиДанных);
	КонецЕсли;
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	КорреспонденцииПоПравилам.ПравилоПолученияФакта КАК ПравилоПолученияФакта,
	|	КорреспонденцииПоПравилам.ПустойИсточникДанныхДт КАК ПустойИсточникДанныхДт,
	|	КорреспонденцииПоПравилам.ПустойИсточникДанныхКт КАК ПустойИсточникДанныхКт,
	|	КорреспонденцииПоПравилам.ИнверсияИсточниковДанных КАК ИнверсияИсточниковДанных,
	|	КорреспонденцииПоПравилам.ИнверсияФактическихДанных КАК ИнверсияФактическихДанных,
	|	ВЫБОР
	|		КОГДА НЕ КорреспонденцииПоПравилам.ИнверсияИсточниковДанных
	|			И НЕ КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА &Дт
	|		КОГДА КорреспонденцииПоПравилам.ИнверсияИсточниковДанных
	|			И КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА &Дт
	|		ИНАЧЕ &Кт
	|	КОНЕЦ КАК ИсточникДанныхКорреспонденции,
	|	КорреспонденцииПоПравилам.НомерЗаписи КАК НомерЗаписи,
	|	КорреспонденцииПоПравилам.Период КАК Период,
	|	ВЫБОР
	|		КОГДА КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА КорреспонденцииПоПравилам.ИмяРегистраКт
	|		ИНАЧЕ КорреспонденцииПоПравилам.ИмяРегистраДт
	|	КОНЕЦ КАК ИмяРегистраДт,
	|	ВЫБОР
	|		КОГДА КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА КорреспонденцииПоПравилам.ИмяРегистраДт
	|		ИНАЧЕ КорреспонденцииПоПравилам.ИмяРегистраКт
	|	КОНЕЦ КАК ИмяРегистраКт,
	|	ВЫБОР
	|		КОГДА КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА КорреспонденцииПоПравилам.ОбъектУчетаКт
	|		ИНАЧЕ КорреспонденцииПоПравилам.ОбъектУчетаДт
	|	КОНЕЦ КАК ОбъектУчетаДт,
	|	ВЫБОР
	|		КОГДА КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА КорреспонденцииПоПравилам.ОбъектУчетаДт
	|		ИНАЧЕ КорреспонденцииПоПравилам.ОбъектУчетаКт
	|	КОНЕЦ КАК ОбъектУчетаКт,
	|	ВЫБОР
	|		КОГДА КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА КорреспонденцииПоПравилам.ЭтоСторноКт
	|		ИНАЧЕ КорреспонденцииПоПравилам.ЭтоСторноДт
	|	КОНЕЦ КАК ЭтоСторноДт,
	|	ВЫБОР
	|		КОГДА КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА КорреспонденцииПоПравилам.ЭтоСторноДт
	|		ИНАЧЕ КорреспонденцииПоПравилам.ЭтоСторноКт
	|	КОНЕЦ КАК ЭтоСторноКт,
	|	КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию КАК ИнвертироватьКорреспонденцию,
	|	КорреспонденцииПоПравилам.Организация КАК Организация,
	|	КорреспонденцииПоПравилам.Регистратор КАК Регистратор,
	|	КорреспонденцииПоПравилам.НастройкаХозОперации КАК НастройкаХозОперации,
	|	КорреспонденцииПоПравилам.ИдентификаторФинЗаписи КАК ИдентификаторФинЗаписи,
	|	ВЫБОР
	|		КОГДА КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА КорреспонденцииПоПравилам.ИдентификаторСтрокиКт
	|		ИНАЧЕ КорреспонденцииПоПравилам.ИдентификаторСтрокиДт
	|	КОНЕЦ КАК ИдентификаторСтрокиДт,
	|	ВЫБОР
	|		КОГДА КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА КорреспонденцииПоПравилам.ИдентификаторСтрокиДт
	|		ИНАЧЕ КорреспонденцииПоПравилам.ИдентификаторСтрокиКт
	|	КОНЕЦ КАК ИдентификаторСтрокиКт,
	|	КорреспонденцииПоПравилам.РеквизитСторно КАК РеквизитСторно,
	|	ВЫБОР
	|		КОГДА КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА КорреспонденцииПоПравилам.ВалютаКт
	|		ИНАЧЕ КорреспонденцииПоПравилам.ВалютаДт
	|	КОНЕЦ КАК ВалютаДт,
	|	ВЫБОР
	|		КОГДА КорреспонденцииПоПравилам.ИнвертироватьКорреспонденцию
	|			ТОГДА КорреспонденцииПоПравилам.ВалютаДт
	|		ИНАЧЕ КорреспонденцииПоПравилам.ВалютаКт
	|	КОНЕЦ КАК ВалютаКт,
	|	КорреспонденцииПоПравилам.СуммаДвиженияУпрДт КАК СуммаДвиженияУпрДт,
	|	КорреспонденцииПоПравилам.СуммаДвиженияУпрКт КАК СуммаДвиженияУпрКт,
	|	КорреспонденцииПоПравилам.СуммаДвиженияРеглДт КАК СуммаДвиженияРеглДт,
	|	КорреспонденцииПоПравилам.СуммаДвиженияРеглКт КАК СуммаДвиженияРеглКт,
	|	КорреспонденцииПоПравилам.СложнаяПроводкаДт КАК СложнаяПроводкаДт,
	|	КорреспонденцииПоПравилам.СложнаяПроводкаКт КАК СложнаяПроводкаКт,
	|	КорреспонденцииПоПравилам.УчитыватьХозОперацию КАК УчитыватьХозОперацию,
	|	КорреспонденцииПоПравилам.СуммаУпрДт КАК СуммаУпрДт,
	|	КорреспонденцииПоПравилам.СуммаУпрКт КАК СуммаУпрКт,
	|	КорреспонденцииПоПравилам.СуммаРеглДт КАК СуммаРеглДт,
	|	КорреспонденцииПоПравилам.СуммаРеглКт КАК СуммаРеглКт,
	|	КорреспонденцииПоПравилам.СуммаВалДт КАК СуммаВалДт,
	|	КорреспонденцииПоПравилам.СуммаВалКт КАК СуммаВалКт,
	|	КорреспонденцииПоПравилам.КоличествоДт КАК КоличествоДт,
	|	КорреспонденцииПоПравилам.КоличествоКт КАК КоличествоКт
	|ПОМЕСТИТЬ втФактическиеКорреспонденции
	|ИЗ
	|	втКорреспонденцииПоПравилам КАК КорреспонденцииПоПравилам
	|ГДЕ
	|	НЕ КорреспонденцииПоПравилам.ПравилоСодержитОтбор
	|	ИЛИ &УсловиеОтбораКорреспонденцийСОтбором
	|ИНДЕКСИРОВАТЬ ПО
	|	ПравилоПолученияФакта,
	|	ОбъектУчетаДт,
	|	ОбъектУчетаКт
	|";
	
	Если ЕстьКорреспонденцииСОтбором Тогда
		УсловиеОтбораКорреспонденцийСОтбором = "ИСТИНА В
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		ИСТИНА
		|	ИЗ
		|		втКорреспонденцииСОтбором КАК КорреспонденцииСОтбором
		|	ГДЕ
		|		КорреспонденцииСОтбором.НомерЗаписи = КорреспонденцииПоПравилам.НомерЗаписи
		|		И КорреспонденцииСОтбором.ПравилоПолученияФакта = КорреспонденцииПоПравилам.ПравилоПолученияФакта
		|	)
		|";
	Иначе
		УсловиеОтбораКорреспонденцийСОтбором = "ЛОЖЬ";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбораКорреспонденцийСОтбором", УсловиеОтбораКорреспонденцийСОтбором);
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	ФинансовыйУчетПоДаннымБалансовыхРегистров.ДобавитьЗапросУдаленияВременнойТаблицы(ТекстыЗапросов, "втКорреспонденцииПоПравилам");
	ФинансовыйУчетПоДаннымБалансовыхРегистров.ДобавитьЗапросУдаленияВременнойТаблицы(ТекстыЗапросов, "втПравилаОбработкиКорреспонденций");
	
	Если ЕстьКорреспонденцииСОтбором Тогда
		ФинансовыйУчетПоДаннымБалансовыхРегистров.ДобавитьЗапросУдаленияВременнойТаблицы(ТекстыЗапросов, "втКорреспонденцииСОтбором");
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПравилаЗаполненияАналитики(Запрос, ТекстыЗапросов)
	
	ТекстыЗапросов.Добавить("
	|ВЫБРАТЬ
	|	ФактическиеКорреспонденции.ПравилоПолученияФакта КАК ПравилоПолученияФакта,
	|	ФактическиеКорреспонденции.ПустойИсточникДанныхДт КАК ПустойИсточникДанныхДт,
	|	ФактическиеКорреспонденции.ПустойИсточникДанныхКт КАК ПустойИсточникДанныхКт,
	|	ФактическиеКорреспонденции.ИнверсияИсточниковДанных КАК ИнверсияИсточниковДанных,
	|	ФактическиеКорреспонденции.ИсточникДанныхКорреспонденции КАК ИсточникДанныхКорреспонденции,
	|	ФактическиеКорреспонденции.ОбъектУчетаДт КАК ОбъектУчетаДт,
	|	ФактическиеКорреспонденции.ОбъектУчетаКт КАК ОбъектУчетаКт,
	|	ФактическиеКорреспонденции.ИмяРегистраДт КАК ИмяРегистраДт,
	|	ФактическиеКорреспонденции.ИмяРегистраКт КАК ИмяРегистраКт
	|ПОМЕСТИТЬ втПравилаОбработкиКорреспонденций
	|ИЗ
	|	втФактическиеКорреспонденции КАК ФактическиеКорреспонденции
	|СГРУППИРОВАТЬ ПО
	|	ФактическиеКорреспонденции.ПравилоПолученияФакта,
	|	ФактическиеКорреспонденции.ПустойИсточникДанныхДт,
	|	ФактическиеКорреспонденции.ПустойИсточникДанныхКт,
	|	ФактическиеКорреспонденции.ИнверсияИсточниковДанных,
	|	ФактическиеКорреспонденции.ИсточникДанныхКорреспонденции,
	|	ФактическиеКорреспонденции.ОбъектУчетаДт,
	|	ФактическиеКорреспонденции.ОбъектУчетаКт,
	|	ФактическиеКорреспонденции.ИмяРегистраДт,
	|	ФактическиеКорреспонденции.ИмяРегистраКт
	|ИНДЕКСИРОВАТЬ ПО
	|	ПравилоПолученияФакта
	|");
	
	ТекстыЗапросов.Добавить("
	|ВЫБРАТЬ
	|	ПравилаОбработкиКорреспонденций.ПравилоПолученияФакта КАК ПравилоПолученияФакта,
	|	ВЫБОР
	|		КОГДА ПравилаПолученияФакта.ЗаполнятьУказаннымЗначениемАналитику1
	|			ТОГДА ПравилаПолученияФакта.ЗначениеАналитики1
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ЗначениеАналитики1,
	|	ВЫБОР
	|		КОГДА ПравилаПолученияФакта.ЗаполнятьУказаннымЗначениемАналитику2
	|			ТОГДА ПравилаПолученияФакта.ЗначениеАналитики2
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ЗначениеАналитики2,
	|	ВЫБОР
	|		КОГДА ПравилаПолученияФакта.ЗаполнятьУказаннымЗначениемАналитику3
	|			ТОГДА ПравилаПолученияФакта.ЗначениеАналитики3
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ЗначениеАналитики3,
	|	ВЫБОР
	|		КОГДА ПравилаПолученияФакта.ЗаполнятьУказаннымЗначениемАналитику4
	|			ТОГДА ПравилаПолученияФакта.ЗначениеАналитики4
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ЗначениеАналитики4,
	|	ВЫБОР
	|		КОГДА ПравилаПолученияФакта.ЗаполнятьУказаннымЗначениемАналитику5
	|			ТОГДА ПравилаПолученияФакта.ЗначениеАналитики5
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ЗначениеАналитики5,
	|	ВЫБОР
	|		КОГДА ПравилаПолученияФакта.ЗаполнятьУказаннымЗначениемАналитику6
	|			ТОГДА ПравилаПолученияФакта.ЗначениеАналитики6
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ЗначениеАналитики6
	|ПОМЕСТИТЬ втЗначенияЗаполненияАналитики
