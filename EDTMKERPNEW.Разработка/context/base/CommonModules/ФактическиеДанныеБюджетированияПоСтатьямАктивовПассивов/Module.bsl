	|";
	
	ФинансовыйУчетПоДаннымБалансовыхРегистров.ВыполнитьЗаменуИменТаблицИПолейДвижений(ТекстЗапроса, ДтКт);
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = "
