	|	СложныеКорреспонденции.Организация КАК Организация,
	|	СложныеКорреспонденции.Регистратор КАК Регистратор,
	|	СложныеКорреспонденции.НастройкаХозОперации КАК НастройкаХозОперации,
	|	СложныеКорреспонденции.ИдентификаторФинЗаписи КАК ИдентификаторФинЗаписи,
	|	СложныеКорреспонденции.РеквизитСторно КАК РеквизитСторно,
	|	СложныеКорреспонденции.СуммаДвиженияУпр КАК СуммаДвиженияУпр,
	|	СложныеКорреспонденции.СуммаДвиженияРегл КАК СуммаДвиженияРегл,
	|	СложныеКорреспонденции.УчитыватьХозОперацию КАК УчитыватьХозОперацию,
	|	СложныеКорреспонденции.СуммаУпр КАК СуммаУпр,
	|	СложныеКорреспонденции.СуммаРегл КАК СуммаРегл
	|ИЗ
	|	втСложныеКорреспонденции КАК СложныеКорреспонденции
	|");
	
	ФинансовыйУчетПоДаннымБалансовыхРегистров.ДобавитьЗапросУдаленияВременнойТаблицы(ТекстыЗапросов, УдаляемыеВременныеТаблицы);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуФактическихДанных(Запрос, ТекстыЗапросов, ТаблицаФактическихДанных,
	ДокументыКОбработке, ПараметрыПолученияФакта, ТаблицаПравил)
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	Результаты = Запрос.ВыполнитьПакет();
	ТекстыЗапросов.Очистить();
	
	ПараметрыПолученияФакта.Вставить("ДлинаСуммы", Запрос.Параметры.ДлинаСуммы);
	ПараметрыПолученияФакта.Вставить("ТочностьСуммы", Запрос.Параметры.ТочностьСуммы);
	ПараметрыПолученияФакта.Вставить("ДлинаКоличества", Запрос.Параметры.ДлинаКоличества);
	ПараметрыПолученияФакта.Вставить("ТочностьКоличества", Запрос.Параметры.ТочностьКоличества);
	
	ТаблицыАналитики = Новый Структура();
	ИндексРезультатаЗапросаКорреспонденций = 0;
	
	Для Каждого КлючИЗначение Из Запрос.Параметры.РегистрыВыборкиАналитики Цикл
		ТаблицыАналитики.Вставить(КлючИЗначение.Ключ, ТаблицаЗапросаАналитики(Результаты[КлючИЗначение.Значение]));
		Если КлючИЗначение.Значение >= ИндексРезультатаЗапросаКорреспонденций Тогда
			ИндексРезультатаЗапросаКорреспонденций = КлючИЗначение.Значение + 1;
		КонецЕсли;
	КонецЦикла;
	
	ИндексРезультатаЗначенийАналитики = ИндексРезультатаЗапросаКорреспонденций + 1;
	ИндексРезультатаВыраженийАналитики = ИндексРезультатаЗапросаКорреспонденций + 2;
	ИндексРезультатаРесурсыПоказателей = ИндексРезультатаЗапросаКорреспонденций + 3;
	ИндексРезультатаСложныеКорреспонденции = ИндексРезультатаЗапросаКорреспонденций + 4;
	
	РезультатКорреспонденции = Результаты[ИндексРезультатаЗапросаКорреспонденций];
	РезультатЗначенияАналитики = Результаты[ИндексРезультатаЗначенийАналитики];
	РезультатВыраженияАналитики = Результаты[ИндексРезультатаВыраженийАналитики];
	РезультатРесурсыПоказателей = Результаты[ИндексРезультатаРесурсыПоказателей];
	РезультатСложныеКорреспонденции = Результаты[ИндексРезультатаСложныеКорреспонденции];
	
	ВыборкаКорреспонденции = РезультатКорреспонденции.Выбрать();
	ВыборкаЗначенияАналитики = РезультатЗначенияАналитики.Выбрать();
	ВыборкаВыраженияАналитики = РезультатВыраженияАналитики.Выбрать();
	ВыборкаРесурсыПоказателей = РезультатРесурсыПоказателей.Выбрать();
	ВыборкаСложныеКорреспонденции = РезультатСложныеКорреспонденции.Выбрать();
	
	Пока ВыборкаКорреспонденции.Следующий() Цикл
		ДтКт = ВыборкаКорреспонденции.ИсточникДанныхКорреспонденции;
		КорДтКт = ВыборкаКорреспонденции.КорИсточникДанныхКорреспонденции;
		
		АналитикаИсточникаДанных = СтрокиАналитикиДвижения(ВыборкаКорреспонденции,
			ВыборкаЗначенияАналитики, ВыборкаВыраженияАналитики, ТаблицыАналитики, Запрос.Параметры, ДтКт);
		АналитикаКорИсточникаДанных = СтрокиАналитикиДвижения(ВыборкаКорреспонденции,
			ВыборкаЗначенияАналитики, ВыборкаВыраженияАналитики, ТаблицыАналитики, Запрос.Параметры, КорДтКт);
		
		ОшибкиКорреспонденции = Новый Соответствие();
		
		Если НЕ ФинансовыйУчетПоДаннымБалансовыхРегистров.ПроверкаРавенстваБалансовыхРесурсов(
			ВыборкаКорреспонденции, АналитикаИсточникаДанных, Запрос.Параметры, ДтКт) Тогда
			ОшибкиКорреспонденции.Вставить(СтрШаблон(
				НСтр("ru = 'Ошибка при подборе аналитики к записи регистра ""%1"" с идентификатором %2.';
					|en = 'An error occurred while picking a dimension for the ""%1"" register record with ID %2.'"),
				ОбщегоНазначения.ПредставлениеОбъекта(Метаданные.РегистрыНакопления[ВыборкаКорреспонденции["ИмяРегистра" + ДтКт]]),
				ВыборкаКорреспонденции.ИдентификаторФинЗаписи));
		КонецЕсли;
		
		Если ВыборкаКорреспонденции.ПолучитьКорАналитику
		И НЕ ФинансовыйУчетПоДаннымБалансовыхРегистров.ПроверкаРавенстваБалансовыхРесурсов(
			ВыборкаКорреспонденции, АналитикаКорИсточникаДанных, Запрос.Параметры, КорДтКт) Тогда
			ОшибкиКорреспонденции.Вставить(СтрШаблон(
				НСтр("ru = 'Ошибка при подборе аналитики к записи регистра ""%1"" с идентификатором %2.';
					|en = 'An error occurred while picking a dimension for the ""%1"" register record with ID %2.'"),
				ОбщегоНазначения.ПредставлениеОбъекта(Метаданные.РегистрыНакопления[ВыборкаКорреспонденции["ИмяРегистра" + КорДтКт]]),
				ВыборкаКорреспонденции.ИдентификаторФинЗаписи));
		КонецЕсли;
		
		Если АналитикаИсточникаДанных.Количество() > 1 И АналитикаКорИсточникаДанных.Количество() > 1 Тогда
			ОшибкиКорреспонденции.Вставить(СтрШаблон(
				НСтр("ru = 'Записи регистров ""%1"" и ""%2"" с идентификатором %3 имеют отношение ""многие ко многим"".';
					|en = 'Records of registers ""%1"" and ""%2"" with ID %3 have the Many-to-Many relationship.'"),
				ОбщегоНазначения.ПредставлениеОбъекта(Метаданные.РегистрыНакопления[ВыборкаКорреспонденции.ИмяРегистраДт]),
				ОбщегоНазначения.ПредставлениеОбъекта(Метаданные.РегистрыНакопления[ВыборкаКорреспонденции.ИмяРегистраКт]),
				ВыборкаКорреспонденции.ИдентификаторФинЗаписи));
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура("Правило", ВыборкаКорреспонденции.ПравилоПолученияФакта);
		СтрокиПравила = ТаблицаПравил.НайтиСтроки(СтруктураПоиска);
		
		Если СтрокиПравила <> Неопределено Тогда
			ОписаниеПравила = СтрокиПравила[0];
		Иначе
			ОшибкиКорреспонденции.Вставить(СтрШаблон(
				НСтр("ru = 'Ошибка при обращении к свойствам правила получения фактических данных ""%1"".';
					|en = 'An error occurred when accessing the properties of the rule for obtaining the ""%1"" actual data.'"),
				ВыборкаКорреспонденции.ПравилоПолученияФакта));
		КонецЕсли;
		
		Если ОшибкиКорреспонденции.Количество() > 0 Тогда
			ТекстОшибки = "";
			Для Каждого ОшибкаКорреспонденции Из ОшибкиКорреспонденции Цикл
				ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", Символы.ПС) + ОшибкаКорреспонденции.Ключ;
			КонецЦикла;
			ЗарегистрироватьОшибкуОбработкиДокумента(ТекстОшибки, ВыборкаКорреспонденции, ДокументыКОбработке, ОписаниеПравила);
			Продолжить;
		КонецЕсли;
		
		ОписаниеПоказателя = ОписаниеПоказателяИсточникаДанных(ВыборкаРесурсыПоказателей, ОписаниеПравила);
		ЗначенияРесурсов = ЗначенияРесурсовПоказателя(ВыборкаКорреспонденции, ОписаниеПоказателя, АналитикаИсточникаДанных, ПараметрыПолученияФакта, ДтКт);
		
		Если ВыборкаКорреспонденции["СложнаяПроводка" + ДтКт] Тогда
			Если НЕ БалансныйПоказательИсточника(ОписаниеПоказателя) Тогда
				ПересчитатьРесурсыНебалансногоПоказателяСложнойКорреспонденции(ВыборкаКорреспонденции, ВыборкаСложныеКорреспонденции, ЗначенияРесурсов);
			ИначеЕсли ЗначенияРесурсов.Количество() > 1 Тогда
				ПересчитатьРесурсыБалансногоПоказателяСложнойКорреспонденции(ВыборкаКорреспонденции, ЗначенияРесурсов, ДтКт);
			КонецЕсли;
		КонецЕсли;
		
		Если АналитикаИсточникаДанных.Количество() = 1 И АналитикаКорИсточникаДанных.Количество() <= 1 Тогда
			ПолучитьДанныеПростойАналитики(ВыборкаКорреспонденции, ТаблицаФактическихДанных, ЗначенияРесурсов,
				АналитикаИсточникаДанных, АналитикаКорИсточникаДанных, ПараметрыПолученияФакта, ОписаниеПравила);
		Иначе
			ПолучитьДанныеСложнойАналитики(ВыборкаКорреспонденции, ТаблицаФактическихДанных, ЗначенияРесурсов,
				АналитикаИсточникаДанных, АналитикаКорИсточникаДанных, ПараметрыПолученияФакта, ОписаниеПравила);
		КонецЕсли;
	КонецЦикла;
	
	СвернутьТаблицуФактическихДанных(ТаблицаФактическихДанных);
	
КонецПроцедуры

Процедура ЗарегистрироватьОшибкуОбработкиДокумента(ТекстОшибки, ВыборкаКорреспонденции, ДокументыКОбработке, ОписаниеПравила)
	
	СтруктураПоиска = Новый Структура("Документ", ВыборкаКорреспонденции.Регистратор);
	СтрокиДокумента = ДокументыКОбработке.НайтиСтроки(СтруктураПоиска);
	СтрокаОшибки = Неопределено;
	
	Для Каждого СтрокаДокумента Из СтрокиДокумента Цикл
		Если СтрокаДокумента.Организация.Пустая() И СтрокаДокумента.Период = '00010101'
		 ИЛИ СтрокаДокумента.Организация = ВыборкаКорреспонденции.Организация
			И СтрокаДокумента.Период = ВыборкаКорреспонденции.Период Тогда
			СтрокаОшибки = СтрокаДокумента;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаОшибки = Неопределено Тогда
		СтрокаОшибки = ДокументыКОбработке.Добавить();
		СтрокаОшибки.Документ = СтруктураПоиска.Документ;
	КонецЕсли;
	
	СтрокаОшибки.Ошибка = Истина;
	СтрокаОшибки.Период = ВыборкаКорреспонденции.Период;
	СтрокаОшибки.Организация = ВыборкаКорреспонденции.Организация;
	СтрокаОшибки.Комментарий = СтрокаОшибки.Комментарий
		+ ?(ПустаяСтрока(СтрокаОшибки.Комментарий), "", Символы.ПС)
		+ ТекстОшибки;
	СтрокаОшибки.Правило = ОписаниеПравила.Правило;
	СтрокаОшибки.СтатьяБюджетов = ОписаниеПравила.СтатьяБюджетов;
	
КонецПроцедуры

Процедура СвернутьТаблицуФактическихДанных(ТаблицаФактическихДанных)
	
	КолонкиГруппировки = Новый Массив();
	КолонкиСуммирования = Новый Массив();
	
	Для Каждого Колонка Из ТаблицаФактическихДанных.Колонки Цикл
		Если Колонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
			КолонкиСуммирования.Добавить(Колонка.Имя);
		Иначе
			КолонкиГруппировки.Добавить(Колонка.Имя);	
		КонецЕсли;
	КонецЦикла;	
	
	КолонкиГруппировки  = СтрСоединить(КолонкиГруппировки , ",");
	КолонкиСуммирования = СтрСоединить(КолонкиСуммирования, ",");
	
	ТаблицаФактическихДанных.Свернуть(КолонкиГруппировки, КолонкиСуммирования);
	
КонецПроцедуры

#Область ТекстыЗапросовОбработкиДвиженийРегистров

Процедура ДобавитьТаблицыДвиженийДебетаИКредита(Запрос, ТекстыЗапросов)
	
	ТекстыЗапросов.Добавить("
	|ВЫБРАТЬ
	|	ДвиженияРегистров.Период КАК Период,
	|	ДвиженияРегистров.ИмяРегистра КАК ИмяРегистра,
	|	ДвиженияРегистров.ОбъектУчета КАК ОбъектУчета,
	|	ДвиженияРегистров.ЭтоДебет КАК ЭтоДебет,
	|	ДвиженияРегистров.ЭтоКредит КАК ЭтоКредит,
	|	ДвиженияРегистров.ЭтоСторно КАК ЭтоСторно,
	|	ДвиженияРегистров.Организация КАК Организация,
	|	ДвиженияРегистров.Регистратор КАК Регистратор,
	|	ДвиженияРегистров.НастройкаХозОперации КАК НастройкаХозОперации,
	|	ДвиженияРегистров.ИдентификаторФинЗаписи КАК ИдентификаторФинЗаписи,
	|	ДвиженияРегистров.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ДвиженияРегистров.СлужебныйВидДеятельностиНДС КАК СлужебныйВидДеятельностиНДС,
	|	ДвиженияРегистров.Валюта КАК Валюта,
	|	ДвиженияРегистров.СуммаУпр КАК СуммаУпр,
	|	ДвиженияРегистров.СуммаРегл КАК СуммаРегл,
	|	ДвиженияРегистров.СуммаВал КАК СуммаВал,
	|	ДвиженияРегистров.Количество КАК Количество,
	|	ДвиженияРегистров.РеквизитСторно КАК РеквизитСторно
	|ПОМЕСТИТЬ втДвиженияРегистровСоСторно
	|ИЗ
	|	втДвиженияРегистров КАК ДвиженияРегистров
	|ГДЕ
	|	ДвиженияРегистров.СуммаУпр < 0 ИЛИ ДвиженияРегистров.СуммаРегл < 0
	|	ИЛИ ДвиженияРегистров.СуммаВал < 0 ИЛИ ДвиженияРегистров.Количество < 0
	|ИНДЕКСИРОВАТЬ ПО
	|	ЭтоДебет,
	|	ЭтоКредит
	|");
	
	ТекстыЗапросов.Добавить("
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДвиженияРегистровСоСторно.ИмяРегистра КАК ИмяРегистра
	|ПОМЕСТИТЬ втРегистрыЗаменыСторноНаРеверс
	|ИЗ
	|	втДвиженияРегистровСоСторно КАК ДвиженияРегистровСоСторно
	|");
	
	ТекстыЗапросов.Добавить("
	|ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи,
	|	ДвиженияРегистров.Период КАК Период,
	|	ДвиженияРегистров.ИмяРегистра КАК ИмяРегистра,
	|	ДвиженияРегистров.ОбъектУчета КАК ОбъектУчета,
	|	ДвиженияРегистров.ЭтоДебет КАК ЭтоДебет,
	|	ДвиженияРегистров.ЭтоСторно КАК ЭтоСторно,
	|	ДвиженияРегистров.Организация КАК Организация,
	|	ДвиженияРегистров.Регистратор КАК Регистратор,
	|	ДвиженияРегистров.НастройкаХозОперации КАК НастройкаХозОперации,
	|	ДвиженияРегистров.ИдентификаторФинЗаписи КАК ИдентификаторФинЗаписи,
	|	ДвиженияРегистров.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ДвиженияРегистров.ВидДеятельностиНДС КАК ВидДеятельностиНДС,
	|	ДвиженияРегистров.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА ДвиженияРегистров.СуммаУпр <> 0
	|			ТОГДА ДвиженияРегистров.СуммаУпр
	|		КОГДА НЕ ДвиженияРегистров.ИмяРегистра В (&РегистрыБезСуммыУпр)
	|			ТОГДА ДвиженияРегистров.СуммаУпр
	|		КОГДА ДвиженияРегистров.Валюта = &ВалютаУправленческогоУчета
	|			ТОГДА ДвиженияРегистров.СуммаВал
	|		КОГДА ДвиженияРегистров.Организация.ВалютаРегламентированногоУчета = &ВалютаУправленческогоУчета
	|			ТОГДА ВЫБОР
