	|	ЕСТЬNULL(ИтогиПоОперациям.КоличествоФинЗаписей, 0) КАК КоличествоЗаписейОперации,
	|	ЕСТЬNULL(ИтогиПоОперациям.СуммаУпр, 0) КАК СуммаУпрОперации,
