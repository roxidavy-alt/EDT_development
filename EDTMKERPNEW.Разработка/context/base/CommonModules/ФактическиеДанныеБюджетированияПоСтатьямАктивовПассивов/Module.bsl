			КонецЕсли;
		КонецЕсли;
	
		ДоступныеПоляРегистра.Добавить("ТипРегистратора");
		ДоступныеПоляРегистров.Вставить(ИмяТаблицыРегистра, ДоступныеПоляРегистра);
