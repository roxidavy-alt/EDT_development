			ДанныеСтроки.СтоимостьПоДаннымУчетаУУ = ДанныеУчета.СтоимостьПоДаннымУчетаУУ;
		КонецЕсли;
			
	КонецЕсли; 
	
	Если НЕ ДанныеСтроки.НаличиеПоДаннымУчета Тогда
		ДанныеСтроки.СтоимостьПоДаннымУчетаБУ = 0;
