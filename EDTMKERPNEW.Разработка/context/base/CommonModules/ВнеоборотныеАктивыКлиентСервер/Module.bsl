		КонецЕсли;
		
		Если ДанныеСтроки.СтоимостьПоДаннымУчетаУУ <> ДанныеСтроки.СтоимостьФактическаяУУ
			И ДанныеСтроки.СтоимостьПоДаннымУчетаУУ <> 0
			И ДанныеСтроки.СтоимостьФактическаяУУ <> 0 Тогда
		
			ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Переоценка");
		
		ИначеЕсли ДанныеСтроки.СтоимостьФактическаяУУ = 0
			И ДанныеСтроки.СтоимостьПоДаннымУчетаУУ <> 0
			И Объект.ОтражатьВУпрУчете
			И (Объект.ОтражатьВБУ ИЛИ Объект.ОтражатьВНУ) Тогда
		
			ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Списание");
		
		ИначеЕсли ДанныеСтроки.СтоимостьФактическаяУУ <> 0
			И ДанныеСтроки.СтоимостьПоДаннымУчетаУУ = 0
			И ДанныеУчета <> Неопределено
			И ДанныеУчета.Организация = Объект.Организация Тогда
		
			ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету");
		
		КонецЕсли;
		
	ИначеЕсли НЕ ДанныеСтроки.НаличиеПоДаннымУчета
		И ДанныеСтроки.НаличиеФактическое Тогда
		
		Если ДанныеУчета = Неопределено
			ИЛИ НЕ ЗначениеЗаполнено(ДанныеУчета.Организация) Тогда
			
			Если Объект.ОтражатьВБУ Тогда
				ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету");
			КонецЕсли;
			
			Если Объект.ОтражатьВНУ Тогда
				ДанныеСтроки.ДействиеНУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету");
			КонецЕсли;
			
			Если Объект.ОтражатьВУпрУчете Тогда
				ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.ПринятиеКУчету");
			КонецЕсли;
			
		Иначе
			
			Если ДанныеУчета <> Неопределено
				И (ДанныеУчета.Организация <> Объект.Организация
					ИЛИ ДанныеУчета.Подразделение <> Объект.Подразделение) Тогда
			
				Если Объект.ОтражатьВБУ Тогда
					ДанныеСтроки.ДействиеБУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Перемещение");
				КонецЕсли;
				
				Если Объект.ОтражатьВНУ <> 0 Тогда
					ДанныеСтроки.ДействиеНУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Перемещение");
				КонецЕсли;
				
				Если Объект.ОтражатьВУпрУчете <> 0 Тогда
					ДанныеСтроки.ДействиеУУ = ПредопределенноеЗначение("Перечисление.ДействияНаОснованииИнвентаризации.Перемещение");
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПредставлениеДействия(ДанныеСтроки, Форма) Экспорт
	
	Объект = Форма.Объект;

	ДанныеСтроки.ДействиеПредставление = "";
	
	Если (НЕ ЗначениеЗаполнено(ДанныеСтроки.ДействиеБУ)
			ИЛИ НЕ Объект.ОтражатьВБУ)
		И (НЕ ЗначениеЗаполнено(ДанныеСтроки.ДействиеНУ)
			ИЛИ НЕ Объект.ОтражатьВНУ)
		И (НЕ ЗначениеЗаполнено(ДанныеСтроки.ДействиеУУ)
			ИЛИ НЕ Объект.ОтражатьВУпрУчете) Тогда
			
		Возврат;
	КонецЕсли;
	
	ДействиеПредставление = "";
	
	Если (ЗначениеЗаполнено(ДанныеСтроки.ДокументНаОснованииБУ)
			ИЛИ НЕ ЗначениеЗаполнено(ДанныеСтроки.ДействиеБУ))
		И (ЗначениеЗаполнено(ДанныеСтроки.ДокументНаОснованииНУ)
			ИЛИ НЕ ЗначениеЗаполнено(ДанныеСтроки.ДействиеНУ))
		И (ЗначениеЗаполнено(ДанныеСтроки.ДокументНаОснованииУУ)
			ИЛИ НЕ ЗначениеЗаполнено(ДанныеСтроки.ДействиеУУ)) Тогда
		
		ОбщийДокумент = ОбщийДокумент(ДанныеСтроки);
		
		Если ОбщийДокумент <> Неопределено Тогда
			
			ДействиеПредставление = Строка(ОбщийДокумент);
			
		Иначе	
			
			ДействиеПредставление = НСтр("ru = 'Все документы оформлены';
										|en = 'All documents are registered'");
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.ДокументНаОснованииБУ)
		ИЛИ ЗначениеЗаполнено(ДанныеСтроки.ДокументНаОснованииНУ)
		ИЛИ ЗначениеЗаполнено(ДанныеСтроки.ДокументНаОснованииУУ) Тогда
			
		ДействиеПредставление = НСтр("ru = 'Документы оформлены частично';
									|en = 'The documents are partially registered'");
			 	
	ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.ДействиеБУ)
		ИЛИ ЗначениеЗаполнено(ДанныеСтроки.ДействиеНУ)
		ИЛИ ЗначениеЗаполнено(ДанныеСтроки.ДействиеУУ) Тогда
			
		Действие = ОбщееДействие(ДанныеСтроки);
		
		Если Действие <> Неопределено Тогда
			
			ДействиеПредставление = Строка(Действие);
			
		Иначе	
			
			ДействиеПредставление = НСтр("ru = 'Документы не оформлены';
										|en = 'The documents are not registered'");
			
		КонецЕсли;
			 	
	КонецЕсли;
	
	ДанныеСтроки.ДействиеПредставление = ДействиеПредставление;
	
КонецПроцедуры

Функция ОбщееДействие(ДанныеСтроки)
	
	Действие = Неопределено;
	
	Если ЗначениеЗаполнено(ДанныеСтроки.ДействиеБУ) Тогда
		
		ДействиеОбщее = ПервоеЗначениеОбщее(
			ДанныеСтроки.ДействиеБУ, 
			ДанныеСтроки.ДействиеНУ, 
			ДанныеСтроки.ДействиеУУ, 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеБУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеНУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеУУ));
				
		Если ДействиеОбщее Тогда
			Действие = ДанныеСтроки.ДействиеБУ;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.ДействиеНУ) Тогда
		
		ДействиеОбщее = ПервоеЗначениеОбщее(
			ДанныеСтроки.ДействиеНУ, 
			ДанныеСтроки.ДействиеБУ, 
			ДанныеСтроки.ДействиеУУ, 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеНУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеБУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеУУ));
		
		Если ДействиеОбщее Тогда
			Действие = ДанныеСтроки.ДействиеНУ;
		КонецЕсли;

	ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.ДействиеУУ) Тогда
		
		ДействиеОбщее = ПервоеЗначениеОбщее(
			ДанныеСтроки.ДействиеУУ, 
			ДанныеСтроки.ДействиеБУ, 
			ДанныеСтроки.ДействиеНУ, 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеУУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеБУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеНУ));

		Если ДействиеОбщее Тогда
			Действие = ДанныеСтроки.ДействиеУУ;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Действие;
	
КонецФункции

Функция ОбщийДокумент(ДанныеСтроки)
	
	ДокументНаОсновании = Неопределено;
	
	Если ЗначениеЗаполнено(ДанныеСтроки.ДокументНаОснованииБУ) Тогда
		
		ДокументОбщий = ПервоеЗначениеОбщее(
			ДанныеСтроки.ДокументНаОснованииБУ, 
			ДанныеСтроки.ДокументНаОснованииНУ, 
			ДанныеСтроки.ДокументНаОснованииУУ, 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеБУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеНУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеУУ));
				
		Если ДокументОбщий Тогда
			ДокументНаОсновании = ДанныеСтроки.ДокументНаОснованииБУ;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.ДокументНаОснованииНУ) Тогда
		
		ДокументОбщий = ПервоеЗначениеОбщее(
			ДанныеСтроки.ДокументНаОснованииНУ, 
			ДанныеСтроки.ДокументНаОснованииБУ, 
			ДанныеСтроки.ДокументНаОснованииУУ, 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеНУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеБУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеУУ));
		
		Если ДокументОбщий Тогда
			ДокументНаОсновании = ДанныеСтроки.ДокументНаОснованииНУ;
		КонецЕсли;

	ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.ДокументНаОснованииУУ) Тогда
		
		ДокументОбщий = ПервоеЗначениеОбщее(
			ДанныеСтроки.ДокументНаОснованииУУ, 
			ДанныеСтроки.ДокументНаОснованииБУ, 
			ДанныеСтроки.ДокументНаОснованииНУ, 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеУУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеБУ), 
			ЗначениеЗаполнено(ДанныеСтроки.ДействиеНУ));

		Если ДокументОбщий Тогда
			ДокументНаОсновании = ДанныеСтроки.ДокументНаОснованииУУ;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДокументНаОсновании;
	
КонецФункции

Функция ПервоеЗначениеОбщее(Значение1, Значение2, Значение3, ИспользоватьЗначение1, ИспользоватьЗначение2, ИспользоватьЗначение3)
	
	Если НЕ ЗначениеЗаполнено(Значение1)
		И НЕ ЗначениеЗаполнено(Значение2)
		И НЕ ЗначениеЗаполнено(Значение3) Тогда
		
		Возврат Истина;
	КонецЕсли;

	Результат =
		ЗначениеЗаполнено(Значение1)
		И ИспользоватьЗначение1
		И (Значение1 = Значение2
				И Значение1 = Значение3
			ИЛИ Значение1 = Значение2
				И (НЕ ИспользоватьЗначение3
					ИЛИ НЕ ЗначениеЗаполнено(Значение3))
			ИЛИ Значение1 = Значение3
				И (НЕ ИспользоватьЗначение2
					ИЛИ НЕ ЗначениеЗаполнено(Значение2))
			ИЛИ НЕ ИспользоватьЗначение2
				И НЕ ИспользоватьЗначение3
			ИЛИ НЕ ЗначениеЗаполнено(Значение2)
				И НЕ ЗначениеЗаполнено(Значение3));
				
	Возврат Результат;
		
КонецФункции

#КонецОбласти

#Область Прочее

Функция ПараметрыПринятияКУчетуОСИВводаОстатков(Объект, ВспомогательныеРеквизиты)

	ДоступныПараметрыАмортизацииБУ = 
		(Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.АмортизацияНачислена")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.ПустаяСсылка"))
		И ВспомогательныеРеквизиты.ОтражатьВБУ
		И ВспомогательныеРеквизиты.РеглУчетВНАВедетсяНезависимо;
		
	//
	ДоступныПараметрыАмортизацииУУ = 
		(Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
				ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.АмортизацияНачислена")
				ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.ПустаяСсылка"))
			И ВспомогательныеРеквизиты.ОтражатьВУпрУчете;
	//								
	ДоступноОтражениеРасходовБУ = 
		ВспомогательныеРеквизиты.ОтражатьВБУ
		И ВспомогательныеРеквизиты.РеглУчетВНАВедетсяНезависимо
		И (Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислитьАмортизациюПриПринятииКУчету")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.АмортизацияНачислена")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.ПустаяСсылка"));
			
	//		
	ДоступноОтражениеРасходовУУ = 
		ВспомогательныеРеквизиты.ОтражатьВУпрУчете
		И (Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислитьАмортизациюПриПринятииКУчету")
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.АмортизацияНачислена")
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.ПустаяСсылка"));
			
	//
	АмортизацияУУДоступна = 
		(Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
				ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислитьАмортизациюПриПринятииКУчету"))
			И ВспомогательныеРеквизиты.ОтражатьВУпрУчете;
							
	//		
	АмортизацияБУДоступна = 
		(Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеИзносаПоЕНАОФ")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислитьАмортизациюПриПринятииКУчету"))
		И ВспомогательныеРеквизиты.ОтражатьВБУ
		И ВспомогательныеРеквизиты.РеглУчетВНАВедетсяНезависимо;
	
	//
	ПоНаработке = 
		Объект.МетодНачисленияАмортизацииУУ = ПредопределенноеЗначение("Перечисление.СпособыНачисленияАмортизацииОС.ПропорциональноОбъемуПродукции")
		ИЛИ Объект.МетодНачисленияАмортизацииБУ = ПредопределенноеЗначение("Перечисление.СпособыНачисленияАмортизацииОС.ПропорциональноОбъемуПродукции")
		ИЛИ Объект.МетодНачисленияАмортизацииБУ = ПредопределенноеЗначение("Перечисление.СпособыНачисленияАмортизацииОС.ПоЕНАОФНа1000кмПробега");
		
	//
	СтатьяРасходовУУОбязательна = 
		ВспомогательныеРеквизиты.ОтражатьВУпрУчете 
		И (НЕ ДоступноОтражениеРасходовБУ 
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НеПриниматьКУчетуВключитьВРасходы")
			ИЛИ ЗначениеЗаполнено(Объект.СтатьяРасходовУУ)
			ИЛИ ЗначениеЗаполнено(Объект.АналитикаРасходовУУ)
			ИЛИ ЗначениеЗаполнено(Объект.ПодразделениеУУ)
			ИЛИ ЗначениеЗаполнено(Объект.НаправлениеДеятельностиУУ));
		
	//
	ПараметрыПринятияКУчетуОС = Новый Структура;
	ПараметрыПринятияКУчетуОС.Вставить("ДоступныПараметрыАмортизацииБУ", ДоступныПараметрыАмортизацииБУ);
	ПараметрыПринятияКУчетуОС.Вставить("ДоступныПараметрыАмортизацииУУ", ДоступныПараметрыАмортизацииУУ);
	ПараметрыПринятияКУчетуОС.Вставить("ДоступноОтражениеРасходовБУ", ДоступноОтражениеРасходовБУ);
	ПараметрыПринятияКУчетуОС.Вставить("ДоступноОтражениеРасходовУУ", ДоступноОтражениеРасходовУУ);
	ПараметрыПринятияКУчетуОС.Вставить("ДоступноОтражениеРасходовНУ", Ложь);
	ПараметрыПринятияКУчетуОС.Вставить("АмортизацияУУДоступна", АмортизацияУУДоступна);
	ПараметрыПринятияКУчетуОС.Вставить("АмортизацияБУДоступна", АмортизацияБУДоступна);
	ПараметрыПринятияКУчетуОС.Вставить("ПоНаработке", ПоНаработке);
	ПараметрыПринятияКУчетуОС.Вставить("НаправлениеДеятельностиОбязательно", Ложь);
	ПараметрыПринятияКУчетуОС.Вставить("СтатьяРасходовУУОбязательна", СтатьяРасходовУУОбязательна);
	
	ВнеоборотныеАктивыКлиентСерверЛокализация.ДополнитьПараметрыПринятияКУчетуОСИВводаОстатков(
		Объект, ВспомогательныеРеквизиты, ПараметрыПринятияКУчетуОС);
	
	Возврат ПараметрыПринятияКУчетуОС;

КонецФункции

Функция ПараметрыПринятияКУчетуНМАИВводаОстатков(Объект, ВспомогательныеРеквизиты)
	
	//
	ДоступныПараметрыАмортизацииБУ = 
		ВспомогательныеРеквизиты.ОтражатьВБУ
		И ВспомогательныеРеквизиты.РеглУчетВНАВедетсяНезависимо
		И (Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.ПустаяСсылка"));
		
	ДоступныПараметрыАмортизацииУУ = 
		ВспомогательныеРеквизиты.ОтражатьВУпрУчете
		И (Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.ПустаяСсылка"));
									
	ДоступноОтражениеРасходовБУ = 
		ВспомогательныеРеквизиты.ОтражатьВБУ
		И ВспомогательныеРеквизиты.РеглУчетВНАВедетсяНезависимо
		И (Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НеПриниматьКУчетуВключитьВРасходы")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.ПустаяСсылка"));
	
	ДоступноОтражениеРасходовУУ = 
		ВспомогательныеРеквизиты.ОтражатьВУпрУчете
		И (Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НеПриниматьКУчетуВключитьВРасходы")
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.ПустаяСсылка"));
									
	ПоНаработке = 
		ВспомогательныеРеквизиты.ОтражатьВУпрУчете
			И Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
			И Объект.МетодНачисленияАмортизацииУУ = ПредопределенноеЗначение("Перечисление.СпособыНачисленияАмортизацииНМА.ПропорциональноОбъемуПродукции")
		ИЛИ ВспомогательныеРеквизиты.ОтражатьВБУ
			И Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
			И Объект.МетодНачисленияАмортизацииБУ = ПредопределенноеЗначение("Перечисление.СпособыНачисленияАмортизацииНМА.ПропорциональноОбъемуПродукции");
				
	СтоимостьБУДоступна = 
		ВспомогательныеРеквизиты.ОтражатьВБУ
		И (Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НеНачислятьАмортизацию")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.АмортизацияНачислена")
			ИЛИ Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.ПустаяСсылка"));
	
	//
	СтоимостьУУДоступна = 
		ВспомогательныеРеквизиты.ОтражатьВУпрУчете
		И (ВспомогательныеРеквизиты.РеглУчетВНАВедетсяНезависимо
			ИЛИ НЕ ВспомогательныеРеквизиты.ВалютыСовпадают)
		И (Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НеНачислятьАмортизацию")
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислениеАмортизацииИлиСписаниеНаРасходы")
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислитьАмортизациюПриПринятииКУчету")
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.АмортизацияНачислена")
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.ПустаяСсылка"));
				
	АмортизацияБУДоступна = 
		ВспомогательныеРеквизиты.ОтражатьВБУ
		И ВспомогательныеРеквизиты.РеглУчетВНАВедетсяНезависимо
		И (Объект.ПорядокУчетаБУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
			ИЛИ Объект.ПорядокУчетаНУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НачислятьАмортизацию")
			ИЛИ Объект.ПорядокУчетаНУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.ПустаяСсылка"));
			
	СтатьяРасходовУУОбязательна = 
		ВспомогательныеРеквизиты.ОтражатьВУпрУчете 
		И (НЕ ДоступноОтражениеРасходовБУ
			ИЛИ Объект.ПорядокУчетаУУ = ПредопределенноеЗначение("Перечисление.ПорядокУчетаСтоимостиВнеоборотныхАктивов.НеПриниматьКУчетуВключитьВРасходы")
			ИЛИ ЗначениеЗаполнено(Объект.СтатьяРасходовУУ)
			ИЛИ ЗначениеЗаполнено(Объект.АналитикаРасходовУУ)
			ИЛИ ЗначениеЗаполнено(Объект.ПодразделениеУУ)
			ИЛИ ЗначениеЗаполнено(Объект.НаправлениеДеятельностиУУ));
	
	ПараметрыПринятияКУчетуНМА = Новый Структура;
	ПараметрыПринятияКУчетуНМА.Вставить("ДоступныПараметрыАмортизацииБУ", ДоступныПараметрыАмортизацииБУ);
	ПараметрыПринятияКУчетуНМА.Вставить("ДоступныПараметрыАмортизацииУУ", ДоступныПараметрыАмортизацииУУ);
	ПараметрыПринятияКУчетуНМА.Вставить("ДоступноОтражениеРасходовБУ", ДоступноОтражениеРасходовБУ);
	ПараметрыПринятияКУчетуНМА.Вставить("ДоступноОтражениеРасходовУУ", ДоступноОтражениеРасходовУУ);
	ПараметрыПринятияКУчетуНМА.Вставить("АмортизацияБУДоступна", АмортизацияБУДоступна);
	ПараметрыПринятияКУчетуНМА.Вставить("СтатьяРасходовУУОбязательна", СтатьяРасходовУУОбязательна);
	ПараметрыПринятияКУчетуНМА.Вставить("ПоНаработке", ПоНаработке);
	ПараметрыПринятияКУчетуНМА.Вставить("НаправлениеДеятельностиОбязательно", Ложь);
	ПараметрыПринятияКУчетуНМА.Вставить("СтоимостьУУДоступна", СтоимостьУУДоступна);
	ПараметрыПринятияКУчетуНМА.Вставить("СтоимостьБУДоступна", СтоимостьБУДоступна);

	ВнеоборотныеАктивыКлиентСерверЛокализация.ДополнитьПараметрыПринятияКУчетуНМАИВводаОстатков(
		Объект, ВспомогательныеРеквизиты, ПараметрыПринятияКУчетуНМА);

	Возврат ПараметрыПринятияКУчетуНМА;
		
КонецФункции

// Добавляет описание ошибки.
// 
// Параметры:
//  СписокОшибок - Массив из Структура - Список ошибок
//  ТекстСообщения - Строка - Текст сообщения
//  Поле - Строка - Поле
//  ПутьКДанным - Строка - Путь к данным
//	ЕстьОшибки - Булево -
Процедура ДобавитьОписаниеОшибки(СписокОшибок, ТекстСообщения, Поле = Неопределено, ПутьКДанным = Неопределено, ЕстьОшибки = Ложь) Экспорт
	
	ЕстьОшибки = Истина;
	
	ОписаниеОшибки = Новый Структура;
	ОписаниеОшибки.Вставить("ТекстСообщения", ТекстСообщения);
	ОписаниеОшибки.Вставить("Поле", Поле);
	ОписаниеОшибки.Вставить("ПутьКДанным", ПутьКДанным);

	СписокОшибок.Добавить(ОписаниеОшибки);
	
КонецПроцедуры

// Добавляет к строке наименование валюты.
// 
// Параметры:
// 	ИсходнаяСтрока - Строка -
// 	ПредставлениеВалюты - Строка -
// 	
// Возвращаемое значение:
// 	Строка - Строка с валютой.
Функция ДобавитьКСтрокеВалюту(ИсходнаяСтрока, ПредставлениеВалюты) Экспорт
	Возврат ?(ЗначениеЗаполнено(ПредставлениеВалюты), СтрШаблон(ИсходнаяСтрока + " (%1)", ПредставлениеВалюты), ИсходнаяСтрока);
КонецФункции

// Представление поля с валютой.
// 
// Параметры:
//  ПредставлениеБезУчета - Строка - 
//  Представление - Строка - 
//  РеглУчетВНАВедетсяНезависимо - Булево - 
//  ВалютыСовпадают - Булево - 
//  ПредставлениеВалюты - Строка - 
// 
// Возвращаемое значение:
//  Строка - Представление поля с валютой
Функция ПредставлениеПоляСВалютой(ПредставлениеБезУчета, Представление, РеглУчетВНАВедетсяНезависимо, ВалютыСовпадают, ПредставлениеВалюты) Экспорт
	
	Если НЕ РеглУчетВНАВедетсяНезависимо
		И ВалютыСовпадают Тогда
			
		ПредставлениеПоляСВалютой = ПредставлениеБезУчета;
		
	Иначе
		
		ПредставлениеПоляСВалютой = ДобавитьКСтрокеВалюту(Представление, ПредставлениеВалюты);
			
	КонецЕсли; 
	
	Возврат ПредставлениеПоляСВалютой;
	
КонецФункции

