#Область ПрограммныйИнтерфейс

// Рассчитать детализацию продукции.
// 
// Параметры:
//  ПараметрыЗапуска - Структура - Параметры запуска:
// * НачалоПериода - Дата - 
// * МассивОрганизаций - Массив из СправочникСсылка.Организации - 
// * МестоВызоваРасчета - Строка - 
// * ВыполняетсяЗакрытиеМесяца - Булево - 
// * АвтоматическоеТестирование - Булево -
// * РежимЗакрытияМесяца - ПеречислениеСсылка.РежимыЗакрытияМесяца - 
// * ИдентификаторРасчета - УникальныйИдентификатор - 
// * ТолькоОднаОрганизация - Булево -
// 
Процедура РассчитатьДетализациюПродукции(ПараметрыЗапуска) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ПараметрыЗапуска.МассивОрганизаций) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыРасчета = ИнициализироватьПараметрыРасчета(ПараметрыЗапуска);
	
	Запрос = Новый Запрос;
	ИнициализироватьПараметрыЗапроса(ПараметрыРасчета, Запрос);
	
	#Область ОстаткиНЗП_НачальныеПартииКРасчету
	
	// Временные таблицы:
	// ВТОрганизацииПрошлыхПериодов
	// ВТОстаткиПартийНЗП
	// ВТПартииКРасчетуПредварительная - информация о проданных, выпущенных, использованных в производстве ПФ и ГП
	// ВТПартииКРасчету - свернутая ВТПартииКРасчетуПредварительная с признаком БезДетализации (отсутствуют записи в регистре детализаций в прошлых периодах)
	// ВТОтборПартии
	// ВТПартииПолуфабрикатовПрошлыхПериодов
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Организация КАК Организация
	|ПОМЕСТИТЬ ВТОрганизацииПрошлыхПериодов
	|ИЗ
	|	РегистрСведений.ДетализацияСебестоимостиПартийПродукции КАК Т
	|ГДЕ
	|	Т.Организация В (&МассивОрганизаций)
	|	И Т.ПериодРегистрации < &НачалоПериода
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Партия КАК Партия,
	|	Т.Организация КАК Организация,
	|	Т.ВидЗапасов КАК ВидЗапасов,
	|	Т.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	Т.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
	|	Т.АналитикаУчетаНоменклатуры.СтатьяКалькуляции КАК СтатьяКалькуляции,
	|	Т.ВидДеятельностиНДС В (&ТипыНалогообложенияНДСУчитываетсяВСтоимости) КАК НДСВключенВСтоимость,
	|	Т.СтоимостьУпрОстаток + Т.ПостатейныеПостоянныеУпрОстаток + Т.ПостатейныеПеременныеУпрОстаток КАК СтоимостьУпр,
	|	Т.СтоимостьРеглОстаток + Т.ПостатейныеПостоянныеРеглОстаток + Т.ПостатейныеПеременныеРеглОстаток КАК СтоимостьРегл,
	|	Т.ПостояннаяРазницаОстаток КАК ПостояннаяРазница,
	|	Т.ВременнаяРазницаОстаток КАК ВременнаяРазница,
	|	Т.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТОстаткиПартийНЗП
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров.Остатки(&ГраницаКонецПредыдущегоПериода,
	|		РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.НезавершенноеПроизводство)
	|		И ТИПЗНАЧЕНИЯ(Партия) = ТИП(Справочник.ПартииПроизводства)
	|		И Организация В(&МассивОрганизаций)
	|		И НЕ (Организация В (ВЫБРАТЬ Отбор.Организация ИЗ ВТОрганизацииПрошлыхПериодов КАК Отбор))) КАК Т
	|ГДЕ
	|	Т.КоличествоОстаток > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// Продажа ПФ и ГП
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Партия КАК Партия,
	|	Т.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	Т.АналитикаУчетаПоПартнерам.Организация КАК Организация
	// Шаг 1.1
	|ПОМЕСТИТЬ ВТПартииКРасчетуПредварительная
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК Т
	|ГДЕ
	|	Т.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Т.АналитикаУчетаПоПартнерам.Организация В(&МассивОрганизаций)
	|	И ТИПЗНАЧЕНИЯ(Т.Партия) В (&ТипыДокументовПартии)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	// Выпуск ПФ и ГП
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Партия,
	|	Т.АналитикаУчетаПартий,
	|	Т.Организация
	// Шаг 1.2
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров КАК Т
	|ГДЕ
	|	Т.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Т.Организация В(&МассивОрганизаций)
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Т.Регистратор = Т.Партия
	|	И ТИПЗНАЧЕНИЯ(Т.Регистратор) В (&ТипыДокументовПартии)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	// Потребление ПФ на выпуск
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Партия,
	|	Т.АналитикаУчетаПартий,
	|	Т.Организация
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров КАК Т
	|ГДЕ
	|	Т.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Т.Организация В(&МассивОрганизаций)
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И ТИПЗНАЧЕНИЯ(Т.Партия) В (&ТипыДокументовПартии)
	|	И ТИПЗНАЧЕНИЯ(Т.КорПартия) = ТИП(Справочник.ПартииПроизводства)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Партия КАК Партия,
	|	Т.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	Т.Организация,
	|	МАКСИМУМ((ПрошлыеПартии.Партия ЕСТЬ NULL)) КАК БезДетализации,
	|	МАКСИМУМ((ЕСТЬNULL(ПрошлыеПартии.НДСРегл, 0) <> 0 ИЛИ ЕСТЬNULL(ПрошлыеПартии.НДСУпр, 0) <> 0)) КАК ЕстьНДС
	// Шаг 1.3
	|ПОМЕСТИТЬ ВТПартииКРасчету
	|ИЗ
	|	ВТПартииКРасчетуПредварительная КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДетализацияСебестоимостиПартийПродукции КАК ПрошлыеПартии
	|		ПО Т.Партия = ПрошлыеПартии.Партия
	|			И Т.АналитикаУчетаПартий = ПрошлыеПартии.АналитикаУчетаПартий
	|			И Т.Организация = ПрошлыеПартии.Организация
	|			И ПрошлыеПартии.ПериодРегистрации < &НачалоПериода
	|			И ПрошлыеПартии.ТипЗаписи = ЗНАЧЕНИЕ(Перечисление.ТипыЗаписейПартий.ПустаяСсылка)
	|ГДЕ
	|	Т.Партия <> НЕОПРЕДЕЛЕНО
	|СГРУППИРОВАТЬ ПО
	|	Т.Партия,
	|	Т.АналитикаУчетаПартий,
	|	Т.Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЛОЖЬ КАК ЭтоОстаток,
	|	Т.Партия КАК Партия
	|ПОМЕСТИТЬ ВТОтборПартии
	|ИЗ
	|	ВТПартииКРасчету КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 0
	|	ЛОЖЬ КАК ЭтоОстаток,
	|	Т.Партия КАК Партия,
	|	Т.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	Т.Организация,
	|	ЛОЖЬ КАК БезДетализации,
	|	ЛОЖЬ КАК ЕстьНДС
	|ПОМЕСТИТЬ ВТПартииПолуфабрикатовПрошлыхПериодов
	|ИЗ
	|	ВТПартииКРасчету КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|";
	
	РасчетСебестоимостиПрикладныеАлгоритмы.ВыполнитьЗапросСЗамеромДляПротокола(ПараметрыРасчета, Запрос);
	
	РасчетСебестоимостиПрикладныеАлгоритмы.УничтожитьВременныеТаблицы(Запрос,
		"ВТОрганизацииПрошлыхПериодов, ВТПартииКРасчетуПредварительная");
	
	#КонецОбласти
	
	#Область РекурсивныйРасчетПартииПолуфабрикатовПрошлыхПериодов

	// Временные таблицы:
	// ВТПартииПроизводстваПрошлыхПериодов
	// ВТПартииПолуфабрикатовПрошлыхПериодовПредварительная
	// ВТНовыеПартииПолуфабрикатовПрошлыхПериодов
	// ВТПартииПолуфабрикатовПрошлыхПериодов (добавление)
	// ВТОтборПартии
	
	Запрос.УстановитьПараметр("ПерваяИтерация", Истина);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Отбор.ЭтоОстаток,
	|	Т.Партия КАК Партия
	// Шаг 2.1
	|ПОМЕСТИТЬ ВТПартииПроизводстваПрошлыхПериодов
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров КАК Т
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОтборПартии КАК Отбор
	|		ПО Т.Регистратор = Отбор.Партия
	|ГДЕ
	|	Т.Период < &НачалоПериода
	|	И Т.Организация В(&МассивОрганизаций)
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И ТИПЗНАЧЕНИЯ(Т.Партия) = ТИП(Справочник.ПартииПроизводства)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИСТИНА КАК ЭтоОстаток,
	|	Т.Партия КАК Партия
	|ИЗ
	|	ВТОстаткиПартийНЗП КАК Т
	|ГДЕ
	|	&ПерваяИтерация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Отбор.ЭтоОстаток,
	|	Т.КорПартия КАК Партия,
	|	Т.КорАналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	Т.Организация
	// Шаг 2.2
	|ПОМЕСТИТЬ ВТПартииПолуфабрикатовПрошлыхПериодовПредварительная
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров КАК Т
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПартииПроизводстваПрошлыхПериодов КАК Отбор
	|		ПО Т.Партия = Отбор.Партия
	|ГДЕ
	|	Т.Период < &НачалоПериода
	|	И Т.Организация В(&МассивОрганизаций)
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И ТИПЗНАЧЕНИЯ(Т.КорПартия) В (&ТипыДокументовПартии)
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.ЭтоОстаток,
	|	Т.Партия КАК Партия,
	|	Т.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	Т.Организация,
	|	МАКСИМУМ((ПрошлыеПартии.Партия ЕСТЬ NULL)) КАК БезДетализации,
	|	МАКСИМУМ((ЕСТЬNULL(ПрошлыеПартии.НДСРегл, 0) <> 0 ИЛИ ЕСТЬNULL(ПрошлыеПартии.НДСУпр, 0) <> 0)) КАК ЕстьНДС
	// Шаг 2.3
	|ПОМЕСТИТЬ ВТНовыеПартииПолуфабрикатовПрошлыхПериодов
	|ИЗ
	|	ВТПартииПолуфабрикатовПрошлыхПериодовПредварительная КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДетализацияСебестоимостиПартийПродукции КАК ПрошлыеПартии
	|		ПО Т.Партия = ПрошлыеПартии.Партия
	|			И Т.АналитикаУчетаПартий = ПрошлыеПартии.АналитикаУчетаПартий
	|			И Т.Организация = ПрошлыеПартии.Организация
	|			И ПрошлыеПартии.ПериодРегистрации < &НачалоПериода
	|			И ПрошлыеПартии.ТипЗаписи = ЗНАЧЕНИЕ(Перечисление.ТипыЗаписейПартий.ПустаяСсылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПартииПолуфабрикатовПрошлыхПериодов КАК ПартииПолуфабрикатов
	|		ПО Т.Партия = ПартииПолуфабрикатов.Партия
	|			И Т.АналитикаУчетаПартий = ПартииПолуфабрикатов.АналитикаУчетаПартий
	|			И Т.Организация = ПартииПолуфабрикатов.Организация
	|			И Т.ЭтоОстаток = ПартииПолуфабрикатов.ЭтоОстаток
	|ГДЕ
	|	ПартииПолуфабрикатов.Партия ЕСТЬ NULL
	|	И Т.Партия <> НЕОПРЕДЕЛЕНО
	|СГРУППИРОВАТЬ ПО
	|	Т.ЭтоОстаток,
	|	Т.Партия,
	|	Т.АналитикаУчетаПартий,
	|	Т.Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.ЭтоОстаток КАК ЭтоОстаток,
	|	Т.Партия КАК Партия,
	|	Т.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	Т.Организация КАК Организация,
	|	Т.БезДетализации КАК БезДетализации,
	|	Т.ЕстьНДС КАК ЕстьНДС
	|ДОБАВИТЬ ВТПартииПолуфабрикатовПрошлыхПериодов
	|ИЗ
	|	ВТНовыеПартииПолуфабрикатовПрошлыхПериодов КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТОтборПартии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Отбор.ЭтоОстаток,
	|	Т.Партия КАК Партия
	|ПОМЕСТИТЬ ВТОтборПартии
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров КАК Т
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНовыеПартииПолуфабрикатовПрошлыхПериодов КАК Отбор
	|		ПО Т.Регистратор = Отбор.Партия
	|ГДЕ
	|	Т.Период < &НачалоПериода
	|	И Т.Организация В(&МассивОрганизаций)
	|	И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И ТИПЗНАЧЕНИЯ(Т.Регистратор) В (&ТипыДокументовПартии)
	|	И ТИПЗНАЧЕНИЯ(Т.Партия) В (&ТипыДокументовПартии)
	|	И ТИПЗНАЧЕНИЯ(Т.КорПартия) = ТИП(Справочник.ПартииПроизводства)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьЗаписи
	|ИЗ
	|	ВТОтборПартии КАК Т
	|";
	
	ВыбиратьПартииПрошлыхПериодов = Истина;
	
	// Шаг 2.4
	Пока ВыбиратьПартииПрошлыхПериодов Цикл
		
		ПараметрыРасчета.ИтерацийПартииПрошлыхПериодов = ПараметрыРасчета.ИтерацийПартииПрошлыхПериодов + 1;
		Пояснение = НСтр("ru = 'Итерация поиска партий прошлых периодов';
						|en = 'Итерация поиска партий прошлых периодов'", ОбщегоНазначения.КодОсновногоЯзыка()) + ":"
			+ СокрЛП(ПараметрыРасчета.ИтерацийПартииПрошлыхПериодов);
			
		РезультатЗапроса = РасчетСебестоимостиПрикладныеАлгоритмы.ВыполнитьЗапросСЗамеромДляПротокола(ПараметрыРасчета, Запрос,,, Истина, Пояснение);
		ВыбиратьПартииПрошлыхПериодов = НЕ РезультатЗапроса.Пустой();
		
		Запрос.УстановитьПараметр("ПерваяИтерация", Ложь);
		
		РасчетСебестоимостиПрикладныеАлгоритмы.УничтожитьВременныеТаблицы(Запрос,
			"ВТПартииПроизводстваПрошлыхПериодов, ВТПартииПолуфабрикатовПрошлыхПериодовПредварительная,
