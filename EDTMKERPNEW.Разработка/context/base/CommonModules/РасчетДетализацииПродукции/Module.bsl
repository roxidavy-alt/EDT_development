	|		ПО Т.Партия = ВсеПартииПроизводства.ПартияВыпуска
	|		 И Т.АналитикаУчетаПартий = ВсеПартииПроизводства.АналитикаУчетаПартий
	|		 И Т.Номенклатура = ВсеПартииПроизводства.Номенклатура
	|		 И Т.ВидЗапасов = ВсеПартииПроизводства.ВидЗапасов
	|		 И Т.Характеристика = ВсеПартииПроизводства.Характеристика
	|		 И Т.ЭтоОстаток = ВсеПартииПроизводства.ЭтоОстаток
	|ГДЕ
	|	Т.ЭтоПартияПроизводства
	|	И Т.ПартияПроизводства = Т.Партия
	|	И НЕ ЕСТЬNULL(СменаВидаДеятельностиНДС.ЕстьНДС, ЛОЖЬ) // уже есть записи в регистре детализации продукции, в т.ч. есть записи НДС 
	|	И Т.ЭтоОстаток
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Номенклатура,
	|	Т.Характеристика,
	|	Т.ВидЗапасов,
	|	Т.СтатьяКалькуляции,
	|	Т.ПартияПроизводства,
	|	Т.Организация,
	|	Т.ДокументПоступления,
	|	Т.Партия
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	// Выбор данных:
	// БезДетализации И НЕ ЕстьИзменениеВидаДеятельностиНДС - берем только суммы без НДС
	// БезДетализации И ЕстьИзменениеВидаДеятельностиНДС - берем все суммы
	// НЕ БезДетализации И НЕ ЕстьИзменениеВидаДеятельностиНДС - ничего не берем, т.к. детализация уже есть
	// НЕ БезДетализации И ЕстьИзменениеВидаДеятельностиНДС - только суммы НДС
	|ВЫБРАТЬ
	|	&НачалоПериода КАК ПериодРегистрации,
	|	Т.Номенклатура,
	|	Т.Характеристика,
	|	Т.ВидЗапасов,
	|	Т.СтатьяКалькуляции,
	|	Т.Партия,
	|	Т.АналитикаУчетаПартий,
	|	Т.Организация,
	|	Т.ДокументПоступления,
	|	Т.ПартияПроизводства,
	|	Т.Количество,
	|	МАКСИМУМ(Т.НДСВключенВСтоимость) КАК НДСВключенВСтоимость,
	|	Т.ТипЗаписи,
	|	СУММА(ВЫБОР КОГДА Т.БезДетализации ТОГДА Т.СтоимостьРегл ИНАЧЕ 0 КОНЕЦ) КАК СтоимостьРегл,
	|	СУММА(ВЫБОР КОГДА Т.БезДетализации ТОГДА Т.СтоимостьУпр ИНАЧЕ 0 КОНЕЦ) КАК СтоимостьУпр,
	|	СУММА(ВЫБОР КОГДА Т.БезДетализации ТОГДА Т.ПостояннаяРазница ИНАЧЕ 0 КОНЕЦ) КАК ПостояннаяРазница,
	|	СУММА(ВЫБОР КОГДА Т.БезДетализации ТОГДА Т.ВременнаяРазница ИНАЧЕ 0 КОНЕЦ) КАК ВременнаяРазница,
	|	СУММА(ВЫБОР КОГДА Т.ЕстьИзменениеВидаДеятельностиНДС ТОГДА Т.НДСРегл ИНАЧЕ 0 КОНЕЦ) КАК НДСРегл,
	|	СУММА(ВЫБОР КОГДА Т.ЕстьИзменениеВидаДеятельностиНДС ТОГДА Т.НДСУпр ИНАЧЕ 0 КОНЕЦ) КАК НДСУпр
	|ПОМЕСТИТЬ ВТРассчитанныеПартии
	|ИЗ
	|	ВТРассчитанныеПартииПредварительная КАК Т
	|ГДЕ
	|	Т.БезДетализации ИЛИ Т.ЕстьИзменениеВидаДеятельностиНДС
	|СГРУППИРОВАТЬ ПО
	|	Т.Номенклатура,
	|	Т.Характеристика,
	|	Т.ВидЗапасов,
	|	Т.СтатьяКалькуляции,
	|	Т.Партия,
	|	Т.АналитикаУчетаПартий,
	|	Т.Организация,
	|	Т.ДокументПоступления,
	|	Т.ПартияПроизводства,
	|	Т.Количество,
	|	Т.ТипЗаписи
	|ИМЕЮЩИЕ
	|	СУММА(ВЫБОР КОГДА Т.БезДетализации ТОГДА Т.СтоимостьРегл ИНАЧЕ 0 КОНЕЦ) <> 0
	|		ИЛИ СУММА(ВЫБОР КОГДА Т.БезДетализации ТОГДА Т.СтоимостьУпр ИНАЧЕ 0 КОНЕЦ) <> 0
	|		ИЛИ СУММА(ВЫБОР КОГДА Т.БезДетализации ТОГДА Т.ПостояннаяРазница ИНАЧЕ 0 КОНЕЦ) <> 0
	|		ИЛИ СУММА(ВЫБОР КОГДА Т.БезДетализации ТОГДА Т.ВременнаяРазница ИНАЧЕ 0 КОНЕЦ) <> 0
	|		ИЛИ СУММА(ВЫБОР КОГДА Т.ЕстьИзменениеВидаДеятельностиНДС ТОГДА Т.НДСРегл ИНАЧЕ 0 КОНЕЦ) <> 0
	|		ИЛИ СУММА(ВЫБОР КОГДА Т.ЕстьИзменениеВидаДеятельностиНДС ТОГДА Т.НДСУпр ИНАЧЕ 0 КОНЕЦ) <> 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|";
	
	РасчетСебестоимостиПрикладныеАлгоритмы.ВыполнитьЗапросСЗамеромДляПротокола(ПараметрыРасчета, Запрос);
	
	#КонецОбласти
	
	РасчетСебестоимостиПрикладныеАлгоритмы.УничтожитьВременныеТаблицы(Запрос,
		"ВТПартииКРасчету, ВТИзменениеВидаДеятельностиНДС, ВТПартииПроизводстваИзЗатратНаВыпуск, ВТПартииЗатратДляНДС,
		|ВТПартииЗатратПрошлыхПериодов, ВТВсеПартииПроизводства, ВТПартииДетализация, ВТПартииПроизводства,
		|ВТПартииЗатрат, ВТЗатратыНаВыпуск, ВТПолуфабрикатыКРасчету, ВТРассчитанныеПартииПредварительная");
	
	ПараметрыРасчета.ВремяНачалаЗаписи = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЗаписатьСформированныеДвижения(ПараметрыРасчета);

	ПараметрыРасчета.ВремяОкончанияЗаписи = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПараметрыРасчета.ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ДлительностьЗаписи = (ПараметрыРасчета.ВремяОкончанияЗаписи - ПараметрыРасчета.ВремяНачалаЗаписи) / 1000;
	ДлительностьРасчета = (ПараметрыРасчета.ВремяОкончания - ПараметрыРасчета.ВремяНачала) / 1000;
	
	ТекстПротокола = НСтр("ru = 'Протокол выполнения расчета детализации продукции.
		|Начало расчета: %1
		|Длительность расчета: %2, в т.ч. длительность записи движений: %3
		|
		|Выполнение запросов:
		|%4';
		|en = 'Протокол выполнения расчета детализации продукции.
		|Начало расчета: %1
		|Длительность расчета: %2, в т.ч. длительность записи движений: %3
		|
		|Выполнение запросов:
		|%4'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	ТекстПротокола = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстПротокола,
		РасчетСебестоимостиПротоколРасчета.ПредставлениеЗначения(ПараметрыРасчета.ДатаНачала),
		РасчетСебестоимостиПротоколРасчета.ПредставлениеВремени(ДлительностьРасчета),
		РасчетСебестоимостиПротоколРасчета.ПредставлениеВремени(ДлительностьЗаписи),
		ПараметрыРасчета.РезультатВыполненияЗапроса);
	
	ЗаписьЖурналаРегистрации(
		СокрЛП(Справочники.ОперацииЗакрытияМесяца.РасчетДетализацииПродукции) + "." + НСтр("ru = 'Протокол выполнения расчета';
																							|en = 'Протокол выполнения расчета'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,,,
		ТекстПротокола);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиЭтаповЗакрытияМесяца

#Область РасчетДетализацииПродукции

// Добавляет этап в таблицу этапов закрытия месяца.
// Элементы данной таблицы являются элементами второго уровня в дереве этапов в форме закрытия месяца.
// 
// Параметры:
// 	ТаблицаЭтапов - см. Обработки.ОперацииЗакрытияМесяца.ЗаполнитьОписаниеЭтаповЗакрытияМесяца
// 	ТекущийРодитель - Строка - идентификатор группы.
//
Процедура ДобавитьЭтап_РасчетДетализацииПродукции(ТаблицаЭтапов,ТекущийРодитель) Экспорт
	
	НоваяСтрока = ЗакрытиеМесяцаСервер.ДобавитьЭтапВТаблицу(ТаблицаЭтапов, ТекущийРодитель,
		Справочники.ОперацииЗакрытияМесяца.РасчетДетализацииПродукции);
	ПредшествующиеЭтапы = НоваяСтрока.ПредшествующиеЭтапы; // Массив	
	ПредшествующиеЭтапы.Добавить(Справочники.ОперацииЗакрытияМесяца.РасчетПартийИСебестоимости);
	
	НоваяСтрока.МультиязычноеНаименование = "ru = 'Расчет детализации продукции';
											|en = 'Расчет детализации продукции'"; // @НСтр-1
	НоваяСтрока.ТекстВыполнить = НСтр("ru = 'Рассчитать';
										|en = 'Рассчитать'");
	НоваяСтрока.ДействиеИспользование = ЗакрытиеМесяцаСервер.ОписаниеДействия_СервернаяПроцедура(
		"РасчетДетализацииПродукции.Использование_РасчетДетализацииПродукции");
	НоваяСтрока.ДействиеОформление = ЗакрытиеМесяцаСервер.ОписаниеДействия_СервернаяПроцедура(
		"РасчетДетализацииПродукции.Оформление_РасчетДетализацииПродукции");
	НоваяСтрока.ДействиеВыполнить  = ЗакрытиеМесяцаСервер.ОписаниеДействия_ВыполнитьРасчет(
		"РасчетДетализацииПродукции.Выполнить_РасчетДетализацииПродукции");
// ТоДо	
//	НоваяСтрока.ДействиеПодробнее = ЗакрытиеМесяцаСервер.ОписаниеДействия_ОткрытьФорму(
//		Метаданные.РегистрыСведений.ПротоколыРасчетаПартийИСебестоимости.Формы.ФормаПросмотраПротоколов.ПолноеИмя());
//	НоваяСтрока.ДействиеПодробнее.ОткрыватьВместоЖР = Истина;
//	НоваяСтрока.ДействиеПодробнее.НеТребуетсяПриУспешномВыполнении = Истина;
	НоваяСтрока.ВыполняетсяПриПредварительномЗакрытииМесяца = Ложь;
	
КонецПроцедуры

// Обработчики этапа.

Процедура Использование_РасчетДетализацииПродукции(ПараметрыОбработчика) Экспорт
	
	Если ЗакрытиеМесяцаСервер.РасчетЭтапаНеТребуется(ПараметрыОбработчика.ДанныеЭтапа) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыРасчета = ПараметрыОбработчика.ПараметрыРасчета;
	ПериодРасчета    = НачалоМесяца(ПараметрыРасчета.ПериодРегистрации);
	
	МассивОрганизаций = ПараметрыОбработчика.ДанныеЭтапа.МассивОрганизаций;
	ЗакрытиеМесяцаСервер.УвеличитьКоличествоОбработанныхДанныхДляЗамера(ПараметрыОбработчика, МассивОрганизаций.Количество());

	Если НЕ РасчетСебестоимостиПовтИсп.ИспользуетсяДетализацияПродукции(ПериодРасчета) Тогда
		ЗакрытиеМесяцаСервер.УстановитьСостояниеНеТребуется(
			ПараметрыОбработчика,
			НСтр("ru = 'Не ведется учет детализации выпущенной продукции по статьям калькуляции.';
				|en = 'Не ведется учет детализации выпущенной продукции по статьям калькуляции.'"));
		Возврат;
	КонецЕсли;

	// Проверим ведение учета себестоимости - расчет возможен начиная с месяца, предшествующему началу учета (с момента ввода остатков).
	Если НЕ РасчетСебестоимостиПовтИсп.ВозможенРасчетСебестоимости(ПериодРасчета) Тогда
		ЗакрытиеМесяцаСервер.УстановитьСостояниеНеТребуется(
			ПараметрыОбработчика,
			НСтр("ru = 'Нет движений по регистрам себестоимости.';
				|en = 'Нет движений по регистрам себестоимости.'"));
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ЗакрытиеМесяцаСервер.ИнициализироватьЗапрос(Запрос, ПараметрыОбработчика);
	
	СоздатьВременнуюТаблицуОрганизацийДляДетализацииПродукции(Запрос, "ВТОрганизацииДляРасчетаДетализацииПродукции", ПериодРасчета);

	РазмерыВременныхТаблиц = ЗакрытиеМесяцаСервер.РазмерыВременныхТаблиц(Запрос, ПараметрыОбработчика);
	
	Если РазмерыВременныхТаблиц.ВТОрганизацииДляРасчетаДетализацииПродукции = 0 Тогда

		ЗакрытиеМесяцаСервер.УстановитьСостояниеНеТребуется(
			ПараметрыОбработчика,
			НСтр("ru = 'Нет организаций, для которых в учетной политике используется метод оценки ""ФИФО скользящая""';
				|en = 'Нет организаций, для которых в учетной политике используется метод оценки ""ФИФО скользящая""'",
			ОбщегоНазначения.КодОсновногоЯзыка()));
	Иначе
		
		ЗакрытиеМесяцаСервер.ПроверитьНаличиеЗаданийКЗакрытиюМесяца(ПараметрыОбработчика, Истина, "ВТОрганизацииДляРасчетаДетализацииПродукции");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Оформление_РасчетДетализацииПродукции(ПараметрыОбработчика) Экспорт
	
	ПараметрыОбработчика.ДанныеЭтапа.ТекстПодробнее = "";
	
	Если ЗакрытиеМесяцаСервер.ТребуетсяПересчетЭтапа(ПараметрыОбработчика.ДанныеЭтапа) Тогда
		
// ТоДо
//		ПротоколыРасчета = РегистрыСведений.ОшибкиРасчетаПартийИСебестоимости.ПолучитьПротоколыРасчета(
//			ПараметрыОбработчика.ПараметрыРасчета.ПериодРегистрации,
//			ПараметрыОбработчика.ПараметрыРасчета.МассивОрганизаций);
//		
//		ЗакрытиеМесяцаСервер.УвеличитьКоличествоОбработанныхДанныхДляЗамера(ПараметрыОбработчика, ПротоколыРасчета.Количество());
//		
//		Если ЗначениеЗаполнено(ПротоколыРасчета) Тогда
//			ПараметрыОбработчика.ДанныеЭтапа.ТекстПодробнее = ЗакрытиеМесяцаСервер.ТекстПодробнееПоУмолчанию();
//		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура Выполнить_РасчетДетализацииПродукции(ПараметрыОбработчика) Экспорт
	
	ПараметрыРасчета = ПараметрыОбработчика.ПараметрыРасчета;
	ДополнительныеСвойства = ПараметрыОбработчика.ДанныеЭтапа.ДополнительныеСвойства;

	НачалоПериода = ЗакрытиеМесяцаСервер.НачалоРасчета(ПараметрыОбработчика.ДанныеЭтапа.Код,
		ПараметрыРасчета.КонецПериода, , ПараметрыРасчета.МассивОрганизаций);
		
	Если НачалоПериода > ПараметрыРасчета.КонецПериода
	 И (ПараметрыОбработчика.ДанныеЭтапа.Состояние = Перечисления.СостоянияОперацийЗакрытияМесяца.ВыполненоСОшибками
	  ИЛИ ПараметрыОбработчика.ДанныеЭтапа.Состояние = Перечисления.СостоянияОперацийЗакрытияМесяца.НеВыполнено) Тогда
		НачалоПериода = ПараметрыРасчета.НачалоПериода;
	КонецЕсли;
	
	Пока НачалоПериода <= ПараметрыРасчета.КонецПериода Цикл
		
		ОкончаниеПериода = КонецМесяца(НачалоПериода);
		ДоступныеОрганизации = ЗакрытиеМесяцаСервер.ДоступныеДляРасчетаОрганизации(НачалоПериода, ПараметрыРасчета.МассивОрганизаций);
		НомерЗаданияДоРасчета = ЗакрытиеМесяцаСервер.УвеличитьНомерЗадания();
		
		// Этап 1. Подготовка работы с заданиями.

		НачатьТранзакцию();

		Попытка
			ЗакрытиеМесяцаСервер.ЗаблокироватьРегистрЗаданий(НомерЗаданияДоРасчета, ДоступныеОрганизации,
				ПараметрыОбработчика.ДанныеЭтапа.Код);
			ДанныеКРасчетуЗаМесяц = ЗакрытиеМесяцаСервер.ЗаданияКРасчетуЗаМесяц(НачалоПериода, ОкончаниеПериода,
				НомерЗаданияДоРасчета, ДоступныеОрганизации, ПараметрыОбработчика.ДанныеЭтапа.Код);

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();

			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр(
					"ru = 'При выполнении расчета за период %1 произошла ошибка:
					|%2';
					|en = 'An error occurred when calculating for the %1 period:
					|%2'", ОбщегоНазначения.КодОсновногоЯзыка()),
				РасчетСебестоимостиПротоколРасчета.ПредставлениеПериодаРасчета(НачалоПериода),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			ЗакрытиеМесяцаСервер.ЗафиксироватьНаличиеПроблемыПриВыполненииРасчета(ПараметрыОбработчика, ТекстОшибки,
				ДоступныеОрганизации, НачалоПериода);
		КонецПопытки;
		
		// Этап 2. Собственно расчет по организациям и периоду.
		Попытка

			ПараметрыЗапуска = Новый Структура;
			ПараметрыЗапуска.Вставить("НачалоПериода", 				НачалоПериода);
			ПараметрыЗапуска.Вставить("МассивОрганизаций",  	    ДоступныеОрганизации);
			ПараметрыЗапуска.Вставить("МестоВызоваРасчета", 	    "РасчетДетализацииПродукции.Выполнить_РасчетДетализацииПродукции");
			ПараметрыЗапуска.Вставить("ВыполняетсяЗакрытиеМесяца",  Истина);
			ПараметрыЗапуска.Вставить("АвтоматическоеТестирование", ПараметрыОбработчика.АвтоматическоеТестирование);
			ПараметрыЗапуска.Вставить("РежимЗакрытияМесяца",        ПараметрыОбработчика.РежимЗакрытияМесяца);
			ПараметрыЗапуска.Вставить("ИдентификаторРасчета", 		ПараметрыОбработчика.ИдентификаторРасчета);
			ПараметрыЗапуска.Вставить("ТолькоОднаОрганизация",	Ложь);
			
			РассчитатьДетализациюПродукции(ПараметрыЗапуска);
		
		Исключение
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр(
					"ru = 'Расчет детализации продукции по статьям калькуляции за период %1 завершилось с ошибкой:
					|%2';
					|en = 'Расчет детализации продукции по статьям калькуляции за период %1 завершилось с ошибкой:
					|%2'", ОбщегоНазначения.КодОсновногоЯзыка()),
				РасчетСебестоимостиПротоколРасчета.ПредставлениеПериодаРасчета(НачалоПериода),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			ЗакрытиеМесяцаСервер.ЗафиксироватьНаличиеПроблемыПриВыполненииРасчета(ПараметрыОбработчика, ТекстОшибки,
				ДанныеКРасчетуЗаМесяц.Организация, НачалоПериода);
		КонецПопытки;
		
		// Этап 3. Завершение работы с заданиями.

		ЗакрытиеМесяцаСервер.УдалитьЗаданияКРасчетуЗаТекущийПериод(ПараметрыОбработчика, ДанныеКРасчетуЗаМесяц);

		НачалоПериода = ОкончаниеПериода + 1;
		
	КонецЦикла;
	
КонецПроцедуры

