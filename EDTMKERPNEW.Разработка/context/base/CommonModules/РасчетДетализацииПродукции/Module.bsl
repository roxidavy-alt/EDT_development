Процедура СформироватьДетализациюПродукции(МенеджерВременныхТаблиц, ИмяТаблицыОтбора, ИмяПоляОтбора, ИмяТаблицыДетализации = "ВТПартииПродукцииСоСтатьямиКалькуляции") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	МетаПартии = Метаданные.РегистрыСведений.ДетализацияСебестоимостиПартийПродукции.Измерения.Партия;
	ТипыДокументовПартии = Новый Массив;
	
	Для Каждого ТипПартии Из МетаПартии.Тип.Типы() Цикл
		ТипыДокументовПартии.Добавить(ТипПартии);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ТипыДокументовПартии", ТипыДокументовПартии);
	
	СуществующиеВТ = РасчетСебестоимостиПрикладныеАлгоритмы.ПолучитьПереченьСуществующихВременныхТаблиц(Запрос);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ИмяПоляОтбора КАК Регистратор
	|ПОМЕСТИТЬ ВТОтборРегистраторы
	|ИЗ
	|	ИмяТаблицыОтбора КАК Т
	|ИНДЕКСИРОВАТЬ ПО
	|	Регистратор
	|";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяПоляОтбора", ИмяПоляОтбора);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяТаблицыОтбора", ИмяТаблицыОтбора);

	Запрос.Текст = 	Запрос.Текст + "
	|
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|" + "
	|ВЫБРАТЬ
	|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи,
