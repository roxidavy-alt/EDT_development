Функция ИнициализироватьПараметрыРасчета(ПараметрыЗапуска)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("ДатаНачала", ТекущаяДатаСеанса());
	ПараметрыРасчета.Вставить("ВремяНачала", ТекущаяУниверсальнаяДатаВМиллисекундах());
	ПараметрыРасчета.Вставить("ВремяОкончания", Неопределено);
	ПараметрыРасчета.Вставить("ВремяНачалаЗаписи", Неопределено);
	ПараметрыРасчета.Вставить("ВремяОкончанияЗаписи", Неопределено);
	
	ПараметрыРасчета.Вставить("ИтерацийПартииПрошлыхПериодов", 0);
	ПараметрыРасчета.Вставить("ИтерацийИзменениеВидаДеятельностиНДС", 0);
	ПараметрыРасчета.Вставить("ИтерацийПартииДетализация", 0);
	
	ПараметрыРасчета.Вставить("МассивОрганизаций", ПараметрыЗапуска.МассивОрганизаций);
	ПараметрыРасчета.Вставить("НачалоПериода", НачалоМесяца(ПараметрыЗапуска.НачалоПериода));
	ПараметрыРасчета.Вставить("КонецПериода", КонецМесяца(ПараметрыЗапуска.НачалоПериода));
	ПараметрыРасчета.Вставить("МестоВызоваРасчета", ПараметрыЗапуска.МестоВызоваРасчета);
	ПараметрыРасчета.Вставить("РежимЗакрытияМесяца", ПараметрыЗапуска.РежимЗакрытияМесяца);
	ПараметрыРасчета.Вставить("ИдентификаторРасчета", ПараметрыЗапуска.ИдентификаторРасчета);
	ПараметрыРасчета.Вставить("АвтоматическоеТестирование", ПараметрыЗапуска.АвтоматическоеТестирование);
	ПараметрыРасчета.Вставить("ВыполняетсяЗакрытиеМесяца", ПараметрыЗапуска.ВыполняетсяЗакрытиеМесяца);
	ПараметрыРасчета.Вставить("РезультатВыполненияЗапроса", "");
	
	ПараметрыРасчета.Вставить("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц);
	
	// Типы налогообложения НДС
	ПараметрыРасчета.Вставить("ТипыНалогообложенияНДСНеУчитываетсяВСтоимости",
		УчетНДСУП.ТипыНалогообложенияНДСНеУчитываетсяВСтоимости());
	ПараметрыРасчета.Вставить("ТипыНалогообложенияНДСУчитываетсяВСтоимости",
		УчетНДСУП.ВидыДеятельностиНДСУчитываетсяВСтоимости());
	
	// Типы партий
	МетаПартии = Метаданные.РегистрыСведений.ДетализацияСебестоимостиПартийПродукции.Измерения.Партия;
	ТипыДокументовПартии = Новый Массив;
	
	Для Каждого ТипПартии Из МетаПартии.Тип.Типы() Цикл
		
		Если Метаданные.Документы.Содержит(Метаданные.НайтиПоТипу(ТипПартии)) Тогда
			ТипыДокументовПартии.Добавить(ТипПартии);
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыРасчета.Вставить("ТипыДокументовПартии", ТипыДокументовПартии);
	
	Возврат ПараметрыРасчета;
	
КонецФункции

Процедура ИнициализироватьПараметрыЗапроса(ПараметрыРасчета, Запрос)
	
	Запрос.МенеджерВременныхТаблиц = ПараметрыРасчета.МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("МассивОрганизаций", ПараметрыРасчета.МассивОрганизаций);
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыРасчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыРасчета.КонецПериода);
	Запрос.УстановитьПараметр("ГраницаКонецПредыдущегоПериода", Новый Граница(ПараметрыРасчета.НачалоПериода-1, ВидГраницы.Включая));
	
	Запрос.УстановитьПараметр("ТипыНалогообложенияНДСНеУчитываетсяВСтоимости",
		ПараметрыРасчета.ТипыНалогообложенияНДСНеУчитываетсяВСтоимости);
	Запрос.УстановитьПараметр("ТипыНалогообложенияНДСУчитываетсяВСтоимости",
		ПараметрыРасчета.ТипыНалогообложенияНДСУчитываетсяВСтоимости);
	
	Запрос.УстановитьПараметр("ТипыДокументовПартии", ПараметрыРасчета.ТипыДокументовПартии);
	
КонецПроцедуры

Функция СоздатьВременнуюТаблицуОрганизацийДляДетализацииПродукции(Запрос, ИмяВременнойТаблицы, ПериодРасчета) Экспорт

	Запрос.УстановитьПараметр("ОтборОрганизации", РасчетСебестоимостиПовтИсп.ОрганизацииСМетодомОценкиФИФО(ПериодРасчета));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ИмяВременнойТаблицы
	|ИЗ
	|	Справочник.Организации КАК Т
	|ГДЕ
	|	Т.Ссылка В(&МассивОрганизаций)
	|	И Т.Ссылка В(&ОтборОрганизации)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяВременнойТаблицы", ИмяВременнойТаблицы);
	
	Запрос.Выполнить();
	
КонецФункции

Процедура ЗаписатьСформированныеДвижения(ПараметрыРасчета)

	Запрос = Новый Запрос;
	ИнициализироватьПараметрыЗапроса(ПараметрыРасчета, Запрос);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЛОЖЬ КАК ЕстьСформированныеЗаписи,
	|	Т.Партия КАК Партия,
	|	Т.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	Т.Организация КАК Организация,
