	|	Т.ПериодРегистрации КАК ПериодРегистрации,
	|	Т.ДокументПоступления КАК ДокументПоступления,
	|	Т.ТипЗаписи,
	|	Т.ПартияПроизводства,
	|	Т.НДСВключенВСтоимость,
	|	Т.Количество КАК Количество,
	|	Т.СтоимостьРегл,
	|	Т.НДСРегл,
	|	Т.СтоимостьУпр,
	|	Т.НДСУпр,
	|	Т.ПостояннаяРазница,
	|	Т.ВременнаяРазница
	|ПОМЕСТИТЬ ВТВсеЗаписи
	|ИЗ
	|	РегистрСведений.ДетализацияСебестоимостиПартийПродукции КАК Т
	|ГДЕ
	|	Т.Организация В (&МассивОрганизаций)
	|	И Т.ПериодРегистрации = &НачалоПериода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ИСТИНА КАК ЕстьСформированныеЗаписи,
	|	Т.Партия КАК Партия,
	|	Т.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	Т.Организация КАК Организация,
	|	Т.ВидЗапасов КАК ВидЗапасов,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.СтатьяКалькуляции КАК СтатьяКалькуляции,
	|	Т.ПериодРегистрации КАК ПериодРегистрации,
	|	Т.ДокументПоступления КАК ДокументПоступления,
	|	Т.ТипЗаписи,
	|	Т.ПартияПроизводства,
	|	Т.НДСВключенВСтоимость,
	|	-Т.Количество КАК Количество,
	|	-Т.СтоимостьРегл,
	|	-Т.НДСРегл,
	|	-Т.СтоимостьУпр,
	|	-Т.НДСУпр,
	|	-Т.ПостояннаяРазница,
	|	-Т.ВременнаяРазница
	|ИЗ
	|	ВТРассчитанныеПартии КАК Т
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия,
	|	АналитикаУчетаПартий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МАКСИМУМ(Т.ЕстьСформированныеЗаписи) КАК ЕстьСформированныеЗаписи,
	|	Т.Партия КАК Партия
	|ПОМЕСТИТЬ ВТИзмененныеПартии
	|ИЗ
	|	ВТВсеЗаписи КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.Партия,
	|	Т.АналитикаУчетаПартий,
	|	Т.Организация,
	|	Т.ВидЗапасов,
	|	Т.Номенклатура,
	|	Т.Характеристика,
	|	Т.СтатьяКалькуляции,
	|	Т.ПериодРегистрации,
	|	Т.ДокументПоступления,
	|	Т.ТипЗаписи,
	|	Т.ПартияПроизводства,
	|	Т.НДСВключенВСтоимость
	|ИМЕЮЩИЕ
	|	СУММА(Т.Количество) <> 0
	|		ИЛИ СУММА(Т.СтоимостьРегл) <> 0
	|		ИЛИ СУММА(Т.НДСРегл) <> 0
	|		ИЛИ СУММА(Т.СтоимостьУпр) <> 0
	|		ИЛИ СУММА(Т.НДСУпр) <> 0
	|		ИЛИ СУММА(Т.ПостояннаяРазница) <> 0
	|		ИЛИ СУММА(Т.ВременнаяРазница) <> 0
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Партии.ЕстьСформированныеЗаписи,
	|	Партии.Партия КАК Партия,
	|	РассчитанныеПартии.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	РассчитанныеПартии.Организация КАК Организация,
	|	РассчитанныеПартии.ВидЗапасов КАК ВидЗапасов,
	|	РассчитанныеПартии.Номенклатура КАК Номенклатура,
	|	РассчитанныеПартии.Характеристика КАК Характеристика,
	|	РассчитанныеПартии.СтатьяКалькуляции КАК СтатьяКалькуляции,
	|	РассчитанныеПартии.ПериодРегистрации КАК ПериодРегистрации,
	|	РассчитанныеПартии.ДокументПоступления КАК ДокументПоступления,
	|	РассчитанныеПартии.ТипЗаписи,
	|	РассчитанныеПартии.ПартияПроизводства,
	|	РассчитанныеПартии.НДСВключенВСтоимость,
	|	РассчитанныеПартии.Количество КАК Количество,
	|	РассчитанныеПартии.СтоимостьРегл,
	|	РассчитанныеПартии.НДСРегл,
	|	РассчитанныеПартии.СтоимостьУпр,
	|	РассчитанныеПартии.НДСУпр,
	|	РассчитанныеПартии.ПостояннаяРазница,
	|	РассчитанныеПартии.ВременнаяРазница
	|ПОМЕСТИТЬ ДанныеДляЗаписи
	|ИЗ
	|	ВТИзмененныеПартии КАК Партии
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТРассчитанныеПартии КАК РассчитанныеПартии
	|		ПО Партии.Партия = РассчитанныеПартии.Партия
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Партия,
	|	Т.ЕстьСформированныеЗаписи
	|ИЗ
	|	ВТИзмененныеПартии КАК Т
	|";
	
	РезультатЗапроса = РасчетСебестоимостиПрикладныеАлгоритмы.ВыполнитьЗапросСЗамеромДляПротокола(ПараметрыРасчета, Запрос,,, Истина);
	Выборка = РезультатЗапроса.Выбрать();
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Партия КАК Партия,
	|	Т.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
	|	Т.Организация КАК Организация,
	|	Т.ВидЗапасов КАК ВидЗапасов,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.СтатьяКалькуляции КАК СтатьяКалькуляции,
	|	Т.ПериодРегистрации КАК ПериодРегистрации,
	|	Т.ДокументПоступления КАК ДокументПоступления,
	|	Т.ТипЗаписи,
	|	Т.ПартияПроизводства,
	|	Т.НДСВключенВСтоимость,
	|	Т.Количество КАК Количество,
	|	Т.СтоимостьРегл,
	|	Т.НДСРегл,
	|	Т.СтоимостьУпр,
	|	Т.НДСУпр,
	|	Т.ПостояннаяРазница,
	|	Т.ВременнаяРазница
	|ИЗ
	|	ДанныеДляЗаписи КАК Т
	|ГДЕ
	|	Т.Партия = &ТекущаяПартия
	|";
	
	Пока Выборка.Следующий() Цикл
		
		ТекущаяПартия = Выборка.Партия;
		
		НаборЗаписей = РегистрыСведений.ДетализацияСебестоимостиПартийПродукции.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Партия.Установить(ТекущаяПартия);
		НаборЗаписей.Отбор.ПериодРегистрации.Установить(ПараметрыРасчета.НачалоПериода);
		
		НаборЗаписей.Заполнить(Неопределено);
		
		Если Выборка.ЕстьСформированныеЗаписи Тогда
			
			// Если нет сформированных записей, значит данные по этой партии надо удалить из регистра
			Запрос.УстановитьПараметр("ТекущаяПартия", ТекущаяПартия);

			НаборЗаписей.Загрузить(Запрос.Выполнить().Выгрузить());
			
		КонецЕсли;
		
		НаборЗаписей.Записать(Истина);
		НаборЗаписей = Неопределено;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
