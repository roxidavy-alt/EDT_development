		Раздел2ДанныеМнЧ.П00021М1.Строки.Очистить();
		НоваяСтрока = Раздел2ДанныеМнЧ.П00021М1.Строки.Добавить();
		НоваяСтрока.Данные = Подраздел21Данные;
		НоваяСтрока.ДанныеМногострочныхЧастей = Новый Структура;
		
		Раздел2ДанныеМнЧ.П00024М1.Строки.Очистить();
		НоваяСтрока = Раздел2ДанныеМнЧ.П00024М1.Строки.Добавить();
		НоваяСтрока.Данные = Подраздел24Данные;
		НоваяСтрока.ДанныеМногострочныхЧастей = Новый Структура;
		
		Раздел2Страница.ДанныеМногострочныхЧастей = Раздел2ДанныеМнЧ;
		
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(Контейнер, ПараметрыОтчета.АдресВоВременномХранилище);
	
КонецПроцедуры

