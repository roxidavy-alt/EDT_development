			Запрос.Выполнить();
			
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МАКСИМУМ(ПараметрыНачисленияНалогаНаИмуществоСрезПоследних.Период) КАК Период,
