	ИтоговыйНомерСтраницы = "Раздел31";
	Если КоординатыСтраницыРаздела.Количество() > 0 Тогда
		ИтоговыйНомерСтраницы = СтрШаблон("%1_%2", ИтоговыйНомерСтраницы, Формат(КоординатыСтраницыРаздела[0], "ЧН=0; ЧГ="));
