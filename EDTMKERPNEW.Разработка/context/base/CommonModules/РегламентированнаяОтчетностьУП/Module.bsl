		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КлиентыКонтрагенты
		|		ПО РеализацияТоваровУслуг.КлиентКонтрагент = КлиентыКонтрагенты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО РеализацияТоваровУслуг.Организация = Организации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|		ПО РеализацияТоваровУслуг.Валюта = Валюты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО РеализацияТоваровУслуг.Договор = ДоговорыКонтрагентов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК КлиентДоговоры
		|		ПО РеализацияТоваровУслуг.КлиентДоговор = КлиентДоговоры.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
		|		ПО РеализацияТоваровУслуг.СтранаРеализации = СтраныМира.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка В (&МассивДокументов)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СтранаРегистрацииКонтрагента";
		
	ИначеЕсли ИмяДокумента = "ОтгрузкаТоваровКлиенту" Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ОтгрузкаТоваровКлиенту.Ссылка КАК ДокументСсылка,
		|	ОтгрузкаТоваровКлиенту.Дата КАК Дата,
		|	ОтгрузкаТоваровКлиенту.Номер КАК Номер,
		|	ЕСТЬNULL(Организации.НаименованиеПолное, """") КАК ОтправительНаименование,
		|	ОтгрузкаТоваровКлиенту.Валюта КАК ВалютаДокумента,
		|	ЕСТЬNULL(Валюты.Наименование, """") КАК ВалютаТовараКод,
		|	ОтгрузкаТоваровКлиенту.Организация КАК Организация,
		|	ЕСТЬNULL(Организации.ОбособленноеПодразделение, """") КАК ОбособленноеПодразделение,
		|	ЕСТЬNULL(Организации.ЮридическоеФизическоеЛицо, """") КАК ОтправительЮридическоеФизическоеЛицо,
		|	ЕСТЬNULL(Организации.ИндивидуальныйПредприниматель, """") КАК ИндивидуальныйПредприниматель,
		|	ЕСТЬNULL(Организации.ЮрФизЛицо, """") КАК ЮрФизЛицо,
		|	ЕСТЬNULL(Организации.ИндивидуальныйПредприниматель.Фамилия, """") КАК ФамилияИП,
		|	ЕСТЬNULL(Организации.ИндивидуальныйПредприниматель.Имя, """") КАК ИмяИП,
		|	ЕСТЬNULL(Организации.ИндивидуальныйПредприниматель.Отчество, """") КАК ОтчествоИП,
		|	ЕСТЬNULL(Организации.НаименованиеОКОПФ, """") КАК Отправитель_ФормаСобственности,
		|	ЕСТЬNULL(Организации.РегистрацияВНалоговомОргане, """") КАК РегистрацияВНалоговомОргане,
		|	ЕСТЬNULL(Организации.ИНН, """") КАК ОтправительРФ_ИНН,
		|	ЕСТЬNULL(Организации.КПП, """") КАК ОтправительРФ_КПП,
		|	ЕСТЬNULL(Организации.ОГРН, """") КАК ОтправительРФ_ОГРН,
		|	ЕСТЬNULL(ДоговорыКонтрагентов.Номер, """") КАК НомерДоговора,
		|	ЕСТЬNULL(ДоговорыКонтрагентов.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДоговора,
		|	ЕСТЬNULL(ДоговорыКонтрагентов.УникальныйНомерВалютногоКонтроля, """") <> """" КАК ЕстьУникальныйНомерВалютногоКонтроля,
		|	ЕСТЬNULL(ДоговорыКонтрагентов.УникальныйНомерВалютногоКонтроля, """") КАК УникальныйНомерВалютногоКонтроля,
		|	ЕСТЬNULL(ДоговорыКонтрагентов.ДатаПостановкиНаВалютныйКонтроль, ДАТАВРЕМЯ(1, 1, 1)) КАК
		|		ДатаПостановкиНаВалютныйКонтроль,
		|	ЕСТЬNULL(СтраныМира.Наименование, """") КАК НаименованиеСтраныРеализации,
		|	ЕСТЬNULL(СтраныМира.КодАльфа2, """") КАК КодАльфа2СтраныРеализации,
		|	ВЫБОР
		|		КОГДА
		|			ОтгрузкаТоваровКлиенту.НалогообложениеНДС = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДСВСтранеЕАЭС)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПродажаФизлицуЧерезЭлектроннуюТорговуюПлощадку,
		|	ОтгрузкаТоваровКлиенту.Контрагент КАК Контрагент,
		|	ЕСТЬNULL(Контрагенты.ИНН, """") КАК ПокупательИНН,
		|	ЕСТЬNULL(Контрагенты.КПП, """") КАК ПокупательКПП,
		|	ЕСТЬNULL(Контрагенты.ЮридическоеФизическоеЛицо, """") КАК ПолучательЮридическоеФизическоеЛицо,
		|	ЕСТЬNULL(Контрагенты.НалоговыйНомер, """") КАК НалоговыйНомер,
		|	ЕСТЬNULL(Контрагенты.СтранаРегистрации, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК СтранаРегистрацииКонтрагента,
		|	ЛОЖЬ КАК ЕстьКлиентДоговор,
		|	"""" КАК НомерКлиентДоговора,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаКлиентДоговора,
		|	ЛОЖЬ КАК ЕстьУникальныйНомерВалютногоКонтроляКлиентДоговора,
		|	"""" КАК УникальныйНомерВалютногоКонтроляКлиентДоговора,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПостановкиНаВалютныйКонтрольКлиентДоговора
		|ПОМЕСТИТЬ РеквизитыОтгрузки
		|ИЗ
		|	Документ.ОтгрузкаТоваровКлиенту КАК ОтгрузкаТоваровКлиенту
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО ОтгрузкаТоваровКлиенту.Контрагент = Контрагенты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО ОтгрузкаТоваровКлиенту.Организация = Организации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|		ПО ОтгрузкаТоваровКлиенту.Валюта = Валюты.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ПО ОтгрузкаТоваровКлиенту.Договор = ДоговорыКонтрагентов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
		|		ПО ОтгрузкаТоваровКлиенту.СтранаРеализации = СтраныМира.Ссылка
		|ГДЕ
		|	ОтгрузкаТоваровКлиенту.Ссылка В (&МассивДокументов)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СтранаРегистрацииКонтрагента";
		
	Иначе
		
		Возврат ТекстЗапроса;
		
	КонецЕсли;
	
	МассивЗапросов.Добавить(ТекстЗапроса);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РеквизитыОтгрузки.ДокументСсылка КАК ДокументСсылка,
	|	РеквизитыОтгрузки.Дата КАК Дата,
	|	РеквизитыОтгрузки.Номер КАК Номер,
	|	РеквизитыОтгрузки.ОтправительНаименование КАК ОтправительНаименование,
	|	РеквизитыОтгрузки.ВалютаДокумента КАК ВалютаДокумента,
	|	РеквизитыОтгрузки.ВалютаТовараКод КАК ВалютаТовараКод,
	|	РеквизитыОтгрузки.ВалютаТовараКод КАК КодВалютыЦеныТовара,
	|	РеквизитыОтгрузки.Организация КАК Организация,
	|	РеквизитыОтгрузки.ОбособленноеПодразделение КАК ОбособленноеПодразделение,
	|	РеквизитыОтгрузки.ОтправительЮридическоеФизическоеЛицо КАК ОтправительЮридическоеФизическоеЛицо,
	|	РеквизитыОтгрузки.ИндивидуальныйПредприниматель КАК ИндивидуальныйПредприниматель,
	|	РеквизитыОтгрузки.ЮрФизЛицо КАК ЮрФизЛицо,
	|	РеквизитыОтгрузки.ФамилияИП КАК ФамилияИП,
	|	РеквизитыОтгрузки.ИмяИП КАК ИмяИП,
	|	РеквизитыОтгрузки.ОтчествоИП КАК ОтчествоИП,
	|	РеквизитыОтгрузки.Отправитель_ФормаСобственности КАК Отправитель_ФормаСобственности,
	|	РеквизитыОтгрузки.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	РеквизитыОтгрузки.ОтправительРФ_ИНН КАК ОтправительКоды,
	|	РеквизитыОтгрузки.ОтправительРФ_ИНН КАК ОтправительРФ_ИНН,
	|	РеквизитыОтгрузки.ОтправительРФ_КПП КАК ОтправительРФ_КПП,
	|	РеквизитыОтгрузки.ОтправительРФ_ОГРН КАК ОтправительРФ_ОГРН,
	|	РеквизитыОтгрузки.Контрагент КАК Контрагент,
	|	РеквизитыОтгрузки.ПокупательИНН КАК ПокупательИНН,
	|	РеквизитыОтгрузки.ПокупательКПП КАК ПокупательКПП,
	|	РеквизитыОтгрузки.ПолучательЮридическоеФизическоеЛицо КАК ПолучательЮридическоеФизическоеЛицо,
	|	РеквизитыОтгрузки.НалоговыйНомер КАК НалоговыйНомер,
	|	ЕСТЬNULL(СтраныМира.КодАльфа2, """") КАК ТоргующаяСтранаКод,
	|	ЕСТЬNULL(СтраныМира.Наименование, """") КАК ТоргующаяСтранаНаименование,
	|	РеквизитыОтгрузки.НомерДоговора КАК НомерДоговора,
	|	РеквизитыОтгрузки.ДатаДоговора КАК ДатаДоговора,
	|	РеквизитыОтгрузки.ЕстьУникальныйНомерВалютногоКонтроля КАК ЕстьУникальныйНомерВалютногоКонтроля,
	|	РеквизитыОтгрузки.УникальныйНомерВалютногоКонтроля КАК УникальныйНомерВалютногоКонтроля,
	|	РеквизитыОтгрузки.ДатаПостановкиНаВалютныйКонтроль КАК ДатаПостановкиНаВалютныйКонтроль,
	|	РеквизитыОтгрузки.ЕстьКлиентДоговор КАК ЕстьКлиентДоговор,
	|	РеквизитыОтгрузки.НомерКлиентДоговора КАК НомерКлиентДоговора,
	|	РеквизитыОтгрузки.ДатаКлиентДоговора КАК ДатаКлиентДоговора,
	|	РеквизитыОтгрузки.ЕстьУникальныйНомерВалютногоКонтроляКлиентДоговора КАК
	|		ЕстьУникальныйНомерВалютногоКонтроляКлиентДоговора,
	|	РеквизитыОтгрузки.УникальныйНомерВалютногоКонтроляКлиентДоговора КАК УникальныйНомерВалютногоКонтроляКлиентДоговора,
	|	РеквизитыОтгрузки.ДатаПостановкиНаВалютныйКонтрольКлиентДоговора КАК ДатаПостановкиНаВалютныйКонтрольКлиентДоговора,
	|	РеквизитыОтгрузки.ПродажаФизлицуЧерезЭлектроннуюТорговуюПлощадку КАК ПродажаФизлицуЧерезЭлектроннуюТорговуюПлощадку,
	|	ВЫБОР
	|		КОГДА РеквизитыОтгрузки.НаименованиеСтраныРеализации <> """"
	|			ТОГДА РеквизитыОтгрузки.НаименованиеСтраныРеализации
	|		ИНАЧЕ ЕСТЬNULL(СтраныМира.Наименование, """")
	|	КОНЕЦ КАК СтранаНазначенияНаименование,
	|	РеквизитыОтгрузки.КодАльфа2СтраныРеализации КАК КодАльфа2СтраныРеализации,
	|	ВЫБОР
	|		КОГДА РеквизитыОтгрузки.КодАльфа2СтраныРеализации <> """"
	|			ТОГДА РеквизитыОтгрузки.КодАльфа2СтраныРеализации
	|		ИНАЧЕ ЕСТЬNULL(СтраныМира.КодАльфа2, """")
	|	КОНЕЦ КАК СтранаНазначенияКод,
	|	ВЫБОР
	|		КОГДА РеквизитыОтгрузки.КодАльфа2СтраныРеализации = ""KZ""
	|			ТОГДА ""РК""
	|		КОГДА РеквизитыОтгрузки.КодАльфа2СтраныРеализации = ""BY""
	|			ТОГДА ""РБ""
	|		КОГДА РеквизитыОтгрузки.КодАльфа2СтраныРеализации = ""AM""
	|			ТОГДА ""АМ""
	|		КОГДА РеквизитыОтгрузки.КодАльфа2СтраныРеализации = ""KG""
	|			ТОГДА ""КГ""
	|		КОГДА РеквизитыОтгрузки.КодАльфа2СтраныРеализации = """"
	|		И ЕСТЬNULL(СтраныМира.КодАльфа2, """") = ""KZ""
	|			ТОГДА ""РК""
	|		КОГДА РеквизитыОтгрузки.КодАльфа2СтраныРеализации = """"
	|		И ЕСТЬNULL(СтраныМира.КодАльфа2, """") = ""BY""
	|			ТОГДА ""РБ""
	|		КОГДА РеквизитыОтгрузки.КодАльфа2СтраныРеализации = """"
	|		И ЕСТЬNULL(СтраныМира.КодАльфа2, """") = ""AM""
	|			ТОГДА ""АМ""
	|		КОГДА РеквизитыОтгрузки.КодАльфа2СтраныРеализации = ""KG""
	|			ТОГДА ""КГ""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК СтранаНазначения,
	|	НЕОПРЕДЕЛЕНО КАК ОтправительРеквизиты,
	|	НЕОПРЕДЕЛЕНО КАК ПолучательКоды,
	|	НЕОПРЕДЕЛЕНО КАК ПолучательРеквизиты,
	|	""РФ"" КАК СтранаОтправления,
	|	""RU"" КАК СтранаОтправленияКод,
	|	""РОССИЯ"" КАК СтранаОтправленияНаименование,
	|	НЕОПРЕДЕЛЕНО КАК ВидТранспортаКод,
	|	НЕОПРЕДЕЛЕНО КАК ВидТранспортаНаименование,
	|	НЕОПРЕДЕЛЕНО КАК ОтвЛицоФинУрКоды,
	|	НЕОПРЕДЕЛЕНО КАК ОтвЛицоФинУрРеквизиты,
	|	""ЭК"" КАК НаправлениеПеремещения,
	|	""ЭК"" КАК НапрПеремещения,
	|	"""" КАК Получатель_ФормаСобственности,
	|	НЕОПРЕДЕЛЕНО КАК ОргПочтовыйАдресСоответствие
	|ИЗ
	|	РеквизитыОтгрузки КАК РеквизитыОтгрузки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|		ПО РеквизитыОтгрузки.СтранаРегистрацииКонтрагента = СтраныМира.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ РеквизитыОтгрузки";
	
	МассивЗапросов.Добавить(ТекстЗапроса);
	ТекстЗапроса = СтрСоединить(МассивЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТоварыСтатформаЭкспорт(ИмяДокумента)
	
	// Упорядочивание итоговой выборки запроса происходит по реквизиту Номенклатура, т.к. упорядочивание по минимальному
	// номеру строки по аналогии с импортом товаров на основании заявления о ввозе приводит к задвоению выборки данных 
	// из регистров. Для экспортных документов суммы по товарам хранятся суммарно по видам запасов.
	
	МассивЗапросов = Новый Массив; // Массив из Строка
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	РеализацияТоваровУслугТовары.Ссылка КАК ДокументСсылка,
	|	РеализацияТоваровУслугТовары.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	ЕСТЬNULL(РеализацияТоваровУслугВидыЗапасов.НомерГТД, ЗНАЧЕНИЕ(Справочник.НомераГТД.ПустаяСсылка)) КАК НомерГТД
	|ПОМЕСТИТЬ НоменклатураДляФильтра
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО РеализацияТоваровУслугТовары.Ссылка = РеализацияТоваровУслуг.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.ВидыЗапасов КАК РеализацияТоваровУслугВидыЗапасов
	|		ПО РеализацияТоваровУслугТовары.Ссылка = РеализацияТоваровУслугВидыЗапасов.Ссылка
	|			И РеализацияТоваровУслугТовары.АналитикаУчетаНоменклатуры = РеализацияТоваровУслугВидыЗапасов.АналитикаУчетаНоменклатуры
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка В(&МассивДокументов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура";
	
	Если ИмяДокумента = "ОтгрузкаТоваровКлиенту" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РеализацияТоваровУслуг", ИмяДокумента);
	КонецЕсли;
	
	МассивЗапросов.Добавить(ТекстЗапроса);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(НоменклатураТоваров.КодТНВЭД, ЗНАЧЕНИЕ(Справочник.КлассификаторТНВЭД.ПустаяСсылка)) КАК КодТНВЭД,
	|	ЕСТЬNULL(НоменклатураТоваров.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК ЕдиницаХранения,
	|	НоменклатураДляФильтра.ДокументСсылка КАК ДокументСсылка,
	|	НоменклатураДляФильтра.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	НоменклатураДляФильтра.Номенклатура КАК Номенклатура,
	|	НоменклатураДляФильтра.НомерГТД КАК НомерГТД,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(НоменклатураТоваров.НаименованиеПолное, """") = """"
	|			ТОГДА ЕСТЬNULL(НоменклатураТоваров.Наименование, """")
	|		ИНАЧЕ ЕСТЬNULL(НоменклатураТоваров.НаименованиеПолное, """")
	|	КОНЕЦ КАК НаименованиеТовара,
	|	ЕСТЬNULL(НоменклатураТоваров.ПрослеживаемыйТовар, ЛОЖЬ) КАК ПрослеживаемыйТовар,
	|	ЕСТЬNULL(НоменклатураТоваров.ПроизводительИмпортерКонтрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Производитель,
	|	ЕСТЬNULL(НоменклатураТоваров.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК СтранаПроисхожденияИзНоменклатуры
	|ПОМЕСТИТЬ НоменклатураТНВЭД
	|ИЗ
	|	НоменклатураДляФильтра КАК НоменклатураДляФильтра
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураТоваров
	|		ПО НоменклатураДляФильтра.Номенклатура = НоменклатураТоваров.Ссылка
	|ГДЕ
	|	ЕСТЬNULL(НоменклатураТоваров.ТипНоменклатуры, ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КодТНВЭД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|
	|УНИЧТОЖИТЬ НоменклатураДляФильтра
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НоменклатураТНВЭД.НомерГТД КАК НомерГТД,
	|	НоменклатураТНВЭД.ДокументСсылка КАК ДокументСсылка,
	|	НоменклатураТНВЭД.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	НоменклатураТНВЭД.Номенклатура КАК Номенклатура,
	|	НоменклатураТНВЭД.ЕдиницаХранения КАК ЕдиницаХранения,
	|	НоменклатураТНВЭД.НаименованиеТовара КАК НаименованиеТовара,
	|	НоменклатураТНВЭД.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	НоменклатураТНВЭД.Производитель КАК Производитель,
	|	НоменклатураТНВЭД.СтранаПроисхожденияИзНоменклатуры КАК СтранаПроисхожденияИзНоменклатуры,
	|	ЕСТЬNULL(КлассификаторТНВЭД.Код, """") КАК КодТовара,
	|	ЕСТЬNULL(КлассификаторТНВЭД.ЕдиницаИзмерения, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК ЕдиницаИзмеренияТНВЭД
	|ПОМЕСТИТЬ НоменклатураНомерГТД
	|ИЗ
	|	НоменклатураТНВЭД КАК НоменклатураТНВЭД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|		ПО НоменклатураТНВЭД.КодТНВЭД = КлассификаторТНВЭД.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерГТД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ НоменклатураТНВЭД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НоменклатураНомерГТД.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	НоменклатураНомерГТД.ДокументСсылка КАК ДокументСсылка,
	|	НоменклатураНомерГТД.Номенклатура КАК Номенклатура,
	|	НоменклатураНомерГТД.НаименованиеТовара КАК НаименованиеТовара,
	|	НоменклатураНомерГТД.Производитель КАК Производитель,
	|	НоменклатураНомерГТД.КодТовара КАК КодТовара,
	|	ЕСТЬNULL(НомераГТД.СтранаПроисхождения, НоменклатураНомерГТД.СтранаПроисхожденияИзНоменклатуры) КАК СтранаПроисхождения,
	|	НоменклатураНомерГТД.НомерГТД КАК НомерГТД,
	|	ЕСТЬNULL(НомераГТД.ТипНомераГТД, ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.ПустаяСсылка)) КАК ТипНомераГТД,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(НомераГТД.ТипНомераГТД, ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.НомерРНПТКомплекта)
	|				ИЛИ ЕСТЬNULL(НомераГТД.ТипНомераГТД, ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыНомеровГТД.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ ЕСТЬNULL(НомераГТД.Код, """")
	|	КОНЕЦ КАК НомерТаможеннойДекларации,
	|	НоменклатураНомерГТД.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмеренияТНВЭД.Наименование, """") КАК НаименованиеИЕдиницыИзмеренияТНВЭД,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмеренияТНВЭД.Код, """") КАК КодЕдиницыИзмеренияТНВЭД,
	|	НоменклатураНомерГТД.ЕдиницаХранения КАК ЕдиницаХранения,
	|	ЕСТЬNULL(УпаковкиЕдиницыХранения.Знаменатель, 0) КАК ЗнаменательЕдиницыХранения,
	|	ЕСТЬNULL(УпаковкиЕдиницыХранения.Числитель, 0) КАК ЧислительЕдиницыХранения,
	|	НоменклатураНомерГТД.ЕдиницаИзмеренияТНВЭД КАК ЕдиницаИзмеренияТНВЭД,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмеренияТНВЭД.Знаменатель, 0) КАК ЗнаменательЕдиницыИзмеренияТНВЭД,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмеренияТНВЭД.Числитель, 0) КАК ЧислительЕдиницыИзмеренияТНВЭД,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмеренияТНВЭД.ТипИзмеряемойВеличины, ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.ПустаяСсылка)) КАК ТипИзмеряемойВеличиныЕдиницыИзмеренияТНВЭД,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмеренияЕдиницыХранения.ЕдиницаИзмерения, 0) КАК ЕдиницаИзмеренияЕдиницыХранения
	|ПОМЕСТИТЬ АналитикаТоваров
	|ИЗ
	|	НоменклатураНомерГТД КАК НоменклатураНомерГТД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НомераГТД КАК НомераГТД
	|		ПО НоменклатураНомерГТД.НомерГТД = НомераГТД.Ссылка
