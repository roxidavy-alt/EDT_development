			РеквизитыШапка.Вставить("ОтвЛицоФинУрОКАТО", РегионОКАТО);
			
		КонецЕсли;
		
		Если ЗаявительЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
			
			// Заявитель статформы физлицо.
			
			ДанныеДокументаПредставление = "";
			
			Если ЗначениеЗаполнено(РеквизитыШапка.ИндивидуальныйПредприниматель) Тогда
				
				ДанныеДокумента = РегламентированнаяОтчетность.ПолучитьДокФизЛица(
					РеквизитыШапка.ИндивидуальныйПредприниматель, РеквизитыШапка.Дата);
				
				Если ЗначениеЗаполнено(ДанныеДокумента) Тогда
					
					ВидДокументаВСтатформе = ВидДокументаФизическогоЛицаВСтатформе(
						ДанныеДокумента.ВидДокумента, "RU", ОбластиМакета.ВидыДокументов);
					
					РеквизитыШапка.ОтвЛицоФинУрПасВидДок        = ВидДокументаВСтатформе.Код;
					РеквизитыШапка.ОтвЛицоФинУрПасДатаДок       = ДанныеДокумента.ДатаВыдачи;
					РеквизитыШапка.ОтвЛицоФинУрПасДатаДокумента = ДанныеДокумента.ДатаВыдачи;
					РеквизитыШапка.ОтвЛицоФинУрПасНаименование  = ВидДокументаВСтатформе.Наименование;
					РеквизитыШапка.ОтвЛицоФинУрПасНомерДок      = ДанныеДокумента.Номер;
					РеквизитыШапка.ОтвЛицоФинУрПасСерДок        = ДанныеДокумента.Серия;
					РеквизитыШапка.ОтвЛицоФинУрПасОрг           = ДанныеДокумента.КемВыдан;
					ДанныеДокументаПредставление                = ДанныеДокумента.Представление;
					
				КонецЕсли;
				
				ФИО = Строка(РеквизитыШапка.ИндивидуальныйПредприниматель);
				РеквизитыШапка.ОтвЛицоФинУрНаименование = ФИО;
				
				Если НаправлениеПеремещения = "ЭК" Тогда
					РеквизитыШапка.ОтправительНаименование = ФИО;
				Иначе
					РеквизитыШапка.ПолучательНаименование = ФИО;
				КонецЕсли;
				
			КонецЕсли;
			
			// Для физического лица, зарегистрированного на территории Российской Федерации в качестве 
			// индивидуального предпринимателя, либо самозанятого заполняются
			// фамилия, имя, отчество, место жительства, сведения о документе, удостоверяющем его личность.
			
			// В ERP в справочнике "Организации" самозанятые не поддерживаются, только индивидуальные предприниматели.
			
			РеквизитыШапка.ОтвЛицоФинУрРеквизиты = СтрШаблон("%1, %2",
				РеквизитыШапка.ОтправительРеквизиты, ДанныеДокументаПредставление);
		
		ИначеЕсли РеквизитыШапка.ОбособленноеПодразделение Тогда
			
			// Заявитель статформы обособленное подразделение
			
			РеквизитыШапка.ОтвЛицоФинУрПодРФ_ИНН = РеквизитыШапка.ОтвЛицоФинУрРФ_ИНН;
			РеквизитыШапка.ОтвЛицоФинУрПодРФ_КПП = РеквизитыШапка.ОтвЛицоФинУрРФ_КПП;
			РеквизитыШапка.ОтвЛицоФинУрПодРФ_ОГРН = РеквизитыШапка.ОтвЛицоФинУрРФ_ОГРН;
			
			РеквизитыШапка.ОтвЛицоФинУрПодСтранаКод = РеквизитыШапка.ОтвЛицоФинУрСтранаКод;
			РеквизитыШапка.ОтвЛицоФинУрПодСтранаНаименование = РеквизитыШапка.ОтвЛицоФинУрСтранаНаименование;
			РеквизитыШапка.ОтвЛицоФинУрПодНаименование = РеквизитыШапка.ОтвЛицоФинУрНаименование;
			РеквизитыШапка.ОтвЛицоФинУрПодИндекс = РеквизитыШапка.ОтвЛицоФинУрИндекс;
			РеквизитыШапка.ОтвЛицоФинУрПодОбласть = РеквизитыШапка.ОтвЛицоФинУрОбласть;
			РеквизитыШапка.ОтвЛицоФинУрПодНаселенныйПункт = РеквизитыШапка.ОтвЛицоФинУрНаселенныйПункт;
			РеквизитыШапка.ОтвЛицоФинУрПодУлицаНомерДома = РеквизитыШапка.ОтвЛицоФинУрУлицаНомерДома;
			
		Иначе
			
			// Заявитель статформы юридическое лицо
			
			РеквизитыШапка.ОтвЛицоФинУр = РеквизитыШапка.ОтвЛицоФинУрНаименование;
			
		КонецЕсли;
		
		РеквизитыШапка.Вставить("ОргСтранаКод",          РеквизитыШапка.ОтвЛицоФинУрСтранаКод);
		РеквизитыШапка.Вставить("ОргСтранаНаименование", РеквизитыШапка.ОтвЛицоФинУрСтранаНаименование);
		РеквизитыШапка.Вставить("ОргИндекс",             РеквизитыШапка.ОтвЛицоФинУрИндекс);
		РеквизитыШапка.Вставить("ОргОбласть",            РеквизитыШапка.ОтвЛицоФинУрОбласть);
		РеквизитыШапка.Вставить("ОргНаселенныйПункт",    РеквизитыШапка.ОтвЛицоФинУрНаселенныйПункт);
		РеквизитыШапка.Вставить("ОргУлицаНомерДома",     РеквизитыШапка.ОтвЛицоФинУрУлицаНомерДома);
		
	КонецЕсли;
	
	// Графа 7 - общая стоимость
	РеквизитыШапка.Вставить("ОбщаяЦенаТоваров", ТаблицаТоварыДляВыгрузки.Итог("ЦенаТовараВыбВал"));
	
	// Реквизиты подписи - ИНН/КПП/ОГРН заявителя статформы.
	// В форме БРО собирается по отдельным значениям ИНН, КПП, ОГРН.
	РеквизитыШапка.Вставить("ИннКппОгрн", ИННКППОГРН);
	
	Для каждого СтрокаТовары Из ТаблицаТоварыДляВыгрузки Цикл
		
		ЗаполнитьЗначенияСвойств(СтрокаТовары,
			РеквизитыТаможеннойДекларации(СтрокаТовары.НомерТаможеннойДекларации),
			"КодТО, ДатаРегистрацииСтр, НомерДок, ДекларацияНом");
		
		СтрокаТовары.ЕдИзмТовараКратко = ВРег(СтрокаТовары.ЕдИзмТовараКратко);
		
		Если СтрокаТовары.СтранаТовараКод = "RU" Тогда
			
			СтрокаТовары.ПроизводительОКАТО = ОКАТОПоИНН(СтрокаТовары.ПроизводительИНН, ТаблицаРегионОКАТО);
			
		КонецЕсли;
			
	КонецЦикла;
	
	ТаблицаДокументы.Свернуть("НаименованиеДокумента, НомерДокумента, ДатаДокумента");
	
	Результат.РеквизитыШапка = РеквизитыШапка;
	Результат.ТаблицаДокументы = ТаблицаДокументы;
	Результат.ТаблицаТоварыДляВыгрузки = ТаблицаТоварыДляВыгрузки;
	Результат.ТаблицаДопСведения = ТаблицаДопСведения;
	Результат.ШтрихкодыУпаковок = ШтрихкодыУпаковок;
	Результат.КурсыВалютыНаДатыДокументовОтгрузки = КурсыВалютыНаДатыДокументовОтгрузки;
	Результат.ДекларацияНаТовары = ТаблицаДекларацииНаТовары;
	
	Возврат Результат;
	
КонецФункции

// Возвращает данные штрихкодов упаковок маркируемых товаров
// для отчета "Статистическая форма учета перемещения товаров".
//
// Параметры:
//  СписокКодовВидовСредствИдентификации - ТабличныйДокумент - описание кодов видов стредств маркировки товаров.
//  МассивДокументов - ДокументСсылка.РеализацияТоваровУслуг
//                   - ДокументСсылка.ОтгрузкаТоваровКлиенту
//                   - Документссылка.ЗаявлениеОВвозеТоваров - документы-основания для заполнения статформы ФТС.
//  ИмяДокумента     - Строка - тип основания для заполнения статформы ФТС.
//
// Возвращаемое значение:
//  ТаблицаЗначений - параметры штрихкодов упаковок маркируемых товаров для статформы ФТС:
//   * ДокументСсылка                    - ДокументСсылка.РеализацияТоваровУслуг
//                                       - ДокументСсылка.ОтгрузкаТоваровКлиенту
//                                       - Документссылка.ЗаявлениеОВвозеТоваров - документы-основания для статформы ФТС.
//   * Номенклатура                      - СправочникСсылка.Номенклатура - маркируемый товар.
//   * КодВидаСтредстваИдентификации     - Строка - описание транспортной упаковки для товаров.
//   * SSCCПривестиКЕдиничномуКоду       - Булево - Истина, если для товаров используется код SSCC.
//   * DataMatrixПривестиКЕдиничномуКоду - Булево - Истина, если для товаров используется штрихкод DataMatrix.
//   * ЕдиничныйКод                      - Строка - значение единичного кода маркировки товара.
//   * КодУровняМаркировки               - Строка - значение кода уровня маркировки товара.
//
Функция ШтрихкодыУпаковокТоваровСтатформы(СписокКодовВидовСредствИдентификации, МассивДокументов, ИмяДокумента)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	Штрихкод101 = "";
	Штрихкод301 = "";
	Штрихкод302 = "";
	Штрихкод999 = "";
	
	КолвоСтрок = СписокКодовВидовСредствИдентификации.ВысотаТаблицы;
	// Нумерация начинается со 2-й строки, т.к. 1-я строка в макете содержит пустое значение
	Для Ном = 2 По КолвоСтрок Цикл
		
		Код = СокрЛП(СписокКодовВидовСредствИдентификации.Область(Ном, 1).Текст);
		
		Если СтрНачинаетсяС(Код, "101") Тогда
			Штрихкод101 = Код;
		ИначеЕсли СтрНачинаетсяС(Код, "301") Тогда 
			Штрихкод301 =  Код;
		ИначеЕсли СтрНачинаетсяС(Код, "302") Тогда 
			Штрихкод302 = Код;
		ИначеЕсли СтрНачинаетсяС(Код, "999") Тогда 
			Штрихкод999 = Код;
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Штрихкод101", Штрихкод101);
	Запрос.УстановитьПараметр("Штрихкод301", Штрихкод301);
	Запрос.УстановитьПараметр("Штрихкод302", Штрихкод302);
	Запрос.УстановитьПараметр("Штрихкод999", Штрихкод999);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковок.Ссылка КАК ДокументСсылка,
	|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.Code128)
	|				ИЛИ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.GS1_128)
	|				ИЛИ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC)
	|				ИЛИ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC18)
	|				ИЛИ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC20)
	|			ТОГДА &Штрихкод101
	|		КОГДА ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.DataMatrix)
	|				ИЛИ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.GS1_DataMatrix)
	|			ТОГДА &Штрихкод301
	|		КОГДА ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.QR)
	|			ТОГДА &Штрихкод302
	|		КОГДА ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)
	|				ИЛИ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.Неопределен)
	|			ТОГДА """"
	|		ИНАЧЕ &Штрихкод999
	|	КОНЕЦ КАК КодВидаСтредстваИдентификации,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC)
	|				ИЛИ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC18)
	|				ИЛИ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC20)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК SSCCПривестиКЕдиничномуКоду,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.DataMatrix)
	|				ИЛИ ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.GS1_DataMatrix)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК DataMatrixПривестиКЕдиничномуКоду,
	|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода, """") КАК ЕдиничныйКод,
	|	НЕОПРЕДЕЛЕНО КАК КодУровняМаркировки
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК ШтрихкодыУпаковок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|		ПО ШтрихкодыУпаковок.ШтрихкодУпаковки = ШтрихкодыУпаковокТоваров.Ссылка
	|ГДЕ
	|	ШтрихкодыУпаковок.Ссылка В(&МассивДокументов)";
	
	Если ИмяДокумента = "РеализацияТоваровУслуг" Тогда
		 Возврат Запрос.Выполнить().Выгрузить();
	ИначеЕсли ИмяДокумента = "ОтгрузкаТоваровКлиенту" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", ИмяДокумента);
	ИначеЕсли ИмяДокумента = "ЗаявлениеОВвозеТоваров" Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявлениеОВвозеТоваровТовары.ДокументПоступления КАК ДокументПоступления,
		|	ЗаявлениеОВвозеТоваровТовары.Ссылка КАК ДокументСсылка,
		|	ЕСТЬNULL(КлючиАналитикиУчетаНоменклатуры.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура
		|ПОМЕСТИТЬ НоменклатураПоступления
		|ИЗ
		|	Документ.ЗаявлениеОВвозеТоваров.Товары КАК ЗаявлениеОВвозеТоваровТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитикиУчетаНоменклатуры
		|		ПО ЗаявлениеОВвозеТоваровТовары.АналитикаУчетаНоменклатуры = КлючиАналитикиУчетаНоменклатуры.Ссылка
		|ГДЕ
		|	ЗаявлениеОВвозеТоваровТовары.Ссылка В(&МассивДокументов)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДокументПоступления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(МаркировкаТоваровИСМП.Ссылка, ЗНАЧЕНИЕ(Документ.МаркировкаТоваровИСМП.ПустаяСсылка)) КАК ДокументМаркировки,
		|	НоменклатураПоступления.ДокументПоступления КАК ДокументПоступления,
		|	НоменклатураПоступления.ДокументСсылка КАК ДокументСсылка,
		|	НоменклатураПоступления.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ МаркировкаТоваров
		|ИЗ
		|	НоменклатураПоступления КАК НоменклатураПоступления
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.МаркировкаТоваровИСМП КАК МаркировкаТоваровИСМП
		|		ПО НоменклатураПоступления.ДокументПоступления = МаркировкаТоваровИСМП.ДокументОснование
		|ГДЕ
		|	НЕ МаркировкаТоваровИСМП.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(ПриемкаТоваровИСМП.Ссылка, ЗНАЧЕНИЕ(Документ.ПриемкаТоваровИСМП.ПустаяСсылка)),
		|	НоменклатураПоступления.ДокументПоступления,
		|	НоменклатураПоступления.ДокументСсылка,
		|	НоменклатураПоступления.Номенклатура
		|ИЗ
		|	НоменклатураПоступления КАК НоменклатураПоступления
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриемкаТоваровИСМП КАК ПриемкаТоваровИСМП
		|		ПО НоменклатураПоступления.ДокументПоступления = ПриемкаТоваровИСМП.ДокументОснование
		|ГДЕ
		|	НЕ ПриемкаТоваровИСМП.ПометкаУдаления
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДокументМаркировки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НоменклатураПоступления.Номенклатура КАК Номенклатура,
		|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК НоменклатураШтрихкода,
		|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)) КАК ТипШтрихкода,
		|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода, """") КАК ЕдиничныйКод,
		|	НоменклатураПоступления.ДокументСсылка КАК ДокументСсылка
		|ПОМЕСТИТЬ НоменклатураДляФильтра
		|ИЗ
		|	НоменклатураПоступления КАК НоменклатураПоступления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг.ШтрихкодыУпаковок КАК ШтрихкодыУпаковок
		|		ПО НоменклатураПоступления.ДокументПоступления = ШтрихкодыУпаковок.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
		|		ПО (ШтрихкодыУпаковок.ШтрихкодУпаковки = ШтрихкодыУпаковокТоваров.Ссылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	МаркировкаТоваров.Номенклатура,
		|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)),
		|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)),
		|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода, """"),
		|	МаркировкаТоваров.ДокументСсылка
		|ИЗ
		|	МаркировкаТоваров КАК МаркировкаТоваров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.МаркировкаТоваровИСМП.ШтрихкодыУпаковок КАК ШтрихкодыУпаковок
		|		ПО МаркировкаТоваров.ДокументМаркировки = ШтрихкодыУпаковок.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
		|		ПО (ШтрихкодыУпаковок.ШтрихкодУпаковки = ШтрихкодыУпаковокТоваров.Ссылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	МаркировкаТоваров.Номенклатура,
		|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)),
		|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ТипШтрихкода, ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)),
		|	ЕСТЬNULL(ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода, """"),
		|	МаркировкаТоваров.ДокументСсылка
		|ИЗ
		|	МаркировкаТоваров КАК МаркировкаТоваров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриемкаТоваровИСМП.ШтрихкодыУпаковок КАК ШтрихкодыУпаковок
		|		ПО МаркировкаТоваров.ДокументМаркировки = ШтрихкодыУпаковок.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
		|		ПО (ШтрихкодыУпаковок.ШтрихкодУпаковки = ШтрихкодыУпаковокТоваров.Ссылка)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ НоменклатураПоступления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ МаркировкаТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НоменклатураЗаявленияОВвозеТоваров.ДокументСсылка КАК ДокументСсылка,
		|	НоменклатураДляФильтра.НоменклатураШтрихкода КАК Номенклатура,
		|	ВЫБОР
		|		КОГДА НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.Code128)
		|				ИЛИ НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.GS1_128)
		|				ИЛИ НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC)
		|				ИЛИ НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC18)
		|				ИЛИ НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC20)
		|			ТОГДА &Штрихкод101
		|		КОГДА НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.DataMatrix)
		|				ИЛИ НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.GS1_DataMatrix)
		|			ТОГДА &Штрихкод301
		|		КОГДА НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.QR)
		|			ТОГДА &Штрихкод302
		|		КОГДА НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.ПустаяСсылка)
		|				ИЛИ НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.Неопределен)
		|			ТОГДА """"
		|		ИНАЧЕ &Штрихкод999
		|	КОНЕЦ КАК КодВидаСтредстваИдентификации,
		|	ВЫБОР
		|		КОГДА НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC)
		|				ИЛИ НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC18)
		|				ИЛИ НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.SSCC20)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК SSCCПривестиКЕдиничномуКоду,
		|	ВЫБОР
		|		КОГДА НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.DataMatrix)
		|				ИЛИ НоменклатураДляФильтра.ТипШтрихкода = ЗНАЧЕНИЕ(Перечисление.ТипыШтрихкодов.GS1_DataMatrix)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК DataMatrixПривестиКЕдиничномуКоду,
		|	НоменклатураДляФильтра.ЕдиничныйКод КАК ЕдиничныйКод,
		|	НЕОПРЕДЕЛЕНО КАК КодУровняМаркировки
		|ИЗ
		|	НоменклатураДляФильтра КАК НоменклатураЗаявленияОВвозеТоваров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НоменклатураДляФильтра КАК НоменклатураДляФильтра
		|		ПО НоменклатураЗаявленияОВвозеТоваров.Номенклатура = НоменклатураДляФильтра.НоменклатураШтрихкода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ НоменклатураДляФильтра";
	Иначе
		ТекстОшибки = СтрШаблон(
		НСтр("ru = 'Для типа документа отгрузки ""%1"" не поддерживается заполнение статистической формы учета перемещения товаров.';
			|en = 'Для типа документа отгрузки ""%1"" не поддерживается заполнение статистической формы учета перемещения товаров.'"),
		ИмяДокумента);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		
		ШтрихкодыУпаковок = Новый ТаблицаЗначений;
		ШтрихкодыУпаковок.Колонки.Добавить("ДокументСсылка", Новый ОписаниеТипов("ДокументСсылка.РеализацияТоваровУслуг"));
		ШтрихкодыУпаковок.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ШтрихкодыУпаковок.Колонки.Добавить("КодВидаСтредстваИдентификации", ОбщегоНазначения.ОписаниеТипаСтрока(1000));
		ШтрихкодыУпаковок.Колонки.Добавить("SSCCПривестиКЕдиничномуКоду",  Новый ОписаниеТипов("Булево"));
		ШтрихкодыУпаковок.Колонки.Добавить("DataMatrixПривестиКЕдиничномуКоду",  Новый ОписаниеТипов("Булево"));
		ШтрихкодыУпаковок.Колонки.Добавить("ЕдиничныйКод", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		ШтрихкодыУпаковок.Колонки.Добавить("КодУровняМаркировки", ОбщегоНазначения.ОписаниеТипаСтрока(1000));
		
		Возврат ШтрихкодыУпаковок;
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает структуру видов упаковок маркируемых товаров для отчета "Статистическая форма учета перемещения товаров".
// 
// Параметры:
//  СписокКодовУровнейМаркировки - ТабличныйДокумент - описание кодов уровней маркировки товаров для статформы ФТС.
//
// Возвращаемое значение:
//  Структура - структура описания видов упаковок маркируемых товаров для статформы ФТС:
//   * ТоварнаяУпаковка      - Строка - описание товаровной упаковки.
//   * ГрупповаяУпаковка     - Строка - описание групповой упаковки для товаров.
//   * ТранспортнаяУпаковка  - Строка - описание транспортной упаковки для товаров.
//
Функция ВидыУпаковокТоваровСтатформы(СписокКодовУровнейМаркировки)
	
	ВидыУпаковок = Новый Структура();
	ВидыУпаковок.Вставить("ТоварнаяУпаковка", "");
	ВидыУпаковок.Вставить("ГрупповаяУпаковка", "");
	ВидыУпаковок.Вставить("ТранспортнаяУпаковка", "");
	
	КолвоСтрок = СписокКодовУровнейМаркировки.ВысотаТаблицы;
	// Нумерация начинается со 2-й строки, т.к. 1-я строка в макете содержит пустое значение
	Для Ном = 2 По КолвоСтрок Цикл
		
		Код = СокрЛП(СписокКодовУровнейМаркировки.Область(Ном, 1).Текст);
		
		Если СтрНачинаетсяС(Код, "0") Тогда
			ВидыУпаковок.ТоварнаяУпаковка = Код;
		ИначеЕсли СтрНачинаетсяС(Код, "1") Тогда 
			ВидыУпаковок.ГрупповаяУпаковка =  Код;
		ИначеЕсли СтрНачинаетсяС(Код, "2") Тогда 
			ВидыУпаковок.ТранспортнаяУпаковка = Код;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВидыУпаковок;
	
КонецФункции

// Устанавливает список выбора типов документов, используемых в отчете "Статистическая форма учета перемещения товаров".
// 
// Параметры:
//  СписокЗначений - СписокЗначений Из Строка - список значений для выбора типов документов, используемых для
//                                              заполнения отчета "Статистическая форма учета перемещения товаров".
//
Процедура СписокДокументовСтатистическойФормыУчетаПеремещенияТоваров(СписокЗначений) Экспорт
	
	МакетПоказателей =
		Отчеты.РегламентированныйОтчетСтатистикаФормаУчетаПеремещенияТоваровТС.ПолучитьМакет("СпискиАналогЛК");
	
	СписокДокументов = МакетПоказателей.ПолучитьОбласть("СписокДокументов");
	
	СписокЗначений.Очистить();
	
	// Нумерация начинается со 2-й строки, т.к. 1-я строка в макете содержит пустое значение
	
	Для Ном = 2 По СписокДокументов.ВысотаТаблицы Цикл
		
		СписокЗначений.Добавить(СписокДокументов.Область(Ном, 2).Текст, СписокДокументов.Область(Ном, 2).Текст);
		
	КонецЦикла;
	
	СписокЗначений.СортироватьПоПредставлению();
	
КонецПроцедуры

// Области макета, соответствующие спискам личного кабинета ФТС в отчете "Статистическая форма учета перемещения товаров".
//
// Возвращаемое значение:
//  Структура - Области макета, соответствующие спискам личного кабинета ФТС:
//   * СписокЗначенийГрафы19 - ТабличныйДокумент - значения для заполнения графы 19 в статформе ФТС.
//   * СписокОКАТО           - ТабличныйДокумент - значения для заполнения информации ОКАТО по ИНН в статформе ФТС.
//   * ВидыДокументов        - ТабличныйДокумент - для заполнения видов документов физлиц в статформе ФТС.
//   * СписокПравовыхФорм    - ТабличныйДокумент - для заполнения правовых форм организаций в статформе ФТС.
//
Функция ОбластиМакетовСписковЛичногоКабинетаФТС()
	
	МакетПоказателей = 
		Отчеты.РегламентированныйОтчетСтатистикаФормаУчетаПеремещенияТоваровТС.ПолучитьМакет("СпискиАналогЛК");
	
	ОбластиМакета = Новый Структура;
	ОбластиМакета.Вставить("СписокКодовУровнейМаркировки", МакетПоказателей.ПолучитьОбласть("КодУровняМаркировки"));
	ОбластиМакета.Вставить("СписокКодовВидовСредствИдентификации", 
		МакетПоказателей.ПолучитьОбласть("КодВидаСредстваИдентификации"));
	ОбластиМакета.Вставить("СписокЗначенийГрафы19", МакетПоказателей.ПолучитьОбласть("Гр19"));
	ОбластиМакета.Вставить("СписокОКАТО", МакетПоказателей.ПолучитьОбласть("ОКАТО"));
	ОбластиМакета.Вставить("ВидыДокументов", МакетПоказателей.ПолучитьОбласть("КодыДокументов"));
	ОбластиМакета.Вставить("СписокПравовыхФорм", МакетПоказателей.ПолучитьОбласть("ОрганизационноПравовыеФормы"));
	
	Возврат ОбластиМакета;
	
КонецФункции

// Получает структуру дополнительных сведений для заполнения графы 19
// в отчете "Статистическая форма учета перемещения товаров".
// 
// Параметры:
//  СписокЗначенийГрафы19 - ТабличныйДокумент - описание значений дополнительных сведений графы 19 статформы ФТС.
//
// Возвращаемое значение:
//  Структура - структуру дополнительных сведений для заполнения графы 19 статформы ФТС:
//   * ПрослеживаемыеТовары - Строка - значения для заполнения признака прослеживаемых товаров.
//   * ТоварыФизЛицамЭлектронныеТорговыеПлощадки - Строка - значения для заполнения признака товаров, ввозимых в рамках
//                                                          интернет-торговли в адрес физических лиц.
//
Функция ДопСведенияСтатформы(СписокЗначенийГрафы19)
	
	ДопСведения = Новый Структура();
	ДопСведения.Вставить("ПрослеживаемыеТовары", "");
	ДопСведения.Вставить("ТоварыФизЛицамЭлектронныеТорговыеПлощадки", "");
	
	КолвоСтрок = СписокЗначенийГрафы19.ВысотаТаблицы;
	// Нумерация начинается со 2-й строки, т.к. 1-я строка в макете содержит пустое значение
	Для Ном = 2 По КолвоСтрок Цикл
		
		Код = СокрЛП(СписокЗначенийГрафы19.Область(Ном, 1).Текст);
		
		Если Код = "07" Тогда
			ДопСведения.ТоварыФизЛицамЭлектронныеТорговыеПлощадки = СокрЛП(СписокЗначенийГрафы19.Область(Ном, 2).Текст);
		КонецЕсли;
		
		Если Код = "08" Тогда
			ДопСведения.ПрослеживаемыеТовары = СокрЛП(СписокЗначенийГрафы19.Область(Ном, 2).Текст);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДопСведения;
	
КонецФункции

// Получает таблицу значений кодов регионов ОКАТО для отчета "Статистическая форма учета перемещения товаров".
//
// Параметры:
//  СписокОКАТО - ТабличныйДокумент - табличный документ, содержащий описания кодов регионов ОКАТО.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица значений кодов регионов ОКАТО:
//   * Код        - Строка - значение ОКАТО.
//   * КодРегиона - Строка - код региона.
//
Функция РегионыОКАТО(СписокОКАТО) экспорт
		
	ТаблицаРегионОКАТО = Новый ТаблицаЗначений;
	ТаблицаРегионОКАТО.Колонки.Добавить("Код", ОбщегоНазначения.ОписаниеТипаСтрока(5));
	ТаблицаРегионОКАТО.Колонки.Добавить("КодРегиона", ОбщегоНазначения.ОписаниеТипаСтрока(2));
	
	КолвоСтрок = СписокОКАТО.ВысотаТаблицы;
	// Нумерация начинается со 2-й строки, т.к. 1-я строка в макете содержит пустое значение
	Для Ном = 2 По КолВоСтрок Цикл
		НоваяСтрока = ТаблицаРегионОКАТО.Добавить();
		НоваяСтрока.Код = СписокОКАТО.Область(Ном, 1).Текст;
		НоваяСтрока.КодРегиона = СписокОКАТО.Область(Ном, 3).Текст;
	КонецЦикла;
	
	Возврат ТаблицаРегионОКАТО;
	
КонецФункции

Функция КурсыВалютыНаДатыДокументовОтгрузки(Знач МассивДокументов, Валюта, БазоваяВалюта, ИмяДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РеализацияТоваровУслуг.Дата КАК Дата,
		|	РеализацияТоваровУслуг.Ссылка КАК ДокументОтгрузки
		|ПОМЕСТИТЬ ДатыОтгрузок
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.Ссылка В (&МассивДокументов)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДатыОтгрузок.Дата КАК Дата,
		|	МАКСИМУМ(КурсыВалют.Период) КАК Период,
		|	ДатыОтгрузок.ДокументОтгрузки КАК ДокументОтгрузки
		|ПОМЕСТИТЬ ДатаКурса
		|ИЗ
		|	РегистрСведений.ОтносительныеКурсыВалют КАК КурсыВалют
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДатыОтгрузок КАК ДатыОтгрузок
		|		ПО КурсыВалют.Валюта = &Валюта
		|			И КурсыВалют.БазоваяВалюта = &БазоваяВалюта
		|			И КурсыВалют.Период <= ДатыОтгрузок.Дата
		|СГРУППИРОВАТЬ ПО
		|	ДатыОтгрузок.Дата,
		|	ДатыОтгрузок.ДокументОтгрузки
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДатаКурса.Дата КАК Дата,
		|	КурсыВалют.Валюта КАК Валюта,
		|	КурсыВалют.КурсЧислитель КАК КурсЧислитель,
		|	КурсыВалют.КурсЗнаменатель КАК КурсЗнаменатель,
		|	ДатаКурса.ДокументОтгрузки КАК ДокументОтгрузки
		|ИЗ
		|	РегистрСведений.ОтносительныеКурсыВалют КАК КурсыВалют
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДатаКурса КАК ДатаКурса
		|		ПО КурсыВалют.Валюта = &Валюта
		|			И КурсыВалют.БазоваяВалюта = &БазоваяВалюта
		|			И КурсыВалют.Период = ДатаКурса.Период";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("БазоваяВалюта", БазоваяВалюта);
	
	Если ИмяДокумента <> "РеализацияТоваровУслуг" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеализацияТоваровУслуг", ИмяДокумента);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

Процедура РеквизитыШапкиСтатформы(РеквизитыШапка, Дата)
	
	ФорматДатыДЛФ = Формат(Дата, "ДЛФ=");
	ФорматДень = Формат(Дата, "ДФ=""дд""");
	ФорматГод = Формат(Дата, "ДФ=""гггг""");
	
	РеквизитыШапка.Вставить("ДатаЗаполнения", Формат(Дата, "ДФ=yyyy-MM-dd"));
	РеквизитыШапка.Вставить("ДатаЗаполненияД1", Лев(ФорматДень, 1));
	РеквизитыШапка.Вставить("ДатаЗаполненияД2", Прав(ФорматДень, 1));
	
	РеквизитыШапка.Вставить("ДатаЗаполненияД", Лев(ФорматДень, 2));
	
	РеквизитыШапка.Вставить("ДатаЗаполненияМ1", Сред(ФорматДатыДЛФ, 4, 1));
	РеквизитыШапка.Вставить("ДатаЗаполненияМ2", Сред(ФорматДатыДЛФ, 5, 1));
	
	РеквизитыШапка.Вставить("ДатаЗаполненияМ", Сред(ФорматДатыДЛФ, 4, 2));

	РеквизитыШапка.Вставить("ДатаЗаполненияГ1", Лев(ФорматГод, 1));
	РеквизитыШапка.Вставить("ДатаЗаполненияГ2", Сред(ФорматГод, 2, 1));
	РеквизитыШапка.Вставить("ДатаЗаполненияГ3", Сред(ФорматГод, 3, 1));
	РеквизитыШапка.Вставить("ДатаЗаполненияГ4", Прав(ФорматГод, 1));
	
	РеквизитыШапка.Вставить("ДатаЗаполненияГ", ФорматГод);
	
	РеквизитыШапка.Вставить("ОтчетныйМесяцМ1", РеквизитыШапка.ДатаЗаполненияМ1);
	РеквизитыШапка.Вставить("ОтчетныйМесяцМ2", РеквизитыШапка.ДатаЗаполненияМ2);
	
	РеквизитыШапка.Вставить("ОтчетныйМесяцМ", РеквизитыШапка.ДатаЗаполненияМ);
	
	РеквизитыШапка.Вставить("ОтчетныйМесяцГ1", РеквизитыШапка.ДатаЗаполненияГ1);
	РеквизитыШапка.Вставить("ОтчетныйМесяцГ2", РеквизитыШапка.ДатаЗаполненияГ2);
	РеквизитыШапка.Вставить("ОтчетныйМесяцГ3", РеквизитыШапка.ДатаЗаполненияГ3);
	РеквизитыШапка.Вставить("ОтчетныйМесяцГ4", РеквизитыШапка.ДатаЗаполненияГ1);
	
	РеквизитыШапка.Вставить("ОтчетныйМесяцГ", ФорматГод);
	РеквизитыШапка.Вставить("ОтчетныйМесяц", Формат(Дата, "ДФ=yyyy-MM"));
	
	РеквизитыШапка.Вставить("Дата", КонецМесяца(Дата));
	
	РеквизитыШапка.Вставить("ОргПочтовыйАдрес", УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		РеквизитыШапка.Организация,
		Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации,
		РеквизитыШапка.Дата));
	
КонецПроцедуры

// По ИНН находит код ОКАТО для региона.
// Параметры:
//  ИНН                - Строка - ИНН.
//  ТаблицаРегионОКАТО - ТаблицаЗначений - таблица значений кодов регионов ОКАТО:
//   * Код             - Строка - значение ОКАТО.
//   * КодРегиона      - Строка - двухзначный код региона.
//
// Возвращаемое значение:
//  Строка - код ОКАТО для региона.
//
Функция ОКАТОПоИНН(ИНН, ТаблицаРегионОКАТО) Экспорт
	Регион = Лев(ИНН, 2);
	Если Не СтрПодобнаПоРегулярномуВыражению(Регион, "[0-9]{2}") Тогда 
		Возврат "";
	КонецЕсли;
	
	ОтборСтроки = ТаблицаРегионОКАТО.НайтиСтроки(Новый Структура("КодРегиона", Регион));
	Возврат ?(ЗначениеЗаполнено(ОтборСтроки), ОтборСтроки[0].Код, "");
КонецФункции

// Приводит значение организационно-правовой формы справочника "Организации" к используемому
// в отчете "Статистическая форма учета перемещения товаров" виду организационно-правовой формы.
// Если соответствующее значение не было найдено, то присваивает пустую строку.
// Параметры:
//  ПравоваяФормаОрганизации - Строка - организационно-правовая форма организации.
//  ЮрФизЛицо                - ПеречислениеСсылка.ЮрФизЛицо - определяет статусы для индивидуальных предпринимателей.
//  СписокПравовыхФорм       - ТабличныйДокумент - список организационно-правовых форм.
//
Процедура ПравоваяФормаВСтатистическойФормеУчетаПеремещенияТоваров(ПравоваяФормаОрганизации,
	ЮрФизЛицо, СписокПравовыхФорм)
	
	Если ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда
		
		Если ЕстьПравоваяФормаВСтатистическойФормеУчетаПеремещенияТоваров("Индивидуальный предприниматель",
			СписокПравовыхФорм) Тогда
			ПравоваяФормаОрганизации = НСтр("ru = 'Индивидуальный предприниматель';
											|en = 'Individual entrepreneur'");
		Иначе
			ПравоваяФормаОрганизации = "";
		КонецЕсли;
		
		Возврат;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(ПравоваяФормаОрганизации) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ПравоваяФормаОрганизации = "Общества с ограниченной ответственностью" Тогда
		
		ПравоваяФормаОрганизации = НСтр("ru = 'Общество с ограниченной ответственностью';
										|en = 'Limited liability company'");
		
	ИначеЕсли ПравоваяФормаОрганизации = "Непубличные акционерные общества" Тогда
		
		ПравоваяФормаОрганизации = НСтр("ru = 'Непубличное акционерное общество';
										|en = 'Непубличное акционерное общество'");
		
	ИначеЕсли ПравоваяФормаОрганизации = "Публичные акционерные общества" Тогда
		
		ПравоваяФормаОрганизации = НСтр("ru = 'Публичное акционерное общество';
										|en = 'Public Joint-Stock Company'");
		
	ИначеЕсли ПравоваяФормаОрганизации = "Акционерные общества" Тогда
		
		ПравоваяФормаОрганизации = НСтр("ru = 'Акционерное общество';
										|en = 'Joint-Stock Company'");
		
	ИначеЕсли СтрНайти(ПравоваяФормаОрганизации, "унитар") > 0
		И СтрНайти(ПравоваяФормаОрганизации, "предприят") > 0 Тогда
		
		ПравоваяФормаОрганизации = НСтр("ru = 'Унитарное предприятие';
										|en = 'Унитарное предприятие'");
		
	ИначеЕсли СтрНайти(ПравоваяФормаОрганизации, "роизводств") > 0
		И СтрНайти(ПравоваяФормаОрганизации, "кооператив") > 0 Тогда
		
		ПравоваяФормаОрганизации = НСтр("ru = 'Производственный кооператив (артель)';
										|en = 'Производственный кооператив (артель)'");
		
	ИначеЕсли СтрНайти(ПравоваяФормаОрганизации, "Открыт") > 0
		И СтрНайти(ПравоваяФормаОрганизации, "акционер") > 0 Тогда
		
		ПравоваяФормаОрганизации = НСтр("ru = 'Открытое акционерное общество';
										|en = 'Open Joint-Stock Company'");
		
	ИначеЕсли СтрНайти(ПравоваяФормаОрганизации, "Закрыт") > 0
		И СтрНайти(ПравоваяФормаОрганизации, "акционер") > 0 Тогда
		
		ПравоваяФормаОрганизации = НСтр("ru = 'Закрытое акционерное общество';
										|en = 'Closed Joint-Stock Company'");
		
	Иначе
		
		ПравоваяФормаОрганизации = "";
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЕстьПравоваяФормаВСтатистическойФормеУчетаПеремещенияТоваров(ПравоваяФормаОрганизации,
		СписокПравовыхФорм) Тогда
		ПравоваяФормаОрганизации = "";
	КонецЕсли;
	
КонецПроцедуры

// Проверяет есть ли значение организационно-правовой формы в макете, используемом в отчете
// "Статистическая форма учета перемещения товаров".
// 
// Параметры:
//  ПравоваяФорма - Строка - организационно-правовая форма.
//  СписокПравовыхФорм - ТабличныйДокумент - список организационно-правовых форм.
// 
// Возвращаемое значение:
//  Булево - Истина, если значение организационно-правовой формы найдено в макете для отчета
//           "Статистическая форма учета перемещения товаров".
Функция ЕстьПравоваяФормаВСтатистическойФормеУчетаПеремещенияТоваров(ПравоваяФорма, СписокПравовыхФорм)
	
	// Нумерация начинается со 2-й строки, т.к. 1-я строка в макете содержит пустое значение
	Для Ном = 2 По СписокПравовыхФорм.ВысотаТаблицы Цикл
		
		Если ПравоваяФорма = СокрЛП(СписокПравовыхФорм.Область(Ном, 2).Текст) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// По значению вида документа из справочника "ВидыДокументовФизическихЛиц"
// возвращает структуру с полями вид и наименование документа физического лица, используемого
// в отчете "Статистическая форма учета перемещения товаров".
// Параметры:
//  ВидДокумента    - СправочникСсылка.ВидыДокументовФизическихЛиц - вид документа физического лица.
//  КодСтраныАльфа2 - Строка - двухзначный код страны физлица из справочника "СтраныМира".
//  ВидыДокументов  - ТабличныйДокумент - коды видов документов, удостоверяющих личность.
// 
// Возвращаемое значение:
//  Структура - вид документа в статистической форме учета перемещения товаров, поля структуры:
//   * Код          - Строка
//   * Наименование - Строка
Функция ВидДокументаФизическогоЛицаВСтатформе(Знач ВидДокумента, Знач КодСтраныАльфа2, ВидыДокументов)
	
	Если ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ Тогда
		Возврат НайтиПоКодуВидДокументаФизическогоЛицаВМакетеСтатформы("RU01001", КодСтраныАльфа2, ВидыДокументов);
	ИначеЕсли ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ЗагранпаспортРФ Тогда
		Возврат НайтиПоКодуВидДокументаФизическогоЛицаВМакетеСтатформы("RU01004", КодСтраныАльфа2, ВидыДокументов);
	ИначеЕсли ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВоенныйБилет Тогда
		Возврат НайтиПоКодуВидДокументаФизическогоЛицаВМакетеСтатформы("RU07016", КодСтраныАльфа2, ВидыДокументов);
	ИначеЕсли ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВременноеУдостоверениеВзаменВоенногоБилетаОфицераЗапаса Тогда
		Возврат НайтиПоКодуВидДокументаФизическогоЛицаВМакетеСтатформы("RU02010", КодСтраныАльфа2, ВидыДокументов);
	ИначеЕсли ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортМоряка Тогда
		Возврат НайтиПоКодуВидДокументаФизическогоЛицаВМакетеСтатформы("RU02005", КодСтраныАльфа2, ВидыДокументов);
	ИначеЕсли ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.УдостоверениеОфицера Тогда
		Возврат НайтиПоКодуВидДокументаФизическогоЛицаВМакетеСтатформы("RU02016", КодСтраныАльфа2, ВидыДокументов);
	КонецЕсли;
	
	КодМВД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДокумента, "КодМВД");
	
	Если КодМВД = "15" Тогда
		Возврат НайтиПоКодуВидДокументаФизическогоЛицаВМакетеСтатформы("RU99024", КодСтраныАльфа2, ВидыДокументов);
	ИначеЕсли КодМВД = "11" Тогда
		Возврат НайтиПоКодуВидДокументаФизическогоЛицаВМакетеСтатформы("RU03022", КодСтраныАльфа2, ВидыДокументов);
	КонецЕсли;
	
	Если ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение
		ИЛИ ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ВоенныйБилетОфицераЗапаса
		ИЛИ ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортМинморфлота
		ИЛИ ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.СправкаВзаменВоенногоБилета
		ИЛИ ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.УдостоверениеГражданинаПодлежащегоПризыву
		ИЛИ КодМВД = "24"
		ИЛИ КодМВД = "91" Тогда
		
		Возврат НайтиПоНаименованиюВидДокументаФизическогоЛицаВМакетеСтатформы("ИНОЙ", КодСтраныАльфа2, ВидыДокументов);
		
	ИначеЕсли ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ЗагранпаспортСССР
		ИЛИ ВидДокумента = Справочники.ВидыДокументовФизическихЛиц.ПаспортСССР
		ИЛИ КодМВД = "10"
		ИЛИ КодМВД = "23" Тогда
		
		Возврат Новый Структура("Код, Наименование", "", "");
		
	КонецЕсли;
	
	Возврат НайтиПоНаименованиюВидДокументаФизическогоЛицаВМакетеСтатформы(
				СтрЗаменить(Строка(ВидДокумента),"РФ",""), КодСтраныАльфа2, ВидыДокументов);
	
КонецФункции

// Поиск вида документа физического лица по коду и двухзначному коду страны в макете, используемом
// в отчете "Статистическая форма учета перемещения товаров".
// Параметры:
//  Код             - Строка - код, который нужно найти в макете.
//  КодСтраныАльфа2 - Строка - двухзначный код страны физлица из справочника "СтраныМира".
//  ВидыДокументов  - ТабличныйДокумент - коды видов документов, удостоверяющих личность.
// 
// Возвращаемое значение:
//  Структура - вид документа в статистической форме учета перемещения товаров, поля структуры:
//   * Код          - Строка
//   * Наименование - Строка
Функция НайтиПоКодуВидДокументаФизическогоЛицаВМакетеСтатформы(Знач Код, Знач КодСтраныАльфа2, ВидыДокументов)
	
	ВидДокументаВСтатформе = Новый Структура("Код, Наименование", "", "");
	// Нумерация начинается со 2-й строки, т.к. 1-я строка в макете содержит пустое значение
	Для Ном = 2 По ВидыДокументов.ВысотаТаблицы Цикл
		
		Если КодСтраныАльфа2 = СокрЛП(ВидыДокументов.Область(Ном, 4).Текст)
			И Код = СокрЛП(ВидыДокументов.Область(Ном, 1).Текст) Тогда
			
			ВидДокументаВСтатформе.Код = Код;
			ВидДокументаВСтатформе.Наименование = СокрЛП(ВидыДокументов.Область(Ном, 3).Текст);
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВидДокументаВСтатформе;
	
КонецФункции

// Поиск вида документа физического лица по наименованию и двухзначному коду страны в макете, используемом
// в отчете "Статистическая форма учета перемещения товаров".
// Параметры:
//  Наименование    - Строка - наименование, которое нужно найти в макете.
//  КодСтраныАльфа2 - Строка - двухзначный код страны физлица из справочника "СтраныМира".
//  ВидыДокументов  - ТабличныйДокумент - коды видов документов, удостоверяющих личность.
// 
// Возвращаемое значение:
//  Структура - поля структуры:
//   * Код          - Строка
//   * Наименование - Строка
Функция НайтиПоНаименованиюВидДокументаФизическогоЛицаВМакетеСтатформы(Наименование, КодСтраныАльфа2, ВидыДокументов)
	
	ВидДокументаВСтатформе = Новый Структура("Код, Наименование", "", "");
	// Нумерация начинается со 2-й строки, т.к. 1-я строка в макете содержит пустое значение
	Для Ном = 2 По ВидыДокументов.ВысотаТаблицы Цикл
		
		Если КодСтраныАльфа2 = СокрЛП(ВидыДокументов.Область(Ном, 4).Текст)
			И СтрНайти(ВРег(СокрЛП(ВидыДокументов.Область(Ном, 2).Текст)), ВРег(Наименование)) > 0 Тогда
			
			ВидДокументаВСтатформе.Код = СокрЛП(ВидыДокументов.Область(Ном, 1).Текст);
			ВидДокументаВСтатформе.Наименование = СокрЛП(ВидыДокументов.Область(Ном, 3).Текст);
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВидДокументаВСтатформе;

КонецФункции

// Из номера таможенной декларации или РНПТ получается параметры Код таможенного органа, даты таможенной декларации,
// номера таможенной декларации и порядковый номер строки товара в декларации.
// 
// Параметры:
//  НомерТаможеннойДекларации - Строка - полный номер таможенной декларации для извлечения реквизитов.
// Возвращаемое значение:
//  Структура - состав реквизитов товара для выгрузки статистической формы учета перемещения товаров ФТС:
//   * КодТО                  - Строка - код таможенного органа.
//   * ДатаРегистрацииСтр     - Строка - дата в строковом виде таможенной декларации.
//   * НомерДок               - Строка - номер таможенной декларации.
//   * ДекларацияНом          - Число - порядковый номер строки в декларации.
//
Функция РеквизитыТаможеннойДекларации(НомерТаможеннойДекларации) Экспорт
	
	СтрокаВыгрузки = Новый Структура;
	
	СтрокаВыгрузки.Вставить("КодТО", "");
	СтрокаВыгрузки.Вставить("ДатаРегистрацииСтр", "0001-01-01");
	СтрокаВыгрузки.Вставить("НомерДок", "");
	СтрокаВыгрузки.Вставить("ДекларацияНом", 0);
	
	Если НЕ ЗначениеЗаполнено(НомерТаможеннойДекларации) Тогда
		Возврат СтрокаВыгрузки;
	КонецЕсли;
	
	МассивСлов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(НомерТаможеннойДекларации, "/");
		
	Если МассивСлов.Количество() < 3
		ИЛИ МассивСлов.Количество() > 4 Тогда
		// Регистрационный номер таможенной декларации введен не корректно.
		Возврат СтрокаВыгрузки;
	КонецЕсли;
	
	СтрокаВыгрузки.КодТО    = МассивСлов[0];
	ДатаРегистрацииСтр      = МассивСлов[1];
	СтрокаВыгрузки.НомерДок = МассивСлов[2];
	
	Если СтрДлина(ДатаРегистрацииСтр) = 6 Тогда
		Число = Лев(ДатаРегистрацииСтр, 2);
		Месяц = Сред(ДатаРегистрацииСтр, 3, 2);
		Год   = Прав(ДатаРегистрацииСтр, 2);
		СтрокаВыгрузки.ДатаРегистрацииСтр = "20" + Год + "-" + Месяц  + "-" + Число;
	КонецЕсли; 
	
	Если МассивСлов.Количество() = 4 Тогда
		// Регистрационный номер таможенной декларации содержит порядковый номер строки в декларации.
		ТипЧисло = Новый ОписаниеТипов("Число");
		СтрокаВыгрузки.ДекларацияНом = ТипЧисло.ПривестиЗначение(МассивСлов[3]);
	КонецЕсли;
	
	Возврат СтрокаВыгрузки;
	
КонецФункции

#КонецОбласти

