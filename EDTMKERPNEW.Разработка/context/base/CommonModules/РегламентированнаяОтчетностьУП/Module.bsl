	|	Организации.КПП КАК ОрганизацияКПП,
	|	ВЫБОР
	|		КОГДА Организации.ОсобыйПризнакЗаявителяДОПП = """"
	|			ТОГДА ""0""
	|		ИНАЧЕ Организации.ОсобыйПризнакЗаявителяДОПП
	|	КОНЕЦ КАК ОсобыйПризнакЗаявителя,
	|	Организации.ИнойОсобыйПризнакЗаявителяДОПП КАК ИнойОсобыйПризнакЗаявителя,
	|	КонтрагентПродавец.НаименованиеПолное КАК ПродавецНаименованиеПолное,
	|	КонтрагентПродавец.ИНН КАК ПродавецИНН,
	|	КонтрагентПродавец.КПП КАК ПродавецКПП,
	|	КонтрагентПродавец.РегистрационныйНомер КАК ПродавецРегистрационныйНомер,
	|	КонтрагентПродавец.СтранаРегистрации КАК ПродавецСтранаРегистрации,
	|	СтранаРегистрацииПродавца.Код КАК КодСтраныРегистрацииПродавца,
	|	СтранаРегистрацииПродавца.НаименованиеПолное КАК СтранаРегистрацииПродавца,
	|	""0"" КАК ОсобыйПризнакДОПП
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ДокументОснованиеДОПП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ДокументОснованиеДОПП.Валюта = Валюты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ДокументОснованиеДОПП.Договор = ДоговорыКонтрагентов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ДокументОснованиеДОПП.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентПродавец
	|		ПО ДокументОснованиеДОПП.Контрагент = КонтрагентПродавец.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтранаРегистрацииПродавца
	|		ПО (КонтрагентПродавец.СтранаРегистрации = СтранаРегистрацииПродавца.Ссылка)
	|ГДЕ
	|	ДокументОснованиеДОПП.Ссылка В (&Ссылки)
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорКонтрагента
	|";
	
	Если ЗначениеЗаполнено(ИмяДокумента) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗаказПоставщику", ИмяДокумента);
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗаполненияДОППТовары(ИмяДокумента = "", ИмяТабличнойЧасти = "")

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДокументОснованиеДОППТовары.НомерСтроки КАК НомерСтроки,
	|	ДокументОснованиеДОППТовары.Номенклатура КАК Номенклатура,
	|	ДокументОснованиеДОППТовары.Ссылка.Договор КАК Договор,
	|	ДокументОснованиеДОППТовары.Количество КАК Количество,
	|	ДокументОснованиеДОППТовары.Сумма КАК ФактурнаяСтоимость,
	|	ТоварНоменклатура.ПродукцияМаркируемаяДляГИСМ КАК МаркируемыйТовар,
	|	&ОсобыйПризнакДОПП КАК ОсобыйПризнакДОПП,
	|	КлассификаторТНВЭД.Код КАК КодТНВЭД,
	|	СтраныМира.Код КАК КодСтраныПроисхождения,
	|	СтраныМира.НаименованиеПолное КАК НаименованиеПолноеСтраныПроисхождения,
	|	УпаковкиЕдиницыИзмерения.Код КАК КодЕдиницыИзмерения,
	|	"""" КАК НомерДекларацииНаТовары,
	|	ТоварНоменклатура.НаименованиеПолное КАК ТоварНаименованиеПолное
	|ПОМЕСТИТЬ ВтТоварыОснования
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ДокументОснованиеДОППТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ТоварНоменклатура
	|			ПО ДокументОснованиеДОППТовары.Номенклатура = ТоварНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|			ПО ТоварНоменклатура.ЕдиницаИзмерения = УпаковкиЕдиницыИзмерения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|			ПО ТоварНоменклатура.СтранаПроисхождения = СтраныМира.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|			ПО ТоварНоменклатура.КодТНВЭД = КлассификаторТНВЭД.Ссылка
	|ГДЕ
	|	ДокументОснованиеДОППТовары.Ссылка В (&Ссылки)
	|	И НЕ ТоварНоменклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга),
	|												ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа))
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура";
	
	
	Если ЗначениеЗаполнено(ИмяДокумента) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗаказПоставщику", ИмяДокумента);
	КонецЕсли;

	Если ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".Товары", "." + ИмяТабличнойЧасти);
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗаполненияДОППЗаказПереработчику()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ДокументОснованиеДОППТовары.Ссылка                КАК Ссылка,
	|	ДокументОснованиеДОППТовары.Ссылка.СуммаДокумента КАК СуммаДокумента,
	|	СУММА(ДокументОснованиеДОППТовары.Количество)     КАК Количество,
	|	СУММА(ДокументОснованиеДОППТовары.ДоляСтоимости)  КАК ДоляСтоимости
	|ПОМЕСТИТЬ ВтИтоги
	|ИЗ
	|	Документ.ЗаказПереработчику2_5.ВыходныеИзделия КАК ДокументОснованиеДОППТовары
	|ГДЕ
	|	ДокументОснованиеДОППТовары.Ссылка В (&Ссылки)
	|СГРУППИРОВАТЬ ПО
	|	ДокументОснованиеДОППТовары.Ссылка
	|;
	|///////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументОснованиеДОППТовары.НомерСтроки    КАК НомерСтроки,
	|	ДокументОснованиеДОППТовары.Номенклатура   КАК Номенклатура,
	|	ДокументОснованиеДОППТовары.Ссылка.Договор КАК Договор,
	|	ДокументОснованиеДОППТовары.Количество     КАК Количество,
	|	ИтоговыеДанные.СуммаДокумента * 
	|	ВЫРАЗИТЬ(ВЫБОР
	|		КОГДА ИтоговыеДанные.ДоляСтоимости <> 0
	|			ТОГДА ДокументОснованиеДОППТовары.ДоляСтоимости/ИтоговыеДанные.ДоляСтоимости
	|		КОГДА ИтоговыеДанные.Количество <> 0 
	|			ТОГДА ДокументОснованиеДОППТовары.Количество/ИтоговыеДанные.Количество
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ КАК ЧИСЛО(15,2)) КАК ФактурнаяСтоимость,
	|	ТоварНоменклатура.ПродукцияМаркируемаяДляГИСМ КАК МаркируемыйТовар,
	|	""0"" КАК ОсобыйПризнакДОПП,
	|	КлассификаторТНВЭД.Код КАК КодТНВЭД,
	|	СтраныМира.Код КАК КодСтраныПроисхождения,
	|	СтраныМира.НаименованиеПолное КАК НаименованиеПолноеСтраныПроисхождения,
	|	УпаковкиЕдиницыИзмерения.Код КАК КодЕдиницыИзмерения,
	|	"""" КАК НомерДекларацииНаТовары,
	|	ТоварНоменклатура.НаименованиеПолное КАК ТоварНаименованиеПолное
	|ПОМЕСТИТЬ ВтТоварыОснования
	|ИЗ
	|	Документ.ЗаказПереработчику2_5.ВыходныеИзделия КАК ДокументОснованиеДОППТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтИтоги КАК ИтоговыеДанные
	|			ПО ДокументОснованиеДОППТовары.Ссылка = ИтоговыеДанные.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ТоварНоменклатура
	|			ПО ДокументОснованиеДОППТовары.Номенклатура = ТоварНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|			ПО ТоварНоменклатура.ЕдиницаИзмерения = УпаковкиЕдиницыИзмерения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|			ПО ТоварНоменклатура.СтранаПроисхождения = СтраныМира.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|			ПО ТоварНоменклатура.КодТНВЭД = КлассификаторТНВЭД.Ссылка
	|ГДЕ
	|	ДокументОснованиеДОППТовары.Ссылка В (&Ссылки)
	|	И НЕ ДокументОснованиеДОППТовары.Отменено
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДокументОснованиеДОППТовары.НомерСтроки       КАК НомерСтроки,
	|	ДокументОснованиеДОППТовары.Номенклатура      КАК Номенклатура,
	|	ДокументОснованиеДОППТовары.Ссылка.Договор    КАК Договор,
	|	ДокументОснованиеДОППТовары.Количество        КАК Количество,
	|	ДокументОснованиеДОППТовары.Сумма             КАК ФактурнаяСтоимость,
	|	ТоварНоменклатура.ПродукцияМаркируемаяДляГИСМ КАК МаркируемыйТовар,
	|	""0"" КАК ОсобыйПризнакДОПП,
	|	КлассификаторТНВЭД.Код КАК КодТНВЭД,
	|	СтраныМира.Код КАК КодСтраныПроисхождения,
	|	СтраныМира.НаименованиеПолное КАК НаименованиеПолноеСтраныПроисхождения,
	|	УпаковкиЕдиницыИзмерения.Код КАК КодЕдиницыИзмерения,
	|	"""" КАК НомерДекларацииНаТовары,
	|	ТоварНоменклатура.НаименованиеПолное КАК ТоварНаименованиеПолное
	|ИЗ
	|	Документ.ЗаказПереработчику2_5.ПобочныеИзделия КАК ДокументОснованиеДОППТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ТоварНоменклатура
	|			ПО ДокументОснованиеДОППТовары.Номенклатура = ТоварНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|			ПО ТоварНоменклатура.ЕдиницаИзмерения = УпаковкиЕдиницыИзмерения.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|			ПО ТоварНоменклатура.СтранаПроисхождения = СтраныМира.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|			ПО ТоварНоменклатура.КодТНВЭД = КлассификаторТНВЭД.Ссылка
	|ГДЕ
	|	ДокументОснованиеДОППТовары.Ссылка В (&Ссылки)
	|	И НЕ ДокументОснованиеДОППТовары.Отменено
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗаполненияДОППАренда(Запрос)

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&ДатаПодписи КАК Дата,
	|	ДокументОснованиеДОПП.Организация КАК Организация,
	|	ДокументОснованиеДОПП.Контрагент КАК Контрагент,
	|	ДокументОснованиеДОПП.Договор КАК ДоговорКонтрагента,
	|	ДокументОснованиеДОПП.Валюта КАК ВалютаДокумента,
	|	&ДатаВвоза КАК ДатаВвоза,
	|	Валюты.Код КАК КодаВалюты,
	|	ДоговорыКонтрагентов.Дата КАК ДатаДоговора,
	|	ДоговорыКонтрагентов.Номер КАК НомерДоговора,
	|	Организации.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
	|	Организации.ИНН КАК ОрганизацияИНН,
	|	Организации.КПП КАК ОрганизацияКПП,
	|	ВЫБОР
	|		КОГДА Организации.ОсобыйПризнакЗаявителяДОПП = """"
	|			ТОГДА ""0""
	|		ИНАЧЕ Организации.ОсобыйПризнакЗаявителяДОПП
	|	КОНЕЦ КАК ОсобыйПризнакЗаявителя,
	|	Организации.ИнойОсобыйПризнакЗаявителяДОПП КАК ИнойОсобыйПризнакЗаявителя,
	|	КонтрагентПродавец.НаименованиеПолное КАК ПродавецНаименованиеПолное,
	|	КонтрагентПродавец.ИНН КАК ПродавецИНН,
	|	КонтрагентПродавец.КПП КАК ПродавецКПП,
	|	КонтрагентПродавец.РегистрационныйНомер КАК ПродавецРегистрационныйНомер,
	|	КонтрагентПродавец.СтранаРегистрации КАК ПродавецСтранаРегистрации,
	|	СтранаРегистрацииПродавца.Код КАК КодСтраныРегистрацииПродавца,
	|	СтранаРегистрацииПродавца.НаименованиеПолное КАК СтранаРегистрацииПродавца,
	|	ВЫБОР
	|		КОГДА ДоговорыКонтрагентов.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоровАренды.Аренда)
	|			ТОГДА ""7""
	|		ИНАЧЕ ""9""
	|	КОНЕЦ КАК ОсобыйПризнакДОПП
	|ИЗ
	|	Документ.ЗаключениеДоговораАренды КАК ДокументОснованиеДОПП
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	|		ПО ДокументОснованиеДОПП.Валюта = Валюты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыАренды КАК ДоговорыКонтрагентов
	|		ПО ДокументОснованиеДОПП.Договор = ДоговорыКонтрагентов.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ДокументОснованиеДОПП.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентПродавец
	|		ПО ДокументОснованиеДОПП.Контрагент = КонтрагентПродавец.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтранаРегистрацииПродавца
	|		ПО (КонтрагентПродавец.СтранаРегистрации = СтранаРегистрацииПродавца.Ссылка)
	|ГДЕ
	|	ДокументОснованиеДОПП.Ссылка В (&Ссылки)
	|УПОРЯДОЧИТЬ ПО
	|	ДоговорКонтрагента;
	|	
	|ВЫБРАТЬ
	|	ДокументОснованиеДОППОС.НомерСтроки КАК НомерСтроки,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
	|	ДокументОснованиеДОППОС.Ссылка.Договор КАК Договор,
	|	1 КАК Количество,
	|	ДокументОснованиеДОППОС.Стоимость КАК ФактурнаяСтоимость,
	|	ЛОЖЬ КАК МаркируемыйТовар,
	|	"""" КАК ОсобыйПризнакДОПП,
	|	"""" КАК КодТНВЭД,
	|	"""" КАК КодСтраныПроисхождения,
	|	"""" КАК НаименованиеПолноеСтраныПроисхождения,
	|	&КодЕдиницыИзмерения КАК КодЕдиницыИзмерения,
	|	"""" КАК НомерДекларацииНаТовары,
	|	ОбъектЭксплуатации.НаименованиеПолное КАК ТоварНаименованиеПолное
	|ПОМЕСТИТЬ ВтТоварыОснования
	|ИЗ
	|	Документ.ЗаключениеДоговораАренды.ОС КАК ДокументОснованиеДОППОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбъектыЭксплуатации КАК ОбъектЭксплуатации
	|			ПО ДокументОснованиеДОППОС.ОсновноеСредство = ОбъектЭксплуатации.Ссылка
	|ГДЕ
	|	ДокументОснованиеДОППОС.Ссылка В (&Ссылки)
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|";
	
	КодЕдиницыИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Константы.ЕдиницаИзмеренияКоличестваШтук.Получить(), "Код");
	Запрос.УстановитьПараметр("КодЕдиницыИзмерения", КодЕдиницыИзмерения);
	
	Возврат ТекстЗапроса;
	
КонецФункции

