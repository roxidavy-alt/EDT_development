#КонецОбласти

#Область ДОПП

// Заполнить регл отчет Документ о предстоящей поставке.
// 
// Параметры:
//  ПараметрыОтчета - Структура - параметры регл. отчета.
//  Контейнер - Структура - данные регл. отчета.
Процедура ЗаполнитьУведомлениеОПредстоящейПоставке(ПараметрыОтчета, КонтейнерДОПП) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ИспользоватьПодакцизныеТовары = УчетПодакцизныхТоваров.ИспользуетсяИмпортПодакцизныхТоваров(
					ПараметрыОтчета.Организация, ПараметрыОтчета.ДатаПодписи);
		
	МассивОснований = ПараметрыОтчета.МассивДокументов;
	
	ЧастиТекстаЗапроса = Новый Массив();
	Если МассивОснований.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("ОсобыйПризнакДОПП", "0");
		ТипОснования = ТипЗнч(МассивОснований[0]);
		Если ТипОснования = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			ТекстЧастиЗапроса = ТекстЗаполненияДОППЗакупкаШапка();
			ЧастиТекстаЗапроса.Добавить(ТекстЧастиЗапроса);
			ТекстЧастиЗапроса = ТекстЗаполненияДОППЗакупкаТовары();
		ИначеЕсли ТипОснования = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
			ТекстЧастиЗапроса = ТекстЗаполненияДОППШапка("ПриобретениеТоваровУслуг");
			ЧастиТекстаЗапроса.Добавить(ТекстЧастиЗапроса);
			ТекстЧастиЗапроса = ТекстЗаполненияДОПППриобретениеТовары();
		ИначеЕсли ТипОснования = Тип("ДокументСсылка.ЗаявкаНаВозвратТоваровОтКлиента") Тогда
			ТекстЧастиЗапроса = ТекстЗаполненияДОППШапка("ЗаявкаНаВозвратТоваровОтКлиента");
			ЧастиТекстаЗапроса.Добавить(ТекстЧастиЗапроса);
			ТекстЧастиЗапроса = ТекстЗаполненияДОППТовары("ЗаявкаНаВозвратТоваровОтКлиента", "ВозвращаемыеТовары");
			Запрос.УстановитьПараметр("ОсобыйПризнакДОПП", "6");
		
		// ++ НЕ УТКА
		
		ИначеЕсли ТипОснования = Тип("ДокументСсылка.ЗаказДавальца2_5") Тогда
			ТекстЧастиЗапроса = ТекстЗаполненияДОППШапка("ЗаказДавальца2_5");
			ЧастиТекстаЗапроса.Добавить(ТекстЧастиЗапроса);
			ТекстЧастиЗапроса = ТекстЗаполненияДОППЗакупкаТовары("ЗаказДавальца2_5", "Материалы");
			Запрос.УстановитьПараметр("ОсобыйПризнакДОПП", "5");
			
		// -- НЕ УТКА	
			
		ИначеЕсли ТипОснования = Тип("ДокументСсылка.ЗаказПереработчику2_5") Тогда
			ТекстЧастиЗапроса = ТекстЗаполненияДОППШапка("ЗаказПереработчику2_5");
			ЧастиТекстаЗапроса.Добавить(ТекстЧастиЗапроса);
			ТекстЧастиЗапроса = ТекстЗаполненияДОППЗаказПереработчику();
		Иначе
			ТекстЧастиЗапроса = ТекстЗаполненияДОППАренда(Запрос);
		КонецЕсли;
	
		ЧастиТекстаЗапроса.Добавить(ТекстЧастиЗапроса);
		
		// Получим параметры расчета суммы Акциза
		ТекстЧастиЗапроса =
			УчетПодакцизныхТоваров.ТекстЗапросаДанныеПодакцизныхТоваров(ИспользоватьПодакцизныеТовары, "ВтТоварыОснования");
			
		ЧастиТекстаЗапроса.Добавить(ТекстЧастиЗапроса);
		
		ТекстЧастиЗапроса =
		"ВЫБРАТЬ
		|	ДокументОснованиеДОППТовары.НомерСтроки КАК НомерСтроки,
		|	ДокументОснованиеДОППТовары.Номенклатура КАК Номенклатура,
		|	ДокументОснованиеДОППТовары.Договор КАК Договор,
		|	ДокументОснованиеДОППТовары.Количество КАК Количество,
		|	ДокументОснованиеДОППТовары.ФактурнаяСтоимость КАК ФактурнаяСтоимость,
		|	ВЫБОР
		|		КОГДА КлючиВидовПродукцииИС.Ссылка ЕСТЬ NULL
		|			ИЛИ КлючиВидовПродукцииИС.ВидПродукцииГИСМТ = ЗНАЧЕНИЕ(Справочник.КлючиВидовПродукцииИС.ПустаяСсылка)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ
		|			ИСТИНА
		|	КОНЕЦ КАК МаркируемыйТовар,
		|	ЕСТЬNULL(ПодакцизныеТовары.КоэффициентПересчетаЕдиницИзмерения, 0)
		|		 * ДокументОснованиеДОППТовары.Количество КАК НалоговаяБазаАкцизы,
		|	ЕСТЬNULL(ПодакцизныеТовары.Ставка, 0) КАК ТвердаяСтавкаАкциза,
		|	0 КАК АдвалорнаяСтавкаАкциза, // Адвалорная Ставка не поддерживается
		|	ЕСТЬNULL(ПодакцизныеТовары.СтавкаРегл, 0) * ЕСТЬNULL(ПодакцизныеТовары.КоэффициентПересчетаЕдиницИзмерения, 0)
		|		 * ДокументОснованиеДОППТовары.Количество КАК СуммаАкциза,
		|	ЕСТЬNULL(ПодакцизныеТовары.ПодакцизныйТовар, ЛОЖЬ) КАК ПодакцизныйТовар,
		|	ДокументОснованиеДОППТовары.ОсобыйПризнакДОПП КАК ОсобыйПризнакДОПП,
		|	ЕстьNULL(ДокументОснованиеДОППТовары.КодТНВЭД, """") КАК КодТНВЭД,
		|	ЕстьNULL(ДокументОснованиеДОППТовары.КодСтраныПроисхождения, """") КАК КодСтраныПроисхождения,
		|	ЕстьNULL(ДокументОснованиеДОППТовары.НаименованиеПолноеСтраныПроисхождения, """") КАК НаименованиеПолноеСтраныПроисхождения,
		|	ЕстьNULL(ДокументОснованиеДОППТовары.КодЕдиницыИзмерения, """") КАК КодЕдиницыИзмерения,
		|	ЕстьNULL(ДокументОснованиеДОППТовары.НомерДекларацииНаТовары, """") КАК НомерДекларацииНаТовары,
		|	ВЫБОР
		|		КОГДА СтавкиНДСНоменклатуры.Номенклатура ЕСТЬ NULL
		|			ТОГДА &ОсновнаяСтавкаНДС
		|		КОГДА СтавкиНДСНоменклатуры.СтавкаНДС.ПеречислениеСтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10)
		|			ТОГДА 10
		|		ИНАЧЕ
		|			&ОсновнаяСтавкаНДС
		|	КОНЕЦ КАК СтавкаНДС,
		|	ДокументОснованиеДОППТовары.ТоварНаименованиеПолное КАК ТоварНаименованиеПолное,
		|	ЕСТЬNULL(ПодакцизныеТовары.КодАкциза, """") КАК КодВидаПодакцизногоТовара
		|ИЗ
		|	ВтТоварыОснования КАК ДокументОснованиеДОППТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПодакцизныеТовары КАК ПодакцизныеТовары
		|			ПО ДокументОснованиеДОППТовары.Номенклатура = ПодакцизныеТовары.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиНДСНоменклатуры.СрезПоследних(, Страна = &СтранаРегистрации) КАК СтавкиНДСНоменклатуры
		|			ПО ДокументОснованиеДОППТовары.Номенклатура = СтавкиНДСНоменклатуры.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
		|			ПО ДокументОснованиеДОППТовары.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиВидовПродукцииИС КАК КлючиВидовПродукцииИС
		|			ПО ОписаниеНоменклатурыИС.КлючВидовПродукции = КлючиВидовПродукцииИС.Ссылка
		|";
		
		ЧастиТекстаЗапроса.Добавить(ТекстЧастиЗапроса);
		ТекстЗапроса = СтрСоединить(ЧастиТекстаЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
		
		Запрос.Текст = ТекстЗапроса;
		
		Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьМногострановойУчет") Тогда
			Запрос.УстановитьПараметр("СтранаРегистрации", ЗначениеНастроекКлиентСерверПовтИсп.ОсновнаяСтрана());
		Иначе
			Страна = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.Организация, "СтранаРегистрации");
			Запрос.УстановитьПараметр("СтранаРегистрации", Страна);
		КонецЕсли;
		
		ОсновнаяСтавкаНДССсылка = УчетНДСУП.СтавкаНДСПоУмолчанию(ПараметрыОтчета.Организация, ПараметрыОтчета.ДатаПодписи);
		ОсновнаяСтавкаНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновнаяСтавкаНДССсылка, "Ставка");
		
		ВалютаРегламентированногоУчета = ЗначениеНастроекПовтИсп.ВалютаРегламентированногоУчетаОрганизации(ПараметрыОтчета.Организация);
		Запрос.УстановитьПараметр("Ссылки",            ПараметрыОтчета.МассивДокументов);
		Запрос.УстановитьПараметр("ДатаПодписи",       ПараметрыОтчета.ДатаПодписи);
		Запрос.УстановитьПараметр("Период",            ПараметрыОтчета.ДатаПодписи);
		Запрос.УстановитьПараметр("ДатаВвоза",         ПараметрыОтчета.ДатаПодписи + 2*86400);
		Запрос.УстановитьПараметр("БазоваяВалюта",     ВалютаРегламентированногоУчета);
		Запрос.УстановитьПараметр("ОсновнаяСтавкаНДС", ОсновнаяСтавкаНДС);
		
		Результат = Запрос.ВыполнитьПакет();
		КоличествоЗапросов = Результат.Количество();
		ТаблицаТовары = Результат[КоличествоЗапросов - 1].Выгрузить();
		
		Если ТаблицаТовары.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Шапка = Результат[0].Выбрать();
		ЗаполнятьТитул = Истина;
		УИДДоговоров = Новый Соответствие;
		ОбесПлатеж = 0;
		
		Пока Шапка.СледующийПоЗначениюПоля("ДоговорКонтрагента") Цикл
			
			Если ЗаполнятьТитул Тогда
				// Состав контейнера
				// Титул - Структура
				Титул = КонтейнерДОПП.Титульная;
				
				ГоловнаяОрганизация         = БухгалтерскийУчетПереопределяемый.ГоловнаяОрганизация(Шапка.Организация);
				РегистрацияВНалоговомОргане = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГоловнаяОрганизация, "РегистрацияВНалоговомОргане");
				ЭтоЮЛ                       = ОбщегоНазначенияБПВызовСервераПовтИсп.ЭтоЮрЛицо(ГоловнаяОрганизация);
				Реквизиты                   = РегистрацияВНОСервер.ДанныеРегистрации(РегистрацияВНалоговомОргане);
				КодНалоговогоОргана         = Реквизиты.Код;
				
				Если ЭтоЮЛ Тогда 
					СтрокаСведений = "ФамилияРук,ИмяРук,ОтчествоРук";
					СведенияОбОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
											ГоловнаяОрганизация,
											Шапка.Дата,
											СтрокаСведений);
				Иначе
					СтрокаСведений = "ФамилияИП,ИмяИП,ОтчествоИП";
					СведенияОбОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
											ГоловнаяОрганизация,
											Шапка.Дата,
											СтрокаСведений);
				КонецЕсли;
				
				СведенияОПродавце   = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Шапка.Контрагент, Шапка.Дата);
				
				Титул.ДатаВвоз      = Шапка.ДатаВвоза;
				Титул.НаимОрг       = Шапка.ОрганизацияНаименованиеПолное;
				Титул.ИНН           = Шапка.ОрганизацияИНН;
				Титул.КПП           = Шапка.ОрганизацияКПП;
				
				Титул.ОсПрЗаяв      = Шапка.ОсобыйПризнакЗаявителя;
				Титул.ИнОсПрЗаяв    = ?(Шапка.ОсобыйПризнакЗаявителя = "2", Шапка.ИнойОсобыйПризнакЗаявителя, "");
				Титул.КодНО         = КодНалоговогоОргана;
				
				Титул.НаимПрод      = Шапка.ПродавецНаименованиеПолное;
				Титул.АдресПрод     = СведенияОПродавце.ЮридическийАдрес;
				Титул.ОКСМПрод      = Шапка.КодСтраныРегистрацииПродавца;
				Титул.РегНомПрод  = ?(Шапка.ПродавецСтранаРегистрации = Справочники.СтраныМира.Россия, Шапка.ПродавецИНН, Шапка.ПродавецРегистрационныйНомер);
				
				Титул.ВидТС         = "1";
				Титул.РегЗнакТС     = "";
				Титул.НомерПрицеп1  = "";
				Титул.НомерПрицеп2  = "";
			
				Титул.ДАТА_ПОДПИСИ  = Шапка.Дата;
				
				ПодписантФамилия  = "";
				ПодписантИмя      = "";
				ПодписантОтчество = "";
				Если ЗначениеЗаполнено(Реквизиты.Представитель) Тогда
					СведенияОПредставителе = РегламентированнаяОтчетностьВызовСервера.ПолучитьПоКодамСведенияОПредставителе(
						Шапка.Организация,
						КодНалоговогоОргана,
						Реквизиты.КПП);
					Если ЗначениеЗаполнено(СведенияОПредставителе.НаименованиеОрганизацииПредставителя) Тогда
						ПодписантСтр = СведенияОПредставителе.ФИОПредставителя;
						ФИО = РегламентированнаяОтчетность.РазложитьФИО(ПодписантСтр);
						ПодписантФамилия = СокрЛП(ФИО.Фамилия);
						ПодписантИмя = СокрЛП(ФИО.Имя);
						ПодписантОтчество = СокрЛП(ФИО.Отчество);
					Иначе
						ДанныеПредставителя = РегламентированнаяОтчетностьПереопределяемый.ПолучитьСведенияОФизЛице(
							Реквизиты.Представитель,
							,
							Шапка.Дата);
						ПодписантФамилия  = СокрЛП(ДанныеПредставителя.Фамилия);
						ПодписантИмя      = СокрЛП(ДанныеПредставителя.Имя);
						ПодписантОтчество = СокрЛП(ДанныеПредставителя.Отчество);
						ПодписантСтр = СокрЛП(ПодписантФамилия + " " + ПодписантИмя + " " + ПодписантОтчество);
					КонецЕсли;
					Титул.Вставить("ФИО_РУКОВОДИТЕЛЯ_ПРЕДСТАВИТЕЛЯ", ПодписантСтр);
					Титул.Вставить("ПРИЗНАК_НП_ПОДВАЛ",              "2");
					Титул.Вставить("НаимДок",                        Реквизиты.ДокументПредставителя);
				Иначе
					Если ЭтоЮЛ Тогда
						ПодписантФамилия  = СведенияОбОрганизации.ФамилияРук;
						ПодписантИмя      = СведенияОбОрганизации.ИмяРук;
						ПодписантОтчество = СведенияОбОрганизации.ОтчествоРук;
					Иначе
						ПодписантФамилия  = СведенияОбОрганизации.ФамилияИП;
						ПодписантИмя      = СведенияОбОрганизации.ИмяИП;
						ПодписантОтчество = СведенияОбОрганизации.ОтчествоИП;
					КонецЕсли;
					ПодписантСтр = СокрЛП(ПодписантФамилия + " " + ПодписантИмя + " " + ПодписантОтчество);
					Титул.Вставить("ФИО_РУКОВОДИТЕЛЯ_ПРЕДСТАВИТЕЛЯ", ПодписантСтр);
					Титул.Вставить("ПРИЗНАК_НП_ПОДВАЛ",              "1");
					Титул.Вставить("НаимДок",                        "");
				КонецЕсли;
				
				//Титул.Фамилия
				//Титул.Имя
				//Титул.Отчество
				
				ЗаполнятьТитул = Ложь;
				
			КонецЕсли;
			
			// Договор - ТаблицаЗначений
			Договоры = КонтейнерДОПП.Договор;
			Договор = Договоры.Добавить();
			
			ДатаКурсаВалют = Шапка.Дата - 86400;
			СтруктураКурса = РаботаСКурсамиВалютУТ.ПолучитьКурсВалюты(Шапка.ВалютаДокумента, ДатаКурсаВалют);
			Если СтруктураКурса.КурсЗнаменатель = 0 Тогда
				СтруктураКурса.КурсЗнаменатель = 1;
			КонецЕсли;
			
			УИДДоговора    = Новый УникальныйИдентификатор();
			
			ПараметрыДоговора = Новый Структура();
			ПараметрыДоговора.Вставить("УИДДоговора",       УИДДоговора);
			ПараметрыДоговора.Вставить("Курс",              СтруктураКурса.КурсЧислитель);
			ПараметрыДоговора.Вставить("Кратность",         СтруктураКурса.КурсЗнаменатель);
			ПараметрыДоговора.Вставить("ОсобыйПризнакДОПП", Шапка.ОсобыйПризнакДОПП);
			ПараметрыДоговора.Вставить("КодСтраныРегистрацииПродавца", Шапка.КодСтраныРегистрацииПродавца);
			ПараметрыДоговора.Вставить("СтранаРегистрацииПродавца",    Шапка.СтранаРегистрацииПродавца);
			
			УИДДоговоров.Вставить(Шапка.ДоговорКонтрагента, ПараметрыДоговора);
			
			Договор.БазаВалют     = СтруктураКурса.КурсЗнаменатель;
			Договор.КурсВалют     = СтруктураКурса.КурсЧислитель;
			Договор.ДатаКурсВалют = ДатаКурсаВалют;
			Договор.КодВалют      = Шапка.КодаВалюты;
			Договор.ДатаДог       = Шапка.ДатаДоговора;
			Договор.НомерДог      = Шапка.НомерДоговора;
			Договор.УИД           = УИДДоговора;
			Договор.ПрСпецТов     = "2";
			
		КонецЦикла;
			
		// Состав контейнера
		// ТоварыДоговор - ТаблицаЗначений
		ТоварДоговор = КонтейнерДОПП.ТоварДоговор;
		
		Для каждого СтрокаТовара Из ТаблицаТовары Цикл
			
			ПараметрыДоговора = УИДДоговоров.Получить(СтрокаТовара.Договор);
			
			Если ПараметрыДоговора = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ЭлементКонтейнера = ТоварДоговор.Добавить();
			
			ЭлементКонтейнера.ОсобПризн    = ?(ЗначениеЗаполнено(СтрокаТовара.ОсобыйПризнакДОПП), СтрокаТовара.ОсобыйПризнакДОПП, ПараметрыДоговора.ОсобыйПризнакДОПП);
			Если ЭлементКонтейнера.ОсобПризн = "0" Тогда
				ЭлементКонтейнера.АкцАдвСт     = СтрокаТовара.АдвалорнаяСтавкаАкциза;
				ЭлементКонтейнера.АкцизАдвБаза = ?(СтрокаТовара.АдвалорнаяСтавкаАкциза > 0, СтрокаТовара.НалоговаяБазаАкцизы, 0);
				ЭлементКонтейнера.СумАкцизАдв  = ?(СтрокаТовара.АдвалорнаяСтавкаАкциза > 0, СтрокаТовара.СуммаАкциза, 0);
				
				ЭлементКонтейнера.АкцТвСт      = СтрокаТовара.ТвердаяСтавкаАкциза;
				ЭлементКонтейнера.АкцизТвБаза  = ?(СтрокаТовара.ТвердаяСтавкаАкциза > 0, СтрокаТовара.НалоговаяБазаАкцизы, 0);
				ЭлементКонтейнера.СумАкцизТв   = ?(СтрокаТовара.ТвердаяСтавкаАкциза > 0, СтрокаТовара.СуммаАкциза, 0);
				
				Если Шапка.ВалютаДокумента <> ВалютаРегламентированногоУчета Тогда
					НалоговаяБазаНДС = Окр((СтрокаТовара.ФактурнаяСтоимость * (ПараметрыДоговора.Курс/ПараметрыДоговора.Кратность)), 2);
				Иначе
					НалоговаяБазаНДС = СтрокаТовара.ФактурнаяСтоимость;
				КонецЕсли;
				
				ЭлементКонтейнера.НДССт        = Строка(СтрокаТовара.СтавкаНДС);
				ЭлементКонтейнера.НДСБаза      = НалоговаяБазаНДС + ЭлементКонтейнера.СумАкцизТв;
				ЭлементКонтейнера.СумНДС       = ЭлементКонтейнера.НДСБаза * СтрокаТовара.СтавкаНДС / 100;
			Иначе
				ЭлементКонтейнера.СумНДС = 0;
				ЭлементКонтейнера.СумАкцизТв = 0;
				ЭлементКонтейнера.НДСБаза = 0;
				ЭлементКонтейнера.АкцизАдвБаза = 0;
			КонецЕсли;
			
			ЭлементКонтейнера.КодПТ        = СтрокаТовара.КодВидаПодакцизногоТовара;
			ЭлементКонтейнера.НаимТов      = СтрокаТовара.ТоварНаименованиеПолное;
			
			ЭлементКонтейнера.КолТов       = СтрокаТовара.Количество;
			
			ЭлементКонтейнера.ОКЕИ         = СокрЛП(Строка(СтрокаТовара.КодЕдиницыИзмерения));
			ЭлементКонтейнера.НомерДекл    = СтрокаТовара.НомерДекларацииНаТовары;
			
			ЭлементКонтейнера.ПрПТ         = ?(СтрокаТовара.ПодакцизныйТовар, "1", "0");
			ЭлементКонтейнера.СтоимТов     = СтрокаТовара.ФактурнаяСтоимость;
			Если ЭлементКонтейнера.ОсобПризн = "7" Или ЭлементКонтейнера.ОсобПризн = "9" Тогда
				ЭлементКонтейнера.ОКСМПроисх   = СокрЛП(Строка(ПараметрыДоговора.КодСтраныРегистрацииПродавца));
				ЭлементКонтейнера.СтрПроисх    = ПараметрыДоговора.СтранаРегистрацииПродавца;
			Иначе
				ЭлементКонтейнера.ОКСМПроисх   = СокрЛП(Строка(СтрокаТовара.КодСтраныПроисхождения));
				ЭлементКонтейнера.СтрПроисх    = СтрокаТовара.НаименованиеПолноеСтраныПроисхождения;
			КонецЕсли;
			ЭлементКонтейнера.ТНВЭД        = СтрокаТовара.КодТНВЭД;
			ЭлементКонтейнера.УИД          = Новый УникальныйИдентификатор();
			ЭлементКонтейнера.УИДРодителя  = ПараметрыДоговора.УИДДоговора;
			ЭлементКонтейнера.МаркируемыйТовар = СтрокаТовара.МаркируемыйТовар;
			
			ОбесПлатеж = ОбесПлатеж + ЭлементКонтейнера.СумНДС + ?(СтрокаТовара.МаркируемыйТовар, 0, ЭлементКонтейнера.СумАкцизТв);
			
		КонецЦикла;
		
		Титул.СумОбПлат = ?(Титул.ОсПрЗаяв = "0", ОбесПлатеж, 0);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Акцизы

#Область Импорт

Процедура ПолучитьСведенияОПоказателяхОтчетаКосвенныеНалогиПриИмпортеФормаОтчета2023Кв3_Акцизы(ПоказателиОтчета) Экспорт
	
	// Раздел 2
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000020001003", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00002М102000", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00002М204000", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00002М300001", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00002М300002", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00002М300003", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00002М300004", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00002М300005", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00002М305000", Истина, Ложь);
	
КонецПроцедуры

Процедура ЗаполнитьОтчетКосвенныеНалогиПриИмпортеФормаОтчета2023Кв3_Акцизы(ПараметрыОтчета, Контейнер) Экспорт
	
	Организация = ПараметрыОтчета.Организация;
	ДатаСведений = ПараметрыОтчета.ДатаПодписи;
	
	ОтчетОбъект = РегламентированнаяОтчетностьВызовСервера.ОтчетОбъект("РегламентированныйОтчетКосвенныеНалогиТамСоюз");
	МакетСоставаПоказателей = ОтчетОбъект.ПолучитьМакет("СпискиВыбора2025Кв1");
	
	КатегорииПодакцизныхТоваров = ПолучитьКатегорииПодакцизныхТоваров(МакетСоставаПоказателей, "КодыВидаПТ_Раздел2");
	
	НачалоПериодаОтчета = ПараметрыОтчета.мДатаНачалаПериодаОтчета;
	КонецПериодаОтчета  = ПараметрыОтчета.мДатаКонцаПериодаОтчета;
	
	НалоговыйОрган = Справочники.РегистрацииВНалоговомОргане.РегистрацияВНалоговомОрганеПоКодуНО(
		Организация, ПараметрыОтчета.КПП, ПараметрыОтчета.КодНалоговогоОргана);
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НалоговыйОрган, "КрупнейшийНалогоплательщик") = Истина Тогда
		НалоговыйОрган = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "РегистрацияВНалоговомОргане");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.КодБК КАК КодБК,
	|	Т.КодПодакцизногоТовара КАК КодПодакцизногоТовара
	|ПОМЕСТИТЬ КБКПоВидамПодакцизныхТоваров
	|ИЗ &ТаблицаКБК КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Категории.Ссылка КАК Категория,
	|	ЕСТЬNULL(КБКПоВидамПодакцизныхТоваров.КодБК, """") КАК КодБК,
	|	ВЫБОР КОГДА Категории.Код = ""298""
	|		ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СахаросодержащиеНапитки
	|ПОМЕСТИТЬ СписокКатегорий
	|ИЗ
	|	Справочник.КатегорииПодакцизныхТоваров КАК Категории
	|	ЛЕВОЕ СОЕДИНЕНИЕ КБКПоВидамПодакцизныхТоваров КАК КБКПоВидамПодакцизныхТоваров
	|		ПО Категории.Код = КБКПоВидамПодакцизныхТоваров.КодПодакцизногоТовара
	|
	|ГДЕ
	|	Категории.Код В (&КодыКатегорий)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДействующиеРегистрации.Подразделение КАК Подразделение,
	|	ДействующиеРегистрации.РегистрацияВНалоговомОргане
	|ПОМЕСТИТЬ ДействующиеРегистрации
	|ИЗ
	|	РегистрСведений.РегистрацииВНалоговомОргане.СрезПоследних(
	|		&ДатаСведений, Организация = &Организация) КАК ДействующиеРегистрации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДействующиеРегистрации.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ СписокПодразделений
	|ИЗ
	|	ДействующиеРегистрации КАК ДействующиеРегистрации
	|
	|ГДЕ
	|	ДействующиеРегистрации.РегистрацияВНалоговомОргане = &НалоговыйОрган
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СтруктураПредприятия.Ссылка
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	|	ЛЕВОЕ СОЕДИНЕНИЕ ДействующиеРегистрации КАК РегистрацииПодразделений
	|		ПО СтруктураПредприятия.Ссылка = РегистрацииПодразделений.Подразделение
	|	ЛЕВОЕ СОЕДИНЕНИЕ ДействующиеРегистрации КАК РегистрацияОрганизации
	|		ПО РегистрацияОрганизации.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|
	|ГДЕ
	|	ЕСТЬNULL(РегистрацииПодразделений.РегистрацияВНалоговомОргане,
	|		РегистрацияОрганизации.РегистрацияВНалоговомОргане
	|	) = &НалоговыйОрган
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КатегорииПодакцизныхТоваров.КодБК КАК КодБК,
	|	КатегорииПодакцизныхТоваров.Категория КАК Категория,
	|	КатегорииПодакцизныхТоваров.Категория.Код КАК КодКатегории,
	|	КатегорииПодакцизныхТоваров.Категория.ЕдиницаИзмерения.Код КАК КодЕдИзм,
	|	ВЫРАЗИТЬ(ВЫБОР КОГДА ДвиженияПоАкцизам.Регистратор ССЫЛКА Документ.Сторно
	|		ТОГДА ВЫРАЗИТЬ(ДвиженияПоАкцизам.Регистратор КАК Документ.Сторно).СторнируемыйДокумент
	|		ИНАЧЕ ДвиженияПоАкцизам.Регистратор
	|	КОНЕЦ КАК Документ.ЗаявлениеОВвозеТоваров).Контрагент.СтранаРегистрации КАК СтранаЕАЭС,
	|	ВЫБОР
	|		КОГДА КатегорииПодакцизныхТоваров.СахаросодержащиеНапитки ТОГДА 0
	|		ИНАЧЕ КатегорииПодакцизнойНоменклатуры.КоэффициентПересчета
	|	КОНЕЦ КАК Коэффициент,
	|	СУММА(ДвиженияПоАкцизам.КоличествоАкцизаОборот) КАК НалоговаяБаза,
	|	СУММА(ДвиженияПоАкцизам.СуммаАкцизаРеглОборот) КАК СуммаАкциза,
	|	ВЫБОР
	|		КОГДА КатегорииПодакцизныхТоваров.СахаросодержащиеНапитки ТОГДА 0
	|		ИНАЧЕ СУММА(ДвиженияПоАкцизам.КоличествоОборот)
	|	КОНЕЦ КАК Количество
	|ИЗ
	|	РегистрНакопления.ДвиженияПоАкцизам.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Организация = &Организация
	|				И КатегорияПодакцизногоТовара В (ВЫБРАТЬ Категория ИЗ СписокКатегорий)
	|				И ПодразделениеУплатыАкциза В (ВЫБРАТЬ Подразделение ИЗ СписокПодразделений)
	|				И ВидОперацииСПодакцизнымТоваром = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСПодакцизнымТоваром.ВвозИзЕАЭС)
	|		) КАК ДвиженияПоАкцизам
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокКатегорий КАК КатегорииПодакцизныхТоваров
	|		ПО ДвиженияПоАкцизам.КатегорияПодакцизногоТовара = КатегорииПодакцизныхТоваров.Категория
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииПодакцизныхТоваров.СрезПоследних(
	|			&КонецПериода,
	|			Страна = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|		) КАК КатегорииПодакцизнойНоменклатуры
	|		ПО ДвиженияПоАкцизам.Номенклатура = КатегорииПодакцизнойНоменклатуры.Номенклатура
	|			И ДвиженияПоАкцизам.КатегорияПодакцизногоТовара = КатегорииПодакцизнойНоменклатуры.КатегорияПодакцизногоТовара
	|			И КатегорииПодакцизнойНоменклатуры.ПодакцизныйТовар
	|
	|ГДЕ
	|	ВЫБОР КОГДА ДвиженияПоАкцизам.Регистратор ССЫЛКА Документ.Сторно
	|		ТОГДА ВЫРАЗИТЬ(ДвиженияПоАкцизам.Регистратор КАК Документ.Сторно).СторнируемыйДокумент
	|		ИНАЧЕ ДвиженияПоАкцизам.Регистратор
	|	КОНЕЦ ССЫЛКА Документ.ЗаявлениеОВвозеТоваров
	|	И ВЫРАЗИТЬ(ВЫБОР КОГДА ДвиженияПоАкцизам.Регистратор ССЫЛКА Документ.Сторно
	|		ТОГДА ВЫРАЗИТЬ(ДвиженияПоАкцизам.Регистратор КАК Документ.Сторно).СторнируемыйДокумент
	|		ИНАЧЕ ДвиженияПоАкцизам.Регистратор
	|	КОНЕЦ КАК Документ.ЗаявлениеОВвозеТоваров).Контрагент.СтранаРегистрации.УчастникЕАЭС = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ВЫБОР КОГДА ДвиженияПоАкцизам.Регистратор ССЫЛКА Документ.Сторно
	|		ТОГДА ВЫРАЗИТЬ(ДвиженияПоАкцизам.Регистратор КАК Документ.Сторно).СторнируемыйДокумент
	|		ИНАЧЕ ДвиженияПоАкцизам.Регистратор
	|	КОНЕЦ КАК Документ.ЗаявлениеОВвозеТоваров).Контрагент.СтранаРегистрации,
	|	ВЫБОР
	|		КОГДА КатегорииПодакцизныхТоваров.СахаросодержащиеНапитки ТОГДА 0
	|		ИНАЧЕ КатегорииПодакцизнойНоменклатуры.КоэффициентПересчета
	|	КОНЕЦ,
	|	КатегорииПодакцизныхТоваров.СахаросодержащиеНапитки,
	|	КатегорииПодакцизныхТоваров.Категория,
	|	КатегорииПодакцизныхТоваров.КодБК
	|
	|ИМЕЮЩИЕ
	|	СУММА(ДвиженияПоАкцизам.КоличествоАкцизаОборот) <> 0
	|	ИЛИ СУММА(ДвиженияПоАкцизам.СуммаАкцизаРеглОборот) <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодКатегории
	|
	|ИТОГИ ПО
	|	КодБК,
	|	СтранаЕАЭС";
	
	КБКПоКатегориямТоваров = Новый ТаблицаЗначений;
	
	Запрос.УстановитьПараметр("Организация",    Организация);
	Запрос.УстановитьПараметр("ДатаСведений",   ДатаСведений);
	Запрос.УстановитьПараметр("НалоговыйОрган", НалоговыйОрган);
	Запрос.УстановитьПараметр("НачалоПериода",  НачалоДня(НачалоПериодаОтчета));
	Запрос.УстановитьПараметр("КонецПериода",   КонецДня(КонецПериодаОтчета));
	Запрос.УстановитьПараметр("КодыКатегорий",  КатегорииПодакцизныхТоваров);
	Запрос.УстановитьПараметр("ТаблицаКБК",     КБКПоКатегориямТоваров);
	
	КБКПоКатегориямТоваров.Колонки.Добавить("КодПодакцизногоТовара", ОбщегоНазначения.ОписаниеТипаСтрока(3));
	КБКПоКатегориямТоваров.Колонки.Добавить("КодБК",                 ОбщегоНазначения.ОписаниеТипаСтрока(20));
	
	НоваяСтрока = КБКПоКатегориямТоваров.Добавить();
	НоваяСтрока.КодПодакцизногоТовара = "298";
	НоваяСтрока.КодБК = "18210402210011000110";
	
	Для Каждого Элемент Из СтрРазделить("510,520,531,532,533,534,535,536", ",", Ложь) Цикл
		НоваяСтрока = КБКПоКатегориямТоваров.Добавить();
		НоваяСтрока.КодПодакцизногоТовара = Элемент;
		НоваяСтрока.КодБК = "18210402060011000110";
	КонецЦикла;
	
	ПоказателиОтчета = Новый Структура;
	ПолучитьСведенияОПоказателяхОтчетаКосвенныеНалогиПриИмпортеФормаОтчета2023Кв3_Акцизы(ПоказателиОтчета);
	
	Раздел2 = Контейнер.Раздел2.Строки;
	Раздел2Данные    = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2[0].Данные);
	Раздел2ДанныеМнЧ = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2[0].ДанныеМногострочныхЧастей);
	Раздел2.Очистить();
	
	КодыБК = Раздел2ДанныеМнЧ.П00002М1.Строки;
	КодыБКДанные    = ОбщегоНазначения.СкопироватьРекурсивно(КодыБК[0].Данные);
	КодыБКДанныеМнЧ = ОбщегоНазначения.СкопироватьРекурсивно(КодыБК[0].ДанныеМногострочныхЧастей);
	КодыБК.Очистить();
	
	СтраныЕАЭС = КодыБКДанныеМнЧ.П00002М2.Строки;
	СтраныЕАЭСДанные    = ОбщегоНазначения.СкопироватьРекурсивно(СтраныЕАЭС[0].Данные);
	СтраныЕАЭСДанныеМнЧ = ОбщегоНазначения.СкопироватьРекурсивно(СтраныЕАЭС[0].ДанныеМногострочныхЧастей);
	СтраныЕАЭС.Очистить();
	
	КатегорииТоваров = СтраныЕАЭСДанныеМнЧ.П00002М3.Строки;
	КатегорииТоваровДанные = ОбщегоНазначения.СкопироватьРекурсивно(КатегорииТоваров[0].Данные);
	КатегорииТоваров.Очистить();
	
	ОчиститьПоляСтруктурыПоказателей(Раздел2Данные, ПоказателиОтчета);
	ОчиститьПоляСтруктурыПоказателей(КодыБКДанные, ПоказателиОтчета);
	ОчиститьПоляСтруктурыПоказателей(СтраныЕАЭСДанные, ПоказателиОтчета);
	ОчиститьПоляСтруктурыПоказателей(КатегорииТоваровДанные, ПоказателиОтчета);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		
		Раздел2Страница = Раздел2.Добавить();
		Раздел2Страница.Данные = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2Данные);
		Раздел2Страница.ДанныеМногострочныхЧастей = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2ДанныеМнЧ);
		
		Раздел2Страница.Данные.П000020001003 = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НалоговыйОрган, "КодПоОКТМО"));
		
		Раздел2Строки = Раздел2Страница.ДанныеМногострочныхЧастей.П00002М1.Строки;
		Раздел2Строки.Очистить();
		
	КонецЕсли;
	
	ВыборкаПоКБК = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоКБК.Следующий() Цикл
		
		Раздел2КБК = Раздел2Строки.Добавить();
		Раздел2КБК.Данные = ОбщегоНазначения.СкопироватьРекурсивно(КодыБКДанные);
		Раздел2КБК.Данные.П00002М102000 = ВыборкаПоКБК.КодБК;
		
		Раздел2КБК.ДанныеМногострочныхЧастей = ОбщегоНазначения.СкопироватьРекурсивно(КодыБКДанныеМнЧ);
		Раздел2СтраныЕАЭС = Раздел2КБК.ДанныеМногострочныхЧастей.П00002М2.Строки;
		Раздел2СтраныЕАЭС.Очистить();
		
		ВыборкаПоСтранам = ВыборкаПоКБК.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоСтранам.Следующий() Цикл
			
			Раздел2СтранаЕАЭС = Раздел2СтраныЕАЭС.Добавить();
			Раздел2СтранаЕАЭС.Данные = ОбщегоНазначения.СкопироватьРекурсивно(СтраныЕАЭСДанные);
			Если ЗначениеЗаполнено(ВыборкаПоСтранам.СтранаЕАЭС) Тогда
				Раздел2СтранаЕАЭС.Данные.П00002М204000 = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаПоСтранам.СтранаЕАЭС, "Код"));
			КонецЕсли;
			
			Раздел2СтранаЕАЭС.ДанныеМногострочныхЧастей = ОбщегоНазначения.СкопироватьРекурсивно(СтраныЕАЭСДанныеМнЧ);
			Раздел2КатегорииПодакцизныхТоваров = Раздел2СтранаЕАЭС.ДанныеМногострочныхЧастей.П00002М3.Строки;
			Раздел2КатегорииПодакцизныхТоваров.Очистить();
			
			ВыборкаПоКатегориям = ВыборкаПоСтранам.Выбрать();
			Пока ВыборкаПоКатегориям.Следующий() Цикл
				
				КодВидаПодакцизногоТовара = СокрЛП(ВыборкаПоКатегориям.КодКатегории);
				
				Раздел2Категория = Раздел2КатегорииПодакцизныхТоваров.Добавить();
				Раздел2Категория.Данные = ОбщегоНазначения.СкопироватьРекурсивно(КатегорииТоваровДанные);
				Раздел2Категория.Данные.П00002М300001 = КодВидаПодакцизногоТовара;
				Раздел2Категория.Данные.П00002М300002 = СокрЛП(ВыборкаПоКатегориям.КодЕдИзм);
				Раздел2Категория.Данные.П00002М300003 = ВыборкаПоКатегориям.Коэффициент;
				Раздел2Категория.Данные.П00002М300004 = ВыборкаПоКатегориям.Количество;
				Раздел2Категория.Данные.П00002М300005 = ВыборкаПоКатегориям.НалоговаяБаза;
				Раздел2Категория.Данные.П00002М305000 = ВыборкаПоКатегориям.СуммаАкциза;
				
				Раздел2Категория.ДанныеМногострочныхЧастей = Новый Структура;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Раздел2.Количество() = 0 Тогда
		
		Раздел2Страница = Раздел2.Добавить();
		Раздел2Страница.Данные                    = Раздел2Данные;
		Раздел2Страница.ДанныеМногострочныхЧастей = Раздел2ДанныеМнЧ;
		
		Раздел2ДанныеМнЧ.П00002М1.Строки.Очистить();
		Раздел2КБК = Раздел2ДанныеМнЧ.П00002М1.Строки.Добавить();
		Раздел2КБК.Данные                    = КодыБКДанные;
		Раздел2КБК.ДанныеМногострочныхЧастей = КодыБКДанныеМнЧ;
		
		КодыБКДанныеМнЧ.П00002М2.Строки.Очистить();
		Раздел2СтранаЕАЭС = КодыБКДанныеМнЧ.П00002М2.Строки.Добавить();
		Раздел2СтранаЕАЭС.Данные                    = СтраныЕАЭСДанные;
		Раздел2СтранаЕАЭС.ДанныеМногострочныхЧастей = СтраныЕАЭСДанныеМнЧ;
		
		СтраныЕАЭСДанныеМнЧ.П00002М3.Строки.Очистить();
		Раздел2Категория = СтраныЕАЭСДанныеМнЧ.П00002М3.Строки.Добавить();
		Раздел2Категория.Данные                    = КатегорииТоваровДанные;
		Раздел2Категория.ДанныеМногострочныхЧастей = Новый Структура;
		
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(Контейнер, ПараметрыОтчета.АдресВоВременномХранилище);
	
КонецПроцедуры

#КонецОбласти

#Область Алкоголь

Процедура ПолучитьСведенияОПоказателяхОтчетаАкцизыАлкогольФормаОтчета2025Кв1(ПоказателиОтчета) Экспорт
	
	// Раздел 1
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000010001003", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00001М102000", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00001М203000", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00001М204000", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00001М105000", Истина, Ложь);
	
	// Раздел 2
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000020001003", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000020002003", Истина, Ложь);
	
	// Подраздел 2.1. Операции, совершаемые с подакцизными товарами на территории Российской Федерации
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00021М100001", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00021М100002", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00021М100003", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00021М100004", Истина, Ложь);
	
	// Подраздел 2.4. Сумма акциза, подлежащая уплате в бюджет либо возмещению из бюджета
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00024М100001", Истина, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П00024М100002", Истина, Ложь);
	
КонецПроцедуры

Процедура ЗаполнитьОтчетАкцизыАлкогольФормаОтчета2025Кв1(ПараметрыОтчета, Контейнер) Экспорт
	
	Организация = ПараметрыОтчета.Организация;
	ДатаСведений = ПараметрыОтчета.ДатаПодписи;
	
	ОтчетОбъект = РегламентированнаяОтчетностьВызовСервера.ОтчетОбъект("РегламентированныйОтчетАкцизыАлкоголь");
	МакетСоставаПоказателей = ОтчетОбъект.ПолучитьМакет("СпискиВыбора2025Кв1");
	
	КатегорииПодакцизныхТоваров = ПолучитьКатегорииПодакцизныхТоваров(МакетСоставаПоказателей, "КодыВидаПодакцизныхТоваров");
	
	НачалоПериодаОтчета = ПараметрыОтчета.мДатаНачалаПериодаОтчета;
	КонецПериодаОтчета  = ПараметрыОтчета.мДатаКонцаПериодаОтчета;
	
	НалоговыйОрган = Справочники.РегистрацииВНалоговомОргане.РегистрацияВНалоговомОрганеПоКодуНО(
		Организация, ПараметрыОтчета.КПП, ПараметрыОтчета.КодНалоговогоОргана);
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НалоговыйОрган, "КрупнейшийНалогоплательщик") = Истина Тогда
		НалоговыйОрган = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "РегистрацияВНалоговомОргане");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаОперацииСПодакцизнымиТоварами());
	Запрос.УстановитьПараметр("ПоВсейОрганизации", Ложь);
	Запрос.УстановитьПараметр("Организации",    ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация));
	Запрос.УстановитьПараметр("ДатаСведений",   ДатаСведений);
	Запрос.УстановитьПараметр("НачалоПериода",  НачалоДня(НачалоПериодаОтчета));
	Запрос.УстановитьПараметр("КонецПериода",   КонецДня(КонецПериодаОтчета));
	Запрос.УстановитьПараметр("КодыКатегорий",  КатегорииПодакцизныхТоваров);
	Запрос.УстановитьПараметр("НалоговыйОрган", НалоговыйОрган);
	
	ПоказателиОтчета = Новый Структура;
	ПолучитьСведенияОПоказателяхОтчетаАкцизыАлкогольФормаОтчета2025Кв1(ПоказателиОтчета);
	
	Раздел1 = Контейнер.Раздел1.Строки;
	Раздел1Данные = Раздел1[0].Данные;
	
	Раздел2 = Контейнер.Раздел2.Строки;
	Раздел2Данные    = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2[0].Данные);
	Раздел2ДанныеМнЧ = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2[0].ДанныеМногострочныхЧастей);
	Раздел2.Очистить();
	
	Подраздел21Данные = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2ДанныеМнЧ.П00021М1.Строки[0].Данные);
	Подраздел24Данные = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2ДанныеМнЧ.П00024М1.Строки[0].Данные);
	
	ОчиститьПоляСтруктурыПоказателей(Раздел2Данные, ПоказателиОтчета);
	ОчиститьПоляСтруктурыПоказателей(Подраздел21Данные, ПоказателиОтчета);
	ОчиститьПоляСтруктурыПоказателей(Подраздел24Данные, ПоказателиОтчета);
	
	ОперацииНаТерриторииРФ = Новый ТаблицаЗначений;
	ОперацииНаТерриторииРФ.Колонки.Добавить("КодОперации",   ОбщегоНазначения.ОписаниеТипаСтрока(5));
	ОперацииНаТерриторииРФ.Колонки.Добавить("НалоговаяБаза", ОбщегоНазначения.ОписаниеТипаЧисло(15, 3));
	ОперацииНаТерриторииРФ.Колонки.Добавить("СуммаАкциза",   Метаданные.ОпределяемыеТипы.ДенежнаяСуммаЛюбогоЗнака.Тип);
	
	КодыВидовОпераций = Новый Соответствие;
	КодыВидовОпераций.Вставить(Перечисления.ВидыОперацийСПодакцизнымТоваром.Реализация,            "10001");
	КодыВидовОпераций.Вставить(Перечисления.ВидыОперацийСПодакцизнымТоваром.ВнутреннееПотребление, "10009");
	КодыВидовОпераций.Вставить(Перечисления.ВидыОперацийСПодакцизнымТоваром.Возврат,               "10001");
	
	Результат = Запрос.Выполнить();
	ВыборкаРегистраций = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "НалоговыйОрган");
	Пока ВыборкаРегистраций.Следующий() Цикл
		
		РеквизитыРегистрации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаРегистраций.НалоговыйОрган, "КПП, КодПоОКТМО");
		Раздел1Данные.П000010001003 = СокрЛП(РеквизитыРегистрации.КодПоОКТМО);
		
		ВыборкаКатегорий = ВыборкаРегистраций.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Категория");
		Пока ВыборкаКатегорий.Следующий() Цикл
			
			КодВидаПодакцизногоТовара = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаКатегорий.Категория, "Код"));
			Если "298" = КодВидаПодакцизногоТовара Тогда
				КодБК = "18210302480011000110";
			Иначе
				КодБК = "";
			КонецЕсли;
			
			Раздел2Страница = Раздел2.Добавить();
			
			Раздел2Страница.Данные = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2Данные);
			Раздел2Страница.Данные.П000020001003 = КодВидаПодакцизногоТовара;
			Раздел2Страница.Данные.П000020002003 = КодБК;
			
			Раздел2Страница.ДанныеМногострочныхЧастей = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2ДанныеМнЧ);
			
			ОперацииНаТерриторииРФ.Очистить();
			ДетальныеЗаписи = ВыборкаКатегорий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "");
			Пока ДетальныеЗаписи.Следующий() Цикл
				
				НоваяСтрока = ОперацииНаТерриторииРФ.Добавить();
				НоваяСтрока.КодОперации   = КодыВидовОпераций.Получить(ДетальныеЗаписи.ВидОперации);
				НоваяСтрока.НалоговаяБаза = ДетальныеЗаписи.Количество;
				НоваяСтрока.СуммаАкциза   = ДетальныеЗаписи.Сумма;
				
			КонецЦикла;
			
			ОперацииНаТерриторииРФ.Свернуть("КодОперации", "НалоговаяБаза, СуммаАкциза");
			ОперацииНаТерриторииРФ.Сортировать("КодОперации");
			
			Раздел2Таблица21 = Раздел2Страница.ДанныеМногострочныхЧастей.П00021М1.Строки;
			Раздел2Таблица21.Очистить();
			
			Если СтрРазделить("298,310,320,330", ",", Ложь).Найти(КодВидаПодакцизногоТовара) <> Неопределено Тогда
				ПризнакПримененияСтавкиАкциза = "4";
			КонецЕсли;
			
			Для Каждого СтрокаТаблицы Из ОперацииНаТерриторииРФ Цикл
				
				НоваяСтрока = Раздел2Таблица21.Добавить();
				НоваяСтрока.ДанныеМногострочныхЧастей = Новый Структура;
				НоваяСтрока.Данные = ОбщегоНазначения.СкопироватьРекурсивно(Подраздел21Данные);
				НоваяСтрока.Данные.П00021М100001 = СтрокаТаблицы.КодОперации;
				НоваяСтрока.Данные.П00021М100002 = ПризнакПримененияСтавкиАкциза;
				НоваяСтрока.Данные.П00021М100003 = СтрокаТаблицы.НалоговаяБаза;
				НоваяСтрока.Данные.П00021М100004 = СтрокаТаблицы.СуммаАкциза;
				
			КонецЦикла;
			
			Раздел2Таблица24 = Раздел2Страница.ДанныеМногострочныхЧастей.П00024М1.Строки;
			Раздел2Таблица24.Очистить();
			
			НоваяСтрока = Раздел2Таблица24.Добавить();
			НоваяСтрока.ДанныеМногострочныхЧастей = Новый Структура;
			НоваяСтрока.Данные = ОбщегоНазначения.СкопироватьРекурсивно(Подраздел24Данные);
			
			Если ОперацииНаТерриторииРФ.Итог("СуммаАкциза") >= 0 Тогда
				НоваяСтрока.Данные.П00024М100001 = "40001";
			Иначе
				НоваяСтрока.Данные.П00024М100001 = "40002";
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Раздел2.Количество() = 0 Тогда
		
		Раздел2Страница = Раздел2.Добавить();
		Раздел2Страница.Данные = Раздел2Данные;
		
		Раздел2ДанныеМнЧ.П00021М1.Строки.Очистить();
		НоваяСтрока = Раздел2ДанныеМнЧ.П00021М1.Строки.Добавить();
		НоваяСтрока.Данные = Подраздел21Данные;
		НоваяСтрока.ДанныеМногострочныхЧастей = Новый Структура;
		
		Раздел2ДанныеМнЧ.П00024М1.Строки.Очистить();
		НоваяСтрока = Раздел2ДанныеМнЧ.П00024М1.Строки.Добавить();
		НоваяСтрока.Данные = Подраздел24Данные;
		НоваяСтрока.ДанныеМногострочныхЧастей = Новый Структура;
		
		Раздел2Страница.ДанныеМногострочныхЧастей = Раздел2ДанныеМнЧ;
		
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(Контейнер, ПараметрыОтчета.АдресВоВременномХранилище);
	
КонецПроцедуры

#КонецОбласти

