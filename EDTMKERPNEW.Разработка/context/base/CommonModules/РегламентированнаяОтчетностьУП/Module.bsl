	|УНИЧТОЖИТЬ НоменклатураЕдиницаИзмеренияТНВЭД";
КонецФункции

Процедура СведенияОДокументахСтатформаИмпорт(Знач МассивДокументов, ТаблицаДокументы)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявлениеОВвозеТоваровСведенияОДокументах.Наименование КАК НаименованиеДокумента,
	|	ЗаявлениеОВвозеТоваровСведенияОДокументах.Номер КАК НомерДокумента,
	|	ЗаявлениеОВвозеТоваровСведенияОДокументах.Дата КАК ДатаДокумента,
	|	ЛОЖЬ КАК ЭтоСчетФактура
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.СведенияОДокументах КАК ЗаявлениеОВвозеТоваровСведенияОДокументах
	|ГДЕ
	|	ЗаявлениеОВвозеТоваровСведенияОДокументах.Ссылка В(&МассивДокументов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&Проформа,
	|	ЗаявлениеОВвозеТоваровТовары.СерияНомерТСД,
	|	ЗаявлениеОВвозеТоваровТовары.ДатаТСД,
	|	ЛОЖЬ
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.Товары КАК ЗаявлениеОВвозеТоваровТовары
	|ГДЕ
	|	ЗаявлениеОВвозеТоваровТовары.Ссылка В(&МассивДокументов)
	|	И ЕСТЬNULL(ЗаявлениеОВвозеТоваровТовары.ДатаТСД, ДАТАВРЕМЯ(1,1,1)) <> ДАТАВРЕМЯ(1,1,1)
	|	И ЕСТЬNULL(ЗаявлениеОВвозеТоваровТовары.СерияНомерТСД, """") <> """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&СчетФактура,
	|	ЗаявлениеОВвозеТоваровТовары.НомерСчетаФактуры,
	|	ЗаявлениеОВвозеТоваровТовары.ДатаСчетаФактуры,
	|	ИСТИНА
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.Товары КАК ЗаявлениеОВвозеТоваровТовары
	|ГДЕ
	|	ЗаявлениеОВвозеТоваровТовары.Ссылка В(&МассивДокументов)
	|	И ЕСТЬNULL(ЗаявлениеОВвозеТоваровТовары.ДатаСчетаФактуры, ДАТАВРЕМЯ(1,1,1)) <> ДАТАВРЕМЯ(1,1,1)
	|	И ЕСТЬNULL(ЗаявлениеОВвозеТоваровТовары.НомерСчетаФактуры, """") <> """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&Договор,
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.НомерДоговора,
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.ДатаДоговора,
	|	ЛОЖЬ
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.УчастникиСделки КАК ЗаявлениеОВвозеТоваровУчастникиСделки
	|ГДЕ
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.Ссылка В(&МассивДокументов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&Проформа,
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.НомерСпецификации,
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.ДатаСпецификации,
	|	ЛОЖЬ
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.УчастникиСделки КАК ЗаявлениеОВвозеТоваровУчастникиСделки
	|ГДЕ
	|	ЗаявлениеОВвозеТоваровУчастникиСделки.Ссылка В(&МассивДокументов)
	|	И ЕСТЬNULL(ЗаявлениеОВвозеТоваровУчастникиСделки.ДатаСпецификации, ДАТАВРЕМЯ(1,1,1)) <> ДАТАВРЕМЯ(1,1,1)
	|	И ЕСТЬNULL(ЗаявлениеОВвозеТоваровУчастникиСделки.НомерСпецификации, """") <> """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&Проформа,
	|	ЗаявлениеОВвозеТоваровСпецификации.НомерСпецификации,
	|	ЗаявлениеОВвозеТоваровСпецификации.ДатаСпецификации,
	|	ЛОЖЬ
	|ИЗ
	|	Документ.ЗаявлениеОВвозеТоваров.Спецификации КАК ЗаявлениеОВвозеТоваровСпецификации
	|ГДЕ
	|	ЗаявлениеОВвозеТоваровСпецификации.Ссылка В(&МассивДокументов)";
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Запрос.Параметры.Вставить("Договор", НСтр("ru = 'Договор''';
												|en = 'Договор'''"));
	Запрос.Параметры.Вставить("Проформа", НСтр("ru = 'Счет-проформа (проформа-инвойс)';
												|en = 'Proforma invoice (proforma invoice)'"));
	Запрос.Параметры.Вставить("СчетФактура", НСтр("ru = 'Счет-фактура (инвойс)';
													|en = 'Tax invoice'"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = ТаблицаДокументы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
		Если Выборка.ЭтоСчетФактура Тогда
			СтрокаТаблицы.НомерДокумента = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(
				Выборка.НомерДокумента, Истина, Ложь);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВидТранспортаНаГранице(Реквизиты, ЗаявлениеОВвозеТоваров)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаявлениеОВвозеТоваровТовары.ВидТранспорта КАК ВидТранспорта
		|ИЗ
		|	Документ.ЗаявлениеОВвозеТоваров.Товары КАК ЗаявлениеОВвозеТоваровТовары
		|ГДЕ
		|	ЗаявлениеОВвозеТоваровТовары.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаявлениеОВвозеТоваров);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Реквизиты.ВидТранспортаКод = Лев(Выборка.ВидТранспорта, 2);
		Реквизиты.ВидТранспортаНаименование = СокрЛП(Сред(Выборка.ВидТранспорта, 6));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбщиеОперации

// Создает список показателей для автоматического заполнения статистической формы учета перемещения товаров.
// Для версии отчета ФормаАналогЛК.
// Параметры:
//  ПоказателиОтчета - Структура - структура, в которую добавляются показатели отчета.
//
Процедура ПолучитьСведенияОПоказателяхОтчетаСтатистикаФормаУчетаПеремещенияТоваровТСФормаАналогЛК(ПоказателиОтчета) Экспорт
	
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "ЭК", Ложь, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "ИМ", Ложь, Ложь);
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, 
		"ДоступенПодборНоменклатурыИзСправочника", Ложь, Ложь);
	
	ПоказателиОтчета.Вставить("ИмяФормыПодбораОснований", "ОбщаяФорма.ПодборОснованийСтатформы");
	
КонецПроцедуры

Процедура ЗаполнитьОтчетСтатистикаФормаУчетаПеремещенияТоваровТСФормаАналогЛК(ПараметрыОтчета, Контейнер) Экспорт
	
	ЗаполнитьСтатистическуюФормуУчетаПеремещенияТоваров(ПараметрыОтчета, Контейнер);
	
КонецПроцедуры

Процедура ЗаполнитьСтатистическуюФормуУчетаПеремещенияТоваров(ПараметрыОтчета, Контейнер)
	
	Контейнер = ТаблицыСтатистическойФормыУчетаПеремещенияТоваров(ПараметрыОтчета.МассивДокументов,
		ПараметрыОтчета.НаправлениеПеремещения);
	
КонецПроцедуры

// Определяет Структуру таблиц значений для заполнения отчета "Статистическая форма учета перемещения товаров".
// 
// Параметры:
//  МассивДокументов       - Массив Из ДокументСсылка - при экспорте товаров в страны ЕАЭС
//                                                      массив из ДокументСсылка.РеализацияТоваровУслуг или
//                                                      ДокументСсылка.ОтгрузкаТоваровКлиенту.
//                                                      При импорте товаров из стран ЕАЭС массив из
//                                                      ДокументСсылка.ЗаявлениеОВвозеТоваров.
//  НаправлениеПеремещения - Строка - "ЭК" - экспорт товаров в страны ЕАЭС, "ИМ" - импорт товаров из стран ЕАЭС.
//
// Возвращаемое значение:
//  Структура - поля структуры:
//   * РеквизитыШапка                      - Структура
//   * ТаблицаДокументы                    - ТаблицаЗначений
//   * ТаблицаТоварыДляВыгрузки            - ТаблицаЗначений
//   * ШтрихкодыУпаковок                   - ТаблицаЗначений,Неопределено
//   * КурсыВалютыНаДатыДокументовОтгрузки - ТаблицаЗначений
Функция ТаблицыСтатистическойФормыУчетаПеремещенияТоваров(МассивДокументов, НаправлениеПеремещения) Экспорт
	
	// Инициализация структуры результата для возврата значения функции.
	
	РеквизитыШапка = Новый Структура;
	ТаблицаТоварыДляВыгрузки = Новый ТаблицаЗначений;
	ШтрихкодыУпаковок = Неопределено;
	КурсыВалютыНаДатыДокументовОтгрузки = Новый ТаблицаЗначений;
	
	// Товаросопроводительные документы не хранятся в экспортных документах отгрузки  в структурированном виде.
	// Товаросопроводительные документы и спецификации при импорте отображаются как "Счет-проформа (проформа-инвойс)".
	ТаблицаДокументы = Новый ТаблицаЗначений; // Таблица для выгрузки
	ТаблицаДокументы.Колонки.Добавить("НаименованиеДокумента", ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ТаблицаДокументы.Колонки.Добавить("НомерДокумента", ОбщегоНазначения.ОписаниеТипаСтрока(1000)); // ТаблицаЗначений
	ТаблицаДокументы.Колонки.Добавить("ДатаДокумента", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	
	// Дополнительная информация о товарах
	ТаблицаДопСведения = Новый ТаблицаЗначений;
	ТаблицаДопСведения.Колонки.Добавить("ДокументСсылка");
	ТаблицаДопСведения.Колонки.Добавить("Номенклатура");
	ТаблицаДопСведения.Колонки.Добавить("Код");
	ТаблицаДопСведения.Колонки.Добавить("ДополнительнаяИнформация");
	
	ТаблицаДекларацииНаТовары = Неопределено;
	
	Результат = Новый Структура;
	
	Результат.Вставить("РеквизитыШапка", РеквизитыШапка);
	Результат.Вставить("ТаблицаДокументы", ТаблицаДокументы);
	Результат.Вставить("ТаблицаТоварыДляВыгрузки", ТаблицаТоварыДляВыгрузки);
	Результат.Вставить("ТаблицаДопСведения", ТаблицаДопСведения);
	Результат.Вставить("ШтрихкодыУпаковок", ШтрихкодыУпаковок);
	Результат.Вставить("КурсыВалютыНаДатыДокументовОтгрузки", КурсыВалютыНаДатыДокументовОтгрузки);
	Результат.Вставить("ДекларацияНаТовары", ТаблицаДекларацииНаТовары);
		
	Если МассивДокументов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВалютаРеглУчета = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	
	Если НЕ ЗначениеЗаполнено(ВалютаРеглУчета) Тогда
		ТекстОшибки = НСтр("ru = 'Не заполнено значение валюты регламентированного учета.';
							|en = 'Не заполнено значение валюты регламентированного учета.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	ДолларСША = Справочники.Валюты.НайтиПоНаименованию("USD", Истина);
	
	Если НЕ ЗначениеЗаполнено(ДолларСША) Тогда
		ТекстОшибки = НСтр("ru = 'В справочнике валюты отсутсвтует значение доллара США.';
							|en = 'В справочнике валюты отсутсвтует значение доллара США.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	ОбластиМакета = ОбластиМакетовСписковЛичногоКабинетаФТС();
	
	ДопСведения = ДопСведенияСтатформы(ОбластиМакета.СписокЗначенийГрафы19);
	ТаблицаРегионОКАТО = РегионыОКАТО(ОбластиМакета.СписокОКАТО);
	
	ИмяДокумента = "";
	ДокументОтгрузки = МассивДокументов[0];
	ТипДокументаОтгрузки = ТипЗнч(ДокументОтгрузки);
	
	Если ТипДокументаОтгрузки = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ИмяДокумента = "РеализацияТоваровУслуг";
	ИначеЕсли ТипДокументаОтгрузки = Тип("ДокументСсылка.ОтгрузкаТоваровКлиенту") Тогда
		ИмяДокумента = "ОтгрузкаТоваровКлиенту";
	ИначеЕсли ТипДокументаОтгрузки = Тип("ДокументСсылка.ЗаявлениеОВвозеТоваров") Тогда
		ИмяДокумента = "ЗаявлениеОВвозеТоваров";
	Иначе
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Для типа документа отгрузки ""%1"" не поддерживается заполнение статистической формы учета перемещения товаров.';
				|en = 'Для типа документа отгрузки ""%1"" не поддерживается заполнение статистической формы учета перемещения товаров.'"),
			ТипДокументаОтгрузки);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		
		Возврат Результат;
		
	КонецЕсли;
	
	КурсыВалютыНаДатыДокументовОтгрузки = КурсыВалютыНаДатыДокументовОтгрузки(МассивДокументов,
		ДолларСША, ВалютаРеглУчета, ИмяДокумента);
	
	ЗапросШапокДокументов = Новый Запрос;
	ЗапросШапокДокументов.УстановитьПараметр("МассивДокументов", МассивДокументов);
	ЗапросШапокДокументов.УстановитьПараметр("ВалютаРеглУчета", ВалютаРеглУчета);
	
	ЗапросТовары = Новый Запрос;
	ЗапросТовары.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ЗапросТовары.УстановитьПараметр("МассивДокументов", МассивДокументов);
	ЗапросТовары.УстановитьПараметр("ВалютаРеглУчета", ВалютаРеглУчета);
	ЗапросТовары.УстановитьПараметр("ДолларСША", ДолларСША);
	ЗапросТовары.УстановитьПараметр("ДопСведенияПрослеживаемыеТовары", ДопСведения.ПрослеживаемыеТовары);
	ЗапросТовары.УстановитьПараметр("КурсыВалютыНаДатыДокументовОтгрузки", КурсыВалютыНаДатыДокументовОтгрузки);
	ЗапросТовары.УстановитьПараметр("ИспользоватьНоменклатуруПартнеров",
		ПолучитьФункциональнуюОпцию("ИспользоватьНоменклатуруПартнеров"));
	
	// Статформа подается ежемесячно всегда по одной организации.
	Если НаправлениеПеремещения = "ЭК" Тогда
		
		ЗапросШапокДокументов.Текст = ТекстЗапросаШапокДокументовСтатформыЭкспорт(ИмяДокумента);
		
		Если ЗапросШапокДокументов.Текст = "" Тогда
			ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Для типа документа отгрузки ""%1"" не поддерживается заполнение статистической формы учета перемещения товаров.';
				|en = 'Для типа документа отгрузки ""%1"" не поддерживается заполнение статистической формы учета перемещения товаров.'"),
			ТипДокументаОтгрузки);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			Возврат Результат;
			
		КонецЕсли;
		
		ЗапросТовары.Текст = ТекстЗапросаТоварыСтатформаЭкспорт(ИмяДокумента);
		
		СведенияОСчетеФактуреВыданномЭкспорт(ИмяДокумента, МассивДокументов, ТаблицаДокументы);
		
	Иначе
		
		ЗапросШапокДокументов.Текст = ТекстЗапросаШапкиСтатформыИмпорт();
		ЗапросТовары.Текст = ТекстЗапросаТоварыСтатформаИмпорт();
		
		СведенияОДокументахСтатформаИмпорт(МассивДокументов, ТаблицаДокументы);
		
	КонецЕсли;
	
	ШапкиДокументов = ЗапросШапокДокументов.Выполнить().Выгрузить();
	
	Если ШапкиДокументов <> Неопределено
		И ШапкиДокументов.Количество() > 0 Тогда
		
		Для каждого СтрокаШапки Из ШапкиДокументов Цикл
			
			НоваяСтрокаВыгрузки = ТаблицаДокументы.Добавить();
			НоваяСтрокаВыгрузки.НаименованиеДокумента = НСтр("ru = 'Договор';
															|en = 'Договор'");
			НоваяСтрокаВыгрузки.НомерДокумента = СтрокаШапки.НомерДоговора;
			НоваяСтрокаВыгрузки.ДатаДокумента = СтрокаШапки.ДатаДоговора;
			
			Если СтрокаШапки.ЕстьКлиентДоговор Тогда
				
				НоваяСтрокаВыгрузки = ТаблицаДокументы.Добавить();
				НоваяСтрокаВыгрузки.НаименованиеДокумента = НСтр("ru = 'Договор';
																|en = 'Договор'");
				НоваяСтрокаВыгрузки.НомерДокумента = СтрокаШапки.НомерКлиентДоговора;
				НоваяСтрокаВыгрузки.ДатаДокумента = СтрокаШапки.ДатаКлиентДоговора;
				
				Если СтрокаШапки.ЕстьУникальныйНомерВалютногоКонтроляКлиентДоговора Тогда
					НоваяСтрокаВыгрузки = ТаблицаДокументы.Добавить();
					НоваяСтрокаВыгрузки.НаименованиеДокумента = НСтр(
						"ru = 'Уникальный номер договора (паспорт сделки)';
						|en = 'Уникальный номер договора (паспорт сделки)'");
					НоваяСтрокаВыгрузки.НомерДокумента = СтрокаШапки.УникальныйНомерВалютногоКонтроляКлиентДоговора;
					НоваяСтрокаВыгрузки.ДатаДокумента = СтрокаШапки.ДатаПостановкиНаВалютныйКонтрольКлиентДоговора;
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтрокаШапки.ЕстьУникальныйНомерВалютногоКонтроля Тогда
				НоваяСтрокаВыгрузки = ТаблицаДокументы.Добавить();
				НоваяСтрокаВыгрузки.НаименованиеДокумента = НСтр("ru = 'Уникальный номер договора (паспорт сделки)';
																|en = 'Уникальный номер договора (паспорт сделки)'");
				НоваяСтрокаВыгрузки.НомерДокумента = СтрокаШапки.УникальныйНомерВалютногоКонтроля;
				НоваяСтрокаВыгрузки.ДатаДокумента = СтрокаШапки.ДатаПостановкиНаВалютныйКонтроль;
			КонецЕсли;
			
			Если НаправлениеПеремещения = "ЭК" Тогда
				НоваяСтрокаВыгрузки = ТаблицаДокументы.Добавить();
				НоваяСтрокаВыгрузки.НаименованиеДокумента = НСтр("ru = 'Товарная накладная';
																|en = 'Invoice'");
				НоваяСтрокаВыгрузки.НомерДокумента = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(
					СтрокаШапки.Номер, Истина, Ложь);
				НоваяСтрокаВыгрузки.ДатаДокумента = СтрокаШапки.Дата;
			КонецЕсли;
		
		КонецЦикла;
		
		СтрокаШапки = ШапкиДокументов[0];
		
		РеквизитыШапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаШапки); // Структура для выгрузки
		РеквизитыШапкиСтатформы(РеквизитыШапка, РеквизитыШапка.Дата);
		
	Иначе
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Для типа документа отгрузки ""%1"" не поддерживается заполнение статистической формы учета перемещения товаров.';
				|en = 'Для типа документа отгрузки ""%1"" не поддерживается заполнение статистической формы учета перемещения товаров.'"),
			ТипДокументаОтгрузки);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			Возврат Результат;
	КонецЕсли;
	
	РегионОКАТО = "";
	
	Если НаправлениеПеремещения = "ЭК" Тогда
		РегионОКАТО = ОКАТОПоИНН(РеквизитыШапка.ОтправительКоды, ТаблицаРегионОКАТО);
		ЗапросТовары.УстановитьПараметр("ВалютаТовараКод", РеквизитыШапка.ВалютаТовараКод);
	Иначе
		ЗапросТовары.УстановитьПараметр("СтранаОтправленияНаименование", РеквизитыШапка.СтранаОтправленияНаименование);
		ЗапросТовары.УстановитьПараметр("СтранаОтправленияКод", РеквизитыШапка.СтранаОтправленияКод);
		РегионОКАТО = ОКАТОПоИНН(РеквизитыШапка.ПокупательИНН, ТаблицаРегионОКАТО);
	КонецЕсли;
	
	ЗапросТовары.Параметры.Вставить("ОкончаниеПериода", РеквизитыШапка.Дата);
	
	ТаблицаТоварыДляВыгрузки = ЗапросТовары.Выполнить().Выгрузить();
	
	// Заполняем отдельно декларацию на товары для прослеживаемых комплектов, т.к. комплект содержит несколько РНПТ.
	ТаблицаДекларацииНаТовары = 
		ЗапросТовары.МенеджерВременныхТаблиц.Таблицы["РНПТПрослеживаемыхКомплектов"].ПолучитьДанные().Выгрузить();
	
	Для каждого РНПТ Из ТаблицаДекларацииНаТовары Цикл
		ЗаполнитьЗначенияСвойств(РНПТ,
			РеквизитыТаможеннойДекларации(РНПТ.РНПТ), "КодТО, ДатаРегистрацииСтр, НомерДок, ДекларацияНом");
	КонецЦикла;
	
	Если НаправлениеПеремещения = "ЭК" Тогда
		
		ШапкиДокументов.Индексы.Добавить("ДокументСсылка, ПродажаФизлицуЧерезЭлектроннуюТорговуюПлощадку");
		ТаблицаТоварыДляВыгрузки.Индексы.Добавить("ДокументСсылка");
		
	КонецЕсли;
	
	ТаблицаТоварыДляВыгрузки.Индексы.Добавить("ДокументСсылка, ПрослеживаемыйТовар");
	
	Для каждого Документ Из МассивДокументов Цикл
		
		Если НаправлениеПеремещения = "ЭК" Тогда
			
			Отбор = Новый Структура;
			Отбор.Вставить("ДокументСсылка", Документ);
			Отбор.Вставить("ПродажаФизлицуЧерезЭлектроннуюТорговуюПлощадку", Истина);
			РезультатПоиска = ШапкиДокументов.НайтиСтроки(Отбор);
			
			Если РезультатПоиска.Количество() > 0 Тогда
				
				Отбор = Новый Структура;
				Отбор.Вставить("ДокументСсылка", Документ);
				ТоварыФизлицуЧерезЭлектроннуюТорговуюПлощадку = ТаблицаТоварыДляВыгрузки.НайтиСтроки(Отбор);
				
				Для каждого Товар Из ТоварыФизлицуЧерезЭлектроннуюТорговуюПлощадку Цикл
					СтрокаДопСведения = ТаблицаДопСведения.Добавить();
					СтрокаДопСведения.ДокументСсылка = Товар.ДокументСсылка;
					СтрокаДопСведения.Номенклатура = Товар.Номенклатура;
					СтрокаДопСведения.Код = "07";
					СтрокаДопСведения.ДополнительнаяИнформация = ДопСведения.ТоварыФизЛицамЭлектронныеТорговыеПлощадки;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("ДокументСсылка", Документ);
		Отбор.Вставить("ПрослеживаемыйТовар", Истина);
		ПрослеживаемыеТовары = ТаблицаТоварыДляВыгрузки.НайтиСтроки(Отбор);
		
		Для каждого Товар Из ПрослеживаемыеТовары Цикл
			СтрокаДопСведения = ТаблицаДопСведения.Добавить();
			СтрокаДопСведения.ДокументСсылка = Товар.ДокументСсылка;
			СтрокаДопСведения.Номенклатура = Товар.Номенклатура;
			СтрокаДопСведения.Код = "08";
			СтрокаДопСведения.ДополнительнаяИнформация = ДопСведения.ПрослеживаемыеТовары;
		КонецЦикла;
		
	КонецЦикла;

	ПараметрыРазбораКодаМаркировки =
		РазборКодаМаркировкиИССлужебныйКлиентСервер.ИнициализироватьПараметрыРазбораКодаМаркировки();
	ПараметрыРазбораКодаМаркировки.НачинаетсяСоСкобки = Ложь;
	
	// Информация о товарах, подлежащих обязательной маркировке.
	
	ШтрихкодыУпаковок = ШтрихкодыУпаковокТоваровСтатформы(ОбластиМакета.СписокКодовВидовСредствИдентификации,
		МассивДокументов, ИмяДокумента);
	
	ВидыУпаковок = ВидыУпаковокТоваровСтатформы(ОбластиМакета.СписокКодовУровнейМаркировки);
	
	Если ШтрихкодыУпаковок <> Неопределено Тогда
		
		Для каждого Штрихкод Из ШтрихкодыУпаковок Цикл
			
			РезультатРазбора =
				РазборКодаМаркировкиИССлужебный.РазобратьКодМаркировки(Штрихкод.ЕдиничныйКод);
			
			Если Штрихкод.SSCCПривестиКЕдиничномуКоду Тогда
				Штрихкод.ЕдиничныйКод = СтрЗаменить(Штрихкод.ЕдиничныйКод,"(00)", "00");
			ИначеЕсли Штрихкод.DataMatrixПривестиКЕдиничномуКоду
					И СтрНайти(Штрихкод.ЕдиничныйКод, "(97)") > 0 Тогда
				Штрихкод.ЕдиничныйКод = СтрЗаменить(Штрихкод.ЕдиничныйКод, "(97)", "97");
				Продолжить;
			КонецЕсли;
				
			Если НЕ ЗначениеЗаполнено(РезультатРазбора) Тогда
				Продолжить;
			КонецЕсли;
			
			Если РезультатРазбора.СоставКодаМаркировки.Свойство("EAN") Тогда
				ШтрихкодыEAN = Новый Массив;
				ШтрихкодыEAN.Добавить(РезультатРазбора.СоставКодаМаркировки.EAN);
				ДанныеПоШтрихкодам = ШтрихкодированиеОбщегоНазначенияИС.ДанныеПоШтрихкодамEAN(ШтрихкодыEAN);
				Штрихкод.ЕдиничныйКод = РазборКодаМаркировкиИССлужебныйКлиентСервер.НормализоватьКодМаркировки(
					РезультатРазбора, Перечисления.ВидыПродукцииИС.ПустаяСсылка(),ПараметрыРазбораКодаМаркировки);
					
				Если ДанныеПоШтрихкодам.Количество() > 0 Тогда
					
					ВидУпаковки = ДанныеПоШтрихкодам[0].ВидУпаковкиИС;
					
					Если ВидУпаковки = Перечисления.ВидыУпаковокИС.Потребительская Тогда
						Штрихкод.КодУровняМаркировки = ВидыУпаковок.ТоварнаяУпаковка;
					ИначеЕсли ВидУпаковки = Перечисления.ВидыУпаковокИС.Групповая
						ИЛИ ВидУпаковки = Перечисления.ВидыУпаковокИС.Набор Тогда
						Штрихкод.КодУровняМаркировки = ВидыУпаковок.ГрупповаяУпаковка;
					ИначеЕсли ВидУпаковки = Перечисления.ВидыУпаковокИС.Логистическая Тогда
						Штрихкод.КодУровняМаркировки = ВидыУпаковок.ТранспортнаяУпаковка;
					КонецЕсли;
					
				КонецЕсли;
			Иначе
				Если ЗначениеЗаполнено(РезультатРазбора.ВидУпаковки) Тогда
					Если РезультатРазбора.ВидУпаковки = Перечисления.ВидыУпаковокИС.Потребительская Тогда
						Штрихкод.КодУровняМаркировки = ВидыУпаковок.ТоварнаяУпаковка;
					ИначеЕсли РезультатРазбора.ВидУпаковки = Перечисления.ВидыУпаковокИС.Групповая
						ИЛИ РезультатРазбора.ВидУпаковки = Перечисления.ВидыУпаковокИС.Набор Тогда
						Штрихкод.КодУровняМаркировки = ВидыУпаковок.ГрупповаяУпаковка;
					ИначеЕсли РезультатРазбора.ВидУпаковки = Перечисления.ВидыУпаковокИС.Логистическая Тогда
						Штрихкод.КодУровняМаркировки = ВидыУпаковок.ТранспортнаяУпаковка;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Для графы 3 сведения о лице, ответственное за финансовое урегулирование:
	// 1. в случае экспорта заполняются из организации,
	// 2. в случае импорта тоже из организации
	// Ограничение из БРО:
	// Считается заявитель и лицо ответственное за финансовое урегулирование - это одно и тоже лицо.
	// При экспорте получателем является всегда иностранное государство, а отправителем является РФ.
	// При импорте получателем является всегда РФ, а отправителем является иностранное государство.
	
	Если ЗначениеЗаполнено(РеквизитыШапка.Организация)
		И ЗначениеЗаполнено(РеквизитыШапка.Контрагент) Тогда
		
		Если НаправлениеПеремещения = "ЭК" Тогда
			
			СведенияОПродавце = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(
				РеквизитыШапка.Организация, РеквизитыШапка.Дата);
			СведенияОПродавце.Телефоны = СтрЗаменить(СведенияОПродавце.Телефоны, "+7", "8");
			
			ПравоваяФормаВСтатистическойФормеУчетаПеремещенияТоваров(
				РеквизитыШапка.Отправитель_ФормаСобственности,
				РеквизитыШапка.ЮрФизЛицо,
				ОбластиМакета.СписокПравовыхФорм);
			
			СведенияОПокупателе = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(
				РеквизитыШапка.Контрагент, РеквизитыШапка.Дата);
			СведенияОПокупателе.Телефоны = СтрЗаменить(СведенияОПокупателе.Телефоны, "+7", "8");
			
			ОтправительАдрес = УчетНДСРФ.ПолучитьАдресВВидеСоответствия(
				РеквизитыШапка.Организация,
				Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
				РеквизитыШапка.Дата);
			
			ПолучательАдрес = УчетНДСРФ.ПолучитьАдресВВидеСоответствия(
				РеквизитыШапка.Контрагент,
				Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,
				РеквизитыШапка.Дата);
			
			РеквизитыШапка.ПолучательКоды = РеквизитыШапка.НалоговыйНомер;
			
			// Реквизиты подписи - сокращенное наименование заявителя статформы
			РеквизитыШапка.Вставить("ПолнСокрНаим", СведенияОПродавце.СокращенноеНаименование);
			
			Если ЗначениеЗаполнено(РеквизитыШапка.ОтправительРФ_КПП) Тогда
				ИННКППОГРН = СтрШаблон("%1/%2/%3",
					РеквизитыШапка.ОтправительРФ_ИНН,
					РеквизитыШапка.ОтправительРФ_КПП,
					РеквизитыШапка.ОтправительРФ_ОГРН);
			Иначе
				ИННКППОГРН = СтрШаблон("%1/%2", РеквизитыШапка.ОтправительРФ_ИНН, РеквизитыШапка.ОтправительРФ_ОГРН);
			КонецЕсли;
			
			ЗаявительЮридическоеФизическоеЛицо = РеквизитыШапка.ОтправительЮридическоеФизическоеЛицо;
			
			РеквизитыШапка.Вставить("ОтправительОКАТО", РегионОКАТО);
			
		Иначе
			
			СведенияОПродавце = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(
				РеквизитыШапка.Контрагент, РеквизитыШапка.Дата);
			
			СведенияОПокупателе = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(
				РеквизитыШапка.Организация, РеквизитыШапка.Дата);
				
			ПравоваяФормаВСтатистическойФормеУчетаПеремещенияТоваров(
				РеквизитыШапка.Получатель_ФормаСобственности, 
				РеквизитыШапка.ЮрФизЛицо,
				ОбластиМакета.СписокПравовыхФорм);
			
			ОтправительАдрес = УчетНДСРФ.ПолучитьАдресВВидеСоответствия(
				РеквизитыШапка.Контрагент,
				Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,
				РеквизитыШапка.Дата);
			
			ПолучательАдрес = УчетНДСРФ.ПолучитьАдресВВидеСоответствия(
				РеквизитыШапка.Организация,
				Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
				РеквизитыШапка.Дата);
			
			Если ЗначениеЗаполнено(РеквизитыШапка.ПокупательКПП) Тогда
				РеквизитыШапка.ПолучательКоды = СтрШаблон("%1/%2",
					РеквизитыШапка.ПокупательИНН,
					РеквизитыШапка.ПокупательКПП);
			Иначе
				РеквизитыШапка.ПолучательКоды = РеквизитыШапка.ПокупательИНН;
			КонецЕсли;
			
			// Реквизиты подписи - сокращенное наименование заявителя статформы
			РеквизитыШапка.Вставить("ПолнСокрНаим", СведенияОПокупателе.СокращенноеНаименование);
			
			Если ЗначениеЗаполнено(РеквизитыШапка.ПокупательКПП) Тогда
				ИННКППОГРН = СтрШаблон("%1/%2/%3",
					РеквизитыШапка.ПокупательИНН,
					РеквизитыШапка.ПокупательКПП,
					РеквизитыШапка.ОГРН);
			Иначе
				ИННКППОГРН = СтрШаблон("%1/%2", РеквизитыШапка.ПокупательИНН, РеквизитыШапка.ОГРН);
			КонецЕсли;
			
