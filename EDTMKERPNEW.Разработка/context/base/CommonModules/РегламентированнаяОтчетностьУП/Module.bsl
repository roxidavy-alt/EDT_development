Процедура ЗаполнитьОтчетАкцизыГСМФормаОтчета2023Кв1(ПараметрыОтчета, Контейнер) Экспорт
	
	Организация = ПараметрыОтчета.Организация;
	ДатаСведений = ПараметрыОтчета.ДатаПодписи;
	
	ОтчетОбъект = РегламентированнаяОтчетностьВызовСервера.ОтчетОбъект("РегламентированныйОтчетАкцизыГСМ");
	МакетСоставаПоказателей = ОтчетОбъект.ПолучитьМакет("СпискиВыбора2023Кв1");
	
	КатегорииПодакцизныхТоваров = ПолучитьКатегорииПодакцизныхТоваров(МакетСоставаПоказателей, "КодыВидаПТ_Р2_П2");
	
	НачалоПериодаОтчета = ПараметрыОтчета.мДатаНачалаПериодаОтчета;
	КонецПериодаОтчета  = ПараметрыОтчета.мДатаКонцаПериодаОтчета;
	
	НалоговыйОрган = Справочники.РегистрацииВНалоговомОргане.РегистрацияВНалоговомОрганеПоКодуНО(
		Организация, ПараметрыОтчета.КПП, ПараметрыОтчета.КодНалоговогоОргана);
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НалоговыйОрган, "КрупнейшийНалогоплательщик") = Истина Тогда
		НалоговыйОрган = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "РегистрацияВНалоговомОргане");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаОперацииСПодакцизнымиТоварами());
	Запрос.УстановитьПараметр("ПоВсейОрганизации", Ложь);
	Запрос.УстановитьПараметр("Организации",    ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Организация));
	Запрос.УстановитьПараметр("ДатаСведений",   ДатаСведений);
	Запрос.УстановитьПараметр("НачалоПериода",  НачалоДня(НачалоПериодаОтчета));
	Запрос.УстановитьПараметр("КонецПериода",   КонецДня(КонецПериодаОтчета));
	Запрос.УстановитьПараметр("КодыКатегорий",  КатегорииПодакцизныхТоваров);
	Запрос.УстановитьПараметр("НалоговыйОрган", НалоговыйОрган);
	
	ПоказателиОтчета = Новый Структура;
	ПолучитьСведенияОПоказателяхОтчетаАкцизыГСМФормаОтчета2023Кв1(ПоказателиОтчета);
	
	Раздел1 = Контейнер.Раздел1.Строки;
	Раздел1Данные = Раздел1[0].Данные;
	
	Раздел2 = Контейнер.Раздел2.Строки;
	Раздел2Данные    = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2[0].Данные);
	Раздел2ДанныеМнЧ = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2[0].ДанныеМногострочныхЧастей);
	Раздел2.Очистить();
	
	Подраздел21Данные = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2ДанныеМнЧ.П00021М1.Строки[0].Данные);
	Подраздел24Данные = ОбщегоНазначения.СкопироватьРекурсивно(Раздел2ДанныеМнЧ.П00024М1.Строки[0].Данные);
	
	ОчиститьПоляСтруктурыПоказателей(Раздел2Данные, ПоказателиОтчета);
	ОчиститьПоляСтруктурыПоказателей(Подраздел21Данные, ПоказателиОтчета);
	ОчиститьПоляСтруктурыПоказателей(Подраздел24Данные, ПоказателиОтчета);
	
