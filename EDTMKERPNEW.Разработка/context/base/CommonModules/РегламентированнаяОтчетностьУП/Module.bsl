			СтраницаРаздел2.П000020000101 = ?(Лев(Выборка.КодВидаИмущества, 1) = "0", Прав(Выборка.КодВидаИмущества, 1), Выборка.КодВидаИмущества);
			СтраницаРаздел2.П000020001001 = Выборка.КодПоОКТМО;
