Процедура ОчиститьПоляСтруктурыПоказателей(СтруктураПолей, ПоказателиОтчета)
	
	Для Каждого КлючИЗначение Из СтруктураПолей Цикл
		Если ПоказателиОтчета.Свойство(КлючИЗначение.Ключ) Тогда
			ТипПоля = ТипЗнч(КлючИЗначение.Значение);
			Если Тип("Строка") = ТипПоля Тогда
				СтруктураПолей[КлючИЗначение.Ключ] = "";
			ИначеЕсли Тип("Дата") = ТипПоля Тогда
				СтруктураПолей[КлючИЗначение.Ключ] = '00010101';
			ИначеЕсли Тип("Булево") = ТипПоля Тогда
				СтруктураПолей[КлючИЗначение.Ключ] = Ложь;
			Иначе
				СтруктураПолей[КлючИЗначение.Ключ] = 0;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#Область Акцизы

Функция ТекстЗапросаОперацииСПодакцизнымиТоварами()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Категории.Ссылка КАК Категория,
	|	ЕСТЬNULL(ДействующиеСтавки.Ставка, 0) КАК СтавкаНалога
	|ПОМЕСТИТЬ СписокКатегорий
	|ИЗ
	|	Справочник.КатегорииПодакцизныхТоваров КАК Категории
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтавкиКатегорийПодакцизныхТоваров.СрезПоследних(&КонецПериода, ) КАК ДействующиеСтавки
	|		ПО Категории.Ссылка = ДействующиеСтавки.КатегорияПодакцизногоТовара
	|ГДЕ
	|	Категории.Код В (&КодыКатегорий)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДействующиеРегистрации.Организация КАК Организация,
	|	ДействующиеРегистрации.Подразделение КАК Подразделение,
	|	ДействующиеРегистрации.РегистрацияВНалоговомОргане
	|ПОМЕСТИТЬ ДействующиеРегистрации
	|ИЗ
	|	РегистрСведений.РегистрацииВНалоговомОргане.СрезПоследних(
	|		&ДатаСведений, Организация В (&Организации)) КАК ДействующиеРегистрации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НЕ РегистрацииПодразделений.РегистрацияВНалоговомОргане ЕСТЬ NULL
	|			ТОГДА РегистрацииПодразделений.РегистрацияВНалоговомОргане
	|		КОГДА НЕ РегистрацияОрганизации.РегистрацияВНалоговомОргане ЕСТЬ NULL
	|			ТОГДА РегистрацияОрганизации.РегистрацияВНалоговомОргане
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|	КОНЕЦ КАК НалоговыйОрган,
	|	ДвиженияПоАкцизам.КатегорияПодакцизногоТовара КАК Категория,
	|	ДвиженияПоАкцизам.ВидОперацииСПодакцизнымТоваром КАК ВидОперации,
	|	ДвиженияПоАкцизам.КоличествоАкцизаОборот КАК Количество,
	|	ДвиженияПоАкцизам.СуммаАкцизаРеглОборот КАК Сумма,
	|	СписокКатегорий.СтавкаНалога КАК СтавкаНалога
	|ИЗ
	|	РегистрНакопления.ДвиженияПоАкцизам.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Период,
	|			Организация В (&Организации)
	|				И КатегорияПодакцизногоТовара В
	|					(ВЫБРАТЬ Категория ИЗ СписокКатегорий)
	|				И ВидОперацииСПодакцизнымТоваром В (
	|					ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСПодакцизнымТоваром.Реализация),
	|					ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСПодакцизнымТоваром.ВнутреннееПотребление),
	|					ЗНАЧЕНИЕ(Перечисление.ВидыОперацийСПодакцизнымТоваром.Возврат))
	|		) КАК ДвиженияПоАкцизам
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокКатегорий КАК СписокКатегорий
	|		ПО ДвиженияПоАкцизам.КатегорияПодакцизногоТовара = СписокКатегорий.Категория
	|	ЛЕВОЕ СОЕДИНЕНИЕ ДействующиеРегистрации КАК РегистрацииПодразделений
	|		ПО ДвиженияПоАкцизам.Организация = РегистрацииПодразделений.Организация
	|			И ДвиженияПоАкцизам.ПодразделениеУплатыАкциза = РегистрацииПодразделений.Подразделение
	|	ЛЕВОЕ СОЕДИНЕНИЕ ДействующиеРегистрации КАК РегистрацияОрганизации
	|		ПО ДвиженияПоАкцизам.Организация = РегистрацияОрганизации.Организация
	|			И РегистрацияОрганизации.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|
	|ГДЕ
	|	&ПоВсейОрганизации ИЛИ ВЫБОР
	|		КОГДА НЕ РегистрацииПодразделений.РегистрацияВНалоговомОргане ЕСТЬ NULL
	|			ТОГДА РегистрацииПодразделений.РегистрацияВНалоговомОргане
	|		КОГДА НЕ РегистрацияОрганизации.РегистрацияВНалоговомОргане ЕСТЬ NULL
	|			ТОГДА РегистрацияОрганизации.РегистрацияВНалоговомОргане
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|	КОНЕЦ = &НалоговыйОрган
	|
	|ИТОГИ
	|	МАКСИМУМ(СтавкаНалога)
	|ПО
	|	НалоговыйОрган,
	|	Категория";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьКатегорииПодакцизныхТоваров(МакетСоставаПоказателей, ИмяОбласти)
	
	Категории = Новый Массив;
	
	Область = МакетСоставаПоказателей.Области.Найти(ИмяОбласти);
	Если Область = Неопределено Тогда
		Возврат Категории;
	КонецЕсли;
	
	ДоступныеКатегории = СтрРазделить("298,510,520,531,532,533,534,535,536",",", Ложь);
	
	Для НомСтр = Область.Верх По Область.Низ Цикл
		КодПоказателя = СокрП(МакетСоставаПоказателей.Область(НомСтр, 1).Текст);
		Если Не ПустаяСтрока(КодПоказателя) И ДоступныеКатегории.Найти(КодПоказателя) <> Неопределено Тогда
			Категории.Добавить(КодПоказателя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Категории;
	
КонецФункции

