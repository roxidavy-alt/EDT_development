			|			ТОГДА ЕСТЬNULL(ДетализацияСебестоимости.АналитикаУчетаПартийДокументаПоступления.ВидЦенности, ЗНАЧЕНИЕ(Перечисление.ВидыЦенностей.ПустаяСсылка))
			|		ИНАЧЕ ДетализацияСебестоимости.СтатьяРасходов
			|	КОНЕЦ,
			|
			|	ТаблицаОтборовУзлов.ИдентификаторУзла,
			|	ТаблицаОтборовУзлов.ИдентификаторУзлаПервогоУровня,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_АналитикаУчетаПродукции,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_ПартияПродукции,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_АналитикаУчетаПартийПродукции
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ТаблицаОтборовУзлов.ИдентификаторУзла КАК ИдентификаторУзла,
			|	ТаблицаОтборовУзлов.ИдентификаторУзлаПервогоУровня КАК ИдентификаторУзлаПервогоУровня,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_АналитикаУчетаПродукции КАК УзелПервогоУровня_АналитикаУчетаПродукции,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_ПартияПродукции КАК УзелПервогоУровня_ПартияПродукции,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_АналитикаУчетаПартийПродукции КАК УзелПервогоУровня_АналитикаУчетаПартийПродукции,
			|	МАКСИМУМ(ТаблицаОтборовУзлов.ДатаИсходнойПартии) КАК ДатаИсходнойПартии,
			|	МАКСИМУМ(ТаблицаОтборовУзлов.РазворачиватьДопРасходы) КАК РазворачиватьДопРасходы,
			|	МАКСИМУМ(ТаблицаОтборовУзлов.ТребуетсяРазузлование) КАК ТребуетсяРазузлованиеУзлаИсточника,
			|
			|	ДАТАВРЕМЯ(1, 1, 1)						КАК МесяцПервичнойПартииВНЗП,
			|
			|	ДетализацияСебестоимости.Организация							КАК Организация,
			|	ДетализацияСебестоимости.Партия									КАК ПартияВыходноеИзделие,
			|	ДетализацияСебестоимости.АналитикаУчетаПартий					КАК АналитикаУчетаПартийВыходноеИзделие,
			|	ТаблицаОтборовУзлов.АналитикаУчетаЗатрат						КАК АналитикаУчетаВыходноеИзделие,
			|	ДетализацияСебестоимости.ДокументПоступления КАК ПартияЗатрата,
			|	ДетализацияСебестоимости.АналитикаУчетаПартийДокументаПоступления КАК АналитикаУчетаПартийЗатрата,
			|	ЛОЖЬ										КАК ВключитьНДСВСтоимость,
			|	ЛОЖЬ										КАК ИсключитьНДСИзСтоимости,
			|	ДетализацияСебестоимости.АналитикаРасходов	КАК АналитикаЗатрата,
			|	ВЫБОР
			|		КОГДА ДетализацияСебестоимости.СтатьяРасходов = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
			|			ТОГДА ЕСТЬNULL(ДетализацияСебестоимости.АналитикаУчетаПартийДокументаПоступления.ВидЦенности, ЗНАЧЕНИЕ(Перечисление.ВидыЦенностей.ПустаяСсылка))
			|		ИНАЧЕ ДетализацияСебестоимости.СтатьяРасходов
			|	КОНЕЦ КАК Затрата,
			|	НЕОПРЕДЕЛЕНО								КАК ЕдиницаИзмеренияЗатрата,
			|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаЗатрата,
			|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК СерияЗатрата,
			|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК НазначениеЗатрата,
			|	ТаблицаОтборовУзлов.СтатьяКалькуляции		КАК СтатьяКалькуляции,
			|	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК Подразделение,
			|	ЛОЖЬ										КАК ТребуетсяРазузлование,
			|	ЛОЖЬ										КАК ТребуетсяРазузлованиеДопРасходов,
			|	&ТипЗатратДопРасходы						КАК ТипЗатрат,
			|	0											КАК КоличествоЗатрата,
			|
			// Стоимости согласно параметру ""ДанныеПоСебестоимости""
			|	0											КАК Материальные,
			|	0											КАК Трудозатраты,
			|	0											КАК ПостатейныеПостоянные,
			|	0											КАК ПостатейныеПеременные,
			|	СУММА(ВЫБОР
			|		КОГДА &ДанныеПоСебестоимости = 1
			|			ТОГДА ДетализацияСебестоимости.СтоимостьСНДС
			|		КОГДА &ДанныеПоСебестоимости = 2
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДС
			|		КОГДА &ДанныеПоСебестоимости = 3
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДСУпр
			|			+ (ВЫБОР КОГДА ТаблицаОтборовУзлов.ВключитьНДСВСтоимость
			|				ТОГДА ДетализацияСебестоимости.НДСУпр ИНАЧЕ 0 КОНЕЦ)
			|		КОГДА &ДанныеПоСебестоимости = 4
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДСРегл
			|			+ (ВЫБОР КОГДА ТаблицаОтборовУзлов.ВключитьНДСВСтоимость
			|				ТОГДА ДетализацияСебестоимости.НДСРегл ИНАЧЕ 0 КОНЕЦ)
			|	КОНЕЦ * ТаблицаОтборовУзлов.КоличествоПродукции)				КАК ДопРасходы,
			|	0											КАК СуммаЗатратаЗабалансовая,
			|	СУММА(ВЫБОР
			|		КОГДА &ДанныеПоСебестоимости = 1
			|			ТОГДА ДетализацияСебестоимости.СтоимостьСНДС
			|		КОГДА &ДанныеПоСебестоимости = 2
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДС
			|		КОГДА &ДанныеПоСебестоимости = 3
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДСУпр
			|			+ (ВЫБОР КОГДА ТаблицаОтборовУзлов.ВключитьНДСВСтоимость
			|				ТОГДА ДетализацияСебестоимости.НДСУпр ИНАЧЕ 0 КОНЕЦ)
			|		КОГДА &ДанныеПоСебестоимости = 4
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДСРегл
			|			+ (ВЫБОР КОГДА ТаблицаОтборовУзлов.ВключитьНДСВСтоимость
			|				ТОГДА ДетализацияСебестоимости.НДСРегл ИНАЧЕ 0 КОНЕЦ)
			|	КОНЕЦ * ТаблицаОтборовУзлов.КоличествоПродукции)				КАК СуммаЗатрата,
			|	0											КАК НДД,
			|
			// Стоимости с НДС
			|	0											КАК МатериальныеСНДС,
			|	0											КАК ТрудозатратыСНДС,
			|	0											КАК ПостатейныеПостоянныеСНДС,
			|	0											КАК ПостатейныеПеременныеСНДС,
			|	СУММА(ДетализацияСебестоимости.СтоимостьСНДС
			|			* ТаблицаОтборовУзлов.КоличествоПродукции) КАК ДопРасходыСНДС,
			|
			// Стоимости без НДС
			|	0											КАК МатериальныеБезНДС,
			|	0											КАК ПостатейныеПостоянныеБезНДС,
			|	0											КАК ПостатейныеПеременныеБезНДС,
			|	СУММА(ДетализацияСебестоимости.СтоимостьБезНДС
			|			* ТаблицаОтборовУзлов.КоличествоПродукции) КАК ДопРасходыБезНДС,
			|
			// Стоимости Упр
			|	0											КАК МатериальныеУпр,
			|	0											КАК ТрудозатратыУпр,
			|	0											КАК ПостатейныеПостоянныеУпр,
			|	0											КАК ПостатейныеПеременныеУпр,
			|	СУММА((ДетализацияСебестоимости.СтоимостьБезНДСУпр
			|			+ (ВЫБОР КОГДА ТаблицаОтборовУзлов.ВключитьНДСВСтоимость
			|				ТОГДА ДетализацияСебестоимости.НДСУпр ИНАЧЕ 0 КОНЕЦ))
			|			* ТаблицаОтборовУзлов.КоличествоПродукции) КАК ДопРасходыУпр,
			|	0											КАК СтоимостьЗабалансоваяУпр,
			|
			// Стоимости Регл
			|	0											КАК МатериальныеРегл,
			|	0											КАК ТрудозатратыРегл,
			|	0											КАК ПостатейныеПостоянныеРегл,
			|	0											КАК ПостатейныеПеременныеРегл,
			|	СУММА((ДетализацияСебестоимости.СтоимостьБезНДСРегл
			|			+ (ВЫБОР КОГДА ТаблицаОтборовУзлов.ВключитьНДСВСтоимость
			|				ТОГДА ДетализацияСебестоимости.НДСРегл ИНАЧЕ 0 КОНЕЦ))
			|			* ТаблицаОтборовУзлов.КоличествоПродукции) КАК ДопРасходыРегл,
			|	0											КАК СтоимостьЗабалансоваяРегл,
			|
			// Налоговый учет
			|	0 КАК НалоговыйУчет,
			|	0 КАК ПостояннаяРазница,
			|	0 КАК ВременнаяРазница,
			|
			// Включение исключение НДС в стоимости
			|	0 КАК ВключениеИсключениеНДСВСтоимости
			|ИЗ
			|	ТаблицаОтборовУзлов КАК ТаблицаОтборовУзлов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДетализацияСебестоимостиТоваровПостатейныеЗатраты КАК ДетализацияСебестоимости
			|		ПО ДетализацияСебестоимости.Период МЕЖДУ ТаблицаОтборовУзлов.ДатаИсходнойПартии_НачалоМесяца И ТаблицаОтборовУзлов.ДатаИсходнойПартии_КонецМесяца
			|			И ДетализацияСебестоимости.Партия = ТаблицаОтборовУзлов.ПартияПродукции
			|			И ДетализацияСебестоимости.АналитикаУчетаПартий = ТаблицаОтборовУзлов.АналитикаУчетаПартийПродукции
			|			И ДетализацияСебестоимости.АналитикаУчетаНоменклатуры = ТаблицаОтборовУзлов.АналитикаУчетаЗатрат
			|ГДЕ
			|	ДетализацияСебестоимости.РазделУчета В (
			|		ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах),
			|		ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ПроизводственныеЗатраты))
			|	И НЕ ВЫБОР
			|			КОГДА &ДанныеПоСебестоимости = 1
			|				ТОГДА ДетализацияСебестоимости.СтоимостьСНДС
			|			КОГДА &ДанныеПоСебестоимости = 2
			|				ТОГДА ДетализацияСебестоимости.СтоимостьБезНДС
			|			КОГДА &ДанныеПоСебестоимости = 3
			|				ТОГДА ДетализацияСебестоимости.СтоимостьБезНДСУпр
			|			КОГДА &ДанныеПоСебестоимости = 4
			|				ТОГДА ДетализацияСебестоимости.СтоимостьБезНДСРегл
			|		КОНЕЦ = 0
			|	И ВЫБОР
			|		КОГДА ДетализацияСебестоимости.СтатьяРасходов = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
			|			ТОГДА ИСТИНА	
			|		КОГДА &ДанныеПоСебестоимости = 4
			|			ТОГДА ДетализацияСебестоимости.СтатьяРасходов.ВариантРаспределенияРасходовРегл = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаСебестоимостьТоваров)
			|		ИНАЧЕ ДетализацияСебестоимости.СтатьяРасходов.ВариантРаспределенияРасходовУпр = ЗНАЧЕНИЕ(Перечисление.ВариантыРаспределенияРасходов.НаСебестоимостьТоваров)
			|	КОНЕЦ 
			|
			|СГРУППИРОВАТЬ ПО
			|	ТаблицаОтборовУзлов.СтатьяКалькуляции,
			|	ТаблицаОтборовУзлов.АналитикаУчетаЗатрат,
			|
			|	ДетализацияСебестоимости.Организация,
			|	ДетализацияСебестоимости.Партия,
			|	ДетализацияСебестоимости.АналитикаУчетаНоменклатуры,
			|	ДетализацияСебестоимости.АналитикаУчетаПартий,
			|	ДетализацияСебестоимости.ДокументПоступления,
			|	ДетализацияСебестоимости.АналитикаУчетаПартийДокументаПоступления,
			|	ДетализацияСебестоимости.АналитикаРасходов,
			|	ВЫБОР
			|		КОГДА ДетализацияСебестоимости.СтатьяРасходов = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
			|			ТОГДА ЕСТЬNULL(ДетализацияСебестоимости.АналитикаУчетаПартийДокументаПоступления.ВидЦенности, ЗНАЧЕНИЕ(Перечисление.ВидыЦенностей.ПустаяСсылка))
			|		ИНАЧЕ ДетализацияСебестоимости.СтатьяРасходов
			|	КОНЕЦ,
			|
			|	ТаблицаОтборовУзлов.ИдентификаторУзла,
			|	ТаблицаОтборовУзлов.ИдентификаторУзлаПервогоУровня,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_АналитикаУчетаПродукции,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_ПартияПродукции,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_АналитикаУчетаПартийПродукции
			|";
		
		Если Не ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
			УбратьИдентификаторУзла(ТекстДопРасходыОбъединение, "ТаблицаОтборовУзлов");
		КонецЕсли;
		ТекстыЗапросаОбъединение.Добавить(ТекстДопРасходыОбъединение);
	
	КонецЕсли;
	
	#КонецОбласти

	ТекстыЗапроса.Добавить(СтрСоединить(ТекстыЗапросаОбъединение, ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении()));
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаРезультатыРазузлования(ПараметрыДерева)
	
	ТекстыЗапросов = Новый Массив();
	ТекстыЗапросовОбъединение = Новый Массив();
	
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Т.ИдентификаторУзлаПервогоУровня КАК ИдентификаторУзлаПервогоУровня,
		|	Т.УзелПервогоУровня_АналитикаУчетаПартийПродукции КАК УзелПервогоУровня_АналитикаУчетаПартийПродукции,
		|	Т.УзелПервогоУровня_АналитикаУчетаПродукции КАК УзелПервогоУровня_АналитикаУчетаПродукции,
		|	Т.УзелПервогоУровня_ПартияПродукции КАК УзелПервогоУровня_ПартияПродукции,
		|	Т.ТребуетсяРазузлованиеУзлаИсточника КАК ТребуетсяРазузлованиеУзлаИсточника,
		|	Т.ДатаИсходнойПартии КАК ДатаИсходнойПартии,
		|	Т.МесяцПервичнойПартииВНЗП КАК МесяцПервичнойПартииВНЗП,
		|
		|	Т.ИдентификаторУзла КАК ИдентификаторУзла,
		|
		|	Т.АналитикаУчетаВыходноеИзделие КАК АналитикаУчетаВыходноеИзделие,
		|	Т.АналитикаУчетаЗатрата КАК АналитикаУчетаЗатрата,
		|	Т.АналитикаУчетаПартийЗатрата КАК АналитикаУчетаПартийЗатрата,
		|	Т.АналитикаУчетаПартийВыходноеИзделие КАК АналитикаУчетаПартийВыходноеИзделие,
		|	Т.ПартияВыходноеИзделие КАК ПартияВыходноеИзделие,
		|
		|	Т.Затрата КАК Затрата,
		|	Т.ХарактеристикаЗатрата КАК ХарактеристикаЗатрата,
		|	Т.СерияЗатрата КАК СерияЗатрата,
		|	Т.НазначениеЗатрата КАК НазначениеЗатрата,
		|	Т.ПартияЗатрата КАК ПартияЗатрата,
		|
		|	Т.Организация КАК Организация,
		|	Т.Подразделение КАК Подразделение,
		|	Т.ТипЗатрат КАК ТипЗатрат,
		|	Т.ТребуетсяРазузлование
		|		И ВЫРАЗИТЬ(Т.КоличествоЗатрата КАК ЧИСЛО(19, 3)) <> 0
		|		И (Т.СуммаЗатрата <> 0 ИЛИ Т.СуммаЗатратаЗабалансовая <> 0) КАК ТребуетсяРазузлование,
		|	Т.ТребуетсяРазузлованиеДопРасходов
		|		И ВЫРАЗИТЬ(Т.КоличествоЗатрата КАК ЧИСЛО(19, 3)) <> 0
		|		И ВЫРАЗИТЬ(Т.ДопРасходы КАК ЧИСЛО(19, 2)) <> 0 КАК ТребуетсяРазузлованиеДопРасходов,
		|
		|	Т.ЕдиницаИзмеренияЗатрата КАК ЕдиницаИзмеренияЗатрата,
		|	Т.СтатьяКалькуляции КАК СтатьяКалькуляции,
		|
		|	Т.КоличествоЗатрата КАК КоличествоЗатрата,
		// Комментарий 3970.
		// Сумму включения/исключения НДС, в рамках регл. учета, добавляем отдельной строкой.
		|	ВЫРАЗИТЬ(Т.СуммаЗатрата КАК ЧИСЛО(19, 2)) КАК СуммаЗатрата,
		|	ВЫРАЗИТЬ(Т.ВключениеИсключениеНДСВСтоимости КАК ЧИСЛО(19, 2)) КАК СуммаВключениеИсключениеНДСВСтоимости,
		|	ВЫРАЗИТЬ(Т.СуммаЗатратаЗабалансовая КАК ЧИСЛО(19, 2)) КАК СуммаЗатратаЗабалансовая,
