		// Стоимости Регл
		|	0											КАК МатериальныеРегл,
		|	0											КАК ТрудозатратыРегл,
		|	ВЫРАЗИТЬ(СУММА(ПрочиеРасходыНЗП.ПостатейныеПостоянныеРегл * ВыпущеннаяПродукция.Числитель / ВыпущеннаяПродукция.Знаменатель) КАК ЧИСЛО(31,10)) КАК ПостатейныеПостоянныеРегл,
		|	ВЫРАЗИТЬ(СУММА(ПрочиеРасходыНЗП.ПостатейныеПеременныеРегл * ВыпущеннаяПродукция.Числитель / ВыпущеннаяПродукция.Знаменатель) КАК ЧИСЛО(31,10)) КАК ПостатейныеПеременныеРегл,
		|	0											КАК ДопРасходыРегл,
		|	0											КАК СтоимостьЗабалансоваяРегл,
		|
		// Налоговый учет
		|	ВЫРАЗИТЬ(СУММА(ПрочиеРасходыНЗП.НалоговыйУчет * ВыпущеннаяПродукция.Числитель / ВыпущеннаяПродукция.Знаменатель) КАК ЧИСЛО(31,10)) КАК НалоговыйУчет,
		|	ВЫРАЗИТЬ(СУММА(ПрочиеРасходыНЗП.ПостояннаяРазница * ВыпущеннаяПродукция.Числитель / ВыпущеннаяПродукция.Знаменатель) КАК ЧИСЛО(31,10)) КАК ПостояннаяРазница,
		|	ВЫРАЗИТЬ(СУММА(ПрочиеРасходыНЗП.ВременнаяРазница * ВыпущеннаяПродукция.Числитель / ВыпущеннаяПродукция.Знаменатель) КАК ЧИСЛО(31,10)) КАК ВременнаяРазница,
		|
		// Включение исключение НДС в стоимости
		|	0 КАК ВключениеИсключениеНДСВСтоимости
		|
		|ИЗ
		|	ВыпущеннаяПродукция КАК ВыпущеннаяПродукция
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПрочиеРасходыНезавершенногоПроизводства КАК ПрочиеРасходыНЗП
		|		ПО ВыпущеннаяПродукция.Организация = ПрочиеРасходыНЗП.Организация
		|			И ВыпущеннаяПродукция.ПартияПродукции = ПрочиеРасходыНЗП.Регистратор
		|			И ВыпущеннаяПродукция.АналитикаУчетаПартийПродукции = ПрочиеРасходыНЗП.КорАналитикаУчетаПартий
		|			И ВыпущеннаяПродукция.АналитикаУчетаПродукции = ПрочиеРасходыНЗП.АналитикаУчетаПродукции
		|
		|СГРУППИРОВАТЬ ПО
		|	ПрочиеРасходыНЗП.Организация,
		|	ПрочиеРасходыНЗП.Регистратор,
		|	ПрочиеРасходыНЗП.КорАналитикаУчетаПартий,
		|	ПрочиеРасходыНЗП.СтатьяРасходов,
		|	ПрочиеРасходыНЗП.СтатьяКалькуляции,
		|	ПрочиеРасходыНЗП.Подразделение,
		|
		|	ВыпущеннаяПродукция.ИдентификаторУзла,
		|	ВыпущеннаяПродукция.ИдентификаторУзлаПервогоУровня,
		|	ВыпущеннаяПродукция.АналитикаУчетаЗатрат,
		|	ВыпущеннаяПродукция.УзелПервогоУровня_АналитикаУчетаПродукции,
		|	ВыпущеннаяПродукция.УзелПервогоУровня_ПартияПродукции,
		|	ВыпущеннаяПродукция.УзелПервогоУровня_АналитикаУчетаПартийПродукции
		|";
	
	Если Не ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
		// Комментарий 3970.
		// Заполнение колонок ниже необходимо только в случае формирования дерева
		// или если ТребуетсяРазузлование или ТребуетсяРазузлованиеДопРасходов,
		// в данном запросе разузлования данных не требуется.
		УбратьИдентификаторУзла(ТекстПрочиеРасходыОбъединение, "ВыпущеннаяПродукция");
	КонецЕсли;
	ТекстыЗапросаОбъединение.Добавить(ТекстПрочиеРасходыОбъединение);
	
	#КонецОбласти
	
	#Область ТекстДопРасходыОбъединение
	
	Если ВыводитьДопРасходы Тогда
			
		ТекстДопРасходыОбъединение = "
			|ВЫБРАТЬ
			|	ТаблицаОтборовУзлов.ИдентификаторУзла КАК ИдентификаторУзла,
			|	ТаблицаОтборовУзлов.ИдентификаторУзлаПервогоУровня КАК ИдентификаторУзлаПервогоУровня,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_АналитикаУчетаПродукции КАК УзелПервогоУровня_АналитикаУчетаПродукции,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_ПартияПродукции КАК УзелПервогоУровня_ПартияПродукции,
			|	ТаблицаОтборовУзлов.УзелПервогоУровня_АналитикаУчетаПартийПродукции КАК УзелПервогоУровня_АналитикаУчетаПартийПродукции,
			|	МАКСИМУМ(ТаблицаОтборовУзлов.ДатаИсходнойПартии) КАК ДатаИсходнойПартии,
			|	МАКСИМУМ(ТаблицаОтборовУзлов.РазворачиватьДопРасходы) КАК РазворачиватьДопРасходы,
			|	МАКСИМУМ(ТаблицаОтборовУзлов.ТребуетсяРазузлование) КАК ТребуетсяРазузлованиеУзлаИсточника,
			|
			|	ДАТАВРЕМЯ(1, 1, 1)						КАК МесяцПервичнойПартииВНЗП,
			|
			|	ДетализацияСебестоимости.Организация							КАК Организация,
			|	ДетализацияСебестоимости.Партия									КАК ПартияВыходноеИзделие,
			|	ДетализацияСебестоимости.АналитикаУчетаПартий					КАК АналитикаУчетаПартийВыходноеИзделие,
			|	ТаблицаОтборовУзлов.АналитикаУчетаЗатрат						КАК АналитикаУчетаВыходноеИзделие,
			|	ДетализацияСебестоимости.ДокументПоступления КАК ПартияЗатрата,
			|	ДетализацияСебестоимости.АналитикаУчетаПартийДокументаПоступления КАК АналитикаУчетаПартийЗатрата,
			|	ЛОЖЬ										КАК ВключитьНДСВСтоимость,
			|	ЛОЖЬ										КАК ИсключитьНДСИзСтоимости,
			|	ДетализацияСебестоимости.АналитикаРасходов	КАК АналитикаЗатрата,
			|	ВЫБОР
			|		КОГДА ДетализацияСебестоимости.СтатьяРасходов = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
			|			ТОГДА ЕСТЬNULL(ДетализацияСебестоимости.АналитикаУчетаПартийДокументаПоступления.ВидЦенности, ЗНАЧЕНИЕ(Перечисление.ВидыЦенностей.ПустаяСсылка))
			|		ИНАЧЕ ДетализацияСебестоимости.СтатьяРасходов
			|	КОНЕЦ КАК Затрата,
			|	НЕОПРЕДЕЛЕНО								КАК ЕдиницаИзмеренияЗатрата,
			|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ХарактеристикаЗатрата,
			|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК СерияЗатрата,
			|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) КАК НазначениеЗатрата,
			|	ТаблицаОтборовУзлов.СтатьяКалькуляции		КАК СтатьяКалькуляции,
			|	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК Подразделение,
			|	ЛОЖЬ										КАК ТребуетсяРазузлование,
			|	ЛОЖЬ										КАК ТребуетсяРазузлованиеДопРасходов,
			|	&ТипЗатратДопРасходы						КАК ТипЗатрат,
			|	0											КАК КоличествоЗатрата,
			|
			// Стоимости согласно параметру ""ДанныеПоСебестоимости""
			|	0											КАК Материальные,
			|	0											КАК Трудозатраты,
			|	0											КАК ПостатейныеПостоянные,
			|	0											КАК ПостатейныеПеременные,
			|	СУММА(ВЫБОР
			|		КОГДА &ДанныеПоСебестоимости = 1
			|			ТОГДА ДетализацияСебестоимости.СтоимостьСНДС
			|		КОГДА &ДанныеПоСебестоимости = 2
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДС
			|		КОГДА &ДанныеПоСебестоимости = 3
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДСУпр
			|			+ (ВЫБОР КОГДА ТаблицаОтборовУзлов.ВключитьНДСВСтоимость
			|				ТОГДА ДетализацияСебестоимости.НДСУпр ИНАЧЕ 0 КОНЕЦ)
			|		КОГДА &ДанныеПоСебестоимости = 4
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДСРегл
			|			+ (ВЫБОР КОГДА ТаблицаОтборовУзлов.ВключитьНДСВСтоимость
			|				ТОГДА ДетализацияСебестоимости.НДСРегл ИНАЧЕ 0 КОНЕЦ)
			|	КОНЕЦ * ТаблицаОтборовУзлов.КоличествоПродукции) КАК ДопРасходы,
			|	0											КАК СуммаЗатратаЗабалансовая,
			|	СУММА(ВЫБОР
			|		КОГДА &ДанныеПоСебестоимости = 1
			|			ТОГДА ДетализацияСебестоимости.СтоимостьСНДС
			|		КОГДА &ДанныеПоСебестоимости = 2
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДС
			|		КОГДА &ДанныеПоСебестоимости = 3
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДСУпр
			|			+ (ВЫБОР КОГДА ТаблицаОтборовУзлов.ВключитьНДСВСтоимость
			|				ТОГДА ДетализацияСебестоимости.НДСУпр ИНАЧЕ 0 КОНЕЦ)
			|		КОГДА &ДанныеПоСебестоимости = 4
			|			ТОГДА ДетализацияСебестоимости.СтоимостьБезНДСРегл
			|			+ (ВЫБОР КОГДА ТаблицаОтборовУзлов.ВключитьНДСВСтоимость
			|				ТОГДА ДетализацияСебестоимости.НДСРегл ИНАЧЕ 0 КОНЕЦ)
			|	КОНЕЦ * ТаблицаОтборовУзлов.КоличествоПродукции) КАК СуммаЗатрата,
			|	0											КАК НДД,
			|
			// Стоимости с НДС
			|	0											КАК МатериальныеСНДС,
