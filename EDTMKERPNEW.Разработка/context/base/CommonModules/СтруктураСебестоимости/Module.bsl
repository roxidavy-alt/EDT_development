
#Область ПрограммныйИнтерфейс

//Инициализирует настройки отчета для формирования отчета.
// Возвращаемое значение:
//	Структура - настройки отчета.
Функция ИнициализироватьНастройкиОтчета(Отчет, КлючТекущегоВарианта, ОтчетОбъект) Экспорт
	
	НастройкиОтчета = ВариантыОтчетов.НастройкиФормыОтчета(Отчет, КлючТекущегоВарианта, ОтчетОбъект); // Структура
	
	НастройкиОтчета.Вставить("ПрочитатьФлажокФормироватьСразуИзПользовательскихНастроек", Ложь);
	НастройкиОтчета.Вставить("РазрешеноВыбиратьВарианты", Ложь);
	НастройкиОтчета.Вставить("СхемаМодифицирована", Ложь);
	НастройкиОтчета.Вставить("ПредопределенныеВарианты", Неопределено);
	НастройкиОтчета.Вставить("АдресСхемы",   "");
	НастройкиОтчета.Вставить("КлючСхемы",    "");
	НастройкиОтчета.Вставить("Контекстный",  Ложь);
	НастройкиОтчета.Вставить("ПолноеИмя",    "");
	НастройкиОтчета.Вставить("Наименование", "");
	НастройкиОтчета.Вставить("ОтчетСсылка",  Неопределено);
	НастройкиОтчета.Вставить("Внешний",      Ложь);
	НастройкиОтчета.Вставить("Безопасный",   Ложь);
	
	Возврат НастройкиОтчета;
	
КонецФункции

// Строит дерево себестоимости для изделия.
//
// Параметры:
//  ПараметрыДерева - см. СтруктураСебестоимости.ПараметрыДереваСебестоимости
//
Процедура ПостроитьДеревоСебестоимости(ПараметрыДерева) Экспорт
	
	// СтандартныеПодсистемы.ЗамерПроизводительности
	Замер = ОценкаПроизводительности.НачатьЗамерДлительнойОперации("ОбщийМодуль.СтруктураСебестоимости.ПостроитьДеревоСебестоимости");
	ПараметрыДерева.Вставить("КоличествоСтрок", 0);
	// Конец СтандартныеПодсистемы.ЗамерПроизводительности
	
	Если ПараметрыДерева.Результат = Неопределено Тогда
		ПустоеДеревоСебестоимости(ПараметрыДерева);
	КонецЕсли;
	
	ЗаполнитьДеревоСебестоимости(ПараметрыДерева);
	
	// СтандартныеПодсистемы.ЗамерПроизводительности
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(Замер, ПараметрыДерева.КоличествоСтрок / 1000);
	// Конец СтандартныеПодсистемы.ЗамерПроизводительности
	
КонецПроцедуры

// Строит дерево себестоимости для изделия в фоне.
//
// Параметры:
// 	Параметры - Структура - описание параметров формирования отчетов:
//		* ПараметрыДерева - см. СтруктураСебестоимости.ПараметрыДереваСебестоимости
//	АдресХранилища - Строка - адрес временного хранилища.
Процедура ПостроитьДеревоСебестоимостиВФоне(Параметры, АдресХранилища) Экспорт
	
	ПараметрыДерева = Параметры.ПараметрыДерева; // см. СтруктураСебестоимости.ПараметрыДереваСебестоимости
	ПостроитьДеревоСебестоимости(ПараметрыДерева);
	
	Результат = Новый Структура("ДеревоСебестоимости, Успех");
	Результат.ДеревоСебестоимости	= ПараметрыДерева.Результат;
	Результат.Успех					= Истина;
	
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);
	
КонецПроцедуры

// Процедура дозаполняет параметры дерева себестоимости, необходимые для запуска разузлования по уровням.
//
// Параметры:
//  ПараметрыДерева - см. СтруктураСебестоимости.ПараметрыДереваСебестоимости
//
Процедура ДозаполнитьПараметрыДереваСебестоимости(ПараметрыДерева) Экспорт
	
	Если ПараметрыДерева.ТипРезультатаДеревоЗначений
		+ ПараметрыДерева.ТипРезультатаМенеджерВременныхТаблиц + ПараметрыДерева.ТипРезультатаТаблицаЗначений <> 1 Тогда
			
		ВызватьИсключение НСтр("ru = 'Должен быть определен один тип результата дерева себестоимости.';
								|en = 'Define one type of cost tree result.'");
	КонецЕсли;
	
	ПараметрыДерева.Вставить("ГлобальныеВременныеТаблицы", Новый Массив());
	ПараметрыДерева.Вставить("ТаблицаОтборовУзлов", ПустаяТаблицаОтборовУзлов(ПараметрыДерева.СтруктураПолей));
	ПараметрыДерева.Вставить("ТаблицаОтборовУзлов_ИменаКолонок",
		РасчетСебестоимостиПрикладныеАлгоритмы.ПолучитьИменаКолонокСтрокой(ПараметрыДерева.ТаблицаОтборовУзлов, "",
			Истина));
	ПараметрыДерева.Вставить("ТаблицаОтборовУзлов_ИменаКолонокССинонимами",
		РасчетСебестоимостиПрикладныеАлгоритмы.ДобавитьКолонкамСинонимы(
			ПараметрыДерева.ТаблицаОтборовУзлов_ИменаКолонок, "Т"));
			
	ПараметрыДерева.Вставить("СоответствиеУзлов", Новый Соответствие());
	Если ПараметрыДерева.МенеджерВременныхТаблиц = Неопределено Тогда
		ПараметрыДерева.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	Если ПараметрыДерева.ТипРезультатаМенеджерВременныхТаблиц Тогда
		ПараметрыДерева.Вставить("ДобавленаВременнаяТаблицаРезультатовРазузлования", Ложь);
	КонецЕсли;
	
	ТекстЗапросаЗатратыНаПродукцию(ПараметрыДерева);
	ПараметрыДерева.Вставить("ТекстЗапросаУзлыТребующиеРазузлования",
		ТекстЗапросаШаблонРезультатыРазузлования(Истина, ПараметрыДерева));
	
	ПараметрыДерева.ПараметрыОтчета.Вставить("НоменклатураВключениеИсключениеНДСВСтоимости",
		НСтр("ru = 'Включение / Исключение НДС в стоимости';
			|en = 'Include / Exclude VAT in / from cost'"));
	ПараметрыДерева.ПараметрыОтчета.Вставить("НоменклатураЗацикливание",
		НСтр("ru = 'Зацикливание разузлования';
			|en = 'Explosion looping'"));
	
	Диагностика = Новый Структура();
	Диагностика.Вставить("ГруппаСобытийЖурналаРегистрации", НСтр("ru = 'Формирование дерева себестоимости.';
																|en = 'Generate a cost tree.'"));
	Диагностика.Вставить("ЕстьОшибки", Ложь);
	Диагностика.Вставить("Ошибки", Неопределено);
	Диагностика.Вставить("ЗамерыВыполненияЗапросовПоУровнямУзлов", Новый Массив());
	ПараметрыДерева.Вставить("Диагностика", Диагностика);
	
	ПараметрыДерева.Вставить("ВышестоящиеУзлы", Новый Соответствие());
	ПараметрыДерева.Вставить("ВышестоящиеУзлыДобавлены", Ложь);
	
	ЗаполнитьИндексДляПроверкиЗацикливания(ПараметрыДерева, Ложь);
	
	ПараметрыДерева.ГлобальныеВременныеТаблицы.Добавить("ТаблицаУзлов");
	ПараметрыДерева.ГлобальныеВременныеТаблицы.Добавить("Результат");
	ПараметрыДерева.ГлобальныеВременныеТаблицы.Добавить("ВТВзаимосвязанныеОрганизации");
	
КонецПроцедуры

// Процедура загружает таблицу отборов узлов во временную таблицу менеджера временных таблиц параметров дерева.
//
// Параметры:
//  ПараметрыДерева - см. СтруктураСебестоимости.ПараметрыДереваСебестоимости
//
Процедура ЗагрузитьТаблицуОтбораУзловВоВременнуюТаблицу(ПараметрыДерева) Экспорт
	
	МассивНаборовИндексов = Новый Массив();
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ПартияПродукции = 1 Тогда
		МассивНаборовИндексов.Добавить("ПартияПродукции");
	КонецЕсли;
	МассивНаборовИндексов.Добавить("ИдентификаторУзла");

	ПараметрыДерева.ГлобальныеВременныеТаблицы.Добавить("ТаблицаОтборовУзлов");
	РасчетСебестоимостиПрикладныеАлгоритмы.ПоместитьТаблицуЗначенийВоВременнуюТаблицу(
		ПараметрыДерева.МенеджерВременныхТаблиц,
		"ТаблицаОтборовУзлов", ПараметрыДерева.ТаблицаОтборовУзлов,
		ПараметрыДерева.ТаблицаОтборовУзлов_ИменаКолонок,
		МассивНаборовИндексов);

КонецПроцедуры

// Вызывается перед раскрытием узла дерева себестоимости.
//
// Параметры:
//  ПараметрыДерева - см. СтруктураСебестоимости.ПараметрыДереваСебестоимости.
//
Процедура ДеревоСебестоимостиПередРазворачиванием(ПараметрыДерева) Экспорт
	
	// СтандартныеПодсистемы.ЗамерПроизводительности
	Замер = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(
		"ОбщийМодуль.СтруктураСебестоимости.ДеревоСебестоимостиПередРазворачиванием");
	ПараметрыДерева.Вставить("КоличествоСтрок", 0);
	// Конец СтандартныеПодсистемы.ЗамерПроизводительности
	
	Справочники.Организации.ПолучитьВзаимосвязанныеОрганизации(ПараметрыДерева.МенеджерВременныхТаблиц);
	ПоместитьТаблицаОтборовУзловВВТТаблицаУзлов(ПараметрыДерева);
	РазузловатьУровеньУзловДереваСебестоимости(ПараметрыДерева, ПараметрыДерева.Результат);
	
	// СтандартныеПодсистемы.ЗамерПроизводительности
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(Замер, ПараметрыДерева.КоличествоСтрок / 100);
	// Конец СтандартныеПодсистемы.ЗамерПроизводительности
	
КонецПроцедуры

#Область ПараметрыДереваСебестоимости

// Параметры построения дерева себестоимости
// 
// Возвращаемое значение:
// Структура:
//  * ДинамическоеСчитывание - Булево - Истина, если уровни дерева себестоимости получается последовательно.
//  * ТипРезультатаДеревоЗначений - Булево - Истина если ТипРезультата - ДеревоЗначений.
//  * ТипРезультатаМенеджерВременныхТаблиц - Булево - Истина если ТипРезультата - МенеджерВременныхТаблиц.
//  * ТипРезультатаТаблицаЗначений - Булево - Истина если ТипРезультата - ТаблицаЗначений.
//  * Результат - Произвольный - При инициализации, определяется позже, для возможности передачи параметров в фон.
//              - ДеревоЗначений - дерево значений, в которое будет помещен результат разузлования,
//                                 в случае когда ТипРезультатаДеревоЗначений.
//              - ТаблицаЗначений - таблица значений, в которую будет помещен результат разузлования,
//                                 в случае когда ТипРезультатаТаблицаЗначений.
//  * МенеджерВременныхТаблиц - Неопределено - При инициализации параметров, определяется позже, для возможности передачи параметров в фон.
//                             - МенеджерВременныхТаблиц - в случае когда ТипРезультатаМенеджерВременныхТаблиц,
//                              результат разузлования возвращается как временная таблица в данном менеджере.
//  * ДобавлятьПолуфабрикатыВРезультат - Булево - Будут ли добавлены промежуточные полуфабрикаты в результат.
//                                       Если результат ДеревоЗначений, то полуфабрикаты добавляются всегда.
//  * ВариантыУсловийСоединенияПоПараметрамУзлов - Структура - структура вариантов соединения.
//  * ИнтерактивнаяНастройка - Булево - Истина если настройки могут быть изменены интерактивно.
//  * СхемаКД - СхемаКомпоновкиДанных - Используемая схема компоновки данных.
//  * НастройкиКД - НастройкиКомпоновкиДанных - Используемые настройки компоновки данных.
//  * СчетчикТаблиц - Число - Счетчик сформированных таблиц.
//  * УровеньУзла - Число - Уровень текущего узла.
//  * ВключитьНДСВСтоимость - Булево - Определяет необходимость включения НДС в стоимость.
//  * ИсключитьНДСИзСтоимости - Булево - Определяет необходимость исключения НДС из стоимости.
//  * СтруктураПолей - Структура - Определяет структуру полей и их типов дерева себестоимости.
//  * МаксимальнаяГлубинаРазузлования - Число - Ограничение максимальной глубины разузлования, дополнительная защита от зацикливания.
//  * ВыводитьОшибки - Булево - Определяет нужно ли выводить пользователю ошибки разузлования.
//  * ПараметрыОтчета - Структура - Структура параметров отчета.
//  * ИндексДляПроверкиЗацикливания - Неопределено - При инициализации параметров, определяется позже.
//                                  - Строка - Список колонок по которым требуется индексирование.
//  * ТаблицаОтборовУзлов - Неопределено - При инициализации параметров, определяется позже.
//                        - ТаблицаЗначений - Таблица, по которой будет происходить отбор данных из регистров.
//
Функция ПараметрыДереваСебестоимости() Экспорт
	
	ТипыРезультата = Новый ОписаниеТипов("ДеревоЗначений,ТаблицаЗначений");
	ПараметрыДерева = Новый Структура;
	
	#Область ОбщиеПараметрыДерева
	
	ПараметрыДерева.Вставить("ДинамическоеСчитывание",	Истина);
	ПараметрыДерева.Вставить("Результат",				ТипыРезультата.ПривестиЗначение(Неопределено));
	ПараметрыДерева.Вставить("ДобавлятьПолуфабрикатыВРезультат", Истина);
	
	ПараметрыДерева.Вставить("СхемаКД", Отчеты.ДеревоСебестоимостиПродукции.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"));
	ПараметрыДерева.Вставить("НастройкиКД", ПараметрыДерева.СхемаКД.НастройкиПоУмолчанию);
	ПараметрыДерева.Вставить("СчетчикТаблиц", 0);
	
	ПараметрыДерева.Вставить("УровеньУзла", 1);
	ПараметрыДерева.Вставить("ИнтерактивнаяНастройка", Ложь);
	ПараметрыДерева.Вставить("ВключитьНДСВСтоимость", Ложь);
	ПараметрыДерева.Вставить("ИсключитьНДСИзСтоимости", Ложь);
	ПараметрыДерева.Вставить("МенеджерВременныхТаблиц", Неопределено);
	ПараметрыДерева.Вставить("ТипРезультатаДеревоЗначений", Ложь);
	ПараметрыДерева.Вставить("ТипРезультатаМенеджерВременныхТаблиц", Ложь);
	ПараметрыДерева.Вставить("ТипРезультатаТаблицаЗначений", Ложь);
	ПараметрыДерева.Вставить("СтруктураПолей", СтруктураПолейДереваСебестоимости());
	ПараметрыДерева.Вставить("МаксимальнаяГлубинаРазузлования", 1000);
	ПараметрыДерева.Вставить("ВыводитьОшибки", Истина);
	ПараметрыДерева.Вставить("ИндексДляПроверкиЗацикливания", Неопределено);
	ПараметрыДерева.Вставить("ТаблицаОтборовУзлов", Неопределено);

	#КонецОбласти
	
	#Область ОбщиеПараметрыОтчета
	
	ПараметрыОтчета = Новый Структура();
	ПараметрыОтчета.Вставить("ДатаНачала", Дата('00010101'));
	ПараметрыОтчета.Вставить("ДатаОкончания", Дата('00010101'));
	ПараметрыОтчета.Вставить("Организации", Новый Массив());
	ПараметрыОтчета.Вставить("Подразделения", Новый Массив());
	ПараметрыОтчета.Вставить("Регистраторы", Новый Массив());
	ПараметрыОтчета.Вставить("РазворачиватьДопРасходы", Истина);
	ПараметрыОтчета.Вставить("ВалютаУправленческогоУчета", Справочники.Валюты.ПустаяСсылка());
	ПараметрыОтчета.Вставить("ДанныеПоСебестоимости", 1);
	ПараметрыОтчета.Вставить("ЗаВесьПериод", Истина);
	ПараметрыОтчета.Вставить("ПоВсемОрганизациям", Истина);
	ПараметрыОтчета.Вставить("ПоВсемПодразделениям", Истина);
	ПараметрыОтчета.Вставить("РасшифровкаДвиженийДокумента", Ложь);
	ПараметрыОтчета.Вставить("КоличествоУзловОтбора", 0);
	
	ПараметрыДерева.Вставить("ПараметрыОтчета", ПараметрыОтчета);
	
	#КонецОбласти
	
	#Область ВариантыУсловийСоединенияПоПараметрамУзлов
	// Комментарий 204.
	// 3 варианта по каждому соединению:
	//    0. По колонке во всех строках значение пустое и не требует соединения, условие соединения не нужно.
	//    1. По колонке во всех строках отбора заполнено значение, условие соединения на равенство.
	//    2. По колонке в каких то строках таблицы отбора требуется соединение, в каких то нет,
	//      условие соединения через ИЛИ, в зависимости от заполненности.
	ВариантыУсловийСоединенияПоПараметрамУзлов = Новый Структура();
	ВариантыУсловийСоединенияПоПараметрамУзлов.Вставить("Продукция", 1);
	ВариантыУсловийСоединенияПоПараметрамУзлов.Вставить("ПартияПродукции", 1);
	ВариантыУсловийСоединенияПоПараметрамУзлов.Вставить("ХарактеристикаПродукции", 1);
	ВариантыУсловийСоединенияПоПараметрамУзлов.Вставить("СерияПродукции", 0);
	ВариантыУсловийСоединенияПоПараметрамУзлов.Вставить("НазначениеПродукции", 0);
	ВариантыУсловийСоединенияПоПараметрамУзлов.Вставить("АналитикаУчетаПартийПродукции", 0);
	
	ПараметрыДерева.Вставить("ВариантыУсловийСоединенияПоПараметрамУзлов", ВариантыУсловийСоединенияПоПараметрамУзлов);
	#КонецОбласти
	
	Возврат ПараметрыДерева;
	
КонецФункции

// Определяет варианты условий соединения для параметров узлов на основе таблицы отборов.
//
// Параметры:
//   ПараметрыДерева - Структура - Структура, содержащая таблицу отборов узлов и варианты условий соединения.
//
Процедура УстановитьВариантыУсловийСоединенияПоПараметрамУзлов(ПараметрыДерева) Экспорт
	ПараметрыДерева.ПараметрыОтчета.КоличествоУзловОтбора = ПараметрыДерева.ТаблицаОтборовУзлов.Количество();
	КоличествоСтрокОтбора = ПараметрыДерева.ПараметрыОтчета.КоличествоУзловОтбора;
	ПоВсейПродукции = 0;
	ПоВсемПартиям = 0;
	ПоВсемХарактеристикам = 0;
	ПоВсемСериям = 0;
	ПоВсемНазначениям = 0;
	ПоВсемАналитикамПартий = 0;
	Для Каждого СтрокаОтбора Из ПараметрыДерева.ТаблицаОтборовУзлов Цикл
		ПоВсейПродукции = ПоВсейПродукции + ?(СтрокаОтбора.ПоВсейПродукции, 1, 0);
		ПоВсемПартиям = ПоВсемПартиям + ?(СтрокаОтбора.ПоВсемПартиям, 1, 0);
		ПоВсемХарактеристикам = ПоВсемХарактеристикам + ?(СтрокаОтбора.ПоВсемХарактеристикам, 1, 0);
		ПоВсемСериям = ПоВсемСериям + ?(СтрокаОтбора.ПоВсемСериям, 1, 0);
		ПоВсемНазначениям = ПоВсемНазначениям + ?(СтрокаОтбора.ПоВсемНазначениям, 1, 0);
		ПоВсемАналитикамПартий = ПоВсемАналитикамПартий + ?(СтрокаОтбора.ПоВсемАналитикамПартий, 1, 0);
	КонецЦикла;
	
	#Область ВариантыУсловийСоединенияПоПараметрамУзлов
	ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.Продукция = 
		?(ПоВсейПродукции = КоличествоСтрокОтбора, 0,
			?(ПоВсейПродукции = 0, 1, 2));
	ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ПартияПродукции = 
		?(ПоВсемПартиям = КоличествоСтрокОтбора, 0,
			?(ПоВсемПартиям = 0, 1, 2));
	ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ХарактеристикаПродукции = 
		?(ПоВсемХарактеристикам = КоличествоСтрокОтбора, 0,
			?(ПоВсемХарактеристикам = 0, 1, 2));
	ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.СерияПродукции = 
		?(ПоВсемСериям = КоличествоСтрокОтбора, 0,
			?(ПоВсемСериям = 0, 1, 2));
	ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.НазначениеПродукции = 
		?(ПоВсемНазначениям = КоличествоСтрокОтбора, 0,
			?(ПоВсемНазначениям = 0, 1, 2));
	ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.АналитикаУчетаПартийПродукции = 
		?(ПоВсемАналитикамПартий = КоличествоСтрокОтбора, 0,
			?(ПоВсемАналитикамПартий = 0, 1, 2));
	#КонецОбласти
КонецПроцедуры

// Возвращает структуру типов затрат, которые могут быть использованы в сформированном дереве себестоимости.
// 
// Возвращаемое значение:
// Структура:
//  * ТипЗатратПродукция - Строка - Тип затрат продукции.
//  * ТипЗатратМатериальные - Строка - Тип затрат материальные.
//  * ТипЗатратТрудозатраты - Строка - Тип затрат трудозатраты.
//  * ТипЗатратПостатейные - Строка - Тип затрат постатейные.
//  * ТипЗатратДопРасходы - Строка - Тип затрат доп. расходы.
//
Функция ТипыЗатратДереваСебестоимости() Экспорт
	ТипыЗатрат = Новый Структура();
	ТипыЗатрат.Вставить("ТипЗатратПродукция",		НСтр("ru = 'Продукция';
															|en = 'Manufactured product'"));
	ТипыЗатрат.Вставить("ТипЗатратМатериальные",	НСтр("ru = 'Материальные';
														|en = 'Material costs'"));
	ТипыЗатрат.Вставить("ТипЗатратТрудозатраты",	НСтр("ru = 'Трудозатраты';
														|en = 'Labor costs'"));
	ТипыЗатрат.Вставить("ТипЗатратПостатейные",		НСтр("ru = 'Постатейные';
															|en = 'Itemized costs'"));
	ТипыЗатрат.Вставить("ТипЗатратДопРасходы",		НСтр("ru = 'Доп. расходы';
															|en = 'Additional expenses'"));
	Возврат ТипыЗатрат;
КонецФункции
	
#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет дерево себестоимости
//
// Параметры:
//  ПараметрыДерева - см. СтруктураСебестоимости.ПараметрыДереваСебестоимости.
//
Процедура ЗаполнитьДеревоСебестоимости(ПараметрыДерева)
	
	Если ПараметрыДерева.ТаблицаОтборовУзлов = Неопределено Тогда
		ДозаполнитьПараметрыДереваСебестоимости(ПараметрыДерева);
	КонецЕсли;
	
	Справочники.Организации.ПолучитьВзаимосвязанныеОрганизации(ПараметрыДерева.МенеджерВременныхТаблиц);
	
	// Набор полей для индексирования должен учитывать варианты условий соединения.
	МассивНаборовИндексов = Новый Массив();
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ПартияПродукции = 1 Тогда
		МассивНаборовИндексов.Добавить("ПартияПродукции");
	КонецЕсли;
	МассивНаборовИндексов.Добавить("ИдентификаторУзла");
		
	РасчетСебестоимостиПрикладныеАлгоритмы.ПоместитьТаблицуЗначенийВоВременнуюТаблицу(
		ПараметрыДерева.МенеджерВременныхТаблиц,
		"ТаблицаОтборовУзлов", ПараметрыДерева.ТаблицаОтборовУзлов,
		ПараметрыДерева.ТаблицаОтборовУзлов_ИменаКолонок,
		МассивНаборовИндексов);
	
	ПараметрыДерева.ПараметрыОтчета.КоличествоУзловОтбора = ПараметрыДерева.ТаблицаОтборовУзлов.Количество();
	Запрос = ЗапросВыпущеннаяПродукция(Ложь, ПараметрыДерева);
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("РезультатВыполненияЗапроса", "");
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВыпущеннаяПродукция = РасчетСебестоимостиПрикладныеАлгоритмы.ВыполнитьЗапросСЗамеромДляПротокола(
		ПараметрыРасчета, Запрос,,, Истина, НСтр("ru = 'Заполнить дерево себестоимости';
												|en = 'Fill cost tree'"));
		
	Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Шаблон = НСтр("ru = 'Уровень узлов: %1
			|Общее время: %2
			|Количество узлов отбора: %3
			|%4';
			|en = 'Node level: %1
			|Total time: %2
			|Number of filter nodes: %3
			|%4'");
	ТекстДляПротокола = СтрШаблон(Шаблон,
		ПараметрыДерева.УровеньУзла,
		РасчетСебестоимостиПротоколРасчета.ПредставлениеВремени(Длительность),
		ПараметрыДерева.ПараметрыОтчета.КоличествоУзловОтбора,
		ПараметрыРасчета.РезультатВыполненияЗапроса);
	ПараметрыДерева.Диагностика.ЗамерыВыполненияЗапросовПоУровнямУзлов.Добавить(ТекстДляПротокола);
	ИмяСобытия = НСтр("ru = 'Выполнение запроса по уровню узлов';
						|en = 'Query execution by node level'");
	ЗаписьЖурналаРегистрации(ПараметрыДерева.Диагностика.ГруппаСобытийЖурналаРегистрации + ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,,,
		ТекстДляПротокола);
		
	УничтожитьВременныеТаблицы(ПараметрыДерева);
		
	ПараметрыДерева.ИнтерактивнаяНастройка = Ложь;
	ПараметрыДерева.Вставить("УровеньУзла", 1);
	
	Если ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
		Результат = ПараметрыДерева.Результат.Строки;
	ИначеЕсли ПараметрыДерева.ТипРезультатаТаблицаЗначений Тогда
		Результат = ПараметрыДерева.Результат;
	Иначе
		Результат = Новый ТаблицаЗначений;
		ИнициализироватьПоляДереваСебестоимости(Результат, ПараметрыДерева.СтруктураПолей);
		ПараметрыДерева.Вставить("ПоляТаблицы",
			РасчетСебестоимостиПрикладныеАлгоритмы.ПолучитьИменаКолонокСтрокой(Результат, "Идентификатор", Истина));
		ПараметрыДерева.Вставить("ИменаТаблиц", Новый Массив());
	КонецЕсли;
	
	ПараметрыДерева.ТаблицаОтборовУзлов.Очистить();
	ВыпущеннаяПродукция = ВыпущеннаяПродукция.Выбрать();
	Пока ВыпущеннаяПродукция.Следующий() Цикл
		
		НовыйИдентификаторУзла = Строка(Новый УникальныйИдентификатор());
		
		Если ПараметрыДерева.ТипРезультатаДеревоЗначений
			ИЛИ ПараметрыДерева.ДобавлятьПолуфабрикатыВРезультат
			ИЛИ Не ВыпущеннаяПродукция.ТребуетсяРазузлование Тогда
			СтрокаПартия = Результат.Добавить(); // СтрокаДереваЗначений
			ЗаполнитьЗначенияСвойств(СтрокаПартия, ВыпущеннаяПродукция);
			
			СтрокаПартия.Идентификатор	= Новый УникальныйИдентификатор();
			СтрокаПартия.ИдентификаторУзла = НовыйИдентификаторУзла;
			СтрокаПартия.ВидСтроки		= Перечисления.ВидыСтрокДереваСебестоимости.ПартияПродукции;
			
			СтрокаПартия.АналитикаУчетаВыходноеИзделие			= ВыпущеннаяПродукция.АналитикаУчетаПродукции;
			СтрокаПартия.АналитикаУчетаПартийВыходноеИзделие	= ВыпущеннаяПродукция.АналитикаУчетаПартийПродукции;
			СтрокаПартия.ПартияВыходноеИзделие					= ВыпущеннаяПродукция.ПартияПродукции;
			
			СтрокаПартия.Номенклатура			= ВыпущеннаяПродукция.Продукция;
			СтрокаПартия.Характеристика			= ВыпущеннаяПродукция.ХарактеристикаПродукции;
			СтрокаПартия.Серия					= ВыпущеннаяПродукция.СерияПродукции;
			СтрокаПартия.Назначение				= ВыпущеннаяПродукция.НазначениеПродукции;
			СтрокаПартия.Валюта					= ВыпущеннаяПродукция.Валюта;
			СтрокаПартия.Партия					= ВыпущеннаяПродукция.ПартияПродукции;
			СтрокаПартия.АналитикаУчетаПартий	= ВыпущеннаяПродукция.АналитикаУчетаПартийПродукции;
			СтрокаПартия.ЕдиницаИзмерения		= ВыпущеннаяПродукция.ЕдиницаИзмеренияПродукция;
			
			СтрокаПартия.Количество	= ВыпущеннаяПродукция.КоличествоПродукция;
			СтрокаПартия.Сумма		= ВыпущеннаяПродукция.СуммаПродукция;
			СтрокаПартия.СуммаЗабалансовая = ВыпущеннаяПродукция.СуммаПродукцияЗабалансовая;
			
			Если ПараметрыДерева.ТипРезультатаДеревоЗначений И ВыпущеннаяПродукция.ТребуетсяРазузлование 
				И ВыпущеннаяПродукция.КоличествоПродукция <> 0 Тогда
						
				ПараметрыДерева.СоответствиеУзлов.Вставить(СтрокаПартия.ИдентификаторУзла, 
					СтрокаПартия);
			КонецЕсли;
		КонецЕсли;
		
		Если (ВыпущеннаяПродукция.ТребуетсяРазузлование Или ВыпущеннаяПродукция.ТребуетсяРазузлованиеДопРасходов)
			И ПараметрыДерева.ТипРезультатаДеревоЗначений
			И ПараметрыДерева.ДинамическоеСчитывание
			И ВыпущеннаяПродукция.КоличествоПродукция <> 0 Тогда
			
			СтрокаПартия.Строки.Добавить();
			
		ИначеЕсли ВыпущеннаяПродукция.ТребуетсяРазузлование
			И ВыпущеннаяПродукция.КоличествоПродукция <> 0 Тогда //проверка на отсторнированный выпуск в выбранном периоде
			
			НоваяСтрокаОтбора = ПараметрыДерева.ТаблицаОтборовУзлов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОтбора, ВыпущеннаяПродукция);
			НоваяСтрокаОтбора.Уровень = ПараметрыДерева.УровеньУзла;
			НоваяСтрокаОтбора.ДанныеПоСебестоимости = ПараметрыДерева.ПараметрыОтчета.ДанныеПоСебестоимости;

			НоваяСтрокаОтбора.ИдентификаторУзла = НовыйИдентификаторУзла;
			ВышестоящиеУзлы = Новый Массив();
			ПараметрыДерева.ВышестоящиеУзлы.Вставить(НовыйИдентификаторУзла, ВышестоящиеУзлы);
			Если Не ЗначениеЗаполнено(НоваяСтрокаОтбора.ИдентификаторУзлаПервогоУровня) Тогда
				НоваяСтрокаОтбора.ИдентификаторУзлаПервогоУровня = НовыйИдентификаторУзла;
			КонецЕсли;
			НоваяСтрокаОтбора.УзелПервогоУровня_АналитикаУчетаПродукции = ВыпущеннаяПродукция.АналитикаУчетаПродукции;
			НоваяСтрокаОтбора.АналитикаУчетаЗатрат = ВыпущеннаяПродукция.АналитикаУчетаПродукции;
			НоваяСтрокаОтбора.УзелПервогоУровня_ПартияПродукции = ВыпущеннаяПродукция.ПартияПродукции;
			НоваяСтрокаОтбора.УзелПервогоУровня_АналитикаУчетаПартийПродукции = ВыпущеннаяПродукция.АналитикаУчетаПартийПродукции;
			// Комментарий 406.
			// При разузловании полуфабрикатов отбор по назначению не нужен,
			// т.к. полуфабрикат может быть выпущен без назначения или с указанием другого назначения.
			// Поэтому в таблицу отбора значение заполняем, но выключаем отбор по назначениям.
			НоваяСтрокаОтбора.ПоВсемНазначениям = Истина;
			
			НоваяСтрокаОтбора.Знаменатель = Макс(-ВыпущеннаяПродукция.Знаменатель, ВыпущеннаяПродукция.Знаменатель);
			НоваяСтрокаОтбора.КоличествоПродукции = Макс(-ВыпущеннаяПродукция.КоличествоПродукция, ВыпущеннаяПродукция.КоличествоПродукция);
			НоваяСтрокаОтбора.РазворачиватьДопРасходы = ПараметрыДерева.ПараметрыОтчета.РазворачиватьДопРасходы;
			НоваяСтрокаОтбора.ДатаИсходнойПартии_НачалоМесяца = НачалоМесяца(НоваяСтрокаОтбора.ДатаИсходнойПартии);
			НоваяСтрокаОтбора.ДатаИсходнойПартии_КонецМесяца = КонецМесяца(НоваяСтрокаОтбора.ДатаИсходнойПартии);
			
			НоваяСтрокаОтбора.Сумма = ВыпущеннаяПродукция.СуммаПродукция;
			НоваяСтрокаОтбора.СуммаЗабалансовая = ВыпущеннаяПродукция.СуммаПродукцияЗабалансовая;
			
			Если ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
				ТаблицаРезультата = СтрокаПартия;
			Иначе
				ТаблицаРезультата = Результат;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПараметрыДерева.ТипРезультатаМенеджерВременныхТаблиц Тогда
		РасчетСебестоимостиПрикладныеАлгоритмы.ПоместитьТаблицуЗначенийВоВременнуюТаблицу(
			ПараметрыДерева.МенеджерВременныхТаблиц,
			"ПредварительныйРезультат",
			Результат,
			ПараметрыДерева.ПоляТаблицы);
		ПараметрыДерева.ГлобальныеВременныеТаблицы.Добавить("ПредварительныйРезультат");
		Результат.Очистить();
	КонецЕсли;
	
	ПараметрыДерева.ПараметрыОтчета.КоличествоУзловОтбора = ПараметрыДерева.ТаблицаОтборовУзлов.Количество();
	Если ПараметрыДерева.ПараметрыОтчета.КоличествоУзловОтбора > 0 Тогда
		#Область ВариантыУсловийСоединенияПоПараметрамУзлов
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.Продукция = 1;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ПартияПродукции = 1;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ХарактеристикаПродукции = 1;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.Продукция = 1;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.СерияПродукции = 1;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.НазначениеПродукции = 0;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.АналитикаУчетаПартийПродукции = 1;
		
		МассивНаборовИндексов = Новый Массив();
		МассивНаборовИндексов.Добавить("ПартияПродукции");
		МассивНаборовИндексов.Добавить("ИдентификаторУзла");
		
		МассивНаборовИндексов.Добавить(ПараметрыДерева.ИндексДляПроверкиЗацикливания);
		#КонецОбласти
		
		// Комментарий 520.
		// Массив регистраторов должен быть заполнен только на первом шаге разузлования.
		ПараметрыДерева.ПараметрыОтчета.Регистраторы = Новый Массив();
		
		РасчетСебестоимостиПрикладныеАлгоритмы.ПоместитьТаблицуЗначенийВоВременнуюТаблицу(
			ПараметрыДерева.МенеджерВременныхТаблиц,
			"ТаблицаОтборовУзлов", ПараметрыДерева.ТаблицаОтборовУзлов,
			ПараметрыДерева.ТаблицаОтборовУзлов_ИменаКолонок,
			МассивНаборовИндексов);
			
		МассивНаборовИндексов = Новый Массив();
		ПоместитьТаблицаОтборовУзловВВТТаблицаУзлов(ПараметрыДерева);

		РазузловатьУровеньУзловДереваСебестоимости(ПараметрыДерева, ТаблицаРезультата);
	КонецЕсли;
	
	Если ПараметрыДерева.ТипРезультатаМенеджерВременныхТаблиц Тогда
		
		ОбъединяемыеВременныеТаблицы = "ПредварительныйРезультат";
		Если РасчетСебестоимостиПрикладныеАлгоритмы.ВременнаяТаблицаСуществует(ПараметрыДерева.МенеджерВременныхТаблиц,
			"ПредварительныйРезультат2") Тогда
				
			ОбъединяемыеВременныеТаблицы = "ПредварительныйРезультат,ПредварительныйРезультат2";
		КонецЕсли;
		
		// В таблицах у колонок разные типы, поэтому для использования метода запроса - добавить,
		// заполняем таблицы отдельно, в конце объединяем.
		РасчетСебестоимостиПрикладныеАлгоритмы.ОбъединитьВременныеТаблицы(ПараметрыДерева.МенеджерВременныхТаблиц,
			ОбъединяемыеВременныеТаблицы, "Результат",
			ПараметрыДерева.ПоляТаблицы, "", "", Истина); //@Query-part
			
	КонецЕсли;
	
	ВывестиОшибкиРазузлования(ПараметрыДерева);
	
КонецПроцедуры

Процедура ЗаполнитьИндексДляПроверкиЗацикливания(ПараметрыДерева, ПроверитьИндексациюВТТаблицаУзлов)
	
	МассивИндексируемыхКолонок = Новый Массив();
	МассивИндексируемыхКолонок.Добавить("ИдентификаторУзлаПервогоУровня"); //@Query-part
	МассивИндексируемыхКолонок.Добавить("АналитикаУчетаЗатрат"); //@Query-part
	МассивИндексируемыхКолонок.Добавить("ПартияЗатрата"); //@Query-part
	
	// Смотри комментарий 204.
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ПартияПродукции = 1 Тогда
		МассивИндексируемыхКолонок.Добавить("ПартияПродукции"); //@Query-part
	КонецЕсли;
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.АналитикаУчетаПартийПродукции = 1 Тогда
		МассивИндексируемыхКолонок.Добавить("АналитикаУчетаПартийПродукции"); //@Query-part
	КонецЕсли;
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.Продукция = 1 Тогда
		МассивИндексируемыхКолонок.Добавить("Продукция"); //@Query-part
	КонецЕсли;
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ХарактеристикаПродукции = 1 Тогда
		МассивИндексируемыхКолонок.Добавить("ХарактеристикаПродукции"); //@Query-part
	КонецЕсли;
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.СерияПродукции = 1 Тогда
		МассивИндексируемыхКолонок.Добавить("СерияПродукции"); //@Query-part
	КонецЕсли;
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.НазначениеПродукции = 1 Тогда
		МассивИндексируемыхКолонок.Добавить("НазначениеПродукции"); //@Query-part
	КонецЕсли;
	
	МассивИндексируемыхКолонок.Добавить("ИдентификаторУзла"); //@Query-part
	НоваяСтрокаИндексируемыхКолонок = СтрСоединить(МассивИндексируемыхКолонок, ",");
	ПереиндексироватьВТТаблицаУзлов = ПроверитьИндексациюВТТаблицаУзлов
		И ПараметрыДерева.ИндексДляПроверкиЗацикливания <> Неопределено
		И НоваяСтрокаИндексируемыхКолонок <> ПараметрыДерева.ИндексДляПроверкиЗацикливания;
	
	ПараметрыДерева.Вставить("ИндексДляПроверкиЗацикливания", НоваяСтрокаИндексируемыхКолонок);
	
	Если ПереиндексироватьВТТаблицаУзлов Тогда
		ИмяИсточника = "ТаблицаУзлов";
		ИмяПриемника = "ТаблицаУзловКопия";
		РасчетСебестоимостиПрикладныеАлгоритмы.СкопироватьВременнуюТаблицу(ПараметрыДерева.МенеджерВременныхТаблиц,
			ИмяИсточника, ИмяПриемника);
		РасчетСебестоимостиПрикладныеАлгоритмы.УничтожитьВременныеТаблицы(ПараметрыДерева.МенеджерВременныхТаблиц,
			ИмяИсточника);
		РасчетСебестоимостиПрикладныеАлгоритмы.СкопироватьВременнуюТаблицу(ПараметрыДерева.МенеджерВременныхТаблиц,
			ИмяПриемника, ИмяИсточника, НоваяСтрокаИндексируемыхКолонок) 
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоместитьТаблицаОтборовУзловВВТТаблицаУзлов(ПараметрыДерева)

	ЗаполнитьИндексДляПроверкиЗацикливания(ПараметрыДерева, Ложь);
	
	// Комментарий 510.
	// ТаблицаУзлов необходима для отслеживания зацикливания.
	РасчетСебестоимостиПрикладныеАлгоритмы.ПоместитьТаблицуЗначенийВоВременнуюТаблицу(
		ПараметрыДерева.МенеджерВременныхТаблиц,
		"ТаблицаУзлов", ПараметрыДерева.ТаблицаОтборовУзлов,
		ПараметрыДерева.ТаблицаОтборовУзлов_ИменаКолонок,
		ПараметрыДерева.ИндексДляПроверкиЗацикливания);
	
КонецПроцедуры

Процедура ВывестиОшибкиРазузлования(ПараметрыДерева)
	Если ПараметрыДерева.ВыводитьОшибки Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(ПараметрыДерева.Диагностика.Ошибки);
	КонецЕсли;
КонецПроцедуры

Процедура УничтожитьВременныеТаблицы(ПараметрыДерева)
	
	ТекстыУничтоженияВременныхТаблиц = Новый Массив();
	Для Каждого ВременнаяТаблица Из ПараметрыДерева.МенеджерВременныхТаблиц.Таблицы Цикл
		Если ПараметрыДерева.ГлобальныеВременныеТаблицы.Найти(ВременнаяТаблица.ПолноеИмя) = Неопределено Тогда
			ТекстыУничтоженияВременныхТаблиц.Добавить("УНИЧТОЖИТЬ " + ВременнаяТаблица.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	
	Если ТекстыУничтоженияВременныхТаблиц.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = ПараметрыДерева.МенеджерВременныхТаблиц;
	Запрос.Текст = СтрСоединить(ТекстыУничтоженияВременныхТаблиц, ";");
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ДобавитьДанныеКВременнойТаблице(МенеджерВТ, ИмяВременнойТаблицы, Данные, ИменаКолонок)
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Шаблон = "
		|ВЫБРАТЬ
		|	%1
		|ДОБАВИТЬ %2
		|ИЗ &ПараметрЗапросаТаблицаЗначений КАК Т
		|"; //@Query-part

	ИменаКолонокССинонимами = РасчетСебестоимостиПрикладныеАлгоритмы.ДобавитьКолонкамСинонимы(ИменаКолонок, "Т");
	Запрос.Текст = СтрШаблон(Шаблон, ИменаКолонокССинонимами, ИмяВременнойТаблицы);
	Запрос.УстановитьПараметр("ПараметрЗапросаТаблицаЗначений", Данные);
	Запрос.Выполнить();
КонецПроцедуры

Процедура РассчитатьРасходПартий(Запрос, ПараметрыДерева)
	МассивТекстовЗапросов = Новый Массив();
	МассивТекстовЗапросов.Добавить(Запрос.Текст);
	МассивТекстовЗапросов.Добавить(ТекстЗапросаРасходПартий());
	Запрос.Текст = СтрСоединить(МассивТекстовЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Пояснение = НСтр("ru = 'Материальные затраты узлов';
					|en = 'Материальные затраты узлов'");
	ИмяСобытия = НСтр("ru = 'Расчет расхода партий в НЗП по уровню узлов';
						|en = 'Расчет расхода партий в НЗП по уровню узлов'");
	РезультатЗапроса = ВыполнитьЗапросСЗамеромДляПротокола(Запрос, ПараметрыДерева, Пояснение, ИмяСобытия);
	
	ИндексПоследнегоЗапроса = РезультатЗапроса.ВГраница();
	ВыбытиеИзНЗПДляОстатка = РезультатЗапроса[ИндексПоследнегоЗапроса - 2].Выгрузить();
	ПервичныеПартииВНЗП = РезультатЗапроса[ИндексПоследнегоЗапроса - 1].Выгрузить();
	ПервичныеПартииВНЗП.Индексы.Добавить("ИдентификаторАналитик");
	РасходПартий = РезультатЗапроса[ИндексПоследнегоЗапроса].Выгрузить();
	
	Для Каждого СтрокаВыбытия Из ВыбытиеИзНЗПДляОстатка Цикл
		СтруктураОтбора = Новый Структура("ИдентификаторАналитик", СтрокаВыбытия.ИдентификаторАналитик);
		СтрокиПрихода = ПервичныеПартииВНЗП.НайтиСтроки(СтруктураОтбора);
		
		// Общий остаток по партиям необходимо считать по месяцу расхода, с учетом возможного расхода в предыдущих месяцах.
		КоличествоОстатокПоПартиям = 0;
		ОтобранныеСтрокиПартий = Новый Массив;
		Для Каждого СтрокаПрихода Из СтрокиПрихода Цикл
			Если СтрокаПрихода.Период > СтрокаВыбытия.Период Или СтрокаПрихода.Количество = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ОтобранныеСтрокиПартий.Добавить(СтрокаПрихода);
			КоличествоОстатокПоПартиям = КоличествоОстатокПоПартиям + СтрокаПрихода.Количество;
		КонецЦикла;
		
		КоличествоВыбытия = СтрокаВыбытия.Количество;
		Для Каждого СтрокаПрихода Из ОтобранныеСтрокиПартий Цикл
			
			// В разделе незавершенного производства учет по средней.
			// Забираем из каждой партии количество выбытия, относительно коэффициента остатка по партии, в общем остатке.
			КоличествоРасход = КоличествоВыбытия * СтрокаПрихода.Количество / КоличествоОстатокПоПартиям;
			
			СтрокаРасходаПартии = РасходПартий.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРасходаПартии, СтрокаПрихода);
			СтрокаРасходаПартии.Период = СтрокаВыбытия.Период;
			СтрокаРасходаПартии.Количество = КоличествоРасход;
			
			СтрокаПрихода.Количество = СтрокаПрихода.Количество - КоличествоРасход;
			СтрокаВыбытия.Количество = СтрокаВыбытия.Количество - КоличествоРасход;
		КонецЦикла;
	КонецЦикла;
	
	РасчетСебестоимостиПрикладныеАлгоритмы.ПоместитьТаблицуЗначенийВоВременнуюТаблицу(
		Запрос.МенеджерВременныхТаблиц,
		"РасходПартий",
		РасходПартий,
		"ИдентификаторУзла,Период,Организация,АналитикаУчетаНоменклатуры,АналитикаУчетаПартий,Партия,
			|КорАналитикаУчетаНоменклатуры,КорПартия,Количество",
		"ИдентификаторУзла,Организация,АналитикаУчетаНоменклатуры,Партия,Период");
КонецПроцедуры

Функция ВыполнитьЗапросСЗамеромДляПротокола(Запрос, ПараметрыДерева, Пояснение, ИмяСобытия)
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("РезультатВыполненияЗапроса", "");
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	РезультатЗапроса = РасчетСебестоимостиПрикладныеАлгоритмы.ВыполнитьЗапросСЗамеромДляПротокола(
		ПараметрыРасчета, Запрос,,, Истина, Пояснение);
		
	Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	Шаблон = НСтр("ru = 'Уровень узлов: %1
			|Общее время: %2
			|Количество узлов отбора: %3
			|%4';
			|en = 'Node level: %1
			|Total time: %2
			|Number of filter nodes: %3
			|%4'");
	ТекстДляПротокола = СтрШаблон(Шаблон,
		ПараметрыДерева.УровеньУзла,
		РасчетСебестоимостиПротоколРасчета.ПредставлениеВремени(Длительность),
		ПараметрыДерева.ПараметрыОтчета.КоличествоУзловОтбора,
		ПараметрыРасчета.РезультатВыполненияЗапроса);
	ПараметрыДерева.Диагностика.ЗамерыВыполненияЗапросовПоУровнямУзлов.Добавить(ТекстДляПротокола);
	
	ЗаписьЖурналаРегистрации(ПараметрыДерева.Диагностика.ГруппаСобытийЖурналаРегистрации + ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,,,
		ТекстДляПротокола);
	
	Возврат РезультатЗапроса;
КонецФункции

Функция СебестоимостьУзлов(ПараметрыДерева, ВыводитьДопРасходы, ДобавитьГруппировкуПоИдентификаторамУзлов)
	
	СтрокаИтогиПоИдентификаторУзла = "";
	Если ДобавитьГруппировкуПоИдентификаторамУзлов Тогда
		СтрокаИтогиПоИдентификаторУзла = "
			|ИТОГИ ПО
			|	ИдентификаторУзла
			|"; //@Query-part
	КонецЕсли;
	
	Запрос = ЗапросВыпущеннаяПродукция(Истина, ПараметрыДерева);
	Запрос.УстановитьПараметр("ДобавлятьПолуфабрикатыВРезультат", ПараметрыДерева.ДобавлятьПолуфабрикатыВРезультат);
	Запрос.УстановитьПараметр("УровеньУзла", ПараметрыДерева.УровеньУзла);
	
	РассчитатьРасходПартий(Запрос, ПараметрыДерева);
	
	МассивТекстовЗапросов = Новый Массив();
	МассивТекстовЗапросов.Добавить(ТекстЗапросаРезультатыРазузлованияПредварительная(ВыводитьДопРасходы, ПараметрыДерева));
	МассивТекстовЗапросов.Добавить(ТекстЗапросаРезультатыРазузлования(ПараметрыДерева));
	МассивТекстовЗапросов.Добавить("УНИЧТОЖИТЬ РезультатыРазузлованияПредварительная"); //@Query-part
	МассивТекстовЗапросов.Добавить(ПараметрыДерева.ТекстЗапросаЗатратыНаПродукцию + СтрокаИтогиПоИдентификаторУзла);
	Если ПараметрыДерева.ТипРезультатаМенеджерВременныхТаблиц Тогда
		МассивТекстовЗапросов.Добавить(
			ПараметрыДерева.ТекстЗапросаУзлыТребующиеРазузлования + СтрокаИтогиПоИдентификаторУзла);
	КонецЕсли;
	Запрос.Текст = СтрСоединить(МассивТекстовЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Если ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДОБАВИТЬ ПредварительныйРезультат2", ""); //@Query-part
		
	ИначеЕсли ПараметрыДерева.ТипРезультатаМенеджерВременныхТаблиц Тогда
		Если Не ПараметрыДерева.ДобавленаВременнаяТаблицаРезультатовРазузлования Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДОБАВИТЬ ПредварительныйРезультат2",
				"ПОМЕСТИТЬ ПредварительныйРезультат2"); //@Query-part
			ПараметрыДерева.ГлобальныеВременныеТаблицы.Добавить("ПредварительныйРезультат2");
			ПараметрыДерева.ДобавленаВременнаяТаблицаРезультатовРазузлования = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Пояснение = НСтр("ru = 'Себестоимость узлов';
					|en = 'Node cost'");
	ИмяСобытия = НСтр("ru = 'Выполнение запроса по уровню узлов';
						|en = 'Query execution by node level'");
	РезультатЗапроса = ВыполнитьЗапросСЗамеромДляПротокола(Запрос, ПараметрыДерева, Пояснение, ИмяСобытия);
	
	Если ТипЗнч(РезультатЗапроса) = Тип("Массив") Тогда
		РезультатЗапроса = РезультатЗапроса[РезультатЗапроса.ВГраница()];
	КонецЕсли;
	
	ПринципОбхода = ?(ДобавитьГруппировкуПоИдентификаторамУзлов,
		ОбходРезультатаЗапроса.ПоГруппировкам, ОбходРезультатаЗапроса.Прямой);
	Возврат РезультатЗапроса.Выбрать(ПринципОбхода);
	
КонецФункции

Процедура РазузловатьУровеньУзловДереваСебестоимости(ПараметрыДерева, ТаблицаРезультата)
	
	ПараметрыДерева.УровеньУзла = ПараметрыДерева.УровеньУзла + 1;
	
	ВыводитьДопРасходы = ПараметрыДерева.ПараметрыОтчета.РазворачиватьДопРасходы И НЕ (ПараметрыДерева.УровеньУзла = 1);
	// Смотри комментарий 3970.
	ДобавитьГруппировкуПоИдентификаторамУзлов = ПараметрыДерева.ТипРезультатаДеревоЗначений 
		И Не ПараметрыДерева.ИнтерактивнаяНастройка
		И Не ПараметрыДерева.ДинамическоеСчитывание;
		
	ЗатратыНаПродукцию = СебестоимостьУзлов(ПараметрыДерева, ВыводитьДопРасходы,
		ДобавитьГруппировкуПоИдентификаторамУзлов);
	УничтожитьВременныеТаблицы(ПараметрыДерева);
	
	// Смотри комментарий 759.
	СоответствиеУзлов = Неопределено;
	Если ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
		СоответствиеУзлов = Новый Соответствие();
	КонецЕсли;
	
	ПараметрыДерева.ТаблицаОтборовУзлов.Очистить();
	Результат = Неопределено;
	Если Не ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
		Результат = ТаблицаРезультата
	КонецЕсли;
	
	ВышестоящиеУзлыКУдалению = Новый Соответствие();
	Пока ЗатратыНаПродукцию.Следующий() Цикл
		Если ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
			Результат = ПараметрыДерева.СоответствиеУзлов[ЗатратыНаПродукцию.ИдентификаторУзла].Строки;
		КонецЕсли;
		
		Если ДобавитьГруппировкуПоИдентификаторамУзлов Тогда
			ТекущаяПартия = ЗатратыНаПродукцию.Выбрать();
			Пока ТекущаяПартия.Следующий() Цикл
				ТаблицаРезультатаПартии = ОбработатьЗатратыНаПродукцию(Результат, ТекущаяПартия,
					СоответствиеУзлов, ПараметрыДерева, ВышестоящиеУзлыКУдалению);
			КонецЦикла;
		Иначе
			ТаблицаРезультатаПартии = ОбработатьЗатратыНаПродукцию(Результат, ЗатратыНаПродукцию,
				СоответствиеУзлов, ПараметрыДерева, ВышестоящиеУзлыКУдалению);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыДерева.ПараметрыОтчета.КоличествоУзловОтбора = ПараметрыДерева.ТаблицаОтборовУзлов.Количество();
	Если ПараметрыДерева.ПараметрыОтчета.КоличествоУзловОтбора > 0 И Не ПараметрыДерева.ДинамическоеСчитывание Тогда
		
		#Область ВариантыУсловийСоединенияПоПараметрамУзлов
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.Продукция = 1;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ПартияПродукции = 1;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ХарактеристикаПродукции = 1;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.Продукция = 1;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.СерияПродукции = 1;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.НазначениеПродукции = 0;
		ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.АналитикаУчетаПартийПродукции = 1;
		
		// Набор полей для индексирования должен учитывать варианты условий соединения.
		НаборовИндексовТаблицыОтбораУзлов = Новый Массив();
		НаборовИндексовТаблицыОтбораУзлов.Добавить("ПартияПродукции");
		НаборовИндексовТаблицыОтбораУзлов.Добавить("ИдентификаторУзла");
		
		#КонецОбласти
		
		Если ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
			// Комментарий 759.
			// Необходимости хранения соответствия узлов для всего дерева нет,
			// для оптимизации обновляем соответствие при разузловке каждого уровня дерева.
			ПараметрыДерева.СоответствиеУзлов = СоответствиеУзлов;
		КонецЕсли;
		
		// Хранить вышестоящие узлы прошлых уровней не нужно, так как они находятся во временной таблице ВышестоящиеУзлы.
		Для Каждого ВышестоящийУзел Из ВышестоящиеУзлыКУдалению Цикл
			ПараметрыДерева.ВышестоящиеУзлы.Удалить(ВышестоящийУзел.Ключ);
		КонецЦикла;
			
		ПроверитьПараметрыРасчета(ПараметрыДерева);
		ПоместитьВышестоящиеУзлыВоВременнуюТаблицу(ПараметрыДерева);
		ЕстьСтрокиДляРазузлования = ДобавитьТаблицуОтбораУзловВоВременную(
			ПараметрыДерева, НаборовИндексовТаблицыОтбораУзлов);
		Если ПараметрыДерева.Диагностика.ЕстьОшибки Или Не ЕстьСтрокиДляРазузлования Тогда
			Возврат;
		КонецЕсли;
		
		// Смотри комментарий 520.
		ПараметрыДерева.ПараметрыОтчета.Регистраторы = Новый Массив();
		
		РазузловатьУровеньУзловДереваСебестоимости(ПараметрыДерева, ТаблицаРезультатаПартии);
	КонецЕсли;
	
КонецПроцедуры

Функция ОбработатьЗатратыНаПродукцию(Результат, ТекПартия, СоответствиеУзлов, ПараметрыДерева, ВышестоящиеУзлыКУдалению)
	
	ТаблицаРезультатаПартии = Неопределено;

	НовыйИдентификаторУзла = Строка(Новый УникальныйИдентификатор);
	Если ПараметрыДерева.ТипРезультатаДеревоЗначений
		И (ПараметрыДерева.ДобавлятьПолуфабрикатыВРезультат Или Не ТекПартия.ТребуетсяРазузлование) Тогда

		СтрокаПартия = Результат.Добавить(); // СтрокаДереваЗначений
		ЗаполнитьЗначенияСвойств(СтрокаПартия, ТекПартия);

		СтрокаПартия.Идентификатор	= Новый УникальныйИдентификатор;

		Если ПараметрыДерева.ТипРезультатаДеревоЗначений
			И (ТекПартия.ТребуетсяРазузлование Или ТекПартия.ТребуетсяРазузлованиеДопРасходов) Тогда
				
			СоответствиеУзлов.Вставить(НовыйИдентификаторУзла, СтрокаПартия);
		КонецЕсли;

	КонецЕсли;

	Если (ТекПартия.ТребуетсяРазузлование Или ТекПартия.ТребуетсяРазузлованиеДопРасходов)
		И ПараметрыДерева.ТипРезультатаДеревоЗначений
		И ПараметрыДерева.ДинамическоеСчитывание Тогда
		
		// Комментарий 649.
		// Добавление пустой строки в дереве значений,
		// необходимо для того, чтобы при динамическом считывании, 
		// была возможность нажать на + и получить разузлование по выбранной позиции.
		// При разузловании, подчиненные строки должны быть сначала очищены.
		СтрокаПартия.Строки.Добавить();

	ИначеЕсли (ТекПартия.ТребуетсяРазузлование Или ТекПартия.ТребуетсяРазузлованиеДопРасходов) Тогда
			
		НоваяСтрокаОтбора = ПараметрыДерева.ТаблицаОтборовУзлов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаОтбора, ТекПартия);
		
		НоваяСтрокаОтбора.УзелПервогоУровня_АналитикаУчетаПродукции = ТекПартия.АналитикаУчетаПродукции;
		НоваяСтрокаОтбора.УзелПервогоУровня_АналитикаУчетаПартийПродукции = ТекПартия.АналитикаУчетаПартийПродукции;
		НоваяСтрокаОтбора.УзелПервогоУровня_ПартияПродукции = ТекПартия.ПартияПродукции;
		
		НоваяСтрокаОтбора.Продукция = ТекПартия.Номенклатура;
		НоваяСтрокаОтбора.ХарактеристикаПродукции = ТекПартия.Характеристика;
		НоваяСтрокаОтбора.СерияПродукции = ТекПартия.Серия;
		// Смотри комментарий 406, 204.
		НоваяСтрокаОтбора.ПоВсемНазначениям = Истина;
		НоваяСтрокаОтбора.НазначениеПродукции = ТекПартия.Назначение;
		НоваяСтрокаОтбора.ПартияПродукции = ТекПартия.Партия;
		
		НоваяСтрокаОтбора.АналитикаУчетаПартийПродукции = ТекПартия.АналитикаУчетаПартийЗатрата;
		НоваяСтрокаОтбора.АналитикаУчетаЗатрат = ТекПартия.АналитикаУчетаЗатрата;

		// Для знаменателя и количества продукции берем модуль значения,
		// чтобы знак количества и сумм затрат определялся по числителю,
		// который при выпуске будет > 0, а при сторно < 0
		НоваяСтрокаОтбора.Числитель = ТекПартия.Количество;
		НоваяСтрокаОтбора.КоличествоПродукции = Макс(-ТекПартия.Количество, ТекПартия.Количество);
		НоваяСтрокаОтбора.ДатаИсходнойПартии_НачалоМесяца = НачалоМесяца(НоваяСтрокаОтбора.ДатаИсходнойПартии);
		НоваяСтрокаОтбора.ДатаИсходнойПартии_КонецМесяца = КонецМесяца(НоваяСтрокаОтбора.ДатаИсходнойПартии);
		НоваяСтрокаОтбора.АналитикаУчетаВыходноеИзделие = ТекПартия.АналитикаУчетаЗатрата;
		
		НоваяСтрокаОтбора.ДанныеПоСебестоимости = ПараметрыДерева.ПараметрыОтчета.ДанныеПоСебестоимости;
		
		// Перед изменением УИД строки разузлования, добавим в соответствие массив всех вышестоящих узлов.
		НоваяСтрокаОтбора.Уровень = ПараметрыДерева.УровеньУзла;
		ВышестоящиеУзлы = ОбщегоНазначения.СкопироватьРекурсивно(
			ПараметрыДерева.ВышестоящиеУзлы.Получить(НоваяСтрокаОтбора.ИдентификаторУзла));
		ВышестоящиеУзлы.Добавить(НоваяСтрокаОтбора.ИдентификаторУзла);
		ВышестоящиеУзлыКУдалению.Вставить(НоваяСтрокаОтбора.ИдентификаторУзла);
		ПараметрыДерева.ВышестоящиеУзлы.Вставить(НовыйИдентификаторУзла, ВышестоящиеУзлы);
		НоваяСтрокаОтбора.ИдентификаторУзла = НовыйИдентификаторУзла;
		
		НоваяСтрокаОтбора.ДатаОкончания = ПараметрыДерева.ПараметрыОтчета.ДатаОкончания;
		НоваяСтрокаОтбора.РазворачиватьДопРасходы = ПараметрыДерева.ПараметрыОтчета.РазворачиватьДопРасходы;

		Если ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
			ТаблицаРезультатаПартии = СтрокаПартия;
		Иначе
			ТаблицаРезультатаПартии = Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТаблицаРезультатаПартии;
	
КонецФункции

Процедура ПоместитьВышестоящиеУзлыВоВременнуюТаблицу(ПараметрыДерева)
	
	ТаблицаВышестоящиеУзлы = Новый ТаблицаЗначений();
	ТаблицаВышестоящиеУзлы.Колонки.Добавить("ВышестоящийУзел", ПараметрыДерева.СтруктураПолей.ИдентификаторУзла);
	ТаблицаВышестоящиеУзлы.Колонки.Добавить("УзелИсточник", ПараметрыДерева.СтруктураПолей.ИдентификаторУзла);
	
	Для Каждого Узел Из ПараметрыДерева.ВышестоящиеУзлы Цикл
		Для Каждого ВышестоящийУзел Из Узел.Значение Цикл
			НоваяСтрока = ТаблицаВышестоящиеУзлы.Добавить();
			НоваяСтрока.ВышестоящийУзел = ВышестоящийУзел;
			НоваяСтрока.УзелИсточник = Узел.Ключ;
		КонецЦикла;
	КонецЦикла;
	
	ИменаКолонок = "
		|Т.ВышестоящийУзел КАК ВышестоящийУзел,
		|Т.УзелИсточник КАК УзелИсточник
		|";
	
	Если ПараметрыДерева.ВышестоящиеУзлыДобавлены Тогда
		ДобавитьДанныеКВременнойТаблице(ПараметрыДерева.МенеджерВременныхТаблиц, "ВышестоящиеУзлы",
			ТаблицаВышестоящиеУзлы,
			ИменаКолонок);
	Иначе
		РасчетСебестоимостиПрикладныеАлгоритмы.ПоместитьТаблицуЗначенийВоВременнуюТаблицу(
			ПараметрыДерева.МенеджерВременныхТаблиц,
			"ВышестоящиеУзлы",
			ТаблицаВышестоящиеУзлы,
			ИменаКолонок,
			"УзелИсточник, ВышестоящийУзел");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПараметрыРасчета(ПараметрыДерева)
	
	Если ПараметрыДерева.МаксимальнаяГлубинаРазузлования > 0
		И ПараметрыДерева.УровеньУзла > ПараметрыДерева.МаксимальнаяГлубинаРазузлования Тогда
		
		ТекстДляПротокола = СтрШаблон(
			НСтр("ru = 'Превышена максимальная глубина разузлования дерева себестоимости (%1)';
				|en = 'The maximum explosion depth of the cost tree is exceeded (%1)'"),
			ПараметрыДерева.МаксимальнаяГлубинаРазузлования);
		
		ГруппаОшибок = НСтр("ru = 'Проверка глубины разузлования';
							|en = 'Check explosion depth'");
		ЗаписьЖурналаРегистрации(ПараметрыДерева.Диагностика.ГруппаСобытийЖурналаРегистрации + ГруппаОшибок,
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстДляПротокола);
			
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ПараметрыДерева.Диагностика.Ошибки,
			"", ТекстДляПротокола, ГруппаОшибок);
		ПараметрыДерева.Диагностика.ЕстьОшибки = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Функция проверяет и исключает возможное зацикливание разузлования.
Функция ДобавитьТаблицуОтбораУзловВоВременную(ПараметрыДерева, НаборовИндексовТаблицыОтбораУзлов)
	
	ЗаполнитьИндексДляПроверкиЗацикливания(ПараметрыДерева, Истина);
	
	РасчетСебестоимостиПрикладныеАлгоритмы.ПоместитьТаблицуЗначенийВоВременнуюТаблицу(
		ПараметрыДерева.МенеджерВременныхТаблиц,
		"ТаблицаОтборовУзловПредварительная", ПараметрыДерева.ТаблицаОтборовУзлов,
		ПараметрыДерева.ТаблицаОтборовУзлов_ИменаКолонок,
		ПараметрыДерева.ИндексДляПроверкиЗацикливания);
	
	// 1. Уничтожаем ВТ ТаблицаОтборовУзлов, если существует.
	РасчетСебестоимостиПрикладныеАлгоритмы.УничтожитьВременныеТаблицы(ПараметрыДерева.МенеджерВременныхТаблиц,
		"ТаблицаОтборовУзлов");
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = ПараметрыДерева.МенеджерВременныхТаблиц;
	ТекстыЗапросов = Новый Массив();
	
	// 2. Ищем возможное зацикливание.
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	&ИменаКолонокССинонимами КАК ИменаКолонокССинонимами,
		|	ИСТИНА В (
		|		ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА
		|	
		|		ИЗ ТаблицаУзлов КАК ТаблицаУзлов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВышестоящиеУзлы КАК ВышестоящиеУзлы
		|		ПО ТаблицаУзлов.ИдентификаторУзлаПервогоУровня = Т.ИдентификаторУзлаПервогоУровня
		|			И ТаблицаУзлов.АналитикаУчетаЗатрат =  Т.АналитикаУчетаЗатрат
		|			И ТаблицаУзлов.ПартияЗатрата = Т.ПартияЗатрата
		|			И &ДополнительныеУсловияСоединения
		|		
		|			И Т.ИдентификаторУзла = ВышестоящиеУзлы.УзелИсточник
		|			И ВышестоящиеУзлы.ВышестоящийУзел = ТаблицаУзлов.ИдентификаторУзла
		|	) КАК Зацикливание
		|
		|ПОМЕСТИТЬ ТаблицаОтборовУзловПредварительная2
		|
		|ИЗ ТаблицаОтборовУзловПредварительная КАК Т
		|";
	
	#Область ВариантыУсловийСоединенияПоПараметрамУзлов
	// Смотри комментарий 204.
	УсловияСоединения = Новый Массив();
		
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ПартияПродукции = 1 Тогда
		УсловияСоединения.Добавить("И ТаблицаУзлов.ПартияПродукции = Т.ПартияПродукции"); //@Query-part
	КонецЕсли;
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.АналитикаУчетаПартийПродукции = 1 Тогда
		УсловияСоединения.Добавить(
			"И ТаблицаУзлов.АналитикаУчетаПартийПродукции = Т.АналитикаУчетаПартийПродукции"); //@Query-part
	КонецЕсли;
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.Продукция = 1 Тогда
		УсловияСоединения.Добавить("И ТаблицаУзлов.Продукция = Т.Продукция"); //@Query-part
	КонецЕсли;
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.ХарактеристикаПродукции = 1 Тогда
		УсловияСоединения.Добавить("И ТаблицаУзлов.ХарактеристикаПродукции = Т.ХарактеристикаПродукции"); //@Query-part
	КонецЕсли;
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.СерияПродукции = 1 Тогда
		УсловияСоединения.Добавить("И ТаблицаУзлов.СерияПродукции = Т.СерияПродукции"); //@Query-part
	КонецЕсли;
	Если ПараметрыДерева.ВариантыУсловийСоединенияПоПараметрамУзлов.НазначениеПродукции = 1 Тогда
		УсловияСоединения.Добавить("И ТаблицаУзлов.НазначениеПродукции = Т.НазначениеПродукции"); //@Query-part
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &ДополнительныеУсловияСоединения",
		?(УсловияСоединения.Количество() = 0,
			"",
			СтрСоединить(УсловияСоединения, Символы.ПС))); //@Query-part
	#КонецОбласти
	
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	// 3. Добавляем в ВТ ТаблицаОтборовУзлов только строки, по которым нет зацикливания.
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	&ИменаКолонокССинонимами КАК ИменаКолонокССинонимами
		|ПОМЕСТИТЬ ТаблицаОтборовУзлов
		|ИЗ ТаблицаОтборовУзловПредварительная2 КАК Т
		|ГДЕ
		|	НЕ Т.Зацикливание
		|";
	
	МассивНаборовИндексов = Новый Массив;
	Для Каждого Набор Из НаборовИндексовТаблицыОтбораУзлов Цикл
		МассивНаборовИндексов.Добавить("(" + Набор + ")");
	КонецЦикла;
	ТекстПоляИндексирования = "
		|ИНДЕКСИРОВАТЬ ПО НАБОРАМ
		|(
		|" + СтрСоединить(МассивНаборовИндексов, "," + Символы.ПС) + "
		|)"; //@Query-part
		
	ТекстыЗапросов.Добавить(ТекстЗапроса + ТекстПоляИндексирования);
	
	// 4. Добавляем в ВТ ТаблицаУзлов только строки, по которым нет зацикливания.
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	&ИменаКолонокССинонимами КАК ИменаКолонокССинонимами
		|ДОБАВИТЬ ТаблицаУзлов
		|ИЗ ТаблицаОтборовУзловПредварительная2 КАК Т
		|ГДЕ
		|	НЕ Т.Зацикливание
		|";
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	// Комментарий 975.
	// 5. Собираем временную таблицу по зацикливанию, в результате представим как НоменклатураЗацикливание.
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	&ИменаКолонокССинонимами КАК ИменаКолонокССинонимами
		|ПОМЕСТИТЬ УзлыСЗацикливанием
		|ИЗ ТаблицаОтборовУзловПредварительная2 КАК Т
		|ГДЕ
		|	Т.Зацикливание
		|";
	
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИменаКолонокССинонимами КАК ИменаКолонокССинонимами",
		ПараметрыДерева.ТаблицаОтборовУзлов_ИменаКолонокССинонимами);
	Запрос.Текст = ТекстЗапроса;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("РезультатВыполненияЗапроса", "");
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	РасчетСебестоимостиПрикладныеАлгоритмы.ВыполнитьЗапросСЗамеромДляПротокола(
		ПараметрыРасчета, Запрос,,, Ложь, НСтр("ru = 'Добавить таблицу отбора узлов во временную';
												|en = 'Add a node filter table to the temporary one'"));
	Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала) / 1000;
	ГруппаОшибок = НСтр("ru = 'Проверка зацикливания';
						|en = 'Looping check'");
	Шаблон = НСтр("ru = 'Уровень узлов: %1
		|Общее время: %2
		|Количество узлов отбора: %3
		|%4';
		|en = 'Node level: %1
		|Total time: %2
		|Number of filter nodes: %3
		|%4'");
	ТекстДляПротокола = ГруппаОшибок + Символы.ПС + СтрШаблон(Шаблон,
		ПараметрыДерева.УровеньУзла,
		РасчетСебестоимостиПротоколРасчета.ПредставлениеВремени(Длительность),
		ПараметрыДерева.ПараметрыОтчета.КоличествоУзловОтбора,
		ПараметрыРасчета.РезультатВыполненияЗапроса);
	ПараметрыДерева.Диагностика.ЗамерыВыполненияЗапросовПоУровнямУзлов.Добавить(ТекстДляПротокола);
	
	ЗаписьЖурналаРегистрации(ПараметрыДерева.Диагностика.ГруппаСобытийЖурналаРегистрации + ГруппаОшибок,
		УровеньЖурналаРегистрации.Информация,,,
		ТекстДляПротокола);
	
	// 6. Проверяем есть ли строки в ВТ ТаблицаОтборовУзлов:
	//	Истина - Строки есть, продолжаем разузлование.
	//	Ложь - нет строк для разузлования.
	Возврат РасчетСебестоимостиПрикладныеАлгоритмы.РазмерВременнойТаблицы(Запрос.МенеджерВременныхТаблиц,
		"ТаблицаОтборовУзлов") > 0;
	
КонецФункции

Функция ТекстЗапросаРасходПартий()
	
	ТекстыЗапроса = Новый Массив;
	
	#Область ВыбытиеИзНЗППоПродукции
	ТекстЗапроса = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВыпущеннаяПродукция.ИдентификаторУзла КАК ИдентификаторУзла,
		|	ВыпущеннаяПродукция.ИдентификаторУзлаПервогоУровня КАК ИдентификаторУзлаПервогоУровня,
		|	ВыпущеннаяПродукция.УзелПервогоУровня_АналитикаУчетаПродукции КАК УзелПервогоУровня_АналитикаУчетаПродукции,
		|	ВыпущеннаяПродукция.УзелПервогоУровня_ПартияПродукции КАК УзелПервогоУровня_ПартияПродукции,
		|	ВыпущеннаяПродукция.УзелПервогоУровня_АналитикаУчетаПартийПродукции КАК УзелПервогоУровня_АналитикаУчетаПартийПродукции,
		|	МАКСИМУМ(ВыпущеннаяПродукция.ДатаИсходнойПартии) КАК ДатаИсходнойПартии,
		|	МАКСИМУМ(ВыпущеннаяПродукция.ТребуетсяРазузлованиеУзлаИсточника) КАК ТребуетсяРазузлованиеУзлаИсточника,
		|	ВыпущеннаяПродукция.АналитикаУчетаЗатрат КАК АналитикаУчетаЗатрат,
		|
		|	МАКСИМУМ(ВыпущеннаяПродукция.РазворачиватьДопРасходы) КАК РазворачиватьДопРасходы,
		|	НАЧАЛОПЕРИОДА(СебестоимостьТоваров.Период, МЕСЯЦ) КАК Период,
		|	ВыпущеннаяПродукция.Организация КАК Организация,
		|	ВыпущеннаяПродукция.ПартияПродукции КАК ПартияПродукции,
		|	ВыпущеннаяПродукция.АналитикаУчетаПартийПродукции КАК АналитикаУчетаПартийПродукции,
		|	ВыпущеннаяПродукция.АналитикаУчетаПродукции КАК АналитикаУчетаПродукции,
		|	МАКСИМУМ(ВыпущеннаяПродукция.Числитель) КАК Числитель,
		|	МАКСИМУМ(ВыпущеннаяПродукция.Знаменатель) КАК Знаменатель,
		|	СебестоимостьТоваров.Партия КАК Партия,
		|	СебестоимостьТоваров.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	СебестоимостьТоваров.ВидЗапасов КАК ВидЗапасов,
		|	СУММА(СебестоимостьТоваров.Количество) КАК Количество,
		// Стоимости согласно параметру ""ДанныеПоСебестоимости""
		|	СУММА(ВЫБОР
		|			КОГДА &ДанныеПоСебестоимости = 1
		|				ТОГДА СебестоимостьТоваров.Стоимость
		|			КОГДА &ДанныеПоСебестоимости = 2
		|				ТОГДА СебестоимостьТоваров.СтоимостьБезНДС
		|			КОГДА &ДанныеПоСебестоимости = 3
		|				ТОГДА СебестоимостьТоваров.СтоимостьУпр
		|			КОГДА &ДанныеПоСебестоимости = 4
		|				ТОГДА СебестоимостьТоваров.СтоимостьРегл
		|		КОНЕЦ)												КАК Материальные,
		|	СУММА(ВЫБОР
		|			КОГДА &ДанныеПоСебестоимости = 1
		|				ТОГДА СебестоимостьТоваров.Трудозатраты
		|			КОГДА &ДанныеПоСебестоимости = 2
		|				ТОГДА СебестоимостьТоваров.Трудозатраты
		|			КОГДА &ДанныеПоСебестоимости = 3
		|				ТОГДА СебестоимостьТоваров.ТрудозатратыУпр
		|			КОГДА &ДанныеПоСебестоимости = 4
		|				ТОГДА СебестоимостьТоваров.ТрудозатратыРегл
		|		КОНЕЦ)												КАК Трудозатраты,
		|	СУММА(ВЫБОР
		|			КОГДА &ДанныеПоСебестоимости = 1
		|				ТОГДА СебестоимостьТоваров.ПостатейныеПостоянныеСНДС
		|			КОГДА &ДанныеПоСебестоимости = 2
		|				ТОГДА СебестоимостьТоваров.ПостатейныеПостоянныеБезНДС
		|			КОГДА &ДанныеПоСебестоимости = 3
		|				ТОГДА СебестоимостьТоваров.ПостатейныеПостоянныеУпр
		|			КОГДА &ДанныеПоСебестоимости = 4
		|				ТОГДА СебестоимостьТоваров.ПостатейныеПостоянныеРегл
		|		КОНЕЦ)												КАК ПостатейныеПостоянные,
		|	СУММА(ВЫБОР
		|			КОГДА &ДанныеПоСебестоимости = 1
		|				ТОГДА СебестоимостьТоваров.ПостатейныеПеременныеСНДС
		|			КОГДА &ДанныеПоСебестоимости = 2
		|				ТОГДА СебестоимостьТоваров.ПостатейныеПеременныеБезНДС
		|			КОГДА &ДанныеПоСебестоимости = 3
		|				ТОГДА СебестоимостьТоваров.ПостатейныеПеременныеУпр
		|			КОГДА &ДанныеПоСебестоимости = 4
		|				ТОГДА СебестоимостьТоваров.ПостатейныеПеременныеРегл
		|		КОНЕЦ)												КАК ПостатейныеПеременные,
		|	СУММА(ВЫБОР
		|			КОГДА &ДанныеПоСебестоимости = 1
		|				ТОГДА СебестоимостьТоваров.ДопРасходы
		|			КОГДА &ДанныеПоСебестоимости = 2
		|				ТОГДА СебестоимостьТоваров.ДопРасходыБезНДС
		|			КОГДА &ДанныеПоСебестоимости = 3
		|				ТОГДА СебестоимостьТоваров.ДопРасходыУпр
		|			КОГДА &ДанныеПоСебестоимости = 4
		|				ТОГДА СебестоимостьТоваров.ДопРасходыРегл
		|		КОНЕЦ)												КАК ДопРасходы,
		|	СУММА(ВЫБОР
		|			КОГДА &ДанныеПоСебестоимости = 1
		|				ТОГДА СебестоимостьТоваров.СтоимостьЗабалансовая
		|			КОГДА &ДанныеПоСебестоимости = 2
		|				ТОГДА СебестоимостьТоваров.СтоимостьЗабалансовая
		|			КОГДА &ДанныеПоСебестоимости = 3
		|				ТОГДА СебестоимостьТоваров.СтоимостьЗабалансовая
		|			КОГДА &ДанныеПоСебестоимости = 4
		|				ТОГДА СебестоимостьТоваров.СтоимостьЗабалансоваяРегл
		|		КОНЕЦ)												КАК СуммаЗатратаЗабалансовая,
		|	СУММА(ВЫБОР
		|			КОГДА &ДанныеПоСебестоимости = 1
		|				ТОГДА СебестоимостьТоваров.Стоимость
		|				+ СебестоимостьТоваров.Трудозатраты
		|				+ СебестоимостьТоваров.ПостатейныеПостоянныеСНДС
		|				+ СебестоимостьТоваров.ПостатейныеПеременныеСНДС
		|				+ СебестоимостьТоваров.ДопРасходы
		|			КОГДА &ДанныеПоСебестоимости = 2
		|				ТОГДА СебестоимостьТоваров.СтоимостьБезНДС
		|				+ СебестоимостьТоваров.Трудозатраты
		|				+ СебестоимостьТоваров.ПостатейныеПостоянныеБезНДС
		|				+ СебестоимостьТоваров.ПостатейныеПеременныеБезНДС
		|				+ СебестоимостьТоваров.ДопРасходыБезНДС
		|			КОГДА &ДанныеПоСебестоимости = 3
		|				ТОГДА СебестоимостьТоваров.СтоимостьУпр
		|				+ СебестоимостьТоваров.ТрудозатратыУпр
		|				+ СебестоимостьТоваров.ПостатейныеПостоянныеУпр
		|				+ СебестоимостьТоваров.ПостатейныеПеременныеУпр
		|				+ СебестоимостьТоваров.ДопРасходыУпр
		|			КОГДА &ДанныеПоСебестоимости = 4
		|				ТОГДА СебестоимостьТоваров.СтоимостьРегл
		|				+ СебестоимостьТоваров.ТрудозатратыРегл
		|				+ СебестоимостьТоваров.ПостатейныеПостоянныеРегл
		|				+ СебестоимостьТоваров.ПостатейныеПеременныеРегл
		|				+ СебестоимостьТоваров.ДопРасходыРегл
		|		КОНЕЦ)												КАК СуммаЗатрата,
		|	СУММА(ВЫБОР
		|			КОГДА &ДанныеПоСебестоимости = 4
		|				ТОГДА СебестоимостьТоваров.СтоимостьНДД
		|			ИНАЧЕ 0
		|		КОНЕЦ)												КАК НДД,
		|
		// Стоимости с НДС
		|	СУММА(СебестоимостьТоваров.Стоимость)					КАК МатериальныеСНДС,
		|	СУММА(СебестоимостьТоваров.Трудозатраты)				КАК ТрудозатратыСНДС,
		|	СУММА(СебестоимостьТоваров.ПостатейныеПостоянныеСНДС)	КАК ПостатейныеПостоянныеСНДС,
		|	СУММА(СебестоимостьТоваров.ПостатейныеПеременныеСНДС)	КАК ПостатейныеПеременныеСНДС,
		|	СУММА(СебестоимостьТоваров.ДопРасходы)					КАК ДопРасходыСНДС,
		|
		// Стоимости без НДС
