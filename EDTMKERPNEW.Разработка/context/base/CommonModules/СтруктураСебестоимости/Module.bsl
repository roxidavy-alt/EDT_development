		|	ВыбытиеИзНЗПДляОстатка.Организация КАК Организация,
		|	ВыбытиеИзНЗПДляОстатка.Период КАК Период,
		|	ВыбытиеИзНЗПДляОстатка.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	ВыбытиеИзНЗПДляОстатка.Партия КАК Партия,
		|	ВыбытиеИзНЗПДляОстатка.Количество КАК Количество
		|ИЗ
		|	ВыбытиеИзНЗПДляОстатка КАК ВыбытиеИзНЗПДляОстатка  
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИдентификаторыАналитик КАК ИдентификаторыАналитик
		|		ПО ВыбытиеИзНЗПДляОстатка.ИдентификаторУзла = ИдентификаторыАналитик.ИдентификаторУзла
		|			И ВыбытиеИзНЗПДляОстатка.Организация = ИдентификаторыАналитик.Организация
		|			И ВыбытиеИзНЗПДляОстатка.АналитикаУчетаНоменклатуры = ИдентификаторыАналитик.АналитикаУчетаНоменклатуры
		|			И ВыбытиеИзНЗПДляОстатка.Партия = ИдентификаторыАналитик.Партия
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период
		|";
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область ВыборкаПервичныеПартииВНЗП
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ИдентификаторыАналитик.ИдентификаторАналитик КАК ИдентификаторАналитик,
		|	ПервичныеПартииВНЗП.ИдентификаторУзла КАК ИдентификаторУзла,
		|	ПервичныеПартииВНЗП.Период КАК Период,
		|	ПервичныеПартииВНЗП.Организация КАК Организация,
		|	ПервичныеПартииВНЗП.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	ПервичныеПартииВНЗП.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
		|	ПервичныеПартииВНЗП.Партия КАК Партия,
		|	ПервичныеПартииВНЗП.КорАналитикаУчетаНоменклатуры КАК КорАналитикаУчетаНоменклатуры,
		|	ПервичныеПартииВНЗП.КорПартия КАК КорПартия,
		|	ПервичныеПартииВНЗП.Количество КАК Количество
		|ИЗ
		|	ПервичныеПартииВНЗП КАК ПервичныеПартииВНЗП 
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИдентификаторыАналитик КАК ИдентификаторыАналитик
		|		ПО ПервичныеПартииВНЗП.ИдентификаторУзла = ИдентификаторыАналитик.ИдентификаторУзла
		|			И ПервичныеПартииВНЗП.Организация = ИдентификаторыАналитик.Организация
		|			И ПервичныеПартииВНЗП.КорАналитикаУчетаНоменклатуры = ИдентификаторыАналитик.АналитикаУчетаНоменклатуры
		|			И ПервичныеПартииВНЗП.КорПартия = ИдентификаторыАналитик.Партия
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период
		|";
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область ВыборкаРасходПартий
	ТекстЗапроса = "
		|ВЫБРАТЬ ПЕРВЫЕ 0
		|	0 КАК ИдентификаторАналитик,
		|	ПервичныеПартииВНЗП.ИдентификаторУзла КАК ИдентификаторУзла,
		|	ПервичныеПартииВНЗП.Период КАК Период,
		|	ПервичныеПартииВНЗП.Организация КАК Организация,
		|	ПервичныеПартииВНЗП.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	ПервичныеПартииВНЗП.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
		|	ПервичныеПартииВНЗП.Партия КАК Партия,
		|	ПервичныеПартииВНЗП.КорАналитикаУчетаНоменклатуры КАК КорАналитикаУчетаНоменклатуры,
		|	ПервичныеПартииВНЗП.КорПартия КАК КорПартия,
		|	ПервичныеПартииВНЗП.Количество КАК Количество
		|ИЗ
		|	ПервичныеПартииВНЗП КАК ПервичныеПартииВНЗП
		|";
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаРезультатыРазузлованияПредварительная(ВыводитьДопРасходы, ПараметрыДерева)
	
	ТекстыЗапроса = Новый Массив;
	
	#Область ТекстМатериальныеЗатраты
	
	#Область ПредварительныйРасходПартий
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	Выбытие.ИдентификаторУзла			КАК ИдентификаторУзла,
		|	Выбытие.Организация					КАК Организация,
		|	Выбытие.Период						КАК Период,
		|	МАКСИМУМ(ПП.МесяцПервичнойПартииВНЗП)	КАК МесяцПервичнойПартииВНЗП,
		|	ПП.АналитикаУчетаНоменклатуры		КАК АналитикаУчетаНоменклатуры,
		|	ПП.АналитикаУчетаПартий				КАК АналитикаУчетаПартий,
		|	ПП.Партия							КАК Партия,
		|	Выбытие.КорАналитикаУчетаНоменклатуры	КАК КорАналитикаУчетаНоменклатуры,
		|	Выбытие.КорПартия						КАК КорПартия,
		|
		|	МАКСИМУМ(ПП.ВключитьНДСВСтоимость) КАК ВключитьНДСВСтоимость,
		|	МАКСИМУМ(ПП.ИсключитьНДСИзСтоимости) КАК ИсключитьНДСИзСтоимости,
		|
		|	СУММА(Выбытие.Количество) КАК Количество,
		|
		// Стоимости согласно параметру ""ДанныеПоСебестоимости""
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.Материальные КАК ЧИСЛО(23, 10))) КАК Материальные,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.Трудозатраты КАК ЧИСЛО(23, 10))) КАК Трудозатраты,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ПостатейныеПостоянные КАК ЧИСЛО(23, 10))) КАК ПостатейныеПостоянные,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ПостатейныеПеременные КАК ЧИСЛО(23, 10))) КАК ПостатейныеПеременные,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ДопРасходы КАК ЧИСЛО(23, 10))) КАК ДопРасходы,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.СуммаЗатратаЗабалансовая КАК ЧИСЛО(23, 10))) КАК СуммаЗатратаЗабалансовая,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.СуммаЗатрата КАК ЧИСЛО(23, 10))) КАК СуммаЗатрата,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.НДД КАК ЧИСЛО(23, 10))) КАК НДД,
		
		// Стоимости с НДС
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.МатериальныеСНДС КАК ЧИСЛО(23, 10))) КАК МатериальныеСНДС,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ТрудозатратыСНДС КАК ЧИСЛО(23, 10))) КАК ТрудозатратыСНДС,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ПостатейныеПостоянныеСНДС КАК ЧИСЛО(23, 10))) КАК ПостатейныеПостоянныеСНДС,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ПостатейныеПеременныеСНДС КАК ЧИСЛО(23, 10))) КАК ПостатейныеПеременныеСНДС,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ДопРасходыСНДС КАК ЧИСЛО(23, 10))) КАК ДопРасходыСНДС,
		
		// Стоимости без НДС
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.МатериальныеБезНДС КАК ЧИСЛО(23, 10))) КАК МатериальныеБезНДС,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ПостатейныеПостоянныеБезНДС КАК ЧИСЛО(23, 10))) КАК ПостатейныеПостоянныеБезНДС,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ПостатейныеПеременныеБезНДС КАК ЧИСЛО(23, 10))) КАК ПостатейныеПеременныеБезНДС,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ДопРасходыБезНДС КАК ЧИСЛО(23, 10))) КАК ДопРасходыБезНДС,
		
		// Стоимости Упр
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.МатериальныеУпр КАК ЧИСЛО(23, 10))) КАК МатериальныеУпр,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ТрудозатратыУпр КАК ЧИСЛО(23, 10))) КАК ТрудозатратыУпр,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ПостатейныеПостоянныеУпр КАК ЧИСЛО(23, 10))) КАК ПостатейныеПостоянныеУпр,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ПостатейныеПеременныеУпр КАК ЧИСЛО(23, 10))) КАК ПостатейныеПеременныеУпр,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ДопРасходыУпр КАК ЧИСЛО(23, 10))) КАК ДопРасходыУпр,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.СтоимостьЗабалансоваяУпр КАК ЧИСЛО(23, 10))) КАК СтоимостьЗабалансоваяУпр,
		
		// Стоимости Регл
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.МатериальныеРегл КАК ЧИСЛО(23, 10))) КАК МатериальныеРегл,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ТрудозатратыРегл КАК ЧИСЛО(23, 10))) КАК ТрудозатратыРегл,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ПостатейныеПостоянныеРегл КАК ЧИСЛО(23, 10))) КАК ПостатейныеПостоянныеРегл,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ПостатейныеПеременныеРегл КАК ЧИСЛО(23, 10))) КАК ПостатейныеПеременныеРегл,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ДопРасходыРегл КАК ЧИСЛО(23, 10))) КАК ДопРасходыРегл,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.СтоимостьЗабалансоваяРегл КАК ЧИСЛО(23, 10))) КАК СтоимостьЗабалансоваяРегл,
		|
		// Налоговый учет
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.НалоговыйУчет КАК ЧИСЛО(23, 10))) КАК НалоговыйУчет,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ПостояннаяРазница КАК ЧИСЛО(23, 10))) КАК ПостояннаяРазница,
		|	СУММА(
		|		ВЫРАЗИТЬ(Выбытие.Количество / ПП.Количество * ПП.ВременнаяРазница КАК ЧИСЛО(23, 10))) КАК ВременнаяРазница
		|
		|ПОМЕСТИТЬ ПредварительныйРасходПартий
		|ИЗ
		|	ВыбытиеИзНЗП КАК ВыбытиеИзНЗП
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РасходПартий КАК Выбытие
		|		ПО ВыбытиеИзНЗП.ИдентификаторУзла = Выбытие.ИдентификаторУзла
		|			И ВыбытиеИзНЗП.Организация = Выбытие.Организация
		|			И ВыбытиеИзНЗП.АналитикаУчетаНоменклатуры = Выбытие.КорАналитикаУчетаНоменклатуры
		|			И ВыбытиеИзНЗП.Партия = Выбытие.КорПартия
		|			И ВыбытиеИзНЗП.Период = Выбытие.Период
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИтогиПоПартиямВНЗП КАК ПП
		|		ПО Выбытие.ИдентификаторУзла = ПП.ИдентификаторУзла
		|			И Выбытие.Организация = ПП.Организация
		|			И Выбытие.АналитикаУчетаНоменклатуры = ПП.АналитикаУчетаНоменклатуры
		|			И Выбытие.Партия = ПП.Партия
		|			И Выбытие.АналитикаУчетаПартий = ПП.АналитикаУчетаПартий
		|			И Выбытие.КорАналитикаУчетаНоменклатуры = ПП.КорАналитикаУчетаНоменклатуры
		|			И Выбытие.КорПартия = ПП.КорПартия
		|
		|СГРУППИРОВАТЬ ПО
		|	Выбытие.ИдентификаторУзла,
		|	Выбытие.Организация,
		|	Выбытие.Период,
		|	Выбытие.КорАналитикаУчетаНоменклатуры,
		|	Выбытие.КорПартия,
		|	ПП.АналитикаУчетаПартий,
		|	ПП.АналитикаУчетаНоменклатуры,
		|	ПП.Партия
		|
		|ИНДЕКСИРОВАТЬ ПО НАБОРАМ
		|(
		|	(ИдентификаторУзла, КорАналитикаУчетаНоменклатуры, КорПартия, АналитикаУчетаНоменклатуры,
		|		АналитикаУчетаПартий, Партия, Организация, Период),
		|	(ИдентификаторУзла, КорПартия, Организация, АналитикаУчетаНоменклатуры, АналитикаУчетаПартий, Партия),
		|	(ИдентификаторУзла, Партия)
		|)
		|";
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	#Область ПервичныеПартииСводно
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.ИдентификаторУзла КАК ИдентификаторУзла,
		|	Т.Организация КАК Организация,
		|	Т.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	Т.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
		|	Т.Партия КАК Партия
		|ПОМЕСТИТЬ ПервичныеПартииСводно
		|ИЗ
		|	ПредварительныйРасходПартий КАК Т
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ИдентификаторУзла,
		|	Партия
		|";
		ТекстыЗапроса.Добавить(ТекстЗапроса);
	#КонецОбласти
		
	#Область ПартииПолуфабрикатов
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПП.ИдентификаторУзла КАК ИдентификаторУзла,
		|	ВЫБОР КОГДА &ДанныеПоСебестоимости < 3
		|		ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ СебестоимостьТоваров.Организация
		|	КОНЕЦ КАК Организация,
		|	ПП.Партия КАК Партия,
		|	ПП.АналитикаУчетаПартий,
		|	ПП.АналитикаУчетаНоменклатуры
		|ПОМЕСТИТЬ ПартииПолуфабрикатов
		|ИЗ
