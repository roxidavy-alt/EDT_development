		|	ДД.УзелПервогоУровня_АналитикаУчетаПартийПродукции КАК АналитикаУчетаПартийПродукции,
		|	ДД.УзелПервогоУровня_АналитикаУчетаПродукции КАК АналитикаУчетаПродукции,
		|
		|	ДД.АналитикаУчетаЗатрат КАК АналитикаУчетаВыходноеИзделие,
		|	ДД.Сумма,
		|	ДД.Материальные,
		|	ДД.НалоговыйУчет,
		|	ДД.Трудозатраты,
		|	ДД.ПостатейныеПостоянные,
		|	ДД.ПостатейныеПеременные,
		|	ДД.ДопРасходы,
		|	ДД.СуммаЗабалансовая,
		|	0
		|ИЗ
		|	ТаблицаОтборовУзлов КАК ДД
		|ГДЕ
		|	ДД.ТребуетсяРазузлование
		|";
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаИсходнойПартии,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыСтрокДереваСебестоимости.ПартияЗатраты) КАК ВидСтроки,
		|	Т.ИдентификаторУзлаПервогоУровня КАК ИдентификаторУзлаПервогоУровня,
		|	Т.ИдентификаторУзла КАК ИдентификаторУзла,
		|
		|	Т.АналитикаУчетаПродукции КАК АналитикаУчетаПродукции,
		|	Т.АналитикаУчетаВыходноеИзделие КАК АналитикаУчетаВыходноеИзделие,
		|	NULL КАК АналитикаУчетаЗатрата,
		|	NULL КАК АналитикаУчетаПартий,
		|	Т.АналитикаУчетаПартийПродукции КАК АналитикаУчетаПартийПродукции,
		|	NULL КАК АналитикаУчетаПартийВыходноеИзделие,
		|	NULL КАК АналитикаУчетаПартийЗатрата,
		|	МАКСИМУМ(Т.Организация) КАК Организация,
		|	МАКСИМУМ(Т.Подразделение) КАК Подразделение,
		|	NULL КАК ТипЗатрат,
		|	ЛОЖЬ КАК ТребуетсяРазузлование,
		|	ЛОЖЬ КАК ТребуетсяРазузлованиеДопРасходов,
		|	NULL КАК ЕдиницаИзмерения,
		|	ВЫБОР
		|		КОГДА СУММА(Т.СуммаЗатрата) = СУММА(Т.ДопРасходы)
		|			ТОГДА &НоменклатураИзменениеСтоимостиПриХранении
		|		ИНАЧЕ &НоменклатураУсреднениеСтоимостиВНезавершенномПроизводстве
		|	КОНЕЦ КАК Номенклатура,
		|	NULL КАК Характеристика,
		|	NULL КАК Серия,
		|	NULL КАК Назначение,
		|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
		|	МАКСИМУМ(Т.СтатьяКалькуляции) КАК СтатьяКалькуляции,
		|	ВЫРАЗИТЬ(&УровеньУзла КАК ЧИСЛО) КАК Уровень,
		|	NULL КАК Партия,
		|	Т.ПартияПродукции КАК ПартияПродукции,
		|	МАКСИМУМ(Т.ПартияВыходноеИзделие) КАК ПартияВыходноеИзделие,
		|	NULL КАК ПартияЗатрата,
		|
		|	0 КАК Количество,
		|	0 КАК Числитель,
		|	0 КАК Знаменатель,
		|	СУММА(Т.СуммаЗатрата) КАК Сумма,
		|	СУММА(Т.СуммаЗатратаЗабалансовая) КАК СуммаЗабалансовая,
		|	СУММА(Т.Материальные) КАК Материальные,
		|	СУММА(Т.Трудозатраты) КАК Трудозатраты,
		|	СУММА(Т.ПостатейныеПостоянные) КАК ПостатейныеПостоянные,
		|	СУММА(Т.ПостатейныеПеременные) КАК ПостатейныеПеременные,
		|	СУММА(Т.ДопРасходы) КАК ДопРасходы,
		|	СУММА(Т.НДД) КАК НДД,
		|	0 КАК МатериальныеСНДС,
		|	0 КАК ТрудозатратыСНДС,
		|	0 КАК ПостатейныеПостоянныеСНДС,
		|	0 КАК ПостатейныеПеременныеСНДС,
		|	0 КАК ДопРасходыСНДС,
		|	0 КАК МатериальныеБезНДС,
		|	0 КАК ПостатейныеПостоянныеБезНДС,
		|	0 КАК ПостатейныеПеременныеБезНДС,
		|	0 КАК ДопРасходыБезНДС,
		|	0 КАК МатериальныеУпр,
		|	0 КАК ТрудозатратыУпр,
		|	0 КАК ПостатейныеПостоянныеУпр,
		|	0 КАК ПостатейныеПеременныеУпр,
		|	0 КАК ДопРасходыУпр,
		|	0 КАК СтоимостьЗабалансоваяУпр,
		|	0 КАК МатериальныеРегл,
		|	0 КАК ТрудозатратыРегл,
		|	0 КАК ПостатейныеПостоянныеРегл,
		|	0 КАК ПостатейныеПеременныеРегл,
		|	0 КАК ДопРасходыРегл,
		|	0 КАК СтоимостьЗабалансоваяРегл,
		|	СУММА(Т.НалоговыйУчет) КАК НалоговыйУчет,
		|	0 КАК ПостояннаяРазница,
		|	0 КАК ВременнаяРазница,
		|	0 КАК СуммаВключениеИсключениеНДСВСтоимости
		|ИЗ
		|	ВТИзменениеСтоимостиПредварительная КАК Т
		|
		|СГРУППИРОВАТЬ ПО
		|	Т.ИдентификаторУзлаПервогоУровня,
		|	Т.ИдентификаторУзла,
		|	Т.АналитикаУчетаВыходноеИзделие,
		|	Т.АналитикаУчетаПродукции,
		|	Т.АналитикаУчетаПартийПродукции,
		|	Т.ПартияПродукции
		|
		|ИМЕЮЩИЕ
		|	СУММА(Т.СуммаЗатрата) <> 0
		|";
		
	Если Не ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
		// Смотри комментарий 3970.
		УбратьИдентификаторУзла(ТекстЗапроса, "Т");
	КонецЕсли;
	
	ТекстыЗапросовОбъединение.Добавить(ТекстЗапроса);
	#КонецОбласти
	
	ТекстыЗапросов.Добавить(СтрСоединить(ТекстыЗапросовОбъединение,
		ОбщегоНазначенияУТ.РазделительЗапросовВОбъединении()));
	
	ПараметрыДерева.Вставить("ТекстЗапросаЗатратыНаПродукцию",
		СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов()));
	
КонецПроцедуры

Процедура УбратьИдентификаторУзла(ТекстЗапроса, ИмяТаблицы)
	// Смотри комментарий 3970.
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		ИмяТаблицы + ".ИдентификаторУзлаПервогоУровня,", ""); //@Query-part
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		ИмяТаблицы + ".ИдентификаторУзла,", ""); //@Query-part
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		ИмяТаблицы + ".ИдентификаторУзлаПервогоУровня", """"""); //@Query-part
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		ИмяТаблицы + ".ИдентификаторУзла", """"""); //@Query-part
КонецПроцедуры

Функция ТекстЗапросаШаблонРезультатыРазузлования(ЗапросДляОтбора, ПараметрыДерева)
	
	// Порядок и наполнение колонок,
	// должен повторять порядок и наполнение колонок в таблице формируемой тут СтруктураПолейДереваСебестоимости()
	Если ЗапросДляОтбора Или ПараметрыДерева.ТипРезультатаДеревоЗначений Тогда
		ТекстЗапроса = "
			|ВЫБРАТЬ
			|	ВЫБОР КОГДА Т.ТребуетсяРазузлование ИЛИ Т.ТребуетсяРазузлованиеДопРасходов
			|		ТОГДА Т.МесяцПервичнойПартииВНЗП
			|		ИНАЧЕ Т.ДатаИсходнойПартии
			|	КОНЕЦ КАК ДатаИсходнойПартии,
			|	ВЫБОР КОГДА Т.ТребуетсяРазузлование
			|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСтрокДереваСебестоимости.ПартияПолуфабриката)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСтрокДереваСебестоимости.ПартияЗатраты)
			|	КОНЕЦ КАК ВидСтроки,
			|	Т.ИдентификаторУзлаПервогоУровня КАК ИдентификаторУзлаПервогоУровня,
			|	Т.ИдентификаторУзла КАК ИдентификаторУзла,
			|	Т.УзелПервогоУровня_АналитикаУчетаПродукции КАК АналитикаУчетаПродукции,
			|	Т.АналитикаУчетаВыходноеИзделие КАК АналитикаУчетаВыходноеИзделие,
			|	Т.АналитикаУчетаЗатрата КАК АналитикаУчетаЗатрата,
			|	Т.АналитикаУчетаПартийЗатрата КАК АналитикаУчетаПартий,
			|	Т.УзелПервогоУровня_АналитикаУчетаПартийПродукции КАК АналитикаУчетаПартийПродукции,
			|	Т.АналитикаУчетаПартийВыходноеИзделие КАК АналитикаУчетаПартийВыходноеИзделие,
			|	Т.АналитикаУчетаПартийЗатрата КАК АналитикаУчетаПартийЗатрата,
			|	Т.Организация КАК Организация,
			|	Т.Подразделение КАК Подразделение,
			|	Т.ТипЗатрат КАК ТипЗатрат,
			|	Т.ТребуетсяРазузлование КАК ТребуетсяРазузлование,
			|	Т.ТребуетсяРазузлованиеДопРасходов КАК ТребуетсяРазузлованиеДопРасходов,
			|	Т.ЕдиницаИзмеренияЗатрата КАК ЕдиницаИзмерения,
			|	Т.Затрата КАК Номенклатура,
			|	Т.ХарактеристикаЗатрата КАК Характеристика,
			|	Т.СерияЗатрата КАК Серия,
			|	Т.НазначениеЗатрата КАК Назначение,
			|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
			|	Т.СтатьяКалькуляции КАК СтатьяКалькуляции,
			|	ВЫРАЗИТЬ(&УровеньУзла КАК ЧИСЛО(15, 0)) КАК Уровень,
			|	Т.ПартияЗатрата КАК Партия,
			|	Т.УзелПервогоУровня_ПартияПродукции КАК ПартияПродукции,
			|	Т.ПартияВыходноеИзделие КАК ПартияВыходноеИзделие,
			|	Т.ПартияЗатрата КАК ПартияЗатрата,
			|	ВЫРАЗИТЬ(Т.КоличествоЗатрата КАК ЧИСЛО(19,6)) КАК Количество,
			|	ВЫРАЗИТЬ(ВЫБОР КОГДА Т.ТребуетсяРазузлование
			|		ТОГДА Т.КоличествоЗатрата
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ЧИСЛО(19,6)) КАК Числитель,
			|	ВЫРАЗИТЬ(0 КАК ЧИСЛО(19,6)) КАК Знаменатель,
			|	ВЫРАЗИТЬ(Т.СуммаЗатрата КАК ЧИСЛО(19,6)) КАК Сумма,
			|	ВЫРАЗИТЬ(Т.СуммаЗатратаЗабалансовая КАК ЧИСЛО(19,6)) КАК СуммаЗабалансовая,
			|	ВЫРАЗИТЬ(Т.Материальные КАК ЧИСЛО(19,6)) КАК Материальные,
			|	ВЫРАЗИТЬ(Т.Трудозатраты КАК ЧИСЛО(19,6)) КАК Трудозатраты,
			|	ВЫРАЗИТЬ(Т.ПостатейныеПостоянные КАК ЧИСЛО(19,6)) КАК ПостатейныеПостоянные,
			|	ВЫРАЗИТЬ(Т.ПостатейныеПеременные КАК ЧИСЛО(19,6)) КАК ПостатейныеПеременные,
			|	ВЫРАЗИТЬ(Т.ДопРасходы КАК ЧИСЛО(19,6)) КАК ДопРасходы,
			|	ВЫРАЗИТЬ(Т.НДД КАК ЧИСЛО(19,6)) КАК НДД,
			|	ВЫРАЗИТЬ(Т.МатериальныеСНДС КАК ЧИСЛО(19,6)) КАК МатериальныеСНДС,
			|	ВЫРАЗИТЬ(Т.ТрудозатратыСНДС КАК ЧИСЛО(19,6)) КАК ТрудозатратыСНДС,
			|	ВЫРАЗИТЬ(Т.ПостатейныеПостоянныеСНДС КАК ЧИСЛО(19,6)) КАК ПостатейныеПостоянныеСНДС,
			|	ВЫРАЗИТЬ(Т.ПостатейныеПеременныеСНДС КАК ЧИСЛО(19,6)) КАК ПостатейныеПеременныеСНДС,
			|	ВЫРАЗИТЬ(Т.ДопРасходыСНДС КАК ЧИСЛО(19,6)) КАК ДопРасходыСНДС,
			|	ВЫРАЗИТЬ(Т.МатериальныеБезНДС КАК ЧИСЛО(19,6)) КАК МатериальныеБезНДС,
			|	ВЫРАЗИТЬ(Т.ПостатейныеПостоянныеБезНДС КАК ЧИСЛО(19,6)) КАК ПостатейныеПостоянныеБезНДС,
			|	ВЫРАЗИТЬ(Т.ПостатейныеПеременныеБезНДС КАК ЧИСЛО(19,6)) КАК ПостатейныеПеременныеБезНДС,
			|	ВЫРАЗИТЬ(Т.ДопРасходыБезНДС КАК ЧИСЛО(19,6)) КАК ДопРасходыБезНДС,
			|	ВЫРАЗИТЬ(Т.МатериальныеУпр КАК ЧИСЛО(19,6)) КАК МатериальныеУпр,
			|	ВЫРАЗИТЬ(Т.ТрудозатратыУпр КАК ЧИСЛО(19,6)) КАК ТрудозатратыУпр,
			|	ВЫРАЗИТЬ(Т.ПостатейныеПостоянныеУпр КАК ЧИСЛО(19,6)) КАК ПостатейныеПостоянныеУпр,
			|	ВЫРАЗИТЬ(Т.ПостатейныеПеременныеУпр КАК ЧИСЛО(19,6)) КАК ПостатейныеПеременныеУпр,
			|	ВЫРАЗИТЬ(Т.ДопРасходыУпр КАК ЧИСЛО(19,6)) КАК ДопРасходыУпр,
			|	ВЫРАЗИТЬ(Т.СтоимостьЗабалансоваяУпр КАК ЧИСЛО(19,6)) КАК СтоимостьЗабалансоваяУпр,
			|	ВЫРАЗИТЬ(Т.МатериальныеРегл КАК ЧИСЛО(19,6)) КАК МатериальныеРегл,
			|	ВЫРАЗИТЬ(Т.ТрудозатратыРегл КАК ЧИСЛО(19,6)) КАК ТрудозатратыРегл,
			|	ВЫРАЗИТЬ(Т.ПостатейныеПостоянныеРегл КАК ЧИСЛО(19,6)) КАК ПостатейныеПостоянныеРегл,
			|	ВЫРАЗИТЬ(Т.ПостатейныеПеременныеРегл КАК ЧИСЛО(19,6)) КАК ПостатейныеПеременныеРегл,
			|	ВЫРАЗИТЬ(Т.ДопРасходыРегл КАК ЧИСЛО(19,6)) КАК ДопРасходыРегл,
			|	ВЫРАЗИТЬ(Т.СтоимостьЗабалансоваяРегл КАК ЧИСЛО(19,6)) КАК СтоимостьЗабалансоваяРегл,
			|	ВЫРАЗИТЬ(Т.НалоговыйУчет КАК ЧИСЛО(19,6)) КАК НалоговыйУчет,
			|	ВЫРАЗИТЬ(Т.ПостояннаяРазница КАК ЧИСЛО(19,6)) КАК ПостояннаяРазница,
			|	ВЫРАЗИТЬ(Т.ВременнаяРазница КАК ЧИСЛО(19,6)) КАК ВременнаяРазница,
			|	ВЫРАЗИТЬ(Т.СуммаВключениеИсключениеНДСВСтоимости КАК ЧИСЛО(19,6)) КАК СуммаВключениеИсключениеНДСВСтоимости
			|
			|ДОБАВИТЬ ПредварительныйРезультат2
			|
			|ИЗ РезультатыРазузлования КАК Т
			|
			|ГДЕ
			|	&УсловиеОтбора
			|";
	Иначе
		ТекстЗапроса = "
			|ВЫБРАТЬ
			// Если это не отбор, в данный момент значение данной колонки больше не где не используется,
			// нет смысла тратит время на включение в группировку.
			|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаИсходнойПартии,
			|	ВЫБОР КОГДА МАКСИМУМ(Т.ТребуетсяРазузлование)
			|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСтрокДереваСебестоимости.ПартияПолуфабриката)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСтрокДереваСебестоимости.ПартияЗатраты)
			|	КОНЕЦ КАК ВидСтроки,
			// Смотри комментарий 3970.
			|	"""" КАК ИдентификаторУзлаПервогоУровня,
			|	"""" КАК ИдентификаторУзла,
			|	Т.УзелПервогоУровня_АналитикаУчетаПродукции КАК АналитикаУчетаПродукции,
			|	Т.АналитикаУчетаВыходноеИзделие КАК АналитикаУчетаВыходноеИзделие,
			|	Т.АналитикаУчетаЗатрата КАК АналитикаУчетаЗатрата,
			|	Т.АналитикаУчетаПартийЗатрата КАК АналитикаУчетаПартий,
			|	Т.УзелПервогоУровня_АналитикаУчетаПартийПродукции КАК АналитикаУчетаПартийПродукции,
			|	Т.АналитикаУчетаПартийВыходноеИзделие КАК АналитикаУчетаПартийВыходноеИзделие,
			|	Т.АналитикаУчетаПартийЗатрата КАК АналитикаУчетаПартийЗатрата,
			|	Т.Организация КАК Организация,
			|	Т.Подразделение КАК Подразделение,
			|	Т.ТипЗатрат КАК ТипЗатрат,
			|	МАКСИМУМ(Т.ТребуетсяРазузлование) КАК ТребуетсяРазузлование,
			|	МАКСИМУМ(Т.ТребуетсяРазузлованиеДопРасходов) КАК ТребуетсяРазузлованиеДопРасходов,
			|	Т.ЕдиницаИзмеренияЗатрата КАК ЕдиницаИзмерения,
			|	Т.Затрата КАК Номенклатура,
			|	Т.ХарактеристикаЗатрата КАК Характеристика,
			|	Т.СерияЗатрата КАК Серия,
			|	Т.НазначениеЗатрата КАК Назначение,
			|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
			|	Т.СтатьяКалькуляции КАК СтатьяКалькуляции,
			|	ВЫРАЗИТЬ(&УровеньУзла КАК ЧИСЛО(15, 0)) КАК Уровень,
			|	Т.ПартияЗатрата КАК Партия,
			|	Т.УзелПервогоУровня_ПартияПродукции КАК ПартияПродукции,
			|	Т.ПартияВыходноеИзделие КАК ПартияВыходноеИзделие,
			|	Т.ПартияЗатрата КАК ПартияЗатрата,
			|	
			|	ВЫРАЗИТЬ(СУММА(Т.КоличествоЗатрата) КАК ЧИСЛО(19,6)) КАК Количество,
			|	ВЫРАЗИТЬ(ВЫБОР КОГДА МАКСИМУМ(Т.ТребуетсяРазузлование)
			|		ТОГДА СУММА(Т.КоличествоЗатрата)
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК ЧИСЛО(19,6)) КАК Числитель,
			|	ВЫРАЗИТЬ(0 КАК ЧИСЛО(19,6)) КАК Знаменатель,
			|	ВЫРАЗИТЬ(СУММА(Т.СуммаЗатрата) КАК ЧИСЛО(19,6)) КАК Сумма,
			|	ВЫРАЗИТЬ(СУММА(Т.СуммаЗатратаЗабалансовая) КАК ЧИСЛО(19,6)) КАК СуммаЗабалансовая,
			|	ВЫРАЗИТЬ(СУММА(Т.Материальные) КАК ЧИСЛО(19,6)) КАК Материальные,
			|	ВЫРАЗИТЬ(СУММА(Т.Трудозатраты) КАК ЧИСЛО(19,6)) КАК Трудозатраты,
			|	ВЫРАЗИТЬ(СУММА(Т.ПостатейныеПостоянные) КАК ЧИСЛО(19,6)) КАК ПостатейныеПостоянные,
			|	ВЫРАЗИТЬ(СУММА(Т.ПостатейныеПеременные) КАК ЧИСЛО(19,6)) КАК ПостатейныеПеременные,
			|	ВЫРАЗИТЬ(СУММА(Т.ДопРасходы) КАК ЧИСЛО(19,6)) КАК ДопРасходы,
			|	ВЫРАЗИТЬ(СУММА(Т.НДД) КАК ЧИСЛО(19,6)) КАК НДД,
			|	ВЫРАЗИТЬ(СУММА(Т.МатериальныеСНДС) КАК ЧИСЛО(19,6)) КАК МатериальныеСНДС,
			|	ВЫРАЗИТЬ(СУММА(Т.ТрудозатратыСНДС) КАК ЧИСЛО(19,6)) КАК ТрудозатратыСНДС,
			|	ВЫРАЗИТЬ(СУММА(Т.ПостатейныеПостоянныеСНДС) КАК ЧИСЛО(19,6)) КАК ПостатейныеПостоянныеСНДС,
			|	ВЫРАЗИТЬ(СУММА(Т.ПостатейныеПеременныеСНДС) КАК ЧИСЛО(19,6)) КАК ПостатейныеПеременныеСНДС,
			|	ВЫРАЗИТЬ(СУММА(Т.ДопРасходыСНДС) КАК ЧИСЛО(19,6)) КАК ДопРасходыСНДС,
			|	ВЫРАЗИТЬ(СУММА(Т.МатериальныеБезНДС) КАК ЧИСЛО(19,6)) КАК МатериальныеБезНДС,
			|	ВЫРАЗИТЬ(СУММА(Т.ПостатейныеПостоянныеБезНДС) КАК ЧИСЛО(19,6)) КАК ПостатейныеПостоянныеБезНДС,
			|	ВЫРАЗИТЬ(СУММА(Т.ПостатейныеПеременныеБезНДС) КАК ЧИСЛО(19,6)) КАК ПостатейныеПеременныеБезНДС,
			|	ВЫРАЗИТЬ(СУММА(Т.ДопРасходыБезНДС) КАК ЧИСЛО(19,6)) КАК ДопРасходыБезНДС,
			|	ВЫРАЗИТЬ(СУММА(Т.МатериальныеУпр) КАК ЧИСЛО(19,6)) КАК МатериальныеУпр,
			|	ВЫРАЗИТЬ(СУММА(Т.ТрудозатратыУпр) КАК ЧИСЛО(19,6)) КАК ТрудозатратыУпр,
			|	ВЫРАЗИТЬ(СУММА(Т.ПостатейныеПостоянныеУпр) КАК ЧИСЛО(19,6)) КАК ПостатейныеПостоянныеУпр,
			|	ВЫРАЗИТЬ(СУММА(Т.ПостатейныеПеременныеУпр) КАК ЧИСЛО(19,6)) КАК ПостатейныеПеременныеУпр,
			|	ВЫРАЗИТЬ(СУММА(Т.ДопРасходыУпр) КАК ЧИСЛО(19,6)) КАК ДопРасходыУпр,
			|	ВЫРАЗИТЬ(СУММА(Т.СтоимостьЗабалансоваяУпр) КАК ЧИСЛО(19,6)) КАК СтоимостьЗабалансоваяУпр,
			|	ВЫРАЗИТЬ(СУММА(Т.МатериальныеРегл) КАК ЧИСЛО(19,6)) КАК МатериальныеРегл,
			|	ВЫРАЗИТЬ(СУММА(Т.ТрудозатратыРегл) КАК ЧИСЛО(19,6)) КАК ТрудозатратыРегл,
			|	ВЫРАЗИТЬ(СУММА(Т.ПостатейныеПостоянныеРегл) КАК ЧИСЛО(19,6)) КАК ПостатейныеПостоянныеРегл,
			|	ВЫРАЗИТЬ(СУММА(Т.ПостатейныеПеременныеРегл) КАК ЧИСЛО(19,6)) КАК ПостатейныеПеременныеРегл,
			|	ВЫРАЗИТЬ(СУММА(Т.ДопРасходыРегл) КАК ЧИСЛО(19,6)) КАК ДопРасходыРегл,
			|	ВЫРАЗИТЬ(СУММА(Т.СтоимостьЗабалансоваяРегл) КАК ЧИСЛО(19,6)) КАК СтоимостьЗабалансоваяРегл,
			|	ВЫРАЗИТЬ(СУММА(Т.НалоговыйУчет) КАК ЧИСЛО(19,6)) КАК НалоговыйУчет,
			|	ВЫРАЗИТЬ(СУММА(Т.ПостояннаяРазница) КАК ЧИСЛО(19,6)) КАК ПостояннаяРазница,
			|	ВЫРАЗИТЬ(СУММА(Т.ВременнаяРазница) КАК ЧИСЛО(19,6)) КАК ВременнаяРазница,
			|	ВЫРАЗИТЬ(СУММА(Т.СуммаВключениеИсключениеНДСВСтоимости) КАК ЧИСЛО(19,6)) КАК СуммаВключениеИсключениеНДСВСтоимости
			|
			|ДОБАВИТЬ ПредварительныйРезультат2
			|
			|ИЗ РезультатыРазузлования КАК Т
			|
			|ГДЕ
			|	&УсловиеОтбора
			|
			|СГРУППИРОВАТЬ ПО
			|	ВЫБОР КОГДА Т.ТребуетсяРазузлование
			|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСтрокДереваСебестоимости.ПартияПолуфабриката)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСтрокДереваСебестоимости.ПартияЗатраты)
			|	КОНЕЦ, // ВидСтроки
			|	Т.Организация,
			|	Т.Подразделение,
			|	Т.УзелПервогоУровня_АналитикаУчетаПродукции,
			|	Т.УзелПервогоУровня_АналитикаУчетаПартийПродукции,
			|	Т.УзелПервогоУровня_ПартияПродукции,
			|	Т.АналитикаУчетаВыходноеИзделие,
			|	Т.АналитикаУчетаПартийВыходноеИзделие,
			|	Т.ПартияВыходноеИзделие,
			|	Т.АналитикаУчетаПартийЗатрата,
			|	Т.ПартияЗатрата,
			|	Т.Затрата,
			|	Т.ХарактеристикаЗатрата,
			|	Т.СтатьяКалькуляции,
			|	Т.ЕдиницаИзмеренияЗатрата,
			|
			|	Т.СерияЗатрата,
			|	Т.НазначениеЗатрата,
			|	Т.АналитикаУчетаЗатрата,
			|	Т.ТипЗатрат
			|";
	КонецЕсли;
	
	Если ЗапросДляОтбора Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбора",
			"Т.ТребуетсяРазузлование ИЛИ Т.ТребуетсяРазузлованиеДопРасходов"); //@Query-part
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДОБАВИТЬ ПредварительныйРезультат2", ""); //@Query-part
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбора",
			"&ДобавлятьПолуфабрикатыВРезультат ИЛИ НЕ Т.ТребуетсяРазузлование"); //@Query-part
	КонецЕсли;
	
	Возврат ТекстЗапроса;
КонецФункции

#Область ЗапросПоВыпущеннойПродукции

Функция ШаблонЗапросаВыпущеннойПродукции(ЕстьОтборПоТаблицеОтбораУзлов, ПомещатьВВТ, ПараметрыДерева)
	
	ТекстыЗапросов = Новый Массив();
	
	ТекстЗапроса = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СебестоимостьТоваров.Организация				КАК Организация,
		|	СебестоимостьТоваров.Партия						КАК ПартияПродукции,
		|	СебестоимостьТоваров.АналитикаУчетаПартий		КАК АналитикаУчетаПартийПродукции,
		|	СУММА(СебестоимостьТоваров.Количество)			КАК Числитель
		|ПОМЕСТИТЬ ТаблицаОтборов
		|ИЗ
		|	РегистрНакопления.СебестоимостьТоваров КАК СебестоимостьТоваров
		|ГДЕ
		|	&РасшифровкаДвиженийДокумента
		|	И СебестоимостьТоваров.РазделУчета В (ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах),
		|										ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ПроизводственныеЗатраты),
		|										ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыПринятыеНаОтветхранение),
		|										ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыПринятыеНаОтветхранениеКОформлениюСписания),
		|										ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыПринятыеНаОтветхранениеПереданныеПартнерам),
		|										ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыПереданныеПереработчику))
		|	И НЕ СебестоимостьТоваров.Партия = НЕОПРЕДЕЛЕНО
		|	И СебестоимостьТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И СебестоимостьТоваров.Регистратор В (&Регистраторы)
		|	И (СебестоимостьТоваров.Период МЕЖДУ &ДатаНачала И &ДатаОкончания ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1,1,1))
		|{ГДЕ
		|	СебестоимостьТоваров.Организация.*	КАК Организация,
		|	СебестоимостьТоваров.Партия.*		КАК ПартияПродукции
		|}
		|СГРУППИРОВАТЬ ПО
		|	СебестоимостьТоваров.Организация,
		|	СебестоимостьТоваров.Партия,
		|	СебестоимостьТоваров.АналитикаУчетаПартий
		|	
		|ИНДЕКСИРОВАТЬ ПО
		|	Организация,
		|	ПартияПродукции,
		|	АналитикаУчетаПартийПродукции
		|";
	ТекстыЗапросов.Добавить(ТекстЗапроса);
	
	#Область СебестоимостьТоваров
	
	УсловиеОтбораПоТаблицеОтбора = "НЕ СебестоимостьТоваров.Партия = НЕОПРЕДЕЛЕНО";
	Если ЕстьОтборПоТаблицеОтбораУзлов Тогда
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.ПартияПродукции КАК ПартияПродукции
		|
		|ПОМЕСТИТЬ ОтборПоПродукцииИПартии
		|ИЗ ТаблицаОтборовУзлов КАК Т
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ПартияПродукции
		|";
		
		УсловиеОтбораПоТаблицеОтбора = "
		|ИСТИНА В (ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА
		|		ИЗ ОтборПоПродукцииИПартии КАК ОтборПоПродукцииИПартии
		|		ГДЕ СебестоимостьТоваров.Партия = ОтборПоПродукцииИПартии.ПартияПродукции
		|)
		|";
		
		ТекстыЗапросов.Добавить(ТекстЗапроса);
	КонецЕсли;
	
	ТекстЗапроса = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СебестоимостьТоваров.Период КАК Период,
		|	СебестоимостьТоваров.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
		|	СебестоимостьТоваров.РазделУчета КАК РазделУчета,
		|	СебестоимостьТоваров.ВидЗапасов КАК ВидЗапасов,
		|	СебестоимостьТоваров.Организация КАК Организация,
		|	СебестоимостьТоваров.Партия КАК Партия,
		|	СебестоимостьТоваров.АналитикаУчетаПартий КАК АналитикаУчетаПартий,
		|	СебестоимостьТоваров.АналитикаФинансовогоУчета КАК АналитикаФинансовогоУчета,
		|	СебестоимостьТоваров.ВидДеятельностиНДС КАК ВидДеятельностиНДС,
		|	СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры КАК КорАналитикаУчетаНоменклатуры,
		|	
		|	СебестоимостьТоваров.Количество КАК Количество,
		|	СебестоимостьТоваров.Стоимость КАК Стоимость,
		|	СебестоимостьТоваров.СтоимостьБезНДС КАК СтоимостьБезНДС,
		|	СебестоимостьТоваров.СтоимостьУпр КАК СтоимостьУпр,
		|	СебестоимостьТоваров.СтоимостьРегл КАК СтоимостьРегл,
		|	СебестоимостьТоваров.Трудозатраты КАК Трудозатраты,
		|	СебестоимостьТоваров.ТрудозатратыУпр КАК ТрудозатратыУпр,
		|	СебестоимостьТоваров.ТрудозатратыРегл КАК ТрудозатратыРегл,
		|	СебестоимостьТоваров.ПостатейныеПостоянныеСНДС КАК ПостатейныеПостоянныеСНДС,
		|	СебестоимостьТоваров.ПостатейныеПостоянныеБезНДС КАК ПостатейныеПостоянныеБезНДС,
		|	СебестоимостьТоваров.ПостатейныеПостоянныеУпр КАК ПостатейныеПостоянныеУпр,
		|	СебестоимостьТоваров.ПостатейныеПостоянныеРегл КАК ПостатейныеПостоянныеРегл,
		|	СебестоимостьТоваров.ПостатейныеПеременныеСНДС КАК ПостатейныеПеременныеСНДС,
		|	СебестоимостьТоваров.ПостатейныеПеременныеБезНДС КАК ПостатейныеПеременныеБезНДС,
		|	СебестоимостьТоваров.ПостатейныеПеременныеУпр КАК ПостатейныеПеременныеУпр, 
		|	СебестоимостьТоваров.ПостатейныеПеременныеРегл КАК ПостатейныеПеременныеРегл,
		|	СебестоимостьТоваров.ДопРасходы КАК ДопРасходы,
		|	СебестоимостьТоваров.ДопРасходыБезНДС КАК ДопРасходыБезНДС,
		|	СебестоимостьТоваров.ДопРасходыУпр КАК ДопРасходыУпр,
		|	СебестоимостьТоваров.ДопРасходыРегл КАК ДопРасходыРегл,
		|	СебестоимостьТоваров.СтоимостьЗабалансовая КАК СтоимостьЗабалансовая,
		|	СебестоимостьТоваров.СтоимостьЗабалансоваяРегл КАК СтоимостьЗабалансоваяРегл,
		|	СебестоимостьТоваров.СтоимостьНДД КАК СтоимостьНДД,
		|	СебестоимостьТоваров.ПостояннаяРазница КАК ПостояннаяРазница,
		|	СебестоимостьТоваров.ВременнаяРазница КАК ВременнаяРазница
		|
		|ПОМЕСТИТЬ ВТСебестоимостьТоваров
		|ИЗ
		|	РегистрНакопления.СебестоимостьТоваров КАК СебестоимостьТоваров
		|ГДЕ
		|	&УсловиеОтбораПоТаблицеОтбора
		|	И СебестоимостьТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|
		|	И СебестоимостьТоваров.ХозяйственнаяОперация В (ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыпускПродукции),
		|										ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыпускПродукцииНаСклад),
		|										ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыпускПродукцииВПодразделение))
		|
		|	И СебестоимостьТоваров.РазделУчета В (ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ВыпускПродукции),
		|										ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ПроизводственныеЗатраты),
		|										ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыПринятыеНаОтветхранение),
