#Область ПрограммныйИнтерфейс

// Возвращает параметры формирования текста запроса карт исследований
//
// Возвращаемое значение:
// 	Структура - из:
//  * ИмяВходнойТаблицы - Строка - Имя входной таблицы
//  * ИмяВыходнойТаблицы - Строка - Имя временной таблицы
//  * ВсеПоляВРезультате - Булево - Истина - если необходимо поместить все поля структуры/таблицы данных об карте исследования в результат выборки
//  * УничтожитьВременныеТаблицы - Булево - Истина - если необходимо уничтожить используемые временные таблицы
//  * РазделительИтоговогоПакета - Булево - Истина - если необходим разделитель итогового пакета
//  * УсловияОтбораВходящихДанных - Массив Из Строка - Дополнительные условия отбора входной таблицы.
//
Функция ПараметрыТекстаЗапросаКартИсследований() Экспорт
	
	Результат = Новый Структура;
	
	// Используется, если имя входной таблицы отличается от ВтСписокНоменклатуры
	Результат.Вставить("ИмяВходнойТаблицы",           "");
	// Используется, если результат необходимо поместить во временную таблицу 
	Результат.Вставить("ИмяВыходнойТаблицы",          "");
	// Истина - если необходимо поместить все поля структуры/таблицы данных об карте исследования в результат выборки
	Результат.Вставить("ВсеПоляВРезультате",          Ложь);
	// Истина - если необходимо уничтожить используемые временные таблицы
	Результат.Вставить("УничтожитьВременныеТаблицы",  Истина);
	// Истина - если необходим разделитель итогового пакета
	Результат.Вставить("РазделительИтоговогоПакета",  Истина);
	// Дополнительные условия отбора входной таблицы
	Результат.Вставить("УсловияОтбораВходящихДанных", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

// Устанавливает параметры запроса, сформированного функцией ТекстЗапросаКартИсследованийТоваров()
//
// Параметры:
//  Запрос          - Запрос    - Запрос выбора Карт исследования товаров.
//  ПараметрыВыбора - см. ИсследованиеТоваровКлиентСервер.ПараметрыВыбораНазначенияИсследованийКонструктор
//
Процедура УстановитьПараметрыЗапросаКартИсследованийТоваров(Запрос, ПараметрыВыбора) Экспорт
	
	СписокПараметров = Новый Структура;
	СписокПараметров.Вставить("ИсключитьКартуИсследованияТоваров", Справочники.КартыИсследованияТоваров.ПустаяСсылка());
	
	СписокПараметровБезОтбора = Новый Структура;
	СписокПараметровБезОтбора.Вставить("ИсключитьКартуИсследованияТоваров", "ИсключитьКартуИсследованияТоваровБезОтбора");
	
	Для каждого КлючИЗначение Из СписокПараметров Цикл
		ЗначениеПараметра = КлючИЗначение.Значение;
		Если ПараметрыВыбора.Свойство(КлючИЗначение.Ключ) Тогда
			ЗначениеПараметра = ПараметрыВыбора[КлючИЗначение.Ключ];
		КонецЕсли;
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, ЗначениеПараметра);
		Запрос.УстановитьПараметр(СписокПараметровБезОтбора[КлючИЗначение.Ключ], НЕ ЗначениеЗаполнено(ЗначениеПараметра));
	КонецЦикла;
	
	ИгнорируемыеУточненияПрименения = Новый Массив;
	Если ПараметрыВыбора.Свойство("ИгнорируемыеУточненияПрименения")
		И ЗначениеЗаполнено(ПараметрыВыбора.ИгнорируемыеУточненияПрименения) Тогда
		ИгнорируемыеУточненияПрименения = ПараметрыВыбора.ИгнорируемыеУточненияПрименения;
	КонецЕсли;
	Запрос.УстановитьПараметр("ИгнорируемыеУточненияПрименения", ИгнорируемыеУточненияПрименения);

	Запрос.УстановитьПараметр("КлючСвязиНоменклатура",   ИсследованиеТоваровКлиентСервер.ОтборПоСвойствамКлючСвязиПредопределенный("Номенклатура"));
	Запрос.УстановитьПараметр("КлючСвязиХарактеристика", ИсследованиеТоваровКлиентСервер.ОтборПоСвойствамКлючСвязиПредопределенный("Характеристика"));

	Запрос.УстановитьПараметр("КлючСвязиПустой",         Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	
	Если ПараметрыВыбора.Свойство("СтрокаПоиска") Тогда
		
		Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СокрЛП(ПараметрыВыбора.СтрокаПоиска) + "%");
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает текст запроса карт исследования товаров
//
// Параметры:
//  ПараметрыЗапроса            - см. ИсследованиеТоваров.ПараметрыТекстаЗапросаКартИсследований
//  ПараметрыВыбораКартИсследованияТоваров - см. ИсследованиеТоваровКлиентСервер.ПараметрыВыбораНазначенияИсследованийКонструктор
// 
// Возвращаемое значение:
//  Строка - текст запроса для выбора карт исследования товаров
//
Функция ТекстЗапросаКартИсследованийТоваров(ПараметрыЗапроса, ПараметрыВыбораКартИсследованияТоваров) Экспорт
	
	ТаблицыУничтожить = Новый Массив;
	ТаблицыУничтожить.Добавить("ВтДоступныеКартыИсследованияТоваров");
	ТаблицыУничтожить.Добавить("ВтСоответствуютПараметрамНазначения");
	ТаблицыУничтожить.Добавить("ВтНайденоВСписке");
		
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	СписокНоменклатуры.ИндексДанных            КАК ИндексДанных,
		|	СписокНоменклатуры.Номенклатура            КАК Номенклатура,
		|	СписокНоменклатуры.Характеристика          КАК Характеристика,
		|	СписокНоменклатуры.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|
		|	КартыИсследованияТоваров.КартаИсследованияТоваров КАК КартаИсследованияТоваров,
		|	КартыИсследованияТоваров.Контроль                КАК Контроль,
		|	КартыИсследованияТоваров.ВариантОтбораОбразцов    КАК ВариантОтбораОбразцов,
		|	КартыИсследованияТоваров.КоличествоОбразцов       КАК КоличествоОбразцов,
		|	КартыИсследованияТоваров.ПроцентОбразцов          КАК ПроцентОбразцов,
		|
		|	КартыИсследованияТоваров.Номенклатура   = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)               КАК ЛюбаяНоменклатура,
		|	КартыИсследованияТоваров.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК ЛюбаяХарактеристика
		|
		|ПОМЕСТИТЬ ВтИсточникДоступныхКартИсследованияТоваров
		|ИЗ
		|	РегистрСведений.КартыИсследованияТоваров КАК КартыИсследованияТоваров
		|
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСписокНоменклатуры КАК СписокНоменклатуры
		|		 ПО КартыИсследованияТоваров.ВидНоменклатуры = СписокНоменклатуры.ВидНоменклатуры
		|			И (КартыИсследованияТоваров.Номенклатура = СписокНоменклатуры.Номенклатура
		|				ИЛИ КартыИсследованияТоваров.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
		|			И (КартыИсследованияТоваров.Характеристика = СписокНоменклатуры.Характеристика
		|				ИЛИ КартыИсследованияТоваров.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		|			И &ТекстУсловиеОтбораВходящихДанных
		|
		|ГДЕ
		|
		|	(КартыИсследованияТоваров.КартаИсследованияТоваров <> &ИсключитьКартуИсследованияТоваров
		|		ИЛИ &ИсключитьКартуИсследованияТоваровБезОтбора)
		|
		|	И &ТекстУсловиеОтбораПоНаименованию
		|
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|";
		
	ТекстПоляКартаИсследованияТоваров             = "КартыИсследованияТоваров.КартаИсследованияТоваров";
	ИмяВременнойТаблицыИсточникаКартИсследования  = "ВтИсточникДоступныхКартИсследованияТоваров";
	
	Если ПараметрыВыбораКартИсследованияТоваров.Свойство("СтрокаПоиска") Тогда
		ТекстУсловия = "
		|	И (&ТекстПоляНоменклатураКартыИсследованияТоваров.Наименование ПОДОБНО &СтрокаПоиска
		|		ИЛИ &СтрокаПоиска = """")";
	Иначе
		ТекстУсловия = "";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &ТекстУсловиеОтбораПоНаименованию", ТекстУсловия);
	
	ТекстЗапроса = ТекстЗапроса + "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДоступныеКартыИсследованияТоваров.ИндексДанных                   КАК ИндексДанных,
	|	ДоступныеКартыИсследованияТоваров.КартаИсследованияТоваров       КАК КартаИсследованияТоваров,
	|	ДоступныеКартыИсследованияТоваров.ЛюбаяНоменклатура              КАК ЛюбаяНоменклатура,
	|	ДоступныеКартыИсследованияТоваров.ЛюбаяХарактеристика            КАК ЛюбаяХарактеристика,
	|
	|	ДоступныеКартыИсследованияТоваров.Контроль           КАК Контроль,
	|	ДоступныеКартыИсследованияТоваров.ВариантОтбораОбразцов КАК ВариантОтбораОбразцов,
	|	ДоступныеКартыИсследованияТоваров.КоличествоОбразцов    КАК КоличествоОбразцов,
	|	ДоступныеКартыИсследованияТоваров.ПроцентОбразцов       КАК ПроцентОбразцов,
	|
	|	ОтборПоСвойствам.КлючСвязи КАК ВидУточненияПрименения,
	|
	|	ОтборПоСвойствам.Свойство  КАК Свойство,
	|
	|	ОтборПоСвойствам.Условие   КАК Условие,
	|	ВЫБОР
	|		КОГДА ОтборПоСвойствам.Условие В (""ВСписке"",""НеВСписке"")
	|			ТОГДА 0
	|		ИНАЧЕ ОтборПоСвойствам.Значение
	|	КОНЕЦ КАК ЗначениеНастройки,
	|
	|	ЕСТЬNULL(
	|		ВЫБОР ОтборПоСвойствам.КлючСвязи
	|			КОГДА &КлючСвязиНоменклатура
	|				ТОГДА ДопРеквизитНоменклатуры.Значение
	|			КОГДА &КлючСвязиХарактеристика
	|				ТОГДА ДопРеквизитХарактеристики.Значение
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(ОтборПоСвойствам.Значение) = ТИП(БУЛЕВО)
	|				ТОГДА ЛОЖЬ
	|			КОГДА ТИПЗНАЧЕНИЯ(ОтборПоСвойствам.Значение) = ТИП(ЧИСЛО)
	|				ТОГДА 0
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ) КАК ЗначениеПараметра
	|
	|ПОМЕСТИТЬ ВтДоступныеКартыИсследованияТоваров
	|
	|ИЗ
	|	ВтИсточникДоступныхКартИсследованияТоваров КАК ДоступныеКартыИсследованияТоваров
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КартыИсследованияТоваров.ОтборПоСвойствам КАК ОтборПоСвойствам
	|		ПО ДоступныеКартыИсследованияТоваров.КартаИсследованияТоваров = ОтборПоСвойствам.Ссылка
	|			И ОтборПоСвойствам.КлючСвязи В (&КлючСвязиНоменклатура, &КлючСвязиХарактеристика)
	|			И НЕ ОтборПоСвойствам.КлючСвязи В (&ИгнорируемыеУточненияПрименения)
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ДополнительныеРеквизиты КАК ДопРеквизитНоменклатуры
	|		ПО ДоступныеКартыИсследованияТоваров.Номенклатура = ДопРеквизитНоменклатуры.Ссылка
	|			И ОтборПоСвойствам.КлючСвязи = &КлючСвязиНоменклатура
	|			И ОтборПоСвойствам.Свойство = ДопРеквизитНоменклатуры.Свойство
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры.ДополнительныеРеквизиты КАК ДопРеквизитХарактеристики
	|		ПО ДоступныеКартыИсследованияТоваров.Характеристика = ДопРеквизитХарактеристики.Ссылка
	|			И ОтборПоСвойствам.КлючСвязи = &КлючСвязиХарактеристика
	|			И ОтборПоСвойствам.Свойство = ДопРеквизитХарактеристики.Свойство
	|
	|
	|;
	|
	|ВЫБРАТЬ
	|	Т.ИндексДанных              КАК ИндексДанных,
	|	Т.КартаИсследованияТоваров  КАК КартаИсследованияТоваров,
	|	Т.ВидУточненияПрименения    КАК ВидУточненияПрименения
	|
	|ПОМЕСТИТЬ
	|	ВтНайденоВСписке
	|ИЗ
	|	ВтДоступныеКартыИсследованияТоваров КАК Т
	|
	|ГДЕ
	|	Т.Условие В (""ВСписке"",""НеВСписке"")
	|	И ИСТИНА В (
	|
	|		ВЫБРАТЬ ПЕРВЫЕ 1
	|			ИСТИНА
	|		ИЗ
	|			Справочник.КартыИсследованияТоваров.ОтборПоСвойствам КАК Т2
	|		ГДЕ
	|			Т.ЗначениеПараметра = Т2.Значение
	|			И Т.КартаИсследованияТоваров = Т2.Ссылка
	|			И Т.ВидУточненияПрименения = Т2.КлючСвязи
	|		)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИндексДанных,
	|	КартаИсследованияТоваров,
	|	ВидУточненияПрименения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоступныеКартыИсследованияТоваров.ИндексДанных                КАК ИндексДанных,
	|	ДоступныеКартыИсследованияТоваров.КартаИсследованияТоваров    КАК КартаИсследованияТоваров,
	|	ДоступныеКартыИсследованияТоваров.Контроль                   КАК Контроль,
	|	ДоступныеКартыИсследованияТоваров.ВариантОтбораОбразцов       КАК ВариантОтбораОбразцов,
	|	ДоступныеКартыИсследованияТоваров.КоличествоОбразцов          КАК КоличествоОбразцов,
	|	ДоступныеКартыИсследованияТоваров.ПроцентОбразцов             КАК ПроцентОбразцов
	|ПОМЕСТИТЬ ВтСоответствуютПараметрамНазначения
	|ИЗ
	|	(ВЫБРАТЬ
	|		Т.ИндексДанных             КАК ИндексДанных,
	|		Т.КартаИсследованияТоваров КАК КартаИсследованияТоваров,
	|		Т.ЛюбаяНоменклатура        КАК ЛюбаяНоменклатура,
	|		Т.ЛюбаяХарактеристика      КАК ЛюбаяХарактеристика,
	|		Т.Контроль                КАК Контроль,
	|		Т.ВариантОтбораОбразцов    КАК ВариантОтбораОбразцов,
	|		Т.КоличествоОбразцов       КАК КоличествоОбразцов,
	|		Т.ПроцентОбразцов          КАК ПроцентОбразцов,
	|		Т.Условие                  КАК Условие,
	|		ВЫБОР Т.Условие
	|			КОГДА ""Равно""
	|				ТОГДА Т.ЗначениеПараметра = Т.ЗначениеНастройки
	|			КОГДА ""НеРавно""
	|				ТОГДА Т.ЗначениеПараметра <> Т.ЗначениеНастройки
	|			КОГДА ""Больше""
	|				ТОГДА Т.ЗначениеПараметра > Т.ЗначениеНастройки
	|			КОГДА ""БольшеИлиРавно""
	|				ТОГДА Т.ЗначениеПараметра >= Т.ЗначениеНастройки
	|			КОГДА ""Меньше""
	|				ТОГДА Т.ЗначениеПараметра < Т.ЗначениеНастройки
	|			КОГДА ""МеньшеИлиРавно""
	|				ТОГДА Т.ЗначениеПараметра <= Т.ЗначениеНастройки
	|			КОГДА ""ВСписке""
	|				ТОГДА НЕ НайденоВСписке.ИндексДанных ЕСТЬ NULL
	|			КОГДА ""НеВСписке""
	|				ТОГДА НайденоВСписке.ИндексДанных ЕСТЬ NULL
	|			КОГДА ""Заполнено""
	|				ТОГДА НЕ Т.ЗначениеПараметра В (НЕОПРЕДЕЛЕНО, ЛОЖЬ, 0)
	|			КОГДА ""НеЗаполнено""
	|				ТОГДА Т.ЗначениеПараметра В (НЕОПРЕДЕЛЕНО, ЛОЖЬ, 0)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ КАК СоответствуетПараметрамНазначения
	|	ИЗ
	|		ВтДоступныеКартыИсследованияТоваров КАК Т
	|	
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВтНайденоВСписке КАК НайденоВСписке
	|			ПО Т.ИндексДанных = НайденоВСписке.ИндексДанных
	|				И Т.КартаИсследованияТоваров = НайденоВСписке.КартаИсследованияТоваров
	|	) КАК ДоступныеКартыИсследованияТоваров
	|
	|СГРУППИРОВАТЬ ПО
	|	ДоступныеКартыИсследованияТоваров.ИндексДанных,
	|	ДоступныеКартыИсследованияТоваров.КартаИсследованияТоваров,
	|	ДоступныеКартыИсследованияТоваров.Контроль,
	|	ДоступныеКартыИсследованияТоваров.ВариантОтбораОбразцов,
	|	ДоступныеКартыИсследованияТоваров.КоличествоОбразцов,
	|	ДоступныеКартыИсследованияТоваров.ПроцентОбразцов,
	|	НЕ ДоступныеКартыИсследованияТоваров.ЛюбаяНоменклатура,
	|	НЕ ДоступныеКартыИсследованияТоваров.ЛюбаяХарактеристика
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(ДоступныеКартыИсследованияТоваров.СоответствуетПараметрамНазначения) = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	ТекстЗапроса = ТекстЗапроса + "
	|ВЫБРАТЬ
	|	КартыИсследованияТоваров.ИндексДанных               КАК ИндексДанных,
	|	КартыИсследованияТоваров.КартаИсследованияТоваров   КАК КартаИсследованияТоваров,
	|	КартыИсследованияТоваров.Контроль                КАК Контроль,
	|	КартыИсследованияТоваров.ВариантОтбораОбразцов      КАК ВариантОтбораОбразцов,
	|	КартыИсследованияТоваров.КоличествоОбразцов         КАК КоличествоОбразцов,
	|	КартыИсследованияТоваров.ПроцентОбразцов            КАК ПроцентОбразцов,
	|	&РеквизитыКартыИсследованияТоваров,
	|	&ВСЕПОЛЯ_РЕКВИЗИТЫ,
	|	КартыИсследованияТоваров.КартаИсследованияТоваров.Представление КАК Представление
	|
	|ПОМЕСТИТЬ ИмяВыходнойТаблицы
	|
	|ИЗ
	|	ВтСоответствуютПараметрамНазначения КАК КартыИсследованияТоваров
	|
	|	,ВСЕПОЛЯ_СОЕДИНЕНИЕ
	|
	|";
	
	// Реквизиты Карты исследования товаров
	Если ЗначениеЗаполнено(ПараметрыВыбораКартИсследованияТоваров.РеквизитыКартыИсследованияТоваров) Тогда
		ПоляЗапроса = Новый Массив;
		Для каждого Реквизит Из СтрРазделить(ПараметрыВыбораКартИсследованияТоваров.РеквизитыКартыИсследованияТоваров, ",", Ложь) Цикл
			ПоляЗапроса.Добавить(СтрШаблон("КартыИсследованияТоваров.КартаИсследованияТоваров.%1 КАК %1,", СокрЛП(Реквизит)));
		КонецЦикла;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеквизитыКартыИсследованияТоваров,", СтрСоединить(ПоляЗапроса,Символы.ПС));
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеквизитыКартыИсследованияТоваров,", "");
	КонецЕсли;
	
	Если ПараметрыЗапроса.ВсеПоляВРезультате Тогда
		
		ТекстСоединениеВсеПоля = "
		|	ЛЕВОЕ СОЕДИНЕНИЕ ВтИсточникДоступныхКартИсследованияТоваров КАК Т
		|	ПО КартыИсследованияТоваров.ИндексДанных = Т.ИндексДанных
		|		И КартыИсследованияТоваров.КартаИсследованияТоваров = Т.КартаИсследованияТоваров
		|";
		ТекстРеквизитыВсеПоля  = "
		|	Т.*,
		|";
		ТекстИндексировать     = "";
		
	Иначе
		
		ТекстСоединениеВсеПоля = "";
		ТекстРеквизитыВсеПоля  = "";
		ТекстИндексировать     = "
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ИндексДанных";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВСЕПОЛЯ_РЕКВИЗИТЫ,", ТекстРеквизитыВсеПоля);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ",ВСЕПОЛЯ_СОЕДИНЕНИЕ", ТекстСоединениеВсеПоля);
	
	Если НЕ ПустаяСтрока(ПараметрыЗапроса.ИмяВыходнойТаблицы) Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ИмяВыходнойТаблицы", "ПОМЕСТИТЬ "+ПараметрыЗапроса.ИмяВыходнойТаблицы);
		ТекстЗапроса = ТекстЗапроса + ТекстИндексировать;
		
	Иначе
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ИмяВыходнойТаблицы", "");
		
	КонецЕсли;
	
	ТекстУсловиеОтбораВходящихДанных = "ИСТИНА";
	Если ЗначениеЗаполнено(ПараметрыЗапроса.УсловияОтбораВходящихДанных) Тогда
		ТекстУсловиеОтбораВходящихДанных = СтрСоединить(ПараметрыЗапроса.УсловияОтбораВходящихДанных, " И ");
	КонецЕсли;
	
	Если ПараметрыЗапроса.УничтожитьВременныеТаблицы Тогда
		
		Для Индекс = 0 По ТаблицыУничтожить.ВГраница() Цикл
			ТаблицыУничтожить[Индекс] = СтрШаблон("%1 УНИЧТОЖИТЬ %2", ОбщегоНазначения.РазделительПакетаЗапросов(), ТаблицыУничтожить[Индекс]);
		КонецЦикла;
		ТекстЗапроса = ТекстЗапроса + СтрСоединить(ТаблицыУничтожить);
		
	КонецЕсли;
	
	Если ПараметрыЗапроса.РазделительИтоговогоПакета Тогда
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстПоляКартаИсследованияТоваров", ТекстПоляКартаИсследованияТоваров);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстУсловиеОтбораВходящихДанных", ТекстУсловиеОтбораВходящихДанных);
	
	Если НЕ ПустаяСтрока(ПараметрыЗапроса.ИмяВходнойТаблицы) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВтСписокНоменклатуры", ПараметрыЗапроса.ИмяВходнойТаблицы);
	КонецЕсли;
	
	Если ИмяВременнойТаблицыИсточникаКартИсследования <> "ВтИсточникДоступныхКартИсследованияТоваров" Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВтИсточникДоступныхКартИсследованияТоваров", ИмяВременнойТаблицыИсточникаКартИсследования);
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Остатки для заполнения документов ЗаявкаНаКонтрольКачестваТоваров и АктКонтроляКачестваТоваров.
// 
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - таблица аналитик:
//   * КонтролируемаяПартия - СправочникСсылка.КонтролируемыеПартии - контролируемая партия
//   * Номенклатура - СправочникСсылка.Номенклатура - номенклатура
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика
//   * Склад - СправочникСсылка.Склады - склад
//   * Назначение - СправочникСсылка.Назначения - назначение
//   * Помещение - СправочникСсылка.СкладскиеПомещения - помещение
//   * Серия - СправочникСсылка.СерииНоменклатуры - серия
//  ДокументИсследования - ДокументСсылка.ИсследованиеКачестваТоваров - документ исследования.
// Возвращаемое значение:
//  ТаблицаЗначений - таблица остатков:
//   * КонтролируемаяПартия - СправочникСсылка.КонтролируемыеПартии - контролируемая партия
//   * Номенклатура - СправочникСсылка.Номенклатура - номенклатура
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика
//   * Склад - СправочникСсылка.Склады - склад
//   * Назначение - СправочникСсылка.Назначения - назначение
//   * Помещение - СправочникСсылка.СкладскиеПомещения - помещение
//   * Серия - СправочникСсылка.СерииНоменклатуры - серия
//   * Упаковка - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка
//   * Количество - Число - остаток
//   * КоличествоУпаковок - Число - остаток в упаковках
Функция РезультатыИсследованногоТовараВыборочныйКонтроль(ТаблицаДанных, ДокументИсследования) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	Запрос.УстановитьПараметр("Ссылка", ДокументИсследования);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаДанных.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ТаблицаДанных.Номенклатура КАК Номенклатура,
	|	ТаблицаДанных.Характеристика КАК Характеристика,
	|	ТаблицаДанных.Серия КАК Серия,
	|	ТаблицаДанных.Склад КАК Склад,
	|	ТаблицаДанных.Назначение КАК Назначение,
	|	ТаблицаДанных.Помещение КАК Помещение,
	|	ТаблицаДанных.Упаковка КАК Упаковка,
	|	ТаблицаДанных.Количество КАК Количество,
	|	ТаблицаДанных.КоличествоУпаковок КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ОстаткиТоваров
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка КАК Исследование,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Номенклатура КАК Номенклатура,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Характеристика КАК Характеристика,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Серия КАК Серия,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Назначение КАК Назначение,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка.Склад КАК Склад,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка.Контроль КАК Контроль,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Заключение КАК Заключение,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Количество КАК Количество,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоГодное КАК КоличествоГодное,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоРазрушено КАК КоличествоРазрушено,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоНегодное КАК КоличествоНегодное,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоУпаковок КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ИсследованныеТовары
	|ИЗ
	|	Документ.ИсследованиеКачестваТоваров.ПланИРезультатИсследования КАК
	|		ИсследованиеКачестваТоваровПланИРезультатИсследования
	|ГДЕ
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсследованныеТовары.Номенклатура КАК Номенклатура,
	|	ИсследованныеТовары.Характеристика КАК Характеристика,
	|	ИсследованныеТовары.Серия КАК Серия,
	|	ИсследованныеТовары.Назначение КАК Назначение,
	|	ИсследованныеТовары.Склад КАК Склад,
	|	СУММА(ИсследованныеТовары.Количество) КАК Количество,
	|	СУММА(ИсследованныеТовары.КоличествоГодное) КАК КоличествоГодное,
	|	СУММА(ИсследованныеТовары.КоличествоРазрушено) КАК КоличествоРазрушено,
	|	СУММА(ИсследованныеТовары.КоличествоНегодное) КАК КоличествоНегодное,
	|	СУММА(ИсследованныеТовары.КоличествоУпаковок) КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ИсследованныеТоварыВыборочный
	|ИЗ
	|	ИсследованныеТовары КАК ИсследованныеТовары
	|СГРУППИРОВАТЬ ПО
	|	ИсследованныеТовары.Номенклатура,
	|	ИсследованныеТовары.Характеристика,
	|	ИсследованныеТовары.Серия,
	|	ИсследованныеТовары.Назначение,
	|	ИсследованныеТовары.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсследованныеТовары.Номенклатура КАК Номенклатура,
	|	ИсследованныеТовары.Характеристика КАК Характеристика,
	|	ИсследованныеТовары.Серия КАК Серия,
	|	ИсследованныеТовары.Назначение КАК Назначение,
	|	ИсследованныеТовары.Склад КАК Склад,
	|	ИсследованныеТовары.Исследование КАК Исследование,
	|	ИсследованныеТовары.Заключение КАК Заключение
	|ПОМЕСТИТЬ ИсследованныеТоварыЗаключение
	|ИЗ
	|	ИсследованныеТовары КАК ИсследованныеТовары
	|СГРУППИРОВАТЬ ПО
	|	ИсследованныеТовары.Номенклатура,
	|	ИсследованныеТовары.Характеристика,
	|	ИсследованныеТовары.Серия,
	|	ИсследованныеТовары.Назначение,
	|	ИсследованныеТовары.Склад,
	|	ИсследованныеТовары.Исследование,
	|	ИсследованныеТовары.Заключение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиТоваров.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваров.Характеристика КАК Характеристика,
	|	ОстаткиТоваров.Серия КАК Серия,
	|	ОстаткиТоваров.Склад КАК Склад,
	|	ОстаткиТоваров.Назначение КАК Назначение,
	|	ОстаткиТоваров.Помещение КАК Помещение,
	|	ОстаткиТоваров.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.Количество > ИсследованныеТовары.КоличествоРазрушено
	|			ТОГДА ОстаткиТоваров.КоличествоУпаковок - ИсследованныеТовары.КоличествоРазрушено
	|		ИНАЧЕ ОстаткиТоваров.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.КоличествоУпаковок > ИсследованныеТовары.КоличествоРазрушено
	|			ТОГДА ОстаткиТоваров.КоличествоУпаковок - ИсследованныеТовары.КоличествоРазрушено
	|		ИНАЧЕ ОстаткиТоваров.КоличествоУпаковок
	|	КОНЕЦ КАК КоличествоУпаковок,
	|	ЗНАЧЕНИЕ(Перечисление.ДействияПоТоварамВАктеКонтроляКачества.Разблокировать) КАК Действие,
	|	ЗНАЧЕНИЕ(Перечисление.РезультатыПроверкиКачестваТоваров.УдовлетворяетТребованиям) КАК РезультатПроверкиКачества
	|ПОМЕСТИТЬ ИтогиИсследованныеТоварыВыборочный
	|ИЗ
	|	ОстаткиТоваров КАК ОстаткиТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсследованныеТоварыВыборочный КАК ИсследованныеТовары
	|		ПО ОстаткиТоваров.Номенклатура = ИсследованныеТовары.Номенклатура
	|		И ОстаткиТоваров.Характеристика = ИсследованныеТовары.Характеристика
	|		И ОстаткиТоваров.Серия = ИсследованныеТовары.Серия
	|		И ОстаткиТоваров.Назначение = ИсследованныеТовары.Назначение
	|		И ОстаткиТоваров.Склад = ИсследованныеТовары.Склад
	|ГДЕ
	|	ИсследованныеТовары.КоличествоНегодное = 0
	|	И ОстаткиТоваров.Количество > ИсследованныеТовары.КоличествоРазрушено
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиТоваров.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваров.Характеристика КАК Характеристика,
	|	ОстаткиТоваров.Серия КАК Серия,
	|	ОстаткиТоваров.Склад КАК Склад,
	|	ОстаткиТоваров.Назначение КАК Назначение,
	|	ОстаткиТоваров.Помещение КАК Помещение,
	|	ОстаткиТоваров.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.Количество > ИсследованныеТовары.КоличествоРазрушено
	|			ТОГДА ИсследованныеТовары.КоличествоРазрушено
	|		ИНАЧЕ ОстаткиТоваров.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.КоличествоУпаковок > ИсследованныеТовары.КоличествоРазрушено
	|			ТОГДА ИсследованныеТовары.КоличествоРазрушено
	|		ИНАЧЕ ОстаткиТоваров.КоличествоУпаковок
	|	КОНЕЦ КАК КоличествоУпаковок,
	|	ЗНАЧЕНИЕ(Перечисление.ДействияПоТоварамВАктеКонтроляКачества.ОформитьСписание) КАК Действие,
	|	ЗНАЧЕНИЕ(Перечисление.РезультатыПроверкиКачестваТоваров.РазрушеноВПроцессеИсследований) КАК РезультатПроверкиКачества
	|ИЗ
	|	ОстаткиТоваров КАК ОстаткиТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсследованныеТоварыВыборочный КАК ИсследованныеТовары
	|		ПО ОстаткиТоваров.Номенклатура = ИсследованныеТовары.Номенклатура
	|		И ОстаткиТоваров.Характеристика = ИсследованныеТовары.Характеристика
	|		И ОстаткиТоваров.Серия = ИсследованныеТовары.Серия
	|		И ОстаткиТоваров.Назначение = ИсследованныеТовары.Назначение
	|		И ОстаткиТоваров.Склад = ИсследованныеТовары.Склад
	|ГДЕ
	|	ИсследованныеТовары.КоличествоРазрушено <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиТоваров.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваров.Характеристика КАК Характеристика,
	|	ОстаткиТоваров.Серия КАК Серия,
	|	ОстаткиТоваров.Склад КАК Склад,
	|	ОстаткиТоваров.Назначение КАК Назначение,
	|	ОстаткиТоваров.Помещение КАК Помещение,
	|	ОстаткиТоваров.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.Количество > ИсследованныеТовары.КоличествоРазрушено
	|			ТОГДА ОстаткиТоваров.КоличествоУпаковок - ИсследованныеТовары.КоличествоРазрушено
	|		ИНАЧЕ ОстаткиТоваров.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.КоличествоУпаковок > ИсследованныеТовары.КоличествоРазрушено
	|			ТОГДА ОстаткиТоваров.КоличествоУпаковок - ИсследованныеТовары.КоличествоРазрушено
	|		ИНАЧЕ ОстаткиТоваров.КоличествоУпаковок
	|	КОНЕЦ КАК КоличествоУпаковок,
	|	ЗНАЧЕНИЕ(Перечисление.ДействияПоТоварамВАктеКонтроляКачества.ПустаяСсылка) КАК Действие,
	|	ЗНАЧЕНИЕ(Перечисление.РезультатыПроверкиКачестваТоваров.НеУдовлетворяетТребованиям) КАК РезультатПроверкиКачества
	|ИЗ
	|	ОстаткиТоваров КАК ОстаткиТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсследованныеТоварыВыборочный КАК ИсследованныеТовары
	|		ПО ОстаткиТоваров.Номенклатура = ИсследованныеТовары.Номенклатура
	|		И ОстаткиТоваров.Характеристика = ИсследованныеТовары.Характеристика
	|		И ОстаткиТоваров.Серия = ИсследованныеТовары.Серия
	|		И ОстаткиТоваров.Назначение = ИсследованныеТовары.Назначение
	|		И ОстаткиТоваров.Склад = ИсследованныеТовары.Склад
	|ГДЕ
	|	ИсследованныеТовары.КоличествоНегодное <> 0
	|	И ОстаткиТоваров.Количество > ИсследованныеТовары.КоличествоРазрушено
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИтогиИсследованныеТоварыВыборочный.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ИтогиИсследованныеТоварыВыборочный.Номенклатура КАК Номенклатура,
	|	ИтогиИсследованныеТоварыВыборочный.Характеристика КАК Характеристика,
	|	ИтогиИсследованныеТоварыВыборочный.Серия КАК Серия,
	|	ИтогиИсследованныеТоварыВыборочный.Склад КАК Склад,
	|	ИтогиИсследованныеТоварыВыборочный.Назначение КАК Назначение,
	|	ИтогиИсследованныеТоварыВыборочный.Помещение КАК Помещение,
	|	ИтогиИсследованныеТоварыВыборочный.Упаковка КАК Упаковка,
	|	ИтогиИсследованныеТоварыВыборочный.Количество КАК Количество,
	|	ИтогиИсследованныеТоварыВыборочный.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ИтогиИсследованныеТоварыВыборочный.Действие КАК Действие,
	|	ИтогиИсследованныеТоварыВыборочный.РезультатПроверкиКачества КАК РезультатПроверкиКачества,
	|	ИсследованныеТоварыЗаключение.Исследование КАК Исследование,
	|	ИсследованныеТоварыЗаключение.Заключение КАК Заключение
	|ИЗ
	|	ИтогиИсследованныеТоварыВыборочный КАК ИтогиИсследованныеТоварыВыборочный
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИсследованныеТоварыЗаключение КАК ИсследованныеТоварыЗаключение
	|		ПО ИтогиИсследованныеТоварыВыборочный.Номенклатура = ИсследованныеТоварыЗаключение.Номенклатура
	|		И ИтогиИсследованныеТоварыВыборочный.Характеристика = ИсследованныеТоварыЗаключение.Характеристика
	|		И ИтогиИсследованныеТоварыВыборочный.Серия = ИсследованныеТоварыЗаключение.Серия
	|		И ИтогиИсследованныеТоварыВыборочный.Назначение = ИсследованныеТоварыЗаключение.Назначение
	|		И ИтогиИсследованныеТоварыВыборочный.Склад = ИсследованныеТоварыЗаключение.Склад";
	
	Исследования = Запрос.Выполнить().Выгрузить();

	Возврат Исследования;

КонецФункции

// Остатки для заполнения документов ЗаявкаНаКонтрольКачестваТоваров и АктКонтроляКачестваТоваров.
// 
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - таблица аналитик:
//   * КонтролируемаяПартия - СправочникСсылка.КонтролируемыеПартии - контролируемая партия
//   * Номенклатура - СправочникСсылка.Номенклатура - номенклатура
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика
//   * Склад - СправочникСсылка.Склады - склад
//   * Назначение - СправочникСсылка.Назначения - назначение
//   * Помещение - СправочникСсылка.СкладскиеПомещения - помещение
//   * Серия - СправочникСсылка.СерииНоменклатуры - серия
//  ДокументИсследования - ДокументСсылка.ИсследованиеКачестваТоваров - документ исследования.
// Возвращаемое значение:
//  ТаблицаЗначений - таблица остатков:
//   * КонтролируемаяПартия - СправочникСсылка.КонтролируемыеПартии - контролируемая партия
//   * Номенклатура - СправочникСсылка.Номенклатура - номенклатура
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика
//   * Склад - СправочникСсылка.Склады - склад
//   * Назначение - СправочникСсылка.Назначения - назначение
//   * Помещение - СправочникСсылка.СкладскиеПомещения - помещение
//   * Серия - СправочникСсылка.СерииНоменклатуры - серия
//   * Упаковка - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка
//   * Количество - Число - остаток
//   * КоличествоУпаковок - Число - остаток в упаковках
Функция РезультатыИсследованногоТовараСплошнойКонтроль(ТаблицаДанных, ДокументИсследования) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	Запрос.УстановитьПараметр("Ссылка", ДокументИсследования);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаДанных.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ТаблицаДанных.Номенклатура КАК Номенклатура,
	|	ТаблицаДанных.Характеристика КАК Характеристика,
	|	ТаблицаДанных.Серия КАК Серия,
	|	ТаблицаДанных.Склад КАК Склад,
	|	ТаблицаДанных.Назначение КАК Назначение,
	|	ТаблицаДанных.Помещение КАК Помещение,
	|	ТаблицаДанных.Упаковка КАК Упаковка,
	|	ТаблицаДанных.Количество КАК Количество,
	|	ТаблицаДанных.КоличествоУпаковок КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ОстаткиТоваров
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка КАК Исследование,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Номенклатура КАК Номенклатура,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Характеристика КАК Характеристика,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Серия КАК Серия,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Назначение КАК Назначение,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка.Склад КАК Склад,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка.Контроль КАК Контроль,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Заключение КАК Заключение,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Количество КАК Количество,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоГодное КАК КоличествоГодное,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоРазрушено КАК КоличествоРазрушено,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоНегодное КАК КоличествоНегодное,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоУпаковок КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ИсследованныеТовары
	|ИЗ
	|	Документ.ИсследованиеКачестваТоваров.ПланИРезультатИсследования КАК
	|		ИсследованиеКачестваТоваровПланИРезультатИсследования
	|ГДЕ
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсследованныеТовары.Номенклатура КАК Номенклатура,
	|	ИсследованныеТовары.Характеристика КАК Характеристика,
	|	ИсследованныеТовары.Серия КАК Серия,
	|	ИсследованныеТовары.Назначение КАК Назначение,
	|	ИсследованныеТовары.Склад КАК Склад,
	|	СУММА(ИсследованныеТовары.Количество) КАК Количество,
	|	СУММА(ИсследованныеТовары.КоличествоГодное) КАК КоличествоГодное,
	|	СУММА(ИсследованныеТовары.КоличествоРазрушено) КАК КоличествоРазрушено,
	|	СУММА(ИсследованныеТовары.КоличествоНегодное) КАК КоличествоНегодное,
	|	СУММА(ИсследованныеТовары.КоличествоУпаковок) КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ИсследованныеТоварыСплошной
	|ИЗ
	|	ИсследованныеТовары КАК ИсследованныеТовары
	|СГРУППИРОВАТЬ ПО
	|	ИсследованныеТовары.Номенклатура,
	|	ИсследованныеТовары.Характеристика,
	|	ИсследованныеТовары.Серия,
	|	ИсследованныеТовары.Назначение,
	|	ИсследованныеТовары.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсследованныеТовары.Номенклатура КАК Номенклатура,
	|	ИсследованныеТовары.Характеристика КАК Характеристика,
	|	ИсследованныеТовары.Серия КАК Серия,
	|	ИсследованныеТовары.Назначение КАК Назначение,
	|	ИсследованныеТовары.Склад КАК Склад,
	|	ИсследованныеТовары.Исследование КАК Исследование,
	|	ИсследованныеТовары.Заключение КАК Заключение
	|ПОМЕСТИТЬ ИсследованныеТоварыЗаключение
	|ИЗ
	|	ИсследованныеТовары КАК ИсследованныеТовары
	|СГРУППИРОВАТЬ ПО
	|	ИсследованныеТовары.Номенклатура,
	|	ИсследованныеТовары.Характеристика,
	|	ИсследованныеТовары.Серия,
	|	ИсследованныеТовары.Назначение,
	|	ИсследованныеТовары.Склад,
	|	ИсследованныеТовары.Исследование,
	|	ИсследованныеТовары.Заключение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиТоваров.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваров.Характеристика КАК Характеристика,
	|	ОстаткиТоваров.Серия КАК Серия,
	|	ОстаткиТоваров.Склад КАК Склад,
	|	ОстаткиТоваров.Назначение КАК Назначение,
	|	ОстаткиТоваров.Помещение КАК Помещение,
	|	ОстаткиТоваров.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.Количество - ИсследованныеТовары.КоличествоРазрушено -
	|			ИсследованныеТовары.КоличествоГодное >= ИсследованныеТовары.КоличествоНегодное
	|			ТОГДА 
	|				ВЫБОР
	|					КОГДА ИсследованныеТовары.КоличествоНегодное - ИсследованныеТовары.КоличествоРазрушено > 0
	|						ТОГДА ИсследованныеТовары.КоличествоНегодное - ИсследованныеТовары.КоличествоРазрушено
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ОстаткиТоваров.Количество - ИсследованныеТовары.КоличествоРазрушено - ИсследованныеТовары.КоличествоГодное
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.КоличествоУпаковок - ИсследованныеТовары.КоличествоРазрушено -
	|			ИсследованныеТовары.КоличествоГодное >= ИсследованныеТовары.КоличествоНегодное
	|			ТОГДА 
	|				ВЫБОР
	|					КОГДА ИсследованныеТовары.КоличествоНегодное - ИсследованныеТовары.КоличествоРазрушено > 0
	|						ТОГДА ИсследованныеТовары.КоличествоНегодное - ИсследованныеТовары.КоличествоРазрушено
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ОстаткиТоваров.КоличествоУпаковок - ИсследованныеТовары.КоличествоРазрушено -
	|			ИсследованныеТовары.КоличествоГодное
	|	КОНЕЦ КАК КоличествоУпаковок,
	|	ЗНАЧЕНИЕ(Перечисление.ДействияПоТоварамВАктеКонтроляКачества.ПустаяСсылка) КАК Действие,
	|	ЗНАЧЕНИЕ(Перечисление.РезультатыПроверкиКачестваТоваров.НеУдовлетворяетТребованиям) КАК РезультатПроверкиКачества
	|ПОМЕСТИТЬ ИтогиИсследованныеТоварыСплошной
	|ИЗ
	|	ОстаткиТоваров КАК ОстаткиТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсследованныеТоварыСплошной КАК ИсследованныеТовары
	|		ПО ОстаткиТоваров.Номенклатура = ИсследованныеТовары.Номенклатура
	|		И ОстаткиТоваров.Характеристика = ИсследованныеТовары.Характеристика
	|		И ОстаткиТоваров.Серия = ИсследованныеТовары.Серия
	|		И ОстаткиТоваров.Назначение = ИсследованныеТовары.Назначение
	|		И ОстаткиТоваров.Склад = ИсследованныеТовары.Склад
	|ГДЕ
	|	ИсследованныеТовары.КоличествоНегодное <> 0
	|	И ОстаткиТоваров.Количество - ИсследованныеТовары.КоличествоРазрушено - ИсследованныеТовары.КоличествоГодное > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиТоваров.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваров.Характеристика КАК Характеристика,
	|	ОстаткиТоваров.Серия КАК Серия,
	|	ОстаткиТоваров.Склад КАК Склад,
	|	ОстаткиТоваров.Назначение КАК Назначение,
	|	ОстаткиТоваров.Помещение КАК Помещение,
	|	ОстаткиТоваров.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.Количество > ИсследованныеТовары.КоличествоРазрушено
	|			ТОГДА ИсследованныеТовары.КоличествоРазрушено
	|		ИНАЧЕ ОстаткиТоваров.Количество
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.КоличествоУпаковок > ИсследованныеТовары.КоличествоРазрушено
	|			ТОГДА ИсследованныеТовары.КоличествоРазрушено
	|		ИНАЧЕ ОстаткиТоваров.КоличествоУпаковок
	|	КОНЕЦ КАК КоличествоУпаковок,
	|	ЗНАЧЕНИЕ(Перечисление.ДействияПоТоварамВАктеКонтроляКачества.ОформитьСписание) КАК Действие,
	|	ЗНАЧЕНИЕ(Перечисление.РезультатыПроверкиКачестваТоваров.РазрушеноВПроцессеИсследований) КАК РезультатПроверкиКачества
	|ИЗ
	|	ОстаткиТоваров КАК ОстаткиТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсследованныеТоварыСплошной КАК ИсследованныеТовары
	|		ПО ОстаткиТоваров.Номенклатура = ИсследованныеТовары.Номенклатура
	|		И ОстаткиТоваров.Характеристика = ИсследованныеТовары.Характеристика
	|		И ОстаткиТоваров.Серия = ИсследованныеТовары.Серия
	|		И ОстаткиТоваров.Назначение = ИсследованныеТовары.Назначение
	|		И ОстаткиТоваров.Склад = ИсследованныеТовары.Склад
	|ГДЕ
	|	ИсследованныеТовары.КоличествоРазрушено <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиТоваров.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ОстаткиТоваров.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваров.Характеристика КАК Характеристика,
	|	ОстаткиТоваров.Серия КАК Серия,
	|	ОстаткиТоваров.Склад КАК Склад,
	|	ОстаткиТоваров.Назначение КАК Назначение,
	|	ОстаткиТоваров.Помещение КАК Помещение,
	|	ОстаткиТоваров.Упаковка КАК Упаковка,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.Количество - ИсследованныеТовары.КоличествоРазрушено >= ИсследованныеТовары.КоличествоГодное
	|			ТОГДА ИсследованныеТовары.КоличествоГодное
	|		ИНАЧЕ ОстаткиТоваров.Количество - ИсследованныеТовары.КоличествоРазрушено
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА ОстаткиТоваров.КоличествоУпаковок -
	|			ИсследованныеТовары.КоличествоРазрушено >= ИсследованныеТовары.КоличествоГодное
	|			ТОГДА ИсследованныеТовары.КоличествоГодное
	|		ИНАЧЕ ОстаткиТоваров.КоличествоУпаковок - ИсследованныеТовары.КоличествоРазрушено
	|	КОНЕЦ КАК КоличествоУпаковок,
	|	ЗНАЧЕНИЕ(Перечисление.ДействияПоТоварамВАктеКонтроляКачества.Разблокировать) КАК Действие,
	|	ЗНАЧЕНИЕ(Перечисление.РезультатыПроверкиКачестваТоваров.УдовлетворяетТребованиям) КАК РезультатПроверкиКачества
	|ИЗ
	|	ОстаткиТоваров КАК ОстаткиТоваров
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсследованныеТоварыСплошной КАК ИсследованныеТовары
	|		ПО ОстаткиТоваров.Номенклатура = ИсследованныеТовары.Номенклатура
	|		И ОстаткиТоваров.Характеристика = ИсследованныеТовары.Характеристика
	|		И ОстаткиТоваров.Серия = ИсследованныеТовары.Серия
	|		И ОстаткиТоваров.Назначение = ИсследованныеТовары.Назначение
	|		И ОстаткиТоваров.Склад = ИсследованныеТовары.Склад
	|ГДЕ
	|	ИсследованныеТовары.КоличествоГодное <> 0
	|	И ОстаткиТоваров.Количество - ИсследованныеТовары.КоличествоРазрушено > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИтогиИсследованныеТоварыСплошной.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ИтогиИсследованныеТоварыСплошной.Номенклатура КАК Номенклатура,
	|	ИтогиИсследованныеТоварыСплошной.Характеристика КАК Характеристика,
	|	ИтогиИсследованныеТоварыСплошной.Серия КАК Серия,
	|	ИтогиИсследованныеТоварыСплошной.Склад КАК Склад,
	|	ИтогиИсследованныеТоварыСплошной.Назначение КАК Назначение,
	|	ИтогиИсследованныеТоварыСплошной.Помещение КАК Помещение,
	|	ИтогиИсследованныеТоварыСплошной.Упаковка КАК Упаковка,
	|	ИтогиИсследованныеТоварыСплошной.Количество КАК Количество,
	|	ИтогиИсследованныеТоварыСплошной.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ИтогиИсследованныеТоварыСплошной.Действие КАК Действие,
	|	ИтогиИсследованныеТоварыСплошной.РезультатПроверкиКачества КАК РезультатПроверкиКачества,
	|	ИсследованныеТоварыЗаключение.Исследование КАК Исследование,
	|	ИсследованныеТоварыЗаключение.Заключение КАК Заключение
	|ИЗ
	|	ИтогиИсследованныеТоварыСплошной КАК ИтогиИсследованныеТоварыСплошной
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИсследованныеТоварыЗаключение КАК ИсследованныеТоварыЗаключение
	|		ПО ИтогиИсследованныеТоварыСплошной.Номенклатура = ИсследованныеТоварыЗаключение.Номенклатура
	|		И ИтогиИсследованныеТоварыСплошной.Характеристика = ИсследованныеТоварыЗаключение.Характеристика
	|		И ИтогиИсследованныеТоварыСплошной.Серия = ИсследованныеТоварыЗаключение.Серия
	|		И ИтогиИсследованныеТоварыСплошной.Назначение = ИсследованныеТоварыЗаключение.Назначение
	|		И ИтогиИсследованныеТоварыСплошной.Склад = ИсследованныеТоварыЗаключение.Склад
	|ГДЕ
	|	ИтогиИсследованныеТоварыСплошной.Количество <> 0";
	
	Исследования = Запрос.Выполнить().Выгрузить();

	Возврат Исследования;

КонецФункции

// Остатки для заполнения документов ЗаявкаНаКонтрольКачестваТоваров и АктКонтроляКачестваТоваров.
// 
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - таблица аналитик:
//   * КонтролируемаяПартия - СправочникСсылка.КонтролируемыеПартии - контролируемая партия
//   * Номенклатура - СправочникСсылка.Номенклатура - номенклатура
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика
//   * Склад - СправочникСсылка.Склады - склад
//   * Назначение - СправочникСсылка.Назначения - назначение
//   * Помещение - СправочникСсылка.СкладскиеПомещения - помещение
//   * Серия - СправочникСсылка.СерииНоменклатуры - серия
//  ПоДокументамИсследования - Массив Из ДокументСсылка.ИсследованиеКачестваТоваров - документы исследования.
// Возвращаемое значение:
//  ТаблицаЗначений - таблица остатков:
//   * КонтролируемаяПартия - СправочникСсылка.КонтролируемыеПартии - контролируемая партия
//   * Номенклатура - СправочникСсылка.Номенклатура - номенклатура
//   * Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры - характеристика
//   * Склад - СправочникСсылка.Склады - склад
//   * Назначение - СправочникСсылка.Назначения - назначение
//   * Помещение - СправочникСсылка.СкладскиеПомещения - помещение
//   * Серия - СправочникСсылка.СерииНоменклатуры - серия
//   * Упаковка - СправочникСсылка.УпаковкиЕдиницыИзмерения - упаковка
//   * Количество - Число - остаток
//   * КоличествоУпаковок - Число - остаток в упаковках
Функция РезультатыИсследованногоТовараПоЗаявкеНаКонтроль(ТаблицаДанных, ПоДокументамИсследования) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	Запрос.УстановитьПараметр("Ссылки", ПоДокументамИсследования);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаДанных.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ТаблицаДанных.Номенклатура КАК Номенклатура,
	|	ТаблицаДанных.Характеристика КАК Характеристика,
	|	ТаблицаДанных.Серия КАК Серия,
	|	ТаблицаДанных.Склад КАК Склад,
	|	ТаблицаДанных.Назначение КАК Назначение,
	|	ТаблицаДанных.Помещение КАК Помещение,
	|	ТаблицаДанных.Упаковка КАК Упаковка,
	|	ТаблицаДанных.Количество КАК Количество,
	|	ТаблицаДанных.КоличествоУпаковок КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ОстаткиТоваровПоПартии
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка КАК Исследование,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Номенклатура КАК Номенклатура,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Характеристика КАК Характеристика,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Серия КАК Серия,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Назначение КАК Назначение,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка.Склад КАК Склад,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка.Контроль КАК Контроль,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Заключение КАК Заключение,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Количество КАК Количество,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоГодное КАК КоличествоГодное,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоРазрушено КАК КоличествоРазрушено,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоНегодное КАК КоличествоНегодное,
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.КоличествоУпаковок КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ИсследованныеТовары
	|ИЗ
	|	Документ.ИсследованиеКачестваТоваров.ПланИРезультатИсследования КАК
	|		ИсследованиеКачестваТоваровПланИРезультатИсследования
	|ГДЕ
	|	ИсследованиеКачестваТоваровПланИРезультатИсследования.Ссылка В (&Ссылки)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсследованныеТовары.Номенклатура КАК Номенклатура,
	|	ИсследованныеТовары.Характеристика КАК Характеристика,
	|	ИсследованныеТовары.Серия КАК Серия,
	|	ИсследованныеТовары.Назначение КАК Назначение,
	|	ИсследованныеТовары.Склад КАК Склад,
	|	СУММА(ИсследованныеТовары.Количество) КАК Количество,
	|	СУММА(ИсследованныеТовары.КоличествоГодное) КАК КоличествоГодное,
	|	СУММА(ИсследованныеТовары.КоличествоРазрушено) КАК КоличествоРазрушено,
	|	СУММА(ИсследованныеТовары.КоличествоНегодное) КАК КоличествоНегодное,
	|	СУММА(ИсследованныеТовары.КоличествоУпаковок) КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ИсследованныеТоварыВыборочный
	|ИЗ
	|	ИсследованныеТовары КАК ИсследованныеТовары
	|ГДЕ
	|	ИсследованныеТовары.Контроль = ЗНАЧЕНИЕ(Перечисление.КонтрольКачества.Выборочный)
	|СГРУППИРОВАТЬ ПО
	|	ИсследованныеТовары.Номенклатура,
	|	ИсследованныеТовары.Характеристика,
	|	ИсследованныеТовары.Серия,
	|	ИсследованныеТовары.Назначение,
	|	ИсследованныеТовары.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсследованныеТовары.Номенклатура КАК Номенклатура,
	|	ИсследованныеТовары.Характеристика КАК Характеристика,
	|	ИсследованныеТовары.Серия КАК Серия,
	|	ИсследованныеТовары.Назначение КАК Назначение,
	|	ИсследованныеТовары.Склад КАК Склад,
	|	СУММА(ИсследованныеТовары.Количество) КАК Количество,
	|	СУММА(ИсследованныеТовары.КоличествоГодное) КАК КоличествоГодное,
	|	СУММА(ИсследованныеТовары.КоличествоРазрушено) КАК КоличествоРазрушено,
	|	СУММА(ИсследованныеТовары.КоличествоНегодное) КАК КоличествоНегодное,
	|	СУММА(ИсследованныеТовары.КоличествоУпаковок) КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ИсследованныеТоварыСплошной
	|ИЗ
	|	ИсследованныеТовары КАК ИсследованныеТовары
	|ГДЕ
	|	ИсследованныеТовары.Контроль = ЗНАЧЕНИЕ(Перечисление.КонтрольКачества.Сплошной)
	|СГРУППИРОВАТЬ ПО
	|	ИсследованныеТовары.Номенклатура,
	|	ИсследованныеТовары.Характеристика,
	|	ИсследованныеТовары.Серия,
	|	ИсследованныеТовары.Назначение,
	|	ИсследованныеТовары.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсследованныеТовары.Номенклатура КАК Номенклатура,
	|	ИсследованныеТовары.Характеристика КАК Характеристика,
	|	ИсследованныеТовары.Серия КАК Серия,
	|	ИсследованныеТовары.Назначение КАК Назначение,
	|	ИсследованныеТовары.Склад КАК Склад
	|ПОМЕСТИТЬ ИсследованныеПозиции
	|ИЗ
	|	ИсследованныеТовары КАК ИсследованныеТовары
	|СГРУППИРОВАТЬ ПО
	|	ИсследованныеТовары.Номенклатура,
	|	ИсследованныеТовары.Характеристика,
	|	ИсследованныеТовары.Серия,
	|	ИсследованныеТовары.Назначение,
	|	ИсследованныеТовары.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиТоваровПоПартии.КонтролируемаяПартия КАК КонтролируемаяПартия,
	|	ОстаткиТоваровПоПартии.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваровПоПартии.Характеристика КАК Характеристика,
	|	ОстаткиТоваровПоПартии.Серия КАК Серия,
	|	ОстаткиТоваровПоПартии.Склад КАК Склад,
	|	ОстаткиТоваровПоПартии.Назначение КАК Назначение,
	|	ОстаткиТоваровПоПартии.Помещение КАК Помещение,
	|	ОстаткиТоваровПоПартии.Упаковка КАК Упаковка,
	|	ОстаткиТоваровПоПартии.Количество КАК Количество,
	|	ОстаткиТоваровПоПартии.КоличествоУпаковок КАК КоличествоУпаковок
	|ПОМЕСТИТЬ ОстаткиТоваров
	|ИЗ
	|	ОстаткиТоваровПоПартии КАК ОстаткиТоваровПоПартии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсследованныеПозиции КАК ИсследованныеПозиции
	|		ПО ОстаткиТоваровПоПартии.Номенклатура = ИсследованныеПозиции.Номенклатура
	|		И ОстаткиТоваровПоПартии.Характеристика = ИсследованныеПозиции.Характеристика
