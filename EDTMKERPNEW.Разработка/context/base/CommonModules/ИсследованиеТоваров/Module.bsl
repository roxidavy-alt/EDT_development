// Возвращает список видов проверок соответствующий переданному тексту
// 
// Параметры:
//	ВидПроверки - Строка - Текст для поиска подходящих видов проверок
//	
// Возвращаемое значение:
// 	СписокЗначений из Строка - Список видов проверок
Функция ВидПроверкиПолучитьСписокВыбораАвтоПодбор(ВидПроверки) Экспорт
	
	СписокВыбора = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 7
	|	КартыИсследованияТоваров.ВидПроверки КАК ВидПроверки,
	|	КартыИсследованияТоваров.Ссылка.Дата КАК Дата
	|ИЗ
	|	Справочник.КартыИсследованияТоваров.Проверки КАК КартыИсследованияТоваров
	|ГДЕ
	|	КартыИсследованияТоваров.ВидПроверки ПОДОБНО &ВидПроверки
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";

	Запрос.УстановитьПараметр("ВидПроверки", "%" + ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(ВидПроверки) + "%");
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(Выборка.ВидПроверки);
	КонецЦикла;

	Возврат СписокВыбора;
	
КонецФункции


// Возвращает параметры выбора назначения исследований.
//
// Возвращаемое значение:
// 	Структура - из:
//  * СвязиПараметровВыбора - Соответствие Из КлючИЗначение:
//	 ** Ключ - Строка - Вид настройки для которого необходимо получить ключ связи.
//	 ** Значение - Строка - Уникальный идентификатор.
//  * РеквизитыКартыИсследованияТоваров - Строка - список реквизитов КартыИсследованияТоваров
Функция ПараметрыВыбораНазначенияИсследований() Экспорт
	
	ПараметрыВыбора = ИсследованиеТоваровКлиентСервер.ПараметрыВыбораНазначенияИсследованийКонструктор();
	
	Возврат ПараметрыВыбора;
	
КонецФункции

