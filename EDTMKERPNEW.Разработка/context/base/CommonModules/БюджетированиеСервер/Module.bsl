#Область ОбработчикиСобытий

Процедура ЭкземплярБюджетаПрисоединенныеФайлыПередЗаписьюПередЗаписью(Источник, Отказ) Экспорт
	
	Если ЗначениеЗаполнено(Источник.ТипСлужебногоФайла)
		И ЗначениеЗаполнено(Источник.Редактирует) Тогда
		
		ТекстОшибки = НСтр("ru = 'Файл является служебным
									|Редактирование файла запрещено';
									|en = 'This file is for technical use
									|Editing is prohibited'");
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура ВыполнитьОтражениеДокументовПланированияВБюджетировании(Задания, ИдентификаторыНеобработанныхЗаписей,
	ДополнительныеСвойства = Неопределено) Экспорт
	
	ДокументыКОбработке = Задания.ВыгрузитьКолонку("Документ");
	Если ДокументыКОбработке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеЗамера = ОценкаПроизводительности.НачатьЗамерДлительнойОперации("ОбщийМодуль.БюджетированиеСервер.ВыполнитьОтражениеДокументовПланированияВБюджетировании");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументыКОбработке", ДокументыКОбработке);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	План.Ссылка КАК Регистратор,
	|	План.Дата КАК Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИсточниковПолученияДанныхДляБюджетирования.ПланыВнутреннихПотреблений) КАК ТипИсточника
	|ПОМЕСТИТЬ ДокументыКОбработкеПоТипуИсточника
	|ИЗ
	|	Документ.ПланВнутреннихПотреблений КАК План
	|ГДЕ
	|	План.Ссылка В(&ДокументыКОбработке)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	План.Ссылка,
	|	План.Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИсточниковПолученияДанныхДляБюджетирования.ПланыЗакупок)
	|ИЗ
	|	Документ.ПланЗакупок КАК План
	|ГДЕ
	|	План.Ссылка В(&ДокументыКОбработке)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	План.Ссылка,
	|	План.Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИсточниковПолученияДанныхДляБюджетирования.ПланыОплатПоставщикам)
	|ИЗ
	|	Документ.ПланЗакупок КАК План
	|ГДЕ
	|	План.Ссылка В(&ДокументыКОбработке)
	|	И ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				Документ.ПланЗакупок.ПланОплаты КАК ПланОплаты
	|			ГДЕ
	|				План.Ссылка = ПланОплаты.Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	План.Ссылка,
	|	План.Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИсточниковПолученияДанныхДляБюджетирования.ПланыОстатков)
	|ИЗ
	|	Документ.ПланОстатков КАК План
	|ГДЕ
	|	План.Ссылка В(&ДокументыКОбработке)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	План.Ссылка,
	|	План.Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИсточниковПолученияДанныхДляБюджетирования.ПланыПродаж)
	|ИЗ
	|	Документ.ПланПродаж КАК План
	|ГДЕ
	|	План.Ссылка В(&ДокументыКОбработке)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	План.Ссылка,
	|	План.Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИсточниковПолученияДанныхДляБюджетирования.ПланыОплатКлиентов)
	|ИЗ
	|	Документ.ПланПродаж КАК План
	|ГДЕ
	|	План.Ссылка В(&ДокументыКОбработке)
	|	И ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				Документ.ПланПродаж.ПланОплаты КАК ПланОплаты
	|			ГДЕ
	|				План.Ссылка = ПланОплаты.Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	План.Ссылка,
	|	План.Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИсточниковПолученияДанныхДляБюджетирования.ПланыПродажПоКатегориям)
	|ИЗ
	|	Документ.ПланПродажПоКатегориям КАК План
	|ГДЕ
	|	План.Ссылка В(&ДокументыКОбработке)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	План.Ссылка,
	|	План.Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИсточниковПолученияДанныхДляБюджетирования.ПланыПроизводства)
	|ИЗ
	|	Документ.ПланПроизводства КАК План
	|ГДЕ
	|	План.Ссылка В(&ДокументыКОбработке)
	|	И Не План.Сценарий.ИспользоватьДляПланированияМатериалов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	План.Ссылка,
	|	План.Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИсточниковПолученияДанныхДляБюджетирования.ПланыПроизводства)
	|ИЗ
	|	Документ.РегистраторПланаПроизводства КАК План
	|ГДЕ
	|	План.Ссылка В(&ДокументыКОбработке)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	План.Ссылка,
	|	План.Дата,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИсточниковПолученияДанныхДляБюджетирования.ПланыСборкиРазборки)
	|ИЗ
	|	Документ.ПланСборкиРазборки КАК План
	|ГДЕ
	|	План.Ссылка В(&ДокументыКОбработке)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокументыКОбработкеПоТипуИсточника.ТипИсточника КАК ТипИсточника
	|ПОМЕСТИТЬ ТипыИсточниковПоДокументам
	|ИЗ
	|	ДокументыКОбработкеПоТипуИсточника КАК ДокументыКОбработкеПоТипуИсточника
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов.Ссылка КАК ПравилоРасчета
	|ИЗ
	|	Справочник.ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов КАК ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов
	|ГДЕ
	|	ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПравилБюджетирования.Действует)
	|	И ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов.ОтражатьРасчетВДокументахПланирования
	|	И ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов.ТипИсточника В
	|			(ВЫБРАТЬ
	|				ТипыИсточниковПоДокументам.ТипИсточника
	|			ИЗ
	|				ТипыИсточниковПоДокументам КАК ТипыИсточниковПоДокументам)
	|	И НЕ ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов.ПометкаУдаления";
	Результаты = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	ДанныеДокументов = Результаты[0].Выгрузить();
	ДанныеДокументов.Индексы.Добавить("ТипИсточника");
	ДанныеДокументов.Индексы.Добавить("Регистратор");
	ТипыИсточников = Результаты[1].Выгрузить();
	ПравилаРасчета = Результаты[2].Выгрузить();
	
	Если ПравилаРасчета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросПоПравиламРасчета = СформироватьЗапросКИсточникуДанныхПоПравиламРасчета(ПравилаРасчета.ВыгрузитьКолонку("ПравилоРасчета"), "План");
	Для Каждого СтрокаТипИсточника Из ТипыИсточников Цикл
		СтруктураОтбора = Новый Структура("ТипИсточника", СтрокаТипИсточника.ТипИсточника);
		ЗапросПоПравиламРасчета.ПараметрыЗапроса.Вставить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"Регистраторы_%1", ОбщегоНазначения.ИмяЗначенияПеречисления(СтрокаТипИсточника.ТипИсточника)),
			ДанныеДокументов.Скопировать(СтруктураОтбора).ВыгрузитьКолонку("Регистратор"));
	КонецЦикла;
	
	ТекстыЗапросов = Новый Массив;
	Если Не ПустаяСтрока(ЗапросПоПравиламРасчета.ТекстЗапросаВТ) Тогда
		Пока Истина Цикл
			ПозицияНачалоУсловия = СтрНайти(ЗапросПоПравиламРасчета.ТекстЗапросаВТ, "&УсловияПоТаблицеИсточникаИПоляКомпановки");
			Если ПозицияНачалоУсловия = 0 Тогда
				Прервать;
			КонецЕсли;
			ПозицияОкончаниеУсловия = СтрНайти(ЗапросПоПравиламРасчета.ТекстЗапросаВТ, ")", , ПозицияНачалоУсловия);
			ДлинаУсловия = ПозицияОкончаниеУсловия - ПозицияНачалоУсловия;
			ЗапросПоПравиламРасчета.ТекстЗапросаВТ = СтрЗаменить(ЗапросПоПравиламРасчета.ТекстЗапросаВТ, Сред(
				ЗапросПоПравиламРасчета.ТекстЗапросаВТ, ПозицияНачалоУсловия, ДлинаУсловия), "ИСТИНА")
		КонецЦикла;
		ТекстыЗапросов.Добавить(ЗапросПоПравиламРасчета.ТекстЗапросаВТ);
	КонецЕсли;
	ПозицияИндексироватьПо = СтрНайти(ЗапросПоПравиламРасчета.ТекстЗапроса, "ИНДЕКСИРОВАТЬ ПО"); // @query-part
	ЗапросПоПравиламРасчета.ТекстЗапроса = СтрЗаменить(Лев(ЗапросПоПравиламРасчета.ТекстЗапроса,
		ПозицияИндексироватьПо - 1), "ПОМЕСТИТЬ Данные", ""); // @query-part
	Пока Истина Цикл
		ПозицияНачалоУсловия = СтрНайти(ЗапросПоПравиламРасчета.ТекстЗапроса, "&УсловияПоТаблицеИсточникаИПоляКомпановки");
		Если ПозицияНачалоУсловия = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияОкончаниеУсловия = СтрНайти(ЗапросПоПравиламРасчета.ТекстЗапроса, ")", , ПозицияНачалоУсловия);
		ДлинаУсловия = ПозицияОкончаниеУсловия - ПозицияНачалоУсловия;
		ЗапросПоПравиламРасчета.ТекстЗапроса = СтрЗаменить(ЗапросПоПравиламРасчета.ТекстЗапроса,
			Сред(ЗапросПоПравиламРасчета.ТекстЗапроса, ПозицияНачалоУсловия, ДлинаУсловия), "ИСТИНА")
	КонецЦикла;
	ТекстыЗапросов.Добавить(ЗапросПоПравиламРасчета.ТекстЗапроса);
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	Запрос.УстановитьПараметр("Регистраторы", ДокументыКОбработке);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Запрос.Параметры, ЗапросПоПравиламРасчета.ПараметрыЗапроса);
	ТаблицаНаборовКЗаписи = Запрос.Выполнить().Выгрузить();
	ТаблицаНаборовКЗаписи.Колонки.Добавить("Период", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	ТаблицаНаборовКЗаписи.Индексы.Добавить("Регистратор");
	КолонкиРесурсов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
		"Количество, СуммаСценария, СуммаУпр, СуммаРегл, СуммаВВалюте", ",", , Истина);
	Для Каждого КолонкаРесурса Из КолонкиРесурсов Цикл
		ТаблицаНаборовКЗаписи.Колонки[СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1Оборот",
			КолонкаРесурса)].Имя = КолонкаРесурса;
	КонецЦикла;
	
	Задания.Сортировать("ДатаЗаписи");
	
	СтруктураПоискаДокумента = Новый Структура("Документ");
	
	ОбработанныеДокументы = Новый Массив;
	ИдентификаторНеобработаннойЗаписи = Неопределено;
	
	КоличествоОбработанныхЗаписей = 0;
	
	Для Каждого СтрокаЗадание Из Задания Цикл
		
		Если ОбработанныеДокументы.Найти(СтрокаЗадание.Документ) <> Неопределено Тогда
			КоличествоОбработанныхЗаписей = КоличествоОбработанныхЗаписей + 1;
			Продолжить;
		КонецЕсли;
		
		ТекущийДокумент = СтрокаЗадание.Документ;
		//++ НЕ УТКА
		Если ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.РегистраторПланаПроизводства") Тогда
			ТекущийДокумент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийДокумент, "ПланПроизводства");
		КонецЕсли;
		//-- НЕ УТКА
		ИдентификаторНеобработаннойЗаписи = СтрокаЗадание.ИдентификаторЗаписи;
		
		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗаданияКОтражениюДокументовПланированияВБюджетировании");
			ЭлементБлокировки.УстановитьЗначение("ИдентификаторЗаписи", ИдентификаторНеобработаннойЗаписи);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОборотыБюджетов.НаборЗаписей");
			ЭлементБлокировки.УстановитьЗначение("Регистратор", ТекущийДокумент);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			НаборЗаписей = РегистрыНакопления.ОборотыБюджетов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(ТекущийДокумент);
			
			СтруктураОтбора = Новый Структура("Регистратор", СтрокаЗадание.Документ);
			ТаблицаНабораКЗаписи = ТаблицаНаборовКЗаписи.Скопировать(СтруктураОтбора);
			ТаблицаНабораКЗаписи.ЗаполнитьЗначения(ДанныеДокументов.Найти(СтрокаЗадание.Документ, "Регистратор").Дата, "Период");
			НаборЗаписей.Загрузить(ТаблицаНабораКЗаписи);
			НаборЗаписей.Записать();
			
			КоличествоОбработанныхЗаписей = КоличествоОбработанныхЗаписей + НаборЗаписей.Количество();
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
		
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			Если ИдентификаторНеобработаннойЗаписи <> Неопределено Тогда
				ТекстОшибки = ОтложенныеЗадания.ТекстОшибкиВыполнения(СтруктураПоискаДокумента, СтрокаЗадание, ТекстОшибки);
			КонецЕсли;
			ИдентификаторыНеобработанныхЗаписей.Вставить(ИдентификаторНеобработаннойЗаписи, ТекстОшибки);
			
			ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, КоличествоОбработанныхЗаписей);
			
		КонецПопытки;
		
	КонецЦикла;
	
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ОписаниеЗамера, КоличествоОбработанныхЗаписей);
	
КонецПроцедуры

//++ НЕ УТКА
Процедура СформироватьСвязанныеОборотыБюджетов(Задания, ИдентификаторыНеобработанныхЗаписей,
	ДополнительныеСвойства = Неопределено) Экспорт
	
	ДокументыКОбработке = Задания.ВыгрузитьКолонку("Объект");
	Если ДокументыКОбработке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументыКОбработке", ДокументыКОбработке);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭкземплярБюджета.Ссылка КАК Объект,
	|	ЭкземплярБюджета.Дата КАК Дата,
	|	ЭкземплярБюджета.Организация КАК Организация,
	|	ЭкземплярБюджета.Подразделение КАК Подразделение,
	|	ЭкземплярБюджета.Сценарий КАК Сценарий,
	|	ЭкземплярБюджета.Статус КАК Статус,
	|	ЭкземплярБюджета.НачалоПериода КАК НачалоПериода,
	|	ЭкземплярБюджета.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ЭкземплярБюджета.ВидБюджета.Периодичность КАК Периодичность
	|ПОМЕСТИТЬ ЭкземплярыБюджетов
	|ИЗ
	|	Документ.ЭкземплярБюджета КАК ЭкземплярБюджета
	|ГДЕ
	|	ЭкземплярБюджета.Ссылка В(&ДокументыКОбработке)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОборотыБюджетов.Регистратор КАК Объект,
	|	ПравилаРасчета.Ссылка КАК ПравилоРасчета
	|ПОМЕСТИТЬ ПравилаРасчета
	|ИЗ
	|	РегистрНакопления.ОборотыБюджетов КАК ОборотыБюджетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов КАК ПравилаРасчета
	|		ПО ОборотыБюджетов.СтатьяБюджетов = ПравилаРасчета.Источник
	|ГДЕ
	|	ОборотыБюджетов.Регистратор В(&ДокументыКОбработке)
	|	И ПравилаРасчета.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПравилБюджетирования.Действует)
	|	И НЕ ПравилаРасчета.ПометкаУдаления
	|	И НЕ ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					Справочник.ПоказателиБюджетов КАК ПоказателиБюджетов
	|				ГДЕ
	|					ПоказателиБюджетов.Ссылка = ПравилаРасчета.Приемник
	|					И ПоказателиБюджетов.ТипПоказателя = ЗНАЧЕНИЕ(Перечисление.ТипПоказателяБюджетов.Расчетный))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭкземплярыБюджетов.Объект КАК Объект,
	|	ЭкземплярыБюджетов.Дата КАК Дата,
	|	ЭкземплярыБюджетов.Организация КАК Организация,
	|	ЭкземплярыБюджетов.Подразделение КАК Подразделение,
	|	ЭкземплярыБюджетов.Сценарий КАК Сценарий,
	|	ЭкземплярыБюджетов.Статус КАК Статус,
	|	ЭкземплярыБюджетов.НачалоПериода КАК НачалоПериода,
	|	ЭкземплярыБюджетов.ОкончаниеПериода КАК ОкончаниеПериода,
	|	ЭкземплярыБюджетов.Периодичность КАК Периодичность,
	|	ПравилаРасчета.ПравилоРасчета КАК ПравилоРасчета
	|ИЗ
	|	ЭкземплярыБюджетов КАК ЭкземплярыБюджетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПравилаРасчета КАК ПравилаРасчета
	|		ПО ЭкземплярыБюджетов.Объект = ПравилаРасчета.Объект
	|ИТОГИ
	|	МАКСИМУМ(Дата),
	|	МАКСИМУМ(Организация),
	|	МАКСИМУМ(Подразделение),
	|	МАКСИМУМ(Сценарий),
	|	МАКСИМУМ(Статус),
	|	МАКСИМУМ(НачалоПериода),
	|	МАКСИМУМ(ОкончаниеПериода),
	|	МАКСИМУМ(Периодичность)
	|ПО
	|	Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РегистраторОборотовБюджетов.Ссылка КАК ДокументРегистратор,
	|	РегистраторОборотовБюджетов.ДокументОснование КАК Объект,
	|	РегистраторОборотовБюджетов.ПериодПланирования КАК ПериодПланирования,
	|	РегистраторОборотовБюджетов.ПравилоРасчета КАК ПравилоРасчета,
	|	ЛОЖЬ КАК Пометка
	|ИЗ
	|	Документ.РегистраторОборотовБюджетов КАК РегистраторОборотовБюджетов
	|ГДЕ
	|	РегистраторОборотовБюджетов.ДокументОснование В(&ДокументыКОбработке)
	|	И НЕ РегистраторОборотовБюджетов.ПометкаУдаления";
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ДанныеПоДокументам = Результаты[2].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	СформированныеДокументы = Результаты[3].Выгрузить();
	
	Задания.Сортировать("ДатаЗаписи");
	
	СтруктураПоискаДокумента = Новый Структура("Объект");
	
	ОбработанныеДокументы = Новый Массив;
	ИдентификаторНеобработаннойЗаписи = Неопределено;
	
	Для Каждого СтрокаЗадание Из Задания Цикл
		
		Если ОбработанныеДокументы.Найти(СтрокаЗадание.Объект) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущийДокумент = СтрокаЗадание.Объект;
		ИдентификаторНеобработаннойЗаписи = СтрокаЗадание.ИдентификаторЗаписи;
		СтруктураПоискаДокумента.Объект = ТекущийДокумент;
		
		СтрокаДокумент = ДанныеПоДокументам.Строки.НайтиСтроки(СтруктураПоискаДокумента);
		Если СтрокаДокумент.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПериодыБюджета = БюджетнаяОтчетностьВыводСервер.ПериодыБюджетногоОтчета(СтрокаДокумент[0].НачалоПериода,
			СтрокаДокумент[0].ОкончаниеПериода, СтрокаДокумент[0].Периодичность);
		
		ДокументыРегистраторы = СформированныеДокументы.Скопировать(СтруктураПоискаДокумента);
		
		НачатьТранзакцию();
		
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОборотыБюджетов.НаборЗаписей");
			ЭлементБлокировки.УстановитьЗначение("Регистратор", ТекущийДокумент);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			Для Каждого СтрокаПравило Из СтрокаДокумент[0].Строки Цикл
			
				Если Не ЗначениеЗаполнено(СтрокаПравило.ПравилоРасчета) Тогда
					Продолжить;
				КонецЕсли;
				
				СтруктураПоискаРегистраторов = Новый Структура("ПравилоРасчета, ПериодПланирования");
				СтруктураПоискаРегистраторов.ПравилоРасчета = СтрокаПравило.ПравилоРасчета;
				
				Для Каждого ПериодБюджета Из ПериодыБюджета Цикл
					
					СтруктураПоискаРегистраторов.ПериодПланирования = ПериодБюджета;
					
					СтрокаРегистратор = ДокументыРегистраторы.НайтиСтроки(СтруктураПоискаРегистраторов);
					Если СтрокаРегистратор.Количество() > 0 Тогда
						ДокументОбъект = СтрокаРегистратор[0].ДокументРегистратор.ПолучитьОбъект();
						СтрокаРегистратор[0].Пометка = Истина;
					Иначе
						ДокументОбъект = Документы.РегистраторОборотовБюджетов.СоздатьДокумент();
						ДокументОбъект.ДокументОснование = ТекущийДокумент;
						ДокументОбъект.ПериодПланирования = ПериодБюджета;
					КонецЕсли;
					ЗаполнитьЗначенияСвойств(ДокументОбъект, СтрокаПравило);
					
					ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
					
				КонецЦикла;
			
			КонецЦикла;
			
			Для Каждого СтрокаРегистратор Из ДокументыРегистраторы Цикл
				Если Не СтрокаРегистратор.Пометка Тогда
					ДокументОбъект = СтрокаРегистратор.ДокументРегистратор.ПолучитьОбъект();
					ДокументОбъект.УстановитьПометкуУдаления(Истина);
				КонецЕсли;
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			Если ИдентификаторНеобработаннойЗаписи <> Неопределено Тогда
				ТекстОшибки = ОтложенныеЗадания.ТекстОшибкиВыполнения(СтруктураПоискаДокумента, СтрокаЗадание, ТекстОшибки);
			КонецЕсли;
			ИдентификаторыНеобработанныхЗаписей.Вставить(ИдентификаторНеобработаннойЗаписи, ТекстОшибки);
			
		КонецПопытки;
	
	КонецЦикла;
	
КонецПроцедуры
//-- НЕ УТКА
	
#КонецОбласти

#Область ОбновлениеИнформационнойБазы

// Проверяет, выполнились ли обработчики обновления, блокирующие формирование бюджетного отчета.
// 
// Возвращаемое значение:
//  Булево - Истина, если данные еще обновляются.
//
Функция ДанныеДляБюджетногоОтчетаЕщеОбновляются() Экспорт
	Возврат НЕ ОбновлениеИнформационнойБазы.ОбъектОбработан("Отчет.БюджетныйОтчет").Обработан;
КонецФункции

// Функция для проверки объектов при открытии форм и перед записью.
// Может использоваться как функция проверки по умолчанию, если
// достаточно логики - заблокированные объекты зарегистрированы на узлах плана обмена ОбновлениеИнформационнойБазы.
//
// Параметры:
//  МетаданныеИОтбор - см. ОбновлениеИнформационнойБазы.МетаданныеИОтборПоДанным.
//
// Возвращаемое значение:
//  Булево - Истина, если объект обновлен и доступен для изменения.
//
Функция ДанныеОбновленыНаНовуюВерсиюПрограммы(МетаданныеИОтбор) Экспорт
	
	Данные = МетаданныеИОтбор.Данные;
	
	Если ПолучитьФункциональнуюОпцию("ОтложенноеОбновлениеЗавершеноУспешно") Тогда
		Если Не ОбщегоНазначения.ЭтоПодчиненныйУзелРИБ() Тогда
			Возврат Истина;
		ИначеЕсли ПолучитьФункциональнуюОпцию("ОтложенноеОбновлениеВГлавномУзлеЗавершеноУспешно") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если МетаданныеИОтбор = Неопределено Тогда
		МетаданныеИОтбор = ОбновлениеИнформационнойБазы.МетаданныеИОтборПоДанным(Данные, Неопределено);
	КонецЕсли;
	
	Если МетаданныеИОтбор.ЭтоНовый Тогда
		
		ДанныеТекущегоОбъектаОбновлены = Истина;
		
	Иначе
		
		ДанныеТекущегоОбъектаОбновлены = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Неопределено, МетаданныеИОтбор.Метаданные, МетаданныеИОтбор.Отбор);
		
	КонецЕсли;
	
	Если НЕ ДанныеТекущегоОбъектаОбновлены Тогда
		Возврат ДанныеТекущегоОбъектаОбновлены;
	КонецЕсли;
	
	СвязанныеОбъекты = Новый Массив;
	
	ДанныеСвязанныхОбъектовОбновлены = Истина;
	
	Если МетаданныеИОтбор.Метаданные = Метаданные.Документы.УстановкаЗначенийНефинансовыхПоказателей Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.НефинансовыеПоказателиБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ШаблоныВводаНефинансовыхПоказателей);
	
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Документы.УстановкаНачальныхОстатковРасчетныхПоказателей Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПоказателиБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.НачальныеОстаткиРасчетныхПоказателей);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Документы.ЭкземплярБюджета Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.НефинансовыеПоказателиБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоПоказателямБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоСтатьямБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ЭлементыФинансовыхОтчетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.ЗначенияНефинансовыхПоказателей);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ЛимитыПоДаннымБюджетирования);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.НачальныеОстаткиРасчетныхПоказателей);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ОборотыБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшВспомогательныхДанныхВидаБюджета);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшИменДокументовДляОбработкиПоПравилу);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ФактическиеДанныеБюджетирования);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Справочники.ВидыБюджетов Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.ПланыВидовХарактеристик.АналитикиСтатейБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ЭлементыФинансовыхОтчетов);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Справочники.ЭлементыФинансовыхОтчетов Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.ПланыВидовХарактеристик.АналитикиСтатейБюджетов);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Отчеты.БюджетныйОтчет Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.НефинансовыеПоказателиБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоПоказателямБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоСтатьямБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ЭлементыФинансовыхОтчетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.ЗначенияНефинансовыхПоказателей);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.НачальныеОстаткиРасчетныхПоказателей);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ОборотыБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшВспомогательныхДанныхВидаБюджета);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшИменДокументовДляОбработкиПоПравилу);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ФактическиеДанныеБюджетирования);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Отчеты.ОборотнаяВедомостьБюджетирования Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоСтатьямБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ОборотыБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшИменДокументовДляОбработкиПоПравилу);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ФактическиеДанныеБюджетирования);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Отчеты.ОборотноСальдоваяВедомостьБюджетирования Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоПоказателямБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоСтатьямБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ОборотыБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшИменДокументовДляОбработкиПоПравилу);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.НачальныеОстаткиРасчетныхПоказателей);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ФактическиеДанныеБюджетирования);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Отчеты.ПроверкаСвязанныхОстатковИОборотовБюджетов Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Отчеты.ПроверкаСвязейПоказателейБюджетов Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоПоказателямБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоСтатьямБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаРасчетаСвязанныхОстатковИОборотовБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ОборотыБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшИменДокументовДляОбработкиПоПравилу);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ФактическиеДанныеБюджетирования);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Отчеты.РезультатРаботыПравилПолученияФактическихДанных Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшИменДокументовДляОбработкиПоПравилу);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Отчеты.РасшифровкаФормулыБюджетногоОтчета Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ЭлементыФинансовыхОтчетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшВспомогательныхДанныхВидаБюджета);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшИменДокументовДляОбработкиПоПравилу);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Отчеты.ЛимитыРасходаДенежныхСредствПоДаннымБюджетирования
		Или МетаданныеИОтбор.Метаданные = Метаданные.Отчеты.ЛимитыПоДаннымБюджетирования Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоСтатьямБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаЛимитовПоДаннымБюджетирования);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ОборотыБюджетов);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшИменДокументовДляОбработкиПоПравилу);
		СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ФактическиеДанныеБюджетирования);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Документы.ЗаявкаНаЗакупку Тогда
		Если Константы.ИспользоватьЛимитыБДРПриЗакупках.Получить() Тогда
			СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаЛимитовПоДаннымБюджетирования);
			СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ЛимитыПоДаннымБюджетирования);
		КонецЕсли;
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Документы.ЗаявкаНаКомандировку Тогда
		Если Константы.ИспользоватьЛимитыРасходаДенежныхСредствБюджетирования.Получить()
			Или Константы.ИспользоватьЛимитыБДРПриПотреблении.Получить()
			Или Константы.ИспользоватьЛимитыБДРПриЗакупках.Получить() Тогда
			СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоСтатьямБюджетов);
			СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаЛимитовПоДаннымБюджетирования);
			Если Не Константы.КонтрольЛимитовПоДаннымБюджетирования2_4.Получить() Тогда
				СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ЛимитыПоДаннымБюджетирования);
			Иначе
				СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ОборотыБюджетов);
			КонецЕсли;
			СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшИменДокументовДляОбработкиПоПравилу);
		КонецЕсли;
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Документы.ЗаявкаНаОбеспечение Тогда
		Если Константы.ИспользоватьЛимитыБДРПриПотреблении.Получить()
			Или Константы.ИспользоватьЛимитыБДРПриЗакупках.Получить() Тогда
			СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаЛимитовПоДаннымБюджетирования);
			СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ЛимитыПоДаннымБюджетирования);
		КонецЕсли;
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Документы.ЗаявкаНаРасходованиеДенежныхСредств Тогда
		Если Константы.ИспользоватьЛимитыРасходаДенежныхСредствБюджетирования.Получить() Тогда
			СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаПолученияФактаПоСтатьямБюджетов);
			СвязанныеОбъекты.Добавить(Метаданные.Справочники.ПравилаЛимитовПоДаннымБюджетирования);
			Если Не Константы.КонтрольЛимитовПоДаннымБюджетирования2_4.Получить() Тогда
				СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ЛимитыПоДаннымБюджетирования);
			Иначе
				СвязанныеОбъекты.Добавить(Метаданные.РегистрыНакопления.ОборотыБюджетов);
			КонецЕсли;
			СвязанныеОбъекты.Добавить(Метаданные.РегистрыСведений.КэшИменДокументовДляОбработкиПоПравилу);
		КонецЕсли;
	
	//++ НЕ УТКА	
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Справочники.ВидыФинансовыхОтчетов Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ЭлементыФинансовыхОтчетов);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Документы.ЭкземплярФинансовогоОтчета Тогда
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ЭлементыФинансовыхОтчетов);
		
	ИначеЕсли МетаданныеИОтбор.Метаданные = Метаданные.Отчеты.МеждународныйОтчет Тогда 
		
		СвязанныеОбъекты.Добавить(Метаданные.Справочники.ЭлементыФинансовыхОтчетов);
		
	//-- НЕ УТКА
	КонецЕсли;
	
	Для каждого МетаданныеСвязанногоОбъекта Из СвязанныеОбъекты Цикл
	
		Если ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Неопределено, МетаданныеСвязанногоОбъекта) Тогда
			ДанныеСвязанныхОбъектовОбновлены = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДанныеТекущегоОбъектаОбновлены И ДанныеСвязанныхОбъектовОбновлены;
	
КонецФункции

#КонецОбласти
