			КолонкиПоЗначению.Вставить("НазначениеСтруктуры",   Изделие.НазначениеСтруктуры);
			КолонкиПоЗначению.Вставить("ИдентификаторВГруппеИзделий", ИдентификаторВГруппеИзделий);
			КолонкиПоЗначению.Вставить("ИдентификаторВерсииДанных", Изделие.ИдентификаторВерсииДанных);
			
			Для каждого Строка Из Кэш.МатериалыИУслуги Цикл
				
				НоваяСтрока = ДвиженияНоменклатура.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, КолонкиПоЗначению);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "Номенклатура,Характеристика,Этап,Подразделение,СтатьяКалькуляции,РазрешениеНаЗамену");
				
				НоваяСтрока.ВидСтроки = Перечисления.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление;
				
				Если Изделие.ТипПроцесса = Перечисления.ТипыПроизводственныхПроцессов.Разборка
					И (Изделие.Номенклатура = НоваяСтрока.Номенклатура И Изделие.Характеристика = НоваяСтрока.Характеристика) Тогда
					НоваяСтрока.Склад = Изделие.Склад;
					НоваяСтрока.Назначение = Изделие.Назначение;
				Иначе
					
					НоваяСтрока.Склад = Строка.Склад;
					Если Строка.Обособленно Тогда
						НоваяСтрока.Назначение = Изделие.НазначениеСтруктуры;
					КонецЕсли;
					
				КонецЕсли;
				
				Если Строка.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется Тогда
					НоваяСтрока.НеОбеспечивать = Партия.РазмерПартии * Строка.КоличествоНаЕдиницуПартииЗапуска / Изделие.КоличествоОсновногоИзделияНаЕдиницуПартииЗапуска;
				Иначе
					НоваяСтрока.КОбеспечению = Партия.РазмерПартии * Строка.КоличествоНаЕдиницуПартииЗапуска / Изделие.КоличествоОсновногоИзделияНаЕдиницуПартииЗапуска;
				КонецЕсли;
				
				НоваяСтрока.СпецификацияПолуфабриката = Строка.СпецификацияПолуфабриката;
				НоваяСтрока.ДлительностьДоВыпуска = Изделие.ДлительностьДоВыпускаРодитель + (Строка.ДлительностьДоВыпуска - Кэш.Изделия[0].ДлительностьДоВыпуска);
