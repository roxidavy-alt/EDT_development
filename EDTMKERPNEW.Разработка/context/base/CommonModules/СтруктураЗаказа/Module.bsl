				НоваяСтрока.КоличествоНаЕдиницуПартииЗапуска = Строка.КоличествоНаЕдиницуПартииЗапуска;
				
				УстановитьКлючСвязиСтроки(НоваяСтрока, "СтруктураЗаказа", "КлючНоменклатура", КлючиСвязи);
				
			КонецЦикла;
			
	#КонецОбласти
	
