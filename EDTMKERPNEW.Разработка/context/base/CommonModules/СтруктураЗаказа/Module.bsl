				УстановитьКлючСвязиСтроки(НоваяСтрока, "ТрудозатратыСтруктурыЗаказа", "КлючВидРабот", КлючиСвязи);
				
			КонецЦикла;
			
	#КонецОбласти
	
		Иначе
			
