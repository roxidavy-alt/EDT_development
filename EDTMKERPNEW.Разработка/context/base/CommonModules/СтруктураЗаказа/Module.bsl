				КонецЕсли;
				
				УстановитьКлючСвязиСтроки(НоваяСтрока, "СтруктураЗаказа", "КлючНоменклатура", КлючиСвязи);
				
			КонецЦикла;
			
	#КонецОбласти
	
	#Область Трудозатраты
	
			ДвиженияТрудозатраты = Хранилище.ТрудозатратыСтруктурыЗаказа; // ТаблицаЗначений
		
			КолонкиПоЗначению = Новый Структура();
			КолонкиПоЗначению.Вставить("КлючПартия",          Партия.КлючПартия);
			КолонкиПоЗначению.Вставить("Спецификация",        Изделие.Спецификация);
			КолонкиПоЗначению.Вставить("ЗаказНаПроизводство", Изделие.ЗаказНаПроизводство);
			КолонкиПоЗначению.Вставить("ИдентификаторВерсииДанных", ?(Партия.ПроизводствоИзДавальческогоСырья, "", ДанныеСпецификации.ИдентификаторВерсииДанных));
			
			Для каждого Строка Из ДанныеСпецификации.Трудозатраты Цикл
			
				НоваяСтрока = ДвиженияТрудозатраты.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, КолонкиПоЗначению);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "ВидРабот,Этап,СтатьяКалькуляции");
				
				НоваяСтрока.Количество = Строка.Количество;
				
				НоваяСтрока.Подразделение = Строка.ПодразделениеЭтапа;
				НоваяСтрока.КлючСвязиСтрокаСпецификации = Строка.КлючСвязи; // КлючСвязиСтрокаСпецификации
				
				Если Строка.АлгоритмРасчетаКоличества <> "" И ДанныеСпецификации.ОсновноеИзделие.КоличествоУпаковок > 0 Тогда
					НоваяСтрока.КоличествоНаЕдиницуПартииЗапуска = Строка.Количество
																		* ДанныеСпецификации.ОсновноеИзделие.КоличествоУпаковокНаЕдиницуПартииВыпуска / ДанныеСпецификации.ОсновноеИзделие.КоличествоУпаковок;
				Иначе
					НоваяСтрока.КоличествоНаЕдиницуПартииЗапуска = Строка.КоличествоНаЕдиницуПартииВыпуска;
				КонецЕсли;
				
				УстановитьКлючСвязиСтроки(НоваяСтрока, "ТрудозатратыСтруктурыЗаказа", "КлючВидРабот", КлючиСвязи);
				
			КонецЦикла;
			
	#КонецОбласти
		
		КонецЕсли;
		
	КонецЕсли;
	
	Если Партия.БылиОшибки Тогда
		ЗаполнитьРеквизитыВДвиженияхПоПараметрамОтбора(Хранилище, Новый Структура("КлючПартия", Партия.КлючПартия), Новый Структура("ИдентификаторВерсииДанных", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000")));
	КонецЕсли;

КонецПроцедуры

Функция НуженДопРасчетСвободногоВыпуска(Партия, ДанныеСпецификации)
	
	Если ДанныеСпецификации.ВыходныеИзделия.Количество() > 1 Или Партия.Остаток <> 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ДанныеСпецификации.ВозвратныеОтходы.Количество() > 0 И НайтиСтрокуПоЗначениюКолонкиВМассивеСтрок(Партия.Строки, "ПобочныйВыход", Истина) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция СвободныйВыпуск(Партия, ДанныеСпецификации)
	
	Изделия = Партия.Строки;
	
	НуженДопРасчетСвободногоВыпуска = НуженДопРасчетСвободногоВыпуска(Партия, ДанныеСпецификации);
	
	Если НЕ
		НуженДопРасчетСвободногоВыпуска Тогда
		
		СвободныйВыпуск = ДанныеСпецификации.ВозвратныеОтходы;
		
	Иначе
		
		СвободныйВыпуск = ДанныеСпецификации.ВозвратныеОтходы.СкопироватьКолонки();
		
		Кэш = СвободныйВыпуск.СкопироватьКолонки("Номенклатура,Характеристика,Количество,КоличествоУпаковокНаЕдиницуПартииВыпуска"); // ТаблицаЗначений
		Кэш.Колонки.Добавить("Строка");
		
		Для каждого Строка Из ДанныеСпецификации.ВыходныеИзделия Цикл
			НоваяСтрока = Кэш.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.Строка = Строка;
		КонецЦикла;
		
		Для каждого Строка Из ДанныеСпецификации.ВозвратныеОтходы Цикл
			НоваяСтрока = Кэш.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.Строка = Строка;
		КонецЦикла;
		
		Кэш.Индексы.Добавить("Номенклатура,Характеристика");
		
		СтруктураОтбора = Новый Структура("Номенклатура,Характеристика");
		
		Для каждого Изделие Из Изделия Цикл
			
			ЗаполнитьЗначенияСвойств(СтруктураОтбора, Изделие);
			
			Если Не ЗначениеЗаполнено(Партия.КорректировкаСтрок) Тогда
				Требуется = Изделие.Требуется;
			Иначе
				Требуется = Изделие.Требуется - ПривестиЗначение(ТипЧисло(), Партия.КорректировкаСтрок[Изделие.КлючНоменклатура]);
			КонецЕсли;
			
			Строки = Кэш.НайтиСтроки(СтруктураОтбора);
			
			Для каждого Строка Из Строки Цикл
				Распределено = Мин(Требуется, Строка.Количество);
				Строка.Количество = Строка.Количество - Распределено;
				Требуется = Требуется - Распределено;
			КонецЦикла;
			
		КонецЦикла;
		
		Для каждого Строка Из Кэш Цикл
			
			Если Строка.Количество > 0 Или Строка.КоличествоУпаковокНаЕдиницуПартииВыпуска > 0 И Строка.Строка.Владелец() = ДанныеСпецификации.ВозвратныеОтходы Тогда
				НоваяСтрока = СвободныйВыпуск.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка.Строка);
				НоваяСтрока.Количество = Строка.Количество;
				НоваяСтрока.КоличествоУпаковокНаЕдиницуПартииВыпуска = Строка.КоличествоУпаковокНаЕдиницуПартииВыпуска;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СвободныйВыпуск;
	
КонецФункции 

Функция КомплектующиеРазборки(Партия, ДанныеСпецификации)

	НуженДопРасчетСвободногоВыпуска = ДанныеСпецификации.ВозвратныеОтходы.Количество() > 0;

	Если НЕ
		НуженДопРасчетСвободногоВыпуска Тогда
		
		СвободныйВыпуск = ДанныеСпецификации.ВыходныеИзделия;
		
		Если СвободныйВыпуск.Колонки.Найти("СтатьяКалькуляции") = Неопределено Тогда
			СвободныйВыпуск.Колонки.Добавить("СтатьяКалькуляции", Новый ОписаниеТипов("СправочникСсылка.СтатьиКалькуляции"));
		КонецЕсли;
		
	Иначе
		
		СвободныйВыпуск = ДанныеСпецификации.ВозвратныеОтходы.Скопировать();
		
		Для каждого Строка Из ДанныеСпецификации.ВыходныеИзделия Цикл
			НоваяСтрока = СвободныйВыпуск.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЦикла;
		
	КонецЕсли;

	Возврат СвободныйВыпуск;
	
КонецФункции

// Рассчитывает изменения и добавляет сторно записи в таблицу движений
// 
// Параметры:
// 	Движения - ТаблицаЗначений - движения
Процедура РассчитатьИзмененияИДобавитьСторноДвиженияВТаблицуСтруктураЗаказа(Движения)
	
	СтруктураМетаданных = РегистрыСведений.СтруктураЗаказа.СтруктураМетаданных();
	
	ПервичныеСтроки = Движения.НайтиСтроки(Новый Структура("РассчитыватьИзменения", Истина));
	
	Дельты = Движения.СкопироватьКолонки(
		СтруктураМетаданных.ИзмеренияСтрока + ",КОбеспечению,НеОбеспечивать,Запланировано,РазборкаЗапланировано");
	
	Дельты.Колонки.Добавить("НомерСтрокиДвиженияДоИзменения", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	Дельты.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	
	Для Индекс = 0 По ПервичныеСтроки.ВГраница() Цикл
		
		Строка = ПервичныеСтроки[Индекс];
		
		НоваяСтрока = Дельты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Строка.ДополнительнаяЗапись Тогда
			Продолжить;
		КонецЕсли;
		
		Если Строка.ДвиженияДоИзменения Тогда
			НоваяСтрока.НомерСтрокиДвиженияДоИзменения = Индекс + 1;
		Иначе
			НоваяСтрока.НомерСтроки                    = Индекс + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Дельты.Свернуть(СтруктураМетаданных.ИзмеренияСтрока,
		"КОбеспечению,НеОбеспечивать,Запланировано,РазборкаЗапланировано" + ",НомерСтроки,НомерСтрокиДвиженияДоИзменения");
	
	Для каждого Дельта Из Дельты Цикл
		
		Если (Дельта.КОбеспечению = 0 И Дельта.НеОбеспечивать = 0 И Дельта.Запланировано = 0 И Дельта.РазборкаЗапланировано = 0) Тогда
			Продолжить;
		КонецЕсли;
		
		ДвиженияДоИзменения = НЕ Дельта.КОбеспечению >= 0 Или НЕ Дельта.НеОбеспечивать >= 0 Или НЕ Дельта.Запланировано >= 0 Или НЕ Дельта.РазборкаЗапланировано >= 0;
		
		НоваяСтрока = Движения.Добавить();
		
		ИндексСтроки = ?(ДвиженияДоИзменения, Дельта.НомерСтрокиДвиженияДоИзменения, Дельта.НомерСтроки) - 1;
		ПервичнаяСтрока = ПервичныеСтроки[ИндексСтроки];
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПервичнаяСтрока, СтруктураМетаданных.РеквизитыСтрока);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Дельта);
		
		Если ДвиженияДоИзменения ИЛИ Дельта.НомерСтрокиДвиженияДоИзменения <> 0 Тогда
		
			НоваяСтрока.ДополнительнаяЗапись = Истина;
			НоваяСтрока.Разделитель = Новый УникальныйИдентификатор();
			
		КонецЕсли;
		
	КонецЦикла;
	
	УдалитьСтрокиИзТаблицы(Движения, ПервичныеСтроки);
	
КонецПроцедуры

// Рассчитывает изменения и добавляет сторно записи в таблицу движений
// 
// Параметры:
// 	Движения - ТаблицаЗначений - движения
Процедура РассчитатьИзмененияИДобавитьСторноДвиженияВТаблицуТрудозатратыСтруктурыЗаказа(Движения)
	
	СтруктураМетаданных = РегистрыСведений.ТрудозатратыСтруктурыЗаказа.СтруктураМетаданных();
	
	ПервичныеСтроки = Движения.НайтиСтроки(Новый Структура("РассчитыватьИзменения", Истина));
	
	Дельты = Движения.СкопироватьКолонки(СтруктураМетаданных.ИзмеренияСтрока + ",Количество");
	
	Дельты.Колонки.Добавить("НомерСтрокиДвиженияДоИзменения", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	Дельты.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	
	Для Индекс = 0 По ПервичныеСтроки.ВГраница() Цикл
		
		Строка = ПервичныеСтроки[Индекс];
		
		НоваяСтрока = Дельты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Строка.ДополнительнаяЗапись Тогда
			Продолжить;
		КонецЕсли;
		
		Если Строка.ДвиженияДоИзменения Тогда
			НоваяСтрока.НомерСтрокиДвиженияДоИзменения = Индекс + 1;
		Иначе
			НоваяСтрока.НомерСтроки                    = Индекс + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Дельты.Свернуть(СтруктураМетаданных.ИзмеренияСтрока, "Количество" + ", НомерСтроки, НомерСтрокиДвиженияДоИзменения");
	
	Для каждого Дельта Из Дельты Цикл
		
		Если Дельта.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДвиженияДоИзменения = НЕ Дельта.Количество >= 0;
		
		НоваяСтрока = Движения.Добавить();
		
		ИндексСтроки = ?(ДвиженияДоИзменения, Дельта.НомерСтрокиДвиженияДоИзменения, Дельта.НомерСтроки) - 1;
		ПервичнаяСтрока = ПервичныеСтроки[ИндексСтроки];
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПервичнаяСтрока, СтруктураМетаданных.РеквизитыСтрока);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Дельта);
		
		Если ДвиженияДоИзменения ИЛИ Дельта.НомерСтрокиДвиженияДоИзменения <> 0 Тогда
		
			НоваяСтрока.ДополнительнаяЗапись = Истина;
			НоваяСтрока.Разделитель = Новый УникальныйИдентификатор();
			
		КонецЕсли;
		
	КонецЦикла;
	
	УдалитьСтрокиИзТаблицы(Движения, ПервичныеСтроки);
	
КонецПроцедуры

Функция ПорцииЗаписи()
	
	Порции = Новый ТаблицаЗначений();
	
	Порции.Колонки.Добавить("НомерПорции", ОбщегоНазначения.ОписаниеТипаЧисло(4, 0));
	
	Порции.Колонки.Добавить("Замещать", Новый ОписаниеТипов("Булево"));
	Порции.Колонки.Добавить("Доступно", Новый ОписаниеТипов("Булево"));
	
	Порции.Колонки.Добавить("КоличествоСтрок", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	
	Возврат Порции;
	
КонецФункции

Функция ПорцияЗаписи(ПорцииЗаписи, Замещать, Найти = Ложь, КоличествоСтрок = 1, ПорцияЗаписи = Неопределено)
	
	Если Найти
		И ПорцияЗаписи = Неопределено Тогда
		
		КоличествоСтрокВНабореЗаписей = КоличествоСтрокВНабореЗаписей();
		
		НайденныеСтроки = ПорцииЗаписи.НайтиСтроки(Новый Структура("Доступно, Замещать", Найти, Замещать));
		
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
			Если КоличествоСтрок < ( КоличествоСтрокВНабореЗаписей - НайденнаяСтрока.КоличествоСтрок ) Тогда
				
				ПорцияЗаписи = НайденнаяСтрока;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПорцияЗаписи = Неопределено Тогда
		
		ПорцияЗаписи = ПорцииЗаписи.Добавить();
		
		ПорцияЗаписи.Замещать    = Замещать;
		ПорцияЗаписи.НомерПорции = ПорцииЗаписи.Количество();
		
	КонецЕсли;
	
	Возврат ПорцияЗаписи;
	
КонецФункции

Процедура УстановитьНомерПорцииВКоллекцииДвижений(Коллекция, НомерПорции)
	
	Для каждого ТекущаяСтрока Из Коллекция Цикл ТекущаяСтрока.НомерПорции = НомерПорции;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкиВТаблицеПоПараметрамОтбора(Таблица, ПараметрыОтбора, КолонкиПоЗначению)
	
	Если ПараметрыОтбора = Неопределено Тогда
	
		Для каждого ТекущаяСтрока Из Таблица Цикл ЗаполнитьЗначенияСвойств(ТекущаяСтрока, КолонкиПоЗначению);
		КонецЦикла;
	
	Иначе
		
		Для каждого ТекущаяСтрока Из Таблица.НайтиСтроки(ПараметрыОтбора) Цикл ЗаполнитьЗначенияСвойств(ТекущаяСтрока, КолонкиПоЗначению);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыВДвиженияхПоПараметрамОтбора(Хранилище, ПараметрыОтбора, КолонкиПоЗначению)
	
	Для каждого Данные Из Хранилище Цикл
		ЗаполнитьКолонкиВТаблицеПоПараметрамОтбора(Данные.Значение, ПараметрыОтбора, КолонкиПоЗначению);
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьКлючСвязиСтроки(Строка, ИмяТЧ, ИмяПоля, КлючиСвязи)
	
	ЗаполнитьЗначенияСвойств(КлючиСвязи.Ключ, Строка);
	
	НайденныеСтроки = КлючиСвязи.Кэш.НайтиСтроки(КлючиСвязи.Ключ);
	
	Если НайденныеСтроки.Количество() = 1 Тогда
		
		Строка[ИмяПоля] = НайденныеСтроки[0].КлючСвязи;
		
	Иначе
		
		Строка[ИмяПоля] = Новый УникальныйИдентификатор();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ГруппаИзделийКонтрольнаяСумма(Данные, ИмяПоляСпецификация = "Спецификация", ИмяПоляЗаказ = "ЗаказНаПроизводство") Экспорт
	
	ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.MD5);
	
	ХешированиеДанных.Добавить("" + Данные[ИмяПоляСпецификация].УникальныйИдентификатор());
	ХешированиеДанных.Добавить("" + Данные[ИмяПоляЗаказ].УникальныйИдентификатор());
	
	Возврат СтрЗаменить(ХешированиеДанных.ХешСумма, " ", "");
	
КонецФункции

Функция ПустаяГруппаИзделий()
	
	Возврат "                                ";
	
КонецФункции

Функция ПорцияРасчетаГруппыИзделий(ПорцияРасчета)
	
	КоличествоСтрок = ПорцияРасчета.Количество();
	
	ГруппыИзделий = Новый Массив(КоличествоСтрок);
	
	Для Индекс = 0 По КоличествоСтрок - 1 Цикл
		ГруппыИзделий[Индекс] = ГруппаИзделийКонтрольнаяСумма(ПорцияРасчета[Индекс]);
	КонецЦикла;
	
	Возврат ГруппыИзделий;
	
КонецФункции

Функция ИдентификаторПартииВГруппеИзделий(Знач ГруппаИзделий, Знач ИдентификаторВГруппеИзделийКлючРодитель, Знач УровеньРодитель, Знач НомерВГруппеИзделий)
	
	Если УровеньРодитель > 0 И ПустаяСтрока(ИдентификаторВГруппеИзделийКлючРодитель) Тогда
		Возврат ""; // пропускаем, чтобы сохранить поведение для "старых" заказов (обработчик обновления не делаем)
	КонецЕсли;
	
	//ИдентификаторВГруппеИзделий - Строка (70)
	//  * группа изделий родителя (32 символа)
	//  * номер партии в группе изделий родителя (3 символа в Base36)
	//  * группа изделий (32 символа)
	//  * номер партии в группе изделий (3 символа в Base36)
	
	НомерВГруппеИзделий36 = ПреобразоватьBase36(НомерВГруппеИзделий, 3); // см. ОпределяемыеТипы.ИдентификаторВГруппеИзделийСтруктурыЗаказа
	
	Результат = ""
		+ ИдентификаторВГруппеИзделийКлючРодитель
		+ ГруппаИзделий
		+ Лев("000", 3 - СтрДлина(НомерВГруппеИзделий36))
		+ НомерВГруппеИзделий36;
	
	Возврат Результат;
	
КонецФункции

Функция ИзвлечьКлючРодителяИзИдентификатора(Знач ИдентификаторВГруппеИзделий)
	
	Результат = Лев(ИдентификаторВГруппеИзделий, 35); // см. ОпределяемыеТипы.ИдентификаторВГруппеИзделийСтруктурыЗаказа

	Если Результат = "" Тогда
		Результат = "00000000000000000000000000000000000";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИзвлечьКлючПартииИзИдентификатора(Знач ИдентификаторВГруппеИзделий)
	
	Результат = Прав(ИдентификаторВГруппеИзделий, 35); // см. ОпределяемыеТипы.ИдентификаторВГруппеИзделийСтруктурыЗаказа

	Если Результат = "" Тогда
		Результат = "00000000000000000000000000000000000";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИзвлечьКодПартииИзИдентификатора(Знач ИдентификаторВГруппеИзделий)
	
	Результат = ПреобразоватьИзBase36ВДесятичноеЧисло(Прав(ИдентификаторВГруппеИзделий, 3)); // см. ОпределяемыеТипы.ИдентификаторВГруппеИзделийСтруктурыЗаказа
	Возврат Результат;
	
КонецФункции

Функция ИзвлечьГруппуИзделияИзИдентификатора(Знач ИдентификаторВГруппеИзделий)
	
	Результат = Сред(ИдентификаторВГруппеИзделий, 35, 32); // см. ОпределяемыеТипы.ИдентификаторВГруппеИзделийСтруктурыЗаказа
	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьBase36(Знач ДесятичноеЧисло, Знач Разрядность = 15)
	
	Результат = "";
	
	ДесятичноеЧисло = Мин(ДесятичноеЧисло, Pow(36, Разрядность));
	
	Пока ДесятичноеЧисло > 0 Цикл
		ОстатокОтДеления = ДесятичноеЧисло % 36;
		ДесятичноеЧисло  = (ДесятичноеЧисло - ОстатокОтДеления) / 36;
		Результат        = Сред("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ", ОстатокОтДеления + 1, 1) + Результат;
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьИзBase36ВДесятичноеЧисло(Знач Значение)
	
	Значение = ВРег(Значение);
	ДлинаСтроки = СтрДлина(Значение);
	
	Результат = 0;
	Для НомерСимвола = 1 По ДлинаСтроки Цикл
		Результат = Результат * 36 + СтрНайти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ", Сред(Значение, НомерСимвола, 1)) - 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиВКэшеКлючПартии(КэшПартий, Знач ИдентификаторВГруппеИзделийКлючРодитель, Знач ГруппаИзделий, ПоляПриоритета, КэшПартияКлючПоиска, ПодходящаяПартия)
	
	ПодходящаяПартия = Неопределено;

	КэшПартияКлючПоиска.ГруппаИзделий = ГруппаИзделий;
	КэшПартияКлючПоиска.ИдентификаторВГруппеИзделийКлючРодитель = ИдентификаторВГруппеИзделийКлючРодитель;
	
	ПодходящаяПартия0 = Неопределено;
	ПодходящаяПартия1 = Неопределено;
	
	НайденныеСтроки = КэшПартий.НайтиСтроки(КэшПартияКлючПоиска);
	
	Для каждого Строка ИЗ НайденныеСтроки Цикл
		
		Если Строка.КлючИспользован Тогда
			Продолжить;
		КонецЕсли;
		
		ПодходящаяПартия = Строка;
		
		Если ПодходящаяПартия.КлючПартия = ПоляПриоритета.КлючПартия Тогда
			Если ПодходящаяПартия.КлючНоменклатура = ПоляПриоритета.КлючНоменклатура Тогда
				ПодходящаяПартия0 = ПодходящаяПартия;
				Прервать;
			КонецЕсли;
			ПодходящаяПартия1 = ПодходящаяПартия;
		КонецЕсли;
		
	КонецЦикла;
	
	ПодходящаяПартия = ?(ПодходящаяПартия0 <> Неопределено,
							ПодходящаяПартия0,
							?(ПодходящаяПартия1 <> Неопределено,
									ПодходящаяПартия1,
									ПодходящаяПартия));
	
	Если ПодходящаяПартия <> Неопределено Тогда
		
		ПодходящаяПартия.КлючИспользован = Истина;
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

Процедура ДобавитьСообщениеВСписокОшибок(СписокОшибок, ТекстСообщения)

	Если СписокОшибок = Неопределено Тогда
		СписокОшибок = Новый Массив;
	КонецЕсли;
	
	СписокОшибок.Добавить(ТекстСообщения);
	
КонецПроцедуры

#КонецОбласти

#Область РаспределениеЗапасов

Процедура ВыполнитьРаспределениеЗапасов(ПараметрыДействия, АдресРезультата) Экспорт
	
	КлючеваяОперация = "СтруктураЗаказа.РаспределениеЗапасов";
	НачалоРасчета = ТекущаяУниверсальнаяДатаВМиллисекундах();
	РазмерПорции = ПараметрыДействия.ПорцияРасчета.Количество();
	ЗамерВремени = ОценкаПроизводительности.НачатьЗамерДлительнойОперации(КлючеваяОперация);
	ВыполнитьРаспределениеЗапасовВнутриЗамераВремени(ПараметрыДействия);
	ОценкаПроизводительности.ЗакончитьЗамерДлительнойОперации(ЗамерВремени, РазмерПорции);
	РезультатРасчета = Новый Структура("Операция, РазмерПорции, Длительность", КлючеваяОперация, РазмерПорции, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоРасчета);
	ПоместитьВоВременноеХранилище(РезультатРасчета, АдресРезультата);
	
КонецПроцедуры

Процедура ВыполнитьРаспределениеЗапасовВнутриЗамераВремени(ПараметрыДействия)
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	
	СостояниеЗапасов = Новый Массив();
	СостояниеЗапасов.Добавить(Перечисления.СостоянияЗапаса.ВНаличии);
	СостояниеЗапасов.Добавить(Перечисления.СостоянияЗапаса.ВНаличииОжидаетсяРазблокировка);
	СостояниеЗапасов.Добавить(Перечисления.СостоянияЗапаса.ОжидаетсяКПоступлению);
	СостояниеЗапасов.Добавить(Перечисления.СостоянияЗапаса.ОжидаетсяКПоступлениюСБлокировкой);
	СостояниеЗапасов.Добавить(Перечисления.СостоянияЗапаса.НаСогласованииПоставки);
	
	ХарактеристикаПотребности = Перечисления.ХарактеристикиПотребности.Излишек;
	
	ПараметрыРасчета = ПараметрыДействия.ПараметрыРасчета;
	ПорцияРасчета = ПараметрыДействия.ПорцияРасчета;
	
	ИспользуютсяАналоги = ПолучитьФункциональнуюОпцию("ИспользоватьАналогиМатериалов");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПорцияРасчета", ПорцияРасчета);
	Запрос.УстановитьПараметр("СостояниеЗапасов", СостояниеЗапасов);
	Запрос.УстановитьПараметр("ХарактеристикаПотребности", ХарактеристикаПотребности);
	Запрос.УстановитьПараметр("ПустойКлючСвязи", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Запрос.УстановитьПараметр("ИспользуютсяАналоги", ИспользуютсяАналоги);
	
	МассивТекстовЗапроса = Новый Массив;
	
	ТекстПорцияРасчета = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Склад КАК Склад,
	|	Товары.Назначение КАК Назначение,
	|	Товары.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ПорцияРасчета
	|ИЗ
	|	&ПорцияРасчета КАК Товары
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Склад,
	|	Назначение
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Склад КАК Склад,
	|	Товары.Назначение КАК Назначение,
	|	Товары.Обособленно КАК Обособленно,
	|	Товары.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ТоварыПоПорции
	|ИЗ (
	|
	|ВЫБРАТЬ
	|
	|	Товары.Номенклатура   КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад,
	|
	|	ТоварыНоменклатура.ОбособленнаяЗакупкаПродажа КАК Обособленно,
	|
	|	ВЫБОР
	|		КОГДА ТоварыНоменклатура.ОбособленнаяЗакупкаПродажа
	|		  ИЛИ Товары.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|			ТОГДА Товары.Назначение
	|		КОГДА ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				ПорцияРасчета КАК ДД
	|			ГДЕ
	|				ДД.Номенклатура = Товары.Номенклатура
	|				И ДД.Характеристика = Товары.Характеристика
	|				И ДД.Склад = Товары.Склад
	|				И ДД.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка))
	|		ИЛИ ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				РегистрСведений.РаспределениеЗапасов КАК ДД
	|			ГДЕ
	|				ДД.СостояниеЗапаса В (&СостояниеЗапасов)
	|				И ДД.ХарактеристикаПотребности = &ХарактеристикаПотребности
	|				И ДД.Номенклатура = Товары.Номенклатура
	|				И ДД.Характеристика = Товары.Характеристика
	|				И ДД.Склад = Товары.Склад
	|				И ДД.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|				И ДД.Количество > 0)
	|		ИЛИ ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				РегистрСведений.СтруктураЗаказа КАК ДД
	|			ГДЕ
	|				ДД.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.СвободныйВыпуск)
	|				И ДД.Номенклатура = Товары.Номенклатура
	|				И ДД.Характеристика = Товары.Характеристика
	|				И ДД.Склад = Товары.Склад
	|				И ДД.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка))
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|		ИНАЧЕ Товары.Назначение
	|	КОНЕЦ КАК Назначение,
	|	Товары.Идентификатор КАК Идентификатор
	|
	|ИЗ
	|	ПорцияРасчета КАК Товары
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ТоварыНоменклатура
	|		ПО Товары.Номенклатура = ТоварыНоменклатура.Ссылка
	|
	|) КАК Товары
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Назначение";
	
	ТекстАналогиМатериалов = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СвязиМатериаловИАналогов.Номенклатура КАК Номенклатура,
	|	СвязиМатериаловИАналогов.Характеристика КАК Характеристика,
	|	СвязиМатериаловИАналогов.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ СвязанныеАналогиМатериалов
	|ИЗ
	|	ТоварыПоПорции КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СвязиНоменклатурыПоРазрешениямНаЗамену КАК СвязиМатериаловИАналогов
	|		ПО (Товары.Идентификатор = СвязиМатериаловИАналогов.Идентификатор)
	|ГДЕ
	|	&ИспользуютсяАналоги
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Идентификатор";
	
	ТекстДополнениеАналогами = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СвязанныеАналогиМатериалов.Номенклатура КАК Номенклатура,
	|	СвязанныеАналогиМатериалов.Характеристика КАК Характеристика,
	|	Товары.Склад КАК Склад,
	|	Товары.Назначение КАК Назначение,
	|	Товары.Обособленно КАК Обособленно,
	|	Товары.Идентификатор КАК Идентификатор
	|ДОБАВИТЬ ТоварыПоПорции
	|ИЗ
	|	ТоварыПоПорции КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СвязанныеАналогиМатериалов КАК СвязанныеАналогиМатериалов
	|		ПО (Товары.Идентификатор = СвязанныеАналогиМатериалов.Идентификатор)";
	
	МассивТекстовЗапроса.Добавить(ТекстПорцияРасчета);
	МассивТекстовЗапроса.Добавить(ТекстАналогиМатериалов);
	
	Если ИспользуютсяАналоги Тогда
		МассивТекстовЗапроса.Добавить(ТекстДополнениеАналогами);
	КонецЕсли;
	
	ТекстНоменклатурныйПлан = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	Товары.Назначение КАК Назначение,
	|	Товары.Обособленно КАК Обособленно,
	|	Товары.Идентификатор КАК Идентификатор
	|ПОМЕСТИТЬ ВсеТовары
	|ИЗ (
	|
	|ВЫБРАТЬ
	|
	|	Товары.Номенклатура   КАК Номенклатура,
	|	Товары.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				ТоварыПоПорции КАК ДД
	|			ГДЕ
	|				ДД.Номенклатура = Товары.Номенклатура
	|				И ДД.Характеристика = Товары.Характеристика
	|				И ДД.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка))
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|		ИНАЧЕ Товары.Назначение
	|	КОНЕЦ КАК Назначение,
	|	Товары.Обособленно КАК Обособленно,
	|	Товары.Идентификатор КАК Идентификатор
	|
	|ИЗ
	|	ТоварыПоПорции КАК Товары
	|
	|) КАК Товары
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура,
	|	Характеристика,
	|	Назначение
	|;
	|ВЫБРАТЬ
	|
	|	АвтоНомерЗаписи() КАК ИндексСтроки,
	|
	|	Товары.Идентификатор         КАК Идентификатор,
	|	Движения.Номенклатура        КАК Номенклатура,
	|	Движения.Характеристика      КАК Характеристика,
	|	Движения.Склад               КАК Склад,
	|	Движения.Назначение          КАК Назначение,
	|	Движения.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	Движения.КлючНоменклатура    КАК КлючНоменклатура,
	|
	|	СУММА(Движения.КОбеспечению) КАК КОбеспечению,
	|	СУММА(Движения.Заменено) КАК Заменено,
	|	СУММА(Движения.Заказано)
	|		- СУММА(ВЫБОР
	|			КОГДА Движения.ВидСтроки В (ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции),
	|										ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Разборка))
	|				ТОГДА Движения.РаспределеноИзПартий + Движения.РаспределеноИзПартийОбособленно
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Заказано,
	|	СУММА(ВЫБОР
	|			КОГДА НЕ Движения.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.СвободныйВыпуск) ТОГДА
	|				Движения.Запланировано + Движения.РазборкаЗапланировано
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ) КАК Запланировано,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Перемещение) ТОГДА
	|				Движения.Запланировано + Движения.РазборкаЗапланировано
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ) КАК ЗапланированоПереместить,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.СвободныйВыпуск) ТОГДА
	|				Движения.Запланировано
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ) КАК СвободныйВыпуск,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Зарезервировано)
	|					И Движения.ЗаказНаПоступление = НЕОПРЕДЕЛЕНО
	|				ТОГДА Движения.РаспределеноИзЗапасов + Движения.РаспределеноИзЗапасовОбособленно
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК РаспределеноИзНаличияНаСкладе,
	|	СУММА(ВЫБОР
	|		КОГДА Движения.ВидСтроки В (
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката))
	|				ТОГДА Движения.Запланировано
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ) КАК КонтрольОграниченияЗацикливания,
	|
	|	МАКСИМУМ(Товары.Назначение) КАК НазначениеГруппировка,
	|
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки В (
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Продукция),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Разборка))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ЭтоПродукция,
	|
	|	МИНИМУМ(Движения.ЗаказНаПоступление) КАК ЗаказНаПоступление,
	|	МИНИМУМ(Движения.ДатаПоступления) КАК ДатаПоступления,
	|	
	|	МИНИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки НЕ В (
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Разборка),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Перемещение))
	|			ТОГДА Движения.КлючПартия
	|	КОНЕЦ) КАК КлючПартия,
	|	
	|	МИНИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки НЕ В (
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Разборка),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Перемещение))
	|			ТОГДА Движения.Этап
	|	КОНЕЦ) КАК Этап,
	|
	|	МИНИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки НЕ В (
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Разборка),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Перемещение))
	|			ТОГДА Движения.Подразделение
	|	КОНЕЦ) КАК Подразделение,
	|
	|	МАКСИМУМ(Движения.НазначениеСтруктуры) КАК НазначениеСтруктуры,
	|
	|	ISNULL(МИНИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки В (
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Продукция),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление))
	|			ТОГДА Движения.Уровень
	|	КОНЕЦ), 0) КАК Уровень,
	|
	|	ISNULL(МИНИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки В (
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Продукция),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.СвободныйВыпуск))
	|			ТОГДА Движения.ДлительностьДоВыпуска
	|	КОНЕЦ), 0) КАК ДлительностьДоВыпуска,
	|
	|	ISNULL(МИНИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки В (
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Продукция),
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление))
	|			ТОГДА Движения.ИдентификаторВГруппеИзделий
	|	КОНЕЦ), 0) КАК ИдентификаторВГруппеИзделий,
	|
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление) ТОГДА
	|			Движения.Спецификация
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
	|	КОНЕЦ) КАК Спецификация,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление) ТОГДА
	|			Движения.КлючСвязиСтрокаСпецификации
	|		ИНАЧЕ
	|			&ПустойКлючСвязи
	|	КОНЕЦ) КАК КлючСвязиСтрокаСпецификации,
	|
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление)
	|			И Движения.РазрешениеНаЗамену <> ЗНАЧЕНИЕ(Документ.РазрешениеНаЗаменуМатериалов.ПустаяСсылка) ТОГДА
	|			&ПустойКлючСвязи
	|		ИНАЧЕ
	|			Движения.КлючСвязиПеремещение
	|	КОНЕЦ) КАК КлючСвязиПеремещение,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Движения.РазрешениеНаЗамену = ЗНАЧЕНИЕ(Документ.РазрешениеНаЗаменуМатериалов.ПустаяСсылка)
	|			ИЛИ Движения.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление)
	|		ТОГДА Движения.КлючСвязиПеремещение
	|		ИНАЧЕ &ПустойКлючСвязи
	|	КОНЕЦ) КАК КлючСвязиПотребности,
	|	МАКСИМУМ(Движения.РазрешениеНаЗамену <> ЗНАЧЕНИЕ(Документ.РазрешениеНаЗаменуМатериалов.ПустаяСсылка)) КАК ЭтоАналог,
	|	МАКСИМУМ(Движения.СпецификацияПолуфабриката) КАК СпецификацияПолуфабриката,
	|
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки В (
	|				ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление))
	|			ТОГДА Движения.КоличествоНаЕдиницуПартииЗапуска
	|	КОНЕЦ) КАК КоличествоНаЕдиницуПартииЗапуска,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА Движения.КОбеспечению > 0
	|				ТОГДА Движения.КлючНабор
	|		КОНЕЦ) КАК КлючНабор,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Движения.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление)
	|		И Движения.КлючСвязиПеремещение = &ПустойКлючСвязи ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ) КАК ИсходнаяПотребность
	|	
	|ПОМЕСТИТЬ НоменклатурныйПлан
	|
	|ИЗ
	|	ВсеТовары КАК Товары
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураЗаказа КАК Движения
	|	ПО Товары.Номенклатура   = Движения.Номенклатура
	|	 И Товары.Характеристика = Движения.Характеристика
	|	 И (Товары.Назначение    = Движения.Назначение
	|		ИЛИ Не Товары.Обособленно И Товары.Назначение В (Движения.НазначениеСтруктуры, ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)))
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Идентификатор, Движения.Номенклатура, Движения.Характеристика, Движения.Склад, Движения.Назначение,
	|	Движения.ЗаказНаПроизводство, Движения.КлючНоменклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура, Характеристика, Склад, Назначение, ЗаказНаПроизводство, КлючНоменклатура, КлючПартия";
	
	МассивТекстовЗапроса.Добавить(ТекстНоменклатурныйПлан);
	
	Запрос.Текст = СтрСоединить(МассивТекстовЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Запрос.Выполнить();
	
	ПолучитьИПоместитьВКэшСпособыОбеспечения(МенеджерВременныхТаблиц, "НоменклатурныйПлан");
	
	МассивТекстовЗапроса.Очистить();
	
	ТекстЗапросаРезультирующиеТаблицы = 
	"ВЫБРАТЬ
	|
	|	График.Номенклатура     КАК Номенклатура,
	|	График.Характеристика   КАК Характеристика,
	|	График.Склад            КАК Склад,
	|	График.Назначение       КАК Назначение,
	|
	|	График.ЗаказНаПоступление КАК ЗаказНаПоступление,
	|	График.ДатаДоступности    КАК ДатаДоступности,
	|
	|	График.Количество КАК Доступно
	|
	|ПОМЕСТИТЬ График
	|ИЗ
	|	ВсеТовары КАК Товары
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК График
	|	ПО Товары.Номенклатура   = График.Номенклатура
	|	 И Товары.Характеристика = График.Характеристика
	|	 И (Товары.Назначение = График.Назначение
	|		ИЛИ Не Товары.Обособленно И Товары.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка))
	|
	|ГДЕ
	|	График.Количество > 0
	|		И График.СостояниеЗапаса В (&СостояниеЗапасов)
	|		И График.ХарактеристикаПотребности = &ХарактеристикаПотребности
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура, Характеристика, Склад, Назначение
	|;
	|УНИЧТОЖИТЬ ПорцияРасчета
	|;
	|УНИЧТОЖИТЬ ТоварыПоПорции
	|;
	|	
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	План.ЗаказНаПроизводство КАК Ссылка
	|ПОМЕСТИТЬ ВсеЗаказы
	|ИЗ
	|	НоменклатурныйПлан КАК План
	|;"  + ?(ИспользуютсяАналоги, ТекстЗапросаАналогиМатериалов(Запрос), "")
	 + СтруктураЗаказаСлужебный.ТекстЗапросаВременнаяТаблицаОчередьЗаказов("ВсеЗаказы", "Очередь")
	 + "ВЫБРАТЬ
	|	НоменклатурныйПлан.КлючСвязиПеремещение КАК КлючСвязиПеремещение,
	|	НоменклатурныйПлан.КлючСвязиПотребности КАК КлючСвязиПотребности
	|ПОМЕСТИТЬ ЗаменаКлючей
	|ИЗ
	|	НоменклатурныйПлан КАК НоменклатурныйПлан
	|ГДЕ 
	|	&ИспользуютсяАналоги 
	|	И НоменклатурныйПлан.ЭтоАналог
	|	И НоменклатурныйПлан.КОбеспечению > 0
	|	И НоменклатурныйПлан.Спецификация <> ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючСвязиПеремещение
	|
	|;
	|ВЫБРАТЬ
	|	НоменклатурныйПлан.Номенклатура КАК Номенклатура,
	|	НоменклатурныйПлан.Характеристика КАК Характеристика,
	|	НоменклатурныйПлан.Склад КАК Склад,
	|	НоменклатурныйПлан.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	НоменклатурныйПлан.КлючНоменклатура КАК КлючНоменклатура,
	|	НоменклатурныйПлан.КлючПартия КАК КлючПартия,
	|	НоменклатурныйПлан.КлючНабор КАК КлючНабор,
	|	ЕСТЬNULL(ЗаменаКлючей.КлючСвязиПотребности, НоменклатурныйПлан.КлючСвязиПеремещение) КАК КлючСвязиПеремещение
	|ИЗ
	|	НоменклатурныйПлан КАК НоменклатурныйПлан
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗаменаКлючей КАК ЗаменаКлючей
	|		ПО НоменклатурныйПлан.КлючСвязиПеремещение = ЗаменаКлючей.КлючСвязиПеремещение
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КэшНСИ.Номенклатура.СхемаОбеспечения КАК СхемаОбеспечения,
	|	ЕСТЬNULL(КэшНСИ.СпособОбеспечения.ДлительностьВДнях, 0) * 86400 КАК ДлительностьПеремещения,
	|	КэшНСИ.Склад КАК СкладПолучатель,
	|	КэшНСИ.СпособОбеспечения.ИсточникОбеспеченияПотребностей КАК СкладОтправитель
	|ИЗ
	|	НоменклатурныйПлан КАК План
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КэшНСИСтруктурыЗаказа КАК КэшНСИ
	|		ПО План.Номенклатура = КэшНСИ.Номенклатура
	|			И План.Характеристика = КэшНСИ.Характеристика
	|			И План.ЗаказНаПроизводство = КэшНСИ.ЗаказНаПроизводство
	|ГДЕ
	|	КэшНСИ.Запланировать
	|;
	|
	|ВЫБРАТЬ
	|
	|	График.Номенклатура       КАК Номенклатура,
	|	График.Характеристика     КАК Характеристика,
	|	График.Склад              КАК Склад,
	|	График.Назначение         КАК Назначение,
	|
	|	График.ЗаказНаПоступление КАК ЗаказНаПоступление,
	|	График.ДатаДоступности    КАК ДатаПоступления,
	|
	|	ВЫБОР
	|		КОГДА График.ДатаДоступности = ДАТАВРЕМЯ(1,1,1) И График.ЗаказНаПоступление = НЕОПРЕДЕЛЕНО ТОГДА
	|			1
	|		КОГДА График.ДатаДоступности <> ДАТАВРЕМЯ(1,1,1) И График.ЗаказНаПоступление <> НЕОПРЕДЕЛЕНО ТОГДА
	|			2
	|		ИНАЧЕ
	|			3
	|	КОНЕЦ КАК ТипЗапаса,
	|	
	|	График.Доступно КАК Доступно,
	|
	|	-1 КАК НомерОчереди,
	|	-1 КАК ПорядокНормативногоГрафика
	|	
	|ИЗ
	|	График КАК График
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|
	|	План.Номенклатура       КАК Номенклатура,
	|	План.Характеристика     КАК Характеристика,
	|	План.Склад              КАК Склад,
	|	План.Назначение         КАК Назначение,
	|
	|	План.ЗаказНаПоступление КАК ЗаказНаПоступление,
	|	План.ДатаПоступления    КАК ДатаПоступления,
	|
	|	5 КАК ТипЗапаса,
	|	
	|	План.СвободныйВыпуск КАК Доступно,
	|
	|	ISNULL(Очередь.НомерОчереди, 0)        КАК НомерОчереди,
	|	ISNULL(-План.ДлительностьДоВыпуска, 0) КАК ПорядокНормативногоГрафика
	|	
	|ИЗ
	|	НоменклатурныйПлан КАК План
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Очередь КАК Очередь
	|		ПО Очередь.Ссылка = План.ЗаказНаПроизводство
	|	
	|ГДЕ
	|	План.СвободныйВыпуск > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура, Характеристика, Склад, Назначение, ТипЗапаса, НомерОчереди, ПорядокНормативногоГрафика, ДатаПоступления, ЗаказНаПоступление
	|;
	|
	|ВЫБРАТЬ
	|
	|	План.ИндексСтроки КАК ИндексСтроки,
	|
	|	План.Номенклатура   КАК Номенклатура,
	|	План.Номенклатура.СхемаОбеспечения КАК СхемаОбеспечения,
	|	План.Характеристика КАК Характеристика,
	|	План.Склад          КАК Склад,
	|
	|	ВЫБОР
	|		КОГДА План.Назначение <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) ТОГДА
	|			План.Назначение
	|		ИНАЧЕ
	|			План.НазначениеСтруктуры
	|	КОНЕЦ КАК Назначение,
	|	ВЫБОР
	|		КОГДА План.Назначение <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ КАК Обособленно,
	|
	|	План.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	План.КлючПартия          КАК КлючПартия,
	|	План.КлючНоменклатура    КАК КлючНоменклатура,
	|	План.КоличествоНаЕдиницуПартииЗапуска КАК КоличествоНаЕдиницуПартииЗапуска,
	|
	|	План.КОбеспечению КАК Требуется,
	|	План.Запланировано КАК Запланировано,
	|	План.КонтрольОграниченияЗацикливания КАК КонтрольОграниченияЗацикливания,
	|	План.ИдентификаторВГруппеИзделий КАК ИдентификаторВГруппеИзделий,
	|
	|	ISNULL(Очередь.НомерОчереди, 0)        КАК НомерОчереди,
	|	ISNULL(-План.ДлительностьДоВыпуска, 0) КАК ПорядокНормативногоГрафика
	|	
	|ИЗ
	|	НоменклатурныйПлан КАК План
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ Очередь КАК Очередь
	|		ПО Очередь.Ссылка = План.ЗаказНаПроизводство
	|
	|ГДЕ
	|	План.ИсходнаяПотребность И План.КОбеспечению > 0 И НЕ План.ЭтоПродукция
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура, Характеристика, Склад, План.НазначениеГруппировка УБЫВ, НомерОчереди, Назначение УБЫВ, Обособленно УБЫВ, ПорядокНормативногоГрафика,
	|	  ВЫБОР
	|			КОГДА План.Этап ССЫЛКА Документ.ЭтапПроизводства2_2 ТОГДА
	|				1
	|			ИНАЧЕ
	|				2
	|	  КОНЕЦ,
	|	  ВЫБОР
	|			КОГДА План.Этап ССЫЛКА Документ.ЭтапПроизводства2_2 ТОГДА
	|				План.Этап
	|			ИНАЧЕ
	|				NULL
	|	  КОНЕЦ,
	|	  ИдентификаторВГруппеИзделий,
	|	  КлючПартия,
	|	  КлючНоменклатура
	|;
	|УНИЧТОЖИТЬ ВсеЗаказы; УНИЧТОЖИТЬ Очередь;
	|";
	
	МассивТекстовЗапроса.Добавить(ТекстЗапросаРезультирующиеТаблицы);
	
	Запрос.Текст = СтрСоединить(МассивТекстовЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	КоличествоПакетов = РезультатЗапроса.Количество();
	
	Если ИспользуютсяАналоги Тогда
		ДанныеОбАналогах = ДанныеОбАналогахДляРасчетаСтруктурыЗаказа(МенеджерВременныхТаблиц);
	Иначе
		ДанныеОбАналогах = Неопределено;
	КонецЕсли;

	РезультатРаспределения = Новый ТаблицаЗначений();
	РезультатРаспределения.Колонки.Добавить("ИндексСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(10,0));
	РезультатРаспределения.Колонки.Добавить("Назначение", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.Назначение.Тип);
	РезультатРаспределения.Колонки.Добавить("ДатаПоступления", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.ДатаПоступления.Тип);
	РезультатРаспределения.Колонки.Добавить("ЗаказНаПоступление", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.ЗаказНаПоступление.Тип);
	РезультатРаспределения.Колонки.Добавить("Распределено", ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	РезультатРаспределения.Колонки.Добавить("Номенклатура", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.Номенклатура.Тип);
	РезультатРаспределения.Колонки.Добавить("Характеристика", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.Характеристика.Тип);
	РезультатРаспределения.Колонки.Добавить("Склад", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.Склад.Тип);
	РезультатРаспределения.Колонки.Добавить("РазрешениеНаЗамену", Метаданные.РегистрыСведений.СтруктураЗаказа.Реквизиты.РазрешениеНаЗамену.Тип);
	РезультатРаспределения.Колонки.Добавить("ТипЗаписи", ОбщегоНазначения.ОписаниеТипаЧисло(1,0));
	РезультатРаспределения.Колонки.Добавить("КлючНоменклатура", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.КлючНоменклатура.Тип);
	РезультатРаспределения.Колонки.Добавить("КлючПартия", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.КлючПартия.Тип);
	РезультатРаспределения.Колонки.Добавить("КлючНабор", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.КлючНабор.Тип);
	РезультатРаспределения.Колонки.Добавить("КлючСвязиПеремещение", Метаданные.РегистрыСведений.СтруктураЗаказа.Реквизиты.КлючСвязиПеремещение.Тип);
	РезультатРаспределения.Колонки.Добавить("КлючСвязиАналог", Метаданные.РегистрыСведений.СтруктураЗаказа.Реквизиты.КлючСвязиПеремещение.Тип);
	РезультатРаспределения.Колонки.Добавить("КлючНоменклатураПотребности", Метаданные.РегистрыСведений.СтруктураЗаказа.Реквизиты.КлючСвязиПеремещение.Тип);
	РезультатРаспределения.Колонки.Добавить("ДлительностьПеремещения", ОбщегоНазначения.ОписаниеТипаЧисло(14, 4));
	РезультатРаспределения.Колонки.Добавить("КоличествоНаЕдиницуПартииЗапуска", Метаданные.РегистрыСведений.СтруктураЗаказа.Реквизиты.КоличествоНаЕдиницуПартииЗапуска.Тип);
	
	РаспределитьЗапасы(РезультатЗапроса[КоличествоПакетов-3], РезультатЗапроса[КоличествоПакетов-4], РезультатЗапроса[КоличествоПакетов-5], РезультатРаспределения, ДанныеОбАналогах, РезультатЗапроса[КоличествоПакетов-6]);
	ПоместитьРезультатРаспределенияЗапасовВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, РезультатРаспределения, ПараметрыРасчета.РассчитыватьИзменения);
	РезультатРаспределения = Неопределено;
	
	РассчитатьИзмененияИЗаписатьРезультатРаспределенияЗапасов(МенеджерВременныхТаблиц, ПараметрыРасчета);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|
	|	План.Номенклатура        КАК Номенклатура,
	|	План.Характеристика      КАК Характеристика,
	|	План.Склад               КАК Склад,
	|	План.Назначение          КАК Назначение,
	|	План.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|
	|	КэшНСИ.ТипОбеспечения    КАК ТипОбеспечения,
	|	КэшНСИ.Спецификация      КАК Спецификация,
	|
	|	КэшНСИ.ИдентификаторОшибки КАК ИдентификаторОшибки
	|
	|ПОМЕСТИТЬ ПланПроизводства
	|ИЗ
	|	РасчетИзменений КАК План
	|
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КэшНСИСтруктурыЗаказа КАК КэшНСИ
	|	ПО План.Номенклатура        = КэшНСИ.Номенклатура
	|	 И План.Характеристика      = КэшНСИ.Характеристика
	|	 И План.Склад               = КэшНСИ.Склад
	|	 И План.Назначение          = КэшНСИ.Назначение
	|	 И План.ЗаказНаПроизводство = КэшНСИ.ЗаказНаПроизводство
	|	 И КэшНСИ.Запланировать
	|	И (КэшНСИ.ТипОбеспечения = ЗНАЧЕНИЕ(Перечисление.ТипыОбеспечения.Производство))
	|
	|
	|ГДЕ
	|	ВЫБОР
	|		КОГДА План.ЭтоПродукция ИЛИ КэшНСИ.ЭтоРазбираемоеИзделие ТОГДА // ограничение зацикливания разборки
	|			План.Заказано <> План.Запланировано
	|		ИНАЧЕ
	|			План.КоличествоКПроизводству <> 0
	|	КОНЕЦ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Спецификация";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() И Выборка.Количество > 0 Тогда
		ЗапланироватьПроизводство(ПараметрыРасчета, МенеджерВременныхТаблиц, "ПланПроизводства", ПараметрыДействия.Очередь);
	КонецЕсли;
	
КонецПроцедуры

Процедура РаспределитьЗапасы(РезультатТребуется, РезультатЗапасы, РезультатСклады, РезультатРаспределения, ТаблицаРазрешений, РезультатКэшКлючейПартий)
	
	Если РезультатТребуется.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ГрафикТовары = СкопироватьКолонки(РезультатЗапасы.Колонки, "Номенклатура,Характеристика,Склад,Назначение");
	
	ГрафикТовары.Колонки.Добавить("ЭтоАналог",      Новый ОписаниеТипов("Булево"));
	ГрафикТовары.Колонки.Добавить("ГрафикРазряжен", Новый ОписаниеТипов("Булево"));
	ГрафикТовары.Колонки.Добавить("Индекс",         Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	ГрафикТовары.Колонки.Добавить("Граница",        Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	
	ГрафикЕстьДоступно = Неопределено;
	
	График = РезультатЗапасы.Выгрузить();
	Индекс = 0;
		
	ГрафикТовара = Неопределено;
	
	Пока График.Количество() > Индекс Цикл
		
		ТекущаяСтрока = График[Индекс];
		
		Если НЕ (Индекс > 0
			 И ГрафикТовара.Номенклатура   = ТекущаяСтрока.Номенклатура
			 И ГрафикТовара.Характеристика = ТекущаяСтрока.Характеристика
			 И ГрафикТовара.Склад          = ТекущаяСтрока.Склад
			 И ГрафикТовара.Назначение     = ТекущаяСтрока.Назначение)  Тогда

			ГрафикТовара = ГрафикТовары.Добавить();
			ЗаполнитьЗначенияСвойств(ГрафикТовара, ТекущаяСтрока);
			ГрафикТовара.Индекс = Индекс;

		КонецЕсли;
		
		Индекс               = Индекс + 1;
		ГрафикТовара.Граница = Индекс;
		
	КонецЦикла;
	
	НаличиеОстатков = График.Скопировать(,"Номенклатура, Характеристика, Склад");
	НаличиеОстатков.Свернуть("Номенклатура, Характеристика, Склад");
	НаличиеОстатков.Индексы.Добавить("Номенклатура, Характеристика, Склад");
	ПоискНаличиеОстатков = Новый Структура("Номенклатура, Характеристика, Склад");
	
	ТаблицаРасчетаПеремещений = СкопироватьКолонки(РезультатРаспределения.Колонки, "ИндексСтроки,Номенклатура,Характеристика,РазрешениеНаЗамену,КлючНоменклатура,КлючПартия,Склад");
	ТаблицаРасчетаПеремещений.Колонки.Добавить("ПорядковыйНомер", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	ТаблицаРасчетаПеремещений.Колонки.Добавить("ЗаказНаПроизводство", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.ЗаказНаПроизводство.Тип);
	ТаблицаРасчетаПеремещений.Колонки.Добавить("КоличествоНаЕдиницуПартииЗапуска", Метаданные.РегистрыСведений.СтруктураЗаказа.Реквизиты.КоличествоНаЕдиницуПартииЗапуска.Тип);

	ТаблицаСкладов = РезультатСклады.Выгрузить();
	ТаблицаСкладов.Индексы.Добавить("СхемаОбеспечения, СкладПолучатель");
	
	ЦепочкаСкладов = Новый ТаблицаЗначений;
	ЦепочкаСкладов.Колонки.Добавить("СкладОтправитель", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.Склад.Тип);
	ЦепочкаСкладов.Колонки.Добавить("СкладПолучатель", Метаданные.РегистрыСведений.СтруктураЗаказа.Измерения.Склад.Тип);
	ЦепочкаСкладов.Колонки.Добавить("ДлительностьПеремещения", ОбщегоНазначения.ОписаниеТипаЧисло(14, 4));
	ЦепочкаСкладов.Колонки.Добавить("ПорядковыйНомер", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	
	ПоискСкладов = Новый Структура("СхемаОбеспечения, СкладПолучатель");
	ПоискСкладовСравнение = Новый Структура("СхемаОбеспечения, СкладПолучатель");
	
	СоответствиеЦепочекСкладов = Новый Соответствие;
	МассивСкладовПроверкаЗацикливания = Новый Массив;
	ДлительностьПеремещенияСумма = 0;
	
	ИтерацияРаспределениеМатериалов = "Материалы";
	ИтерацияРаспределениеПриоритетныхАналогов = "ПриоритетныеАналоги";
	ИтерацияРаспределениеОбычныхАналогов = "ОбычныеАналоги";
	
	ИтерацииРаспределенияЗапасов = Новый Массив;
	ИтерацииРаспределенияЗапасов.Добавить(ИтерацияРаспределениеМатериалов);
	
	ЕстьАналоги = ТипЗнч(ТаблицаРазрешений) = Тип("ТаблицаЗначений") И ТаблицаРазрешений.Количество() > 0;
	
	Если ЕстьАналоги Тогда
		ИтерацииРаспределенияЗапасов.Вставить(0, ИтерацияРаспределениеПриоритетныхАналогов);
		ИтерацииРаспределенияЗапасов.Добавить(ИтерацияРаспределениеОбычныхАналогов);
		ТаблицаРазрешений.Индексы.Добавить("Номенклатура, Характеристика, Ссылка, ПриоритетныйАналог");
	КонецЕсли;
		
	ТребуетсяОстаток = Неопределено;
	
	ПоискРазрешений = Новый Структура("Номенклатура, Характеристика, Ссылка, ПриоритетныйАналог");
	АналитикаАналога = Новый Структура("Номенклатура, Характеристика, Склад, Назначение");
	
	ГрафикТовары.Индексы.Добавить("Номенклатура,Характеристика,Склад,Назначение");
	
	ТипЗаписиРаспределениеЗапасовРезерв = ТипЗаписиРаспределениеЗапасовРезерв();
	ТипЗаписиРаспределениеЗапасовТребуетсяПеремещение = ТипЗаписиРаспределениеЗапасовТребуетсяПеремещение();
	ТипЗаписиРаспределениеЗапасовТребуетсяПотребление =  ТипЗаписиРаспределениеЗапасовТребуетсяПотребление();
	ТипЗаписиРаспределениеЗапасовЗакрытиеПотребности = ТипЗаписиРаспределениеЗапасовЗакрытиеПотребности();
	ТипЗаписиРаспределениеЗапасовЗамена = ТипЗаписиРаспределениеЗапасовЗамена();
	ТипЗаписиРаспределениеЗапасовНеОбеспечивать = ТипЗаписиРаспределениеЗапасовНеОбеспечивать();
	
	Требуется = Неопределено;
	Индекс = -1;
	Граница = -1;
	
	Аналитика = Новый Структура("Номенклатура,Характеристика,Склад,Назначение");
	ПустойКлючСвязи = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	ЕстьЗацикливаниеЦепочки = Ложь;
	
	ТаблицаКэшКлючейПартийПеремещений = РезультатКэшКлючейПартий.Выгрузить();
	ТаблицаКэшКлючейПартийПеремещений.Индексы.Добавить("Номенклатура, Характеристика, Склад, ЗаказНаПроизводство, КлючСвязиПеремещение");
	ПоискКлючейПартий = Новый Структура("Номенклатура, Характеристика, Склад, ЗаказНаПроизводство, КлючСвязиПеремещение");
	РезультатРаспределенияНеОбеспечивать = РезультатРаспределения.СкопироватьКолонки();

	Выборка = РезультатТребуется.Выбрать();

	ЕстьЗаписиВВыборке = Выборка.Следующий();
	
	Пока ЕстьЗаписиВВыборке Цикл
		
		ПоискКлючейПартий.ЗаказНаПроизводство = Выборка.ЗаказНаПроизводство;
		ПоискКлючейПартий.КлючСвязиПеремещение = Выборка.КлючНоменклатура;
		ПоискСкладов.СхемаОбеспечения = Выборка.СхемаОбеспечения;
		ПоискСкладов.СкладПолучатель = Выборка.Склад;
		
		ПерезаполнитьДанныеСкладов = НЕ (ПоискСкладов.СхемаОбеспечения = ПоискСкладовСравнение.СхемаОбеспечения
			И ПоискСкладов.СкладПолучатель = ПоискСкладовСравнение.СкладПолучатель);
		ИндексСклада = 1;
		
		Если ПерезаполнитьДанныеСкладов Тогда
			
			ЕстьЗацикливаниеЦепочки = Ложь;
			ДлительностьПеремещенияСумма = 0;
			ЦепочкаСкладов.Очистить();
			МассивСкладовПроверкаЗацикливания.Очистить();
			МассивСкладовПроверкаЗацикливания.Добавить(Выборка.Склад);
			
			НоваяСтрокаЦепочки = ЦепочкаСкладов.Добавить();
			НоваяСтрокаЦепочки.СкладОтправитель = Выборка.Склад;
			НоваяСтрокаЦепочки.ПорядковыйНомер = ИндексСклада;
		
		КонецЕсли;
		
		Пока ПерезаполнитьДанныеСкладов Цикл
		
			НайденныеСклады = ТаблицаСкладов.НайтиСтроки(ПоискСкладов);
			ДобавленСклад = Ложь;
		
			Для каждого СтрокаТаблицыСкладов Из НайденныеСклады Цикл
				
				Если МассивСкладовПроверкаЗацикливания.Найти(СтрокаТаблицыСкладов.СкладПолучатель) = Неопределено
				   И ЗначениеЗаполнено(СтрокаТаблицыСкладов.СкладПолучатель)
				   И ТипЗнч(СтрокаТаблицыСкладов.СкладПолучатель) = Тип("СправочникСсылка.Склады") Тогда
					МассивСкладовПроверкаЗацикливания.Добавить(СтрокаТаблицыСкладов.СкладПолучатель);
					ДобавленСклад = Истина;
				КонецЕсли;
				
				Если МассивСкладовПроверкаЗацикливания.Найти(СтрокаТаблицыСкладов.СкладОтправитель) = Неопределено
				   И ЗначениеЗаполнено(СтрокаТаблицыСкладов.СкладОтправитель)
				   И ТипЗнч(СтрокаТаблицыСкладов.СкладОтправитель) = Тип("СправочникСсылка.Склады") Тогда
					МассивСкладовПроверкаЗацикливания.Добавить(СтрокаТаблицыСкладов.СкладОтправитель);
					ДобавленСклад = Истина;
				КонецЕсли;
				
				ПоискСкладов.СкладПолучатель = СтрокаТаблицыСкладов.СкладОтправитель;
				
				Если ДобавленСклад Тогда
					
					ИндексСклада = ИндексСклада + 1;
					
					НоваяСтрокаЦепочки = ЦепочкаСкладов.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаЦепочки, СтрокаТаблицыСкладов);
					ДлительностьПеремещения = ?(СтрокаТаблицыСкладов.ДлительностьПеремещения > 0, СтрокаТаблицыСкладов.ДлительностьПеремещения, 0.0001);
					ДлительностьПеремещенияСумма = ДлительностьПеремещенияСумма + ДлительностьПеремещения;
					НоваяСтрокаЦепочки.ДлительностьПеремещения = ДлительностьПеремещенияСумма;
					НоваяСтрокаЦепочки.ПорядковыйНомер = ИндексСклада;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если НайденныеСклады.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если Не ДобавленСклад И ЗначениеЗаполнено(ПоискСкладов.СкладПолучатель) И ТипЗнч(ПоискСкладов.СкладПолучатель) = Тип("СправочникСсылка.Склады") Тогда
				ЕстьЗацикливаниеЦепочки = Истина;
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
		
		ПоискСкладовСравнение.СхемаОбеспечения = Выборка.СхемаОбеспечения;
		ПоискСкладовСравнение.СкладПолучатель = Выборка.Склад;
				
		СкладПотребности = МассивСкладовПроверкаЗацикливания[МассивСкладовПроверкаЗацикливания.ВГраница()];
		
		ЗамененоВсего = 0;
		ТребуетсяОстаток = Выборка.Требуется;
		ЗаполнитьЗначенияСвойств(Аналитика, Выборка);
		
		Если ЕстьАналоги Тогда
			
			ЗаполнитьЗначенияСвойств(ПоискРазрешений, Аналитика);
			ПоискРазрешений.ПриоритетныйАналог = Истина;
			ПоискРазрешений.Ссылка = Выборка.ИндексСтроки;
			
			ДоступныеПриоритетныеРазрешения = ТаблицаРазрешений.НайтиСтроки(ПоискРазрешений);
			ЕстьПриоритетныеРазрешения = ДоступныеПриоритетныеРазрешения.Количество() > 0;
			
			ПоискРазрешений.ПриоритетныйАналог = Ложь;
			ДоступныеРазрешения = ТаблицаРазрешений.НайтиСтроки(ПоискРазрешений);
			ЕстьОбычныеРазрешения = ДоступныеРазрешения.Количество() > 0;
		
		КонецЕсли;
		
		КлючНоменклатураСкладаПотребности = Неопределено;
		КлючПартияСкладаПотребности = Неопределено;
		ЕстьПеремещения = Ложь;
		
		Для каждого ИтерацияРаспределения Из ИтерацииРаспределенияЗапасов Цикл
			
			Если ТребуетсяОстаток = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если ИтерацияРаспределения = ИтерацияРаспределениеПриоритетныхАналогов 
			 ИЛИ ИтерацияРаспределения = ИтерацияРаспределениеОбычныхАналогов Тогда
			
				КоллекцияРазрешений = ?(ИтерацияРаспределения = ИтерацияРаспределениеПриоритетныхАналогов, ДоступныеПриоритетныеРазрешения, ДоступныеРазрешения);
				ФлагНаличияРазрешений = ?(ИтерацияРаспределения = ИтерацияРаспределениеПриоритетныхАналогов, ЕстьПриоритетныеРазрешения, ЕстьОбычныеРазрешения);
			
				Если ЕстьАналоги И ФлагНаличияРазрешений Тогда
					
					Для каждого СтрокаСкладов Из ЦепочкаСкладов Цикл
						
						Склад = СтрокаСкладов.СкладОтправитель;
						
						Если ТребуетсяОстаток = 0 Тогда
							Прервать;
						КонецЕсли;
						
						Аналитика.Склад = Склад;
						СкладСовпадает = Склад = Выборка.Склад;
						
						Для каждого СтрокаРазрешение Из КоллекцияРазрешений Цикл
							
							КоэффициентРаспределения = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
								СтрокаРазрешение.КонтролироватьКратность, ТребуетсяОстаток, СтрокаРазрешение.КоличествоУпаковок, СтрокаРазрешение.ДанныеУпаковки);
							
							АналогиРазрешения = СтрокаРазрешение.Аналоги;
							
							Для каждого СтрокаАналог Из АналогиРазрешения Цикл
								
								СтрокаАналог.КлючНоменклатураАналог = Новый УникальныйИдентификатор;
								
								ЗаполнитьЗначенияСвойств(АналитикаАналога, Аналитика);
								ЗаполнитьЗначенияСвойств(АналитикаАналога, СтрокаАналог);
								
								ГрафикТовара = ГрафикТовара(ГрафикТовары, АналитикаАналога, Граница, Индекс, Выборка); // СтрокаТаблицыЗначений
								
								УсловиеГрафикТовара = Истина;
								Остаток = 0;
								Пока УсловиеГрафикТовара Цикл
									
									СтрокаАналог.ГрафикиТовара.Добавить(ГрафикТовара);
									ГраницаОбход = Граница;
									ИндексОбход = Индекс;
									
									Пока ГраницаОбход > ИндексОбход Цикл
										
										Запас = График[ИндексОбход];
										
										Если ЗначениеЗаполнено(Запас.ЗаказНаПоступление) 
										   И ИтерацияРаспределения = ИтерацияРаспределениеОбычныхАналогов Тогда
										
											ИндексОбход = ИндексОбход + 1;
											Продолжить;
										
										КонецЕсли;
										
										Остаток = Остаток + Запас.Доступно;
										ИндексОбход = ИндексОбход + 1;
										
									КонецЦикла;
									
									УсловиеГрафикТовара = СледующийГрафикТовара(ГрафикТовара, АналитикаАналога, Граница, Индекс, Выборка);
								
								КонецЦикла;
								
								Коэффициент = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
									СтрокаРазрешение.КонтролироватьКратность, Остаток, СтрокаАналог.КоличествоУпаковок, СтрокаАналог.ДанныеУпаковки);
									
								КоэффициентРаспределения = Мин(КоэффициентРаспределения, Коэффициент);
								
							КонецЦикла;
							
							Если КоэффициентРаспределения > 0 Тогда
								
								ЗамененоПоСтроке = РасчетноеКоличествоНоменклатуры(СтрокаРазрешение.КоличествоУпаковок, КоэффициентРаспределения, СтрокаРазрешение.ДанныеУпаковки);
								ТребуетсяОстаток = ТребуетсяОстаток - ЗамененоПоСтроке;
								ЗамененоВсего = ЗамененоВсего + ЗамененоПоСтроке;
								
								КоэффициентКоличествоНаЕдиницуПартииЗапуска = ПроизводствоКлиентСервер.КоэффициентПоНормативу(
									СтрокаРазрешение.КонтролироватьКратность, Выборка.КоличествоНаЕдиницуПартииЗапуска, СтрокаРазрешение.КоличествоУпаковок, СтрокаАналог.ДанныеУпаковки);
								
								Для каждого СтрокаАналог Из АналогиРазрешения Цикл
									
									ОсталосьРаспределить = РасчетноеКоличествоНоменклатуры(СтрокаАналог.КоличествоУпаковок, КоэффициентРаспределения, СтрокаАналог.ДанныеУпаковки);
									КоличествоНаЕдиницуПартииЗапуска = РасчетноеКоличествоНоменклатуры(СтрокаАналог.КоличествоУпаковок, КоэффициентКоличествоНаЕдиницуПартииЗапуска, СтрокаАналог.ДанныеУпаковки);
									
									СтрокаТаблицыРасчетаПеремещений = ТаблицаРасчетаПеремещений.Добавить();
									СтрокаТаблицыРасчетаПеремещений.РазрешениеНаЗамену = СтрокаРазрешение.Разрешение;
									СтрокаТаблицыРасчетаПеремещений.ИндексСтроки = Выборка.ИндексСтроки;
									СтрокаТаблицыРасчетаПеремещений.ПорядковыйНомер = СтрокаСкладов.ПорядковыйНомер;
									СтрокаТаблицыРасчетаПеремещений.КоличествоНаЕдиницуПартииЗапуска = КоличествоНаЕдиницуПартииЗапуска;
									ЗаполнитьЗначенияСвойств(СтрокаТаблицыРасчетаПеремещений, СтрокаАналог, "Номенклатура, Характеристика");
									ЗаполнитьЗначенияСвойств(СтрокаТаблицыРасчетаПеремещений, Выборка, "КлючНоменклатура, КлючПартия, Склад, ЗаказНаПроизводство");
									ЕстьПеремещения = Истина;
									
									КлючИзКэша = Новый УникальныйИдентификатор;
									ЗаполнитьЗначенияСвойств(ПоискКлючейПартий, СтрокаАналог, "Номенклатура, Характеристика");
									ПоискКлючейПартий.Склад = Склад;
									Для Каждого СтрокаТаблицыКэша Из ТаблицаКэшКлючейПартийПеремещений.НайтиСтроки(ПоискКлючейПартий) Цикл
										
										СтрокаАналог.КлючНоменклатураАналог = СтрокаТаблицыКэша.КлючНоменклатура;
										КлючИзКэша = СтрокаТаблицыКэша.КлючПартия;
										Прервать;
									
									КонецЦикла;
									
									КлючПартия = ?(СкладСовпадает, Выборка.КлючПартия, КлючИзКэша);
									
									Для каждого ГрафикТовара Из СтрокаАналог.ГрафикиТовара Цикл // СтрокаТаблицыЗначений
										
										Если ГрафикТовара = Неопределено Тогда
											Продолжить;
										КонецЕсли;
										
										Индекс = ГрафикТовара.Индекс; // Число
										Граница = ГрафикТовара.Граница; // Число
										
										Пока ОсталосьРаспределить > 0 И Граница > Индекс Цикл
										
											Запас = График[Индекс];
											Если ЗначениеЗаполнено(Запас.ЗаказНаПоступление) 
											   И ИтерацияРаспределения = ИтерацияРаспределениеОбычныхАналогов Тогда
											
												Индекс = Индекс + 1;
												Продолжить;
											
											КонецЕсли;
									
											Распределено = Мин(ОсталосьРаспределить, Запас.Доступно);
											
											Если Распределено > 0 Тогда
											
												Потребность = РезультатРаспределения.Добавить();
												ЗаполнитьЗначенияСвойств(Потребность, Выборка, "ИндексСтроки");
												ЗаполнитьЗначенияСвойств(Потребность, Запас, "Номенклатура,Характеристика,ДатаПоступления,ЗаказНаПоступление,Назначение,Склад");
												Потребность.Распределено = Распределено;
												Потребность.РазрешениеНаЗамену = СтрокаРазрешение.Разрешение;
												Потребность.ДлительностьПеремещения = СтрокаСкладов.ДлительностьПеремещения;
												Потребность.КоличествоНаЕдиницуПартииЗапуска = КоличествоНаЕдиницуПартииЗапуска;
												
												Потребность.КлючНоменклатура = СтрокаАналог.КлючНоменклатураАналог;
												Потребность.КлючПартия = КлючПартия;
												Потребность.КлючНоменклатураПотребности = Выборка.КлючНоменклатура;
												
											Иначе
												
												ГрафикТовара.ГрафикРазряжен = ГрафикТовара.ГрафикРазряжен Или Запас.Доступно > 0;
												
												Если ГрафикЕстьДоступно = Неопределено И Запас.Доступно > 0 Тогда
													ГрафикЕстьДоступно = ГрафикТовара;
												КонецЕсли;
												
												Если Не ГрафикТовара.ГрафикРазряжен Тогда
													Прервать;
												Иначе
													Индекс = Индекс + 1;
													Продолжить;
												КонецЕсли;	
											
											КонецЕсли;
											
											Запас.Доступно = Запас.Доступно - Распределено;
											ОсталосьРаспределить = ОсталосьРаспределить - Распределено;
											
											Если Запас.Доступно > 0 Тогда
												Продолжить;
											Иначе
												Если Индекс = ГрафикТовара.Индекс Тогда
													ГрафикТовара.Индекс = ГрафикТовара.Индекс + 1;
													ГрафикТовара.ГрафикРазряжен = Ложь;
												КонецЕсли;
											КонецЕсли;
											
											Индекс = Индекс + 1;	
										
										КонецЦикла;
										
									КонецЦикла;
									
									СтрокаАналог.ГрафикиТовара.Очистить();
									СтрокаАналог.КлючНоменклатураАналог = ПустойКлючСвязи;
									
								КонецЦикла;
								
							КонецЕсли;
							
						КонецЦикла;	
						
					КонецЦикла;	
				
				КонецЕсли;
				
			Иначе // распределение материалов
				
				ЗаполнитьЗначенияСвойств(ПоискНаличиеОстатков, Выборка, "Номенклатура, Характеристика");
				
				Для каждого СтрокаСкладов Из ЦепочкаСкладов Цикл
					
					Если ТребуетсяОстаток = 0 Тогда
						Прервать;
					КонецЕсли;
					
					Склад = СтрокаСкладов.СкладОтправитель;
					
					ПоискНаличиеОстатков.Склад = Склад;
					ЕстьСтроки = НаличиеОстатков.НайтиСтроки(ПоискНаличиеОстатков).Количество() > 0;
					
					Если Не ЕстьСтроки Тогда
						Продолжить;
					КонецЕсли;
					
					СкладСовпадает = Склад = Выборка.Склад;
					
					Аналитика.Склад = Склад;
					
					КлючИзКэша = Новый УникальныйИдентификатор;
					КлючНоменклатураМатериал = Новый УникальныйИдентификатор;
					ЗаполнитьЗначенияСвойств(ПоискКлючейПартий, Выборка, "Номенклатура, Характеристика");
					ПоискКлючейПартий.Склад = Склад;
					Для Каждого СтрокаТаблицыКэша Из ТаблицаКэшКлючейПартийПеремещений.НайтиСтроки(ПоискКлючейПартий) Цикл
						
						КлючНоменклатураМатериал = СтрокаТаблицыКэша.КлючНоменклатура;
						КлючИзКэша = СтрокаТаблицыКэша.КлючПартия;
						Прервать;
					
					КонецЦикла;
					КлючПартия = ?(СкладСовпадает, Выборка.КлючПартия, КлючИзКэша);
					
					ГрафикТовара = ГрафикТовара(ГрафикТовары, Аналитика, Граница, Индекс, Выборка); // СтрокаТаблицыЗначений
					КлючНоменклатураМатериал = ?(СкладСовпадает, Выборка.КлючНоменклатура, КлючНоменклатураМатериал);
					
					Если Склад = СкладПотребности Тогда
								
						КлючНоменклатураСкладаПотребности = КлючНоменклатураМатериал;
						КлючПартияСкладаПотребности = КлючПартия;
					
					КонецЕсли;
					
					Пока ЕстьЗаписиВВыборке
						И Аналитика.Номенклатура   = Выборка.Номенклатура
						И Аналитика.Характеристика = Выборка.Характеристика
						И Аналитика.Склад          = Склад
						И Аналитика.Назначение     = Выборка.Назначение Цикл
						
						Требуется = ?(Не Требуется = Неопределено, Требуется, ТребуетсяОстаток);
						
						Пока Требуется > 0 И Граница > Индекс Цикл
							
							Запас = График[Индекс];
							
							Если ЗапасДоступен(Выборка, Запас) Тогда
								
								Распределено = Мин(Требуется, Запас.Доступно);

								Потребность = РезультатРаспределения.Добавить();
								ЗаполнитьЗначенияСвойств(Потребность, Выборка, "ИндексСтроки");
								ЗаполнитьЗначенияСвойств(Потребность, Запас, "Номенклатура, Характеристика,ДатаПоступления,ЗаказНаПоступление,Назначение,Склад");
								Потребность.Распределено = Распределено;
								
								Потребность.КлючНоменклатура = КлючНоменклатураМатериал;
								Потребность.КлючПартия = КлючПартия;
								Потребность.ДлительностьПеремещения = СтрокаСкладов.ДлительностьПеремещения;
								Потребность.КлючНоменклатураПотребности = Выборка.КлючНоменклатура;
								
								Если НЕ СкладСовпадает Тогда
											
									СтрокаТаблицыРасчетаПеремещений = ТаблицаРасчетаПеремещений.Добавить();
									СтрокаТаблицыРасчетаПеремещений.РазрешениеНаЗамену = Документы.РазрешениеНаЗаменуМатериалов.ПустаяСсылка();
									СтрокаТаблицыРасчетаПеремещений.ИндексСтроки = Выборка.ИндексСтроки;
									СтрокаТаблицыРасчетаПеремещений.ПорядковыйНомер = СтрокаСкладов.ПорядковыйНомер;
									ЗаполнитьЗначенияСвойств(СтрокаТаблицыРасчетаПеремещений, Выборка, "Номенклатура, Характеристика, КлючНоменклатура, КлючПартия, Склад, ЗаказНаПроизводство");
									ЕстьПеремещения = Истина;
								
								КонецЕсли;
								
							Иначе
								
								ГрафикТовара.ГрафикРазряжен = ГрафикТовара.ГрафикРазряжен Или Запас.Доступно > 0;
								
								Если ГрафикЕстьДоступно = Неопределено И Запас.Доступно > 0 Тогда
									ГрафикЕстьДоступно = ГрафикТовара;
								КонецЕсли;
								
								Если Не ГрафикТовара.ГрафикРазряжен Тогда
									Прервать;
								Иначе
									Индекс = Индекс + 1;
									Продолжить;
								КонецЕсли;
								
							КонецЕсли;
							
							Запас.Доступно = Запас.Доступно - Распределено;
							Требуется = Требуется - Распределено;
							ТребуетсяОстаток = ТребуетсяОстаток - Распределено;
							
							Если Запас.Доступно > 0 Тогда
								Продолжить;
							Иначе
								Если Индекс = ГрафикТовара.Индекс Тогда
									ГрафикТовара.Индекс = ГрафикТовара.Индекс + 1;
									ГрафикТовара.ГрафикРазряжен = Ложь;
								КонецЕсли;
							КонецЕсли;
							
							Индекс = Индекс + 1;
							
						КонецЦикла;
						
						Если Требуется > 0 И СледующийГрафикТовара(ГрафикТовара, Аналитика, Граница, Индекс, Выборка) Тогда
							Продолжить;
						КонецЕсли;
						
						Если ГрафикЕстьДоступно <> Неопределено Тогда
							ГрафикТовара = ГрафикЕстьДоступно;
							Индекс  = ГрафикТовара.Индекс;
							Граница = ГрафикТовара.Граница;
						КонецЕсли;
						
						ГрафикЕстьДоступно = Неопределено;
						Требуется = Неопределено;
						
						Прервать;
						
					КонецЦикла;
					
				КонецЦикла;	
			
			КонецЕсли;	
		
		КонецЦикла;
		
		// Фиксация оставшейся потребности в материале
		
		Если ТребуетсяОстаток > 0 Тогда
			
			Потребность = РезультатРаспределения.Добавить();
			ЗаполнитьЗначенияСвойств(Потребность, Выборка);
			Потребность.ТипЗаписи = ТипЗаписиРаспределениеЗапасовЗакрытиеПотребности;
			Потребность.Склад = СкладПотребности;
			Потребность.Распределено = ТребуетсяОстаток;
			Потребность.КлючНоменклатураПотребности = Выборка.КлючНоменклатура;
			
			КлючИзКэша = Новый УникальныйИдентификатор;
			КлючНоменклатураПотребность = Новый УникальныйИдентификатор;
			ЗаполнитьЗначенияСвойств(ПоискКлючейПартий, Потребность, "Номенклатура, Характеристика, Склад");
			Для Каждого СтрокаТаблицыКэша Из ТаблицаКэшКлючейПартийПеремещений.НайтиСтроки(ПоискКлючейПартий) Цикл
				
				КлючНоменклатураПотребность = СтрокаТаблицыКэша.КлючНоменклатура;
				КлючИзКэша = СтрокаТаблицыКэша.КлючПартия;
				Прервать;
			
			КонецЦикла;
			
			Потребность.КлючНоменклатура = ?(КлючНоменклатураСкладаПотребности <> Неопределено, КлючНоменклатураСкладаПотребности, КлючНоменклатураПотребность);
			Потребность.КлючПартия = ?(КлючПартияСкладаПотребности <> Неопределено, КлючПартияСкладаПотребности, КлючИзКэша);
			Потребность.ДлительностьПеремещения = ДлительностьПеремещенияСумма;
			
			Если НЕ Выборка.Обособленно Тогда
				Потребность.Назначение = Справочники.Назначения.ПустаяСсылка();
			КонецЕсли;
			
			СкладСовпадает = СкладПотребности = Выборка.Склад;
			
			Если НЕ СкладСовпадает Тогда
									
				СтрокаТаблицыРасчетаПеремещений = ТаблицаРасчетаПеремещений.Добавить();
				СтрокаТаблицыРасчетаПеремещений.РазрешениеНаЗамену = Документы.РазрешениеНаЗаменуМатериалов.ПустаяСсылка();
				СтрокаТаблицыРасчетаПеремещений.ИндексСтроки = Выборка.ИндексСтроки;
				СтрокаТаблицыРасчетаПеремещений.ПорядковыйНомер = МассивСкладовПроверкаЗацикливания.Количество();
				ЗаполнитьЗначенияСвойств(СтрокаТаблицыРасчетаПеремещений, Выборка, "Номенклатура, Характеристика, КлючНоменклатура, КлючПартия, Склад, ЗаказНаПроизводство");
				ЕстьПеремещения = Истина;
			
			КонецЕсли;
			
			Если ЕстьЗацикливаниеЦепочки Тогда
				
				Потребность = РезультатРаспределенияНеОбеспечивать.Добавить(); // Запись Перемещение
				ЗаполнитьЗначенияСвойств(Потребность, Выборка);
				Потребность.ТипЗаписи = ТипЗаписиРаспределениеЗапасовТребуетсяПеремещение;
				Потребность.Склад = СкладПотребности;
				Потребность.Распределено = ТребуетсяОстаток;
								
				КлючПартияПеремещениеЗацикливание = Новый УникальныйИдентификатор;
				
				Потребность.КлючНоменклатура = ?(КлючНоменклатураСкладаПотребности <> Неопределено, КлючНоменклатураСкладаПотребности, Новый УникальныйИдентификатор);
				Потребность.КлючПартия = КлючПартияПеремещениеЗацикливание;
				Потребность.ДлительностьПеремещения = ДлительностьПеремещенияСумма;
				
				Если НЕ Выборка.Обособленно Тогда
					Потребность.Назначение = Справочники.Назначения.ПустаяСсылка();
				КонецЕсли;
				
				Потребность = РезультатРаспределенияНеОбеспечивать.Добавить(); // Запись Потребление - Не обеспечивать
				ЗаполнитьЗначенияСвойств(Потребность, Выборка);
				Потребность.ТипЗаписи = ТипЗаписиРаспределениеЗапасовНеОбеспечивать;
				Потребность.Склад = Выборка.Склад;
				Потребность.Распределено = ТребуетсяОстаток;
				
				Потребность.КлючНоменклатура = Новый УникальныйИдентификатор;
				Потребность.КлючПартия = КлючПартияПеремещениеЗацикливание;
				Потребность.ДлительностьПеремещения = ДлительностьПеремещенияСумма;
				
				Если НЕ Выборка.Обособленно Тогда
					Потребность.Назначение = Справочники.Назначения.ПустаяСсылка();
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЕсли;
		
		// Отражение замененного количества
		
		Если ЗамененоВсего > 0 Тогда
		
			Потребность = РезультатРаспределения.Добавить();
			ЗаполнитьЗначенияСвойств(Потребность, Выборка);
			Потребность.Распределено = ЗамененоВсего;
			
			Потребность.ТипЗаписи = ТипЗаписиРаспределениеЗапасовЗамена;
			Потребность.КлючНоменклатураПотребности = Выборка.КлючНоменклатура;
			
		КонецЕсли;
		
		Если ЕстьПеремещения Тогда
		
			СоответствиеЦепочекСкладов.Вставить(Выборка.ИндексСтроки, ЦепочкаСкладов.Скопировать());
		
		КонецЕсли;
			
		ЕстьЗаписиВВыборке = Выборка.Следующий();
		
	КонецЦикла;
	
	// Формирование записей по перемещениям материалов и аналогов
	
	СвязиАналогов = РезультатРаспределения.СкопироватьКолонки("ИндексСтроки, Номенклатура, Характеристика, Склад, РазрешениеНаЗамену, КлючНоменклатура");
		
	Если ТаблицаРасчетаПеремещений.Количество() > 0 Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Таблица.ИндексСтроки КАК ИндексСтроки,
		|	Таблица.Номенклатура КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.РазрешениеНаЗамену КАК РазрешениеНаЗамену,
		|	Таблица.КлючНоменклатура КАК КлючНоменклатура,
		|	Таблица.КлючПартия КАК КлючПартия,
		|	Таблица.Склад КАК Склад,
		|	Таблица.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|	Таблица.КоличествоНаЕдиницуПартииЗапуска КАК КоличествоНаЕдиницуПартииЗапуска,
		|	Таблица.ПорядковыйНомер КАК ПорядковыйНомер
		|ПОМЕСТИТЬ ТаблицаРасчетаПеремещений
		|ИЗ
		|	&ТаблицаРасчетаПеремещений КАК Таблица
		|
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Таблица.ИндексСтроки КАК ИндексСтроки,
		|	Таблица.Номенклатура КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.РазрешениеНаЗамену КАК РазрешениеНаЗамену,
		|	Таблица.КлючНоменклатура КАК КлючНоменклатура,
		|	Таблица.КлючПартия КАК КлючПартия,
		|	Таблица.Склад КАК Склад,
		|	Таблица.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|	Таблица.КоличествоНаЕдиницуПартииЗапуска КАК КоличествоНаЕдиницуПартииЗапуска,
		|	МАКСИМУМ(Таблица.ПорядковыйНомер) КАК ПорядковыйНомер
		|ИЗ
		|	ТаблицаРасчетаПеремещений КАК Таблица
		|
		|СГРУППИРОВАТЬ ПО
		|	Таблица.ИндексСтроки,
		|	Таблица.Номенклатура,
		|	Таблица.Характеристика,
		|	Таблица.РазрешениеНаЗамену,
		|	Таблица.КлючНоменклатура,
		|	Таблица.КлючПартия,
		|	Таблица.Склад,
		|	Таблица.ЗаказНаПроизводство,
		|	Таблица.КоличествоНаЕдиницуПартииЗапуска";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("ТаблицаРасчетаПеремещений", ТаблицаРасчетаПеремещений);
		ТаблицаПеремещений = Запрос.Выполнить().Выгрузить();
		
		РезультатРаспределенияПоиск = РезультатРаспределения.Скопировать();
		РезультатРаспределенияПоиск.Индексы.Добавить("Номенклатура, Характеристика, Склад, РазрешениеНаЗамену, ИндексСтроки");
		ПоискТоваров = Новый Структура("Номенклатура, Характеристика, Склад, РазрешениеНаЗамену, ИндексСтроки");
		
		Для каждого СтрокаТаблицы Из ТаблицаПеремещений Цикл
			
			РаспределеноИтого = 0;
			РаспределениеАналога = ЗначениеЗаполнено(СтрокаТаблицы.РазрешениеНаЗамену);
			ЦепочкаСкладов = СоответствиеЦепочекСкладов.Получить(СтрокаТаблицы.ИндексСтроки);
			
			ПотребностьПолучатель = Неопределено;
			ЗаполнитьЗначенияСвойств(ПоискТоваров, СтрокаТаблицы, "Номенклатура, Характеристика, РазрешениеНаЗамену, ИндексСтроки");
			
			ИндексСкладов = СтрокаТаблицы.ПорядковыйНомер - 1;
			
			Пока ИндексСкладов > 0 Цикл
			
				СтрокаСкладов = ЦепочкаСкладов[ИндексСкладов];
				ИндексСкладов = ИндексСкладов - 1;
				ПоискТоваров.Склад = СтрокаСкладов.СкладОтправитель;
				
				ТаблицаПоНоменклатуре = РезультатРаспределенияПоиск.НайтиСтроки(ПоискТоваров);
				
				Если ТаблицаПоНоменклатуре.Количество() > 0 Тогда
				
					Для каждого СтрокаТЗ Из ТаблицаПоНоменклатуре Цикл
						РаспределеноИтого = РаспределеноИтого + СтрокаТЗ.Распределено;
						КлючНоменклатура = СтрокаТЗ.КлючНоменклатура;
						КлючПартия = СтрокаТЗ.КлючПартия;
					КонецЦикла;
					
				Иначе
					
					КлючНоменклатура = Новый УникальныйИдентификатор;
					КлючПартия = Новый УникальныйИдентификатор;
					
					ЗаполнитьЗначенияСвойств(ПоискКлючейПартий, СтрокаТаблицы, "Номенклатура, Характеристика, Склад, ЗаказНаПроизводство");
					ПоискКлючейПартий.КлючСвязиПеремещение = СтрокаТаблицы.КлючНоменклатура;
				
				КонецЕсли;
				
				Если ПотребностьПолучатель <> Неопределено Тогда
					ПотребностьПолучатель.КлючНоменклатура = КлючНоменклатура;
					ПотребностьПолучатель.ДлительностьПеремещения = СтрокаСкладов.ДлительностьПеремещения;
				КонецЕсли;
				
				Если РаспределеноИтого > 0 Тогда
				
					ПотребностьОтправитель = РезультатРаспределения.Добавить();
					ЗаполнитьЗначенияСвойств(ПотребностьОтправитель, СтрокаТаблицы);
					ПотребностьОтправитель.Склад = СтрокаСкладов.СкладОтправитель;
					ПотребностьОтправитель.ДлительностьПеремещения = СтрокаСкладов.ДлительностьПеремещения;
					ПотребностьОтправитель.Распределено = РаспределеноИтого;
					ПотребностьОтправитель.ТипЗаписи = ТипЗаписиРаспределениеЗапасовТребуетсяПотребление;
					ПотребностьОтправитель.КлючНоменклатура = КлючНоменклатура;
					ПотребностьОтправитель.КлючПартия = КлючПартия;
					ПотребностьОтправитель.КлючНоменклатураПотребности = СтрокаТаблицы.КлючНоменклатура;
					
					ПотребностьПолучатель = РезультатРаспределения.Добавить();
					ЗаполнитьЗначенияСвойств(ПотребностьПолучатель, СтрокаТаблицы);
					ПотребностьПолучатель.Склад = СтрокаСкладов.СкладПолучатель;
					ПотребностьПолучатель.Распределено = РаспределеноИтого;
					ПотребностьПолучатель.ТипЗаписи = ТипЗаписиРаспределениеЗапасовТребуетсяПеремещение;
					ПотребностьПолучатель.КлючПартия = КлючПартия;
					ПотребностьПолучатель.КлючНоменклатураПотребности = СтрокаТаблицы.КлючНоменклатура;
					
				КонецЕсли;
			
			КонецЦикла;
				
			Если ПотребностьПолучатель <> Неопределено Тогда
				ПотребностьПолучатель.КлючНоменклатура = СтрокаТаблицы.КлючНоменклатура;
			КонецЕсли;
			
			Если РаспределениеАналога Тогда
				
				ПоискТоваров.Склад = СтрокаТаблицы.Склад;
				ТаблицаПоНоменклатуре = РезультатРаспределенияПоиск.НайтиСтроки(ПоискТоваров);
				КлючНаборПотребностиАналога = Новый УникальныйИдентификатор;
				
				Если ТаблицаПоНоменклатуре.Количество() > 0 Тогда
				
					Для каждого СтрокаТЗ Из ТаблицаПоНоменклатуре Цикл
						РаспределеноИтого = РаспределеноИтого + СтрокаТЗ.Распределено;
						КлючНоменклатура = СтрокаТЗ.КлючНоменклатура;
						КлючПартия = СтрокаТЗ.КлючПартия;
					КонецЦикла;
					
					ЗаполнитьЗначенияСвойств(ПоискКлючейПартий, СтрокаТаблицы, "Номенклатура, Характеристика, Склад, ЗаказНаПроизводство");
					ПоискКлючейПартий.КлючСвязиПеремещение = СтрокаТаблицы.КлючНоменклатура;
					
					Для Каждого СтрокаТаблицыКэша Из ТаблицаКэшКлючейПартийПеремещений.НайтиСтроки(ПоискКлючейПартий) Цикл
						
						КлючНаборПотребностиАналога = СтрокаТаблицыКэша.КлючНабор; 
						Прервать;
					
					КонецЦикла;
					
				Иначе
					
					КлючНоменклатура = Новый УникальныйИдентификатор;
					КлючПартия = СтрокаТаблицы.КлючПартия;
					
					ЗаполнитьЗначенияСвойств(ПоискКлючейПартий, СтрокаТаблицы, "Номенклатура, Характеристика, Склад, ЗаказНаПроизводство");
					ПоискКлючейПартий.КлючСвязиПеремещение = СтрокаТаблицы.КлючНоменклатура;
					
					Для Каждого СтрокаТаблицыКэша Из ТаблицаКэшКлючейПартийПеремещений.НайтиСтроки(ПоискКлючейПартий) Цикл
						
						КлючНаборПотребностиАналога = СтрокаТаблицыКэша.КлючНабор; 
						КлючНоменклатура = СтрокаТаблицыКэша.КлючНоменклатура;
						Прервать;
					
					КонецЦикла;
				
				КонецЕсли;
				
				Если РаспределеноИтого > 0 Тогда
				
					Если ПотребностьПолучатель <> Неопределено Тогда
						ПотребностьПолучатель.КлючНоменклатура = КлючНоменклатура;
					КонецЕсли;
				
					ПотребностьОтправитель = РезультатРаспределения.Добавить();
					ЗаполнитьЗначенияСвойств(ПотребностьОтправитель, СтрокаТаблицы);
					ПотребностьОтправитель.Склад = СтрокаТаблицы.Склад;
					ПотребностьОтправитель.Распределено = РаспределеноИтого;
					ПотребностьОтправитель.ТипЗаписи = ТипЗаписиРаспределениеЗапасовТребуетсяПотребление;
					ПотребностьОтправитель.КлючНоменклатура = КлючНоменклатура;
					ПотребностьОтправитель.КлючСвязиАналог = КлючНоменклатура;
					ПотребностьОтправитель.КлючПартия = КлючПартия;
					ПотребностьОтправитель.КлючНабор = КлючНаборПотребностиАналога;
					ПотребностьОтправитель.КлючНоменклатураПотребности = СтрокаТаблицы.КлючНоменклатура;
					
					СтрокаЗаполненияСвязей = СвязиАналогов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаЗаполненияСвязей, ПотребностьОтправитель);
				
				КонецЕсли;
				
			КонецЕсли;
				
		КонецЦикла;
	
	КонецЕсли;
	
	// Формирование записей по зацикливающимся потребностям
	Для каждого СтрокаРезультата Из РезультатРаспределенияНеОбеспечивать Цикл
	
		НоваяСтрока = РезультатРаспределения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
	
	КонецЦикла;
	
	РезультатРаспределения.Индексы.Добавить("ИндексСтроки, Номенклатура, Характеристика, РазрешениеНаЗамену");
	ПоискАналогов = Новый Структура("ИндексСтроки, Номенклатура, Характеристика, РазрешениеНаЗамену");
	
	// Заполнение поля КлючСвязиПеремещение для строк-аналогов
	Для каждого СтрокаЗаполненияСвязей Из СвязиАналогов Цикл
	
		ЗаполнитьЗначенияСвойств(ПоискАналогов, СтрокаЗаполненияСвязей);
		СтрокиРаспределения = РезультатРаспределения.НайтиСтроки(ПоискАналогов);
		
		Для каждого СтрокаРезультат Из СтрокиРаспределения Цикл
			
			Если ЗначениеЗаполнено(СтрокаРезультат.КлючНабор) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаРезультат.КлючСвязиПеремещение = СтрокаЗаполненияСвязей.КлючНоменклатура;
			СтрокаРезультат.КлючСвязиАналог = СтрокаЗаполненияСвязей.КлючНоменклатура;
		
		КонецЦикла;
	
	КонецЦикла;
	
КонецПроцедуры

