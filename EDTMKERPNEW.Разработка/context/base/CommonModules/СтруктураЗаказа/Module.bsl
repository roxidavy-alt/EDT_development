Функция РасчетноеКоличествоНоменклатуры(Норматив, КоэффициентПересчета, ДанныеУпаковки)

	РасчетноеКоличество = Норматив * КоэффициентПересчета
		* ДанныеУпаковки.Числитель / ДанныеУпаковки.Знаменатель;
			
	ТекущееКоличество = Цел(РасчетноеКоличество);
	Если РасчетноеКоличество > ТекущееКоличество Тогда
		ТекущееКоличество = ТекущееКоличество + Цел((РасчетноеКоличество - ТекущееКоличество) * 1000) / 1000;
	КонецЕсли;
	
	Возврат РасчетноеКоличество;

КонецФункции

Функция ГрафикТовара(График, Аналитика, Граница, Индекс, УсловияРасчета, ИзменитьАналитику = Ложь)
	
	Назначение = Аналитика.Назначение;
	
	Если ИзменитьАналитику Тогда
		Аналитика.Назначение = Справочники.Назначения.ПустаяСсылка();
	КонецЕсли;
	
	Список = График.НайтиСтроки(Аналитика);
	
	НетГрафика = Список.Количество() = 0;
	
	Если НетГрафика
		И Не ИзменитьАналитику И Не УсловияРасчета.Обособленно Тогда
		
		ГрафикТовара = ГрафикТовара(График, Аналитика, Граница, Индекс, УсловияРасчета, Истина);
		
	Иначе
		
		Если НетГрафика Тогда
			ГрафикТовара  = Неопределено;
			Индекс  = -1;
			Граница = -1;
		Иначе
			ГрафикТовара = Список[0];
			Индекс  = ГрафикТовара.Индекс;
			Граница = ГрафикТовара.Граница;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИзменитьАналитику Тогда
		Аналитика.Назначение = Назначение;
	КонецЕсли;
	
	Возврат ГрафикТовара;
	
КонецФункции

Функция СледующийГрафикТовара(ГрафикТовара, Аналитика, Граница, Индекс, УсловияРасчета)
	
	Если ГрафикТовара = Неопределено ИЛИ УсловияРасчета.Обособленно Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ГрафикТовара.Назначение.Пустая() Тогда
		ГрафикТовара  = Неопределено;
		Индекс  = -1;
		Граница = -1;
		Возврат Ложь;
	КонецЕсли;
	
	ГрафикТовара = ГрафикТовара(ГрафикТовара.Владелец(), Аналитика, Граница, Индекс, УсловияРасчета, Истина);
	
	Возврат (ГрафикТовара <> Неопределено);
	
КонецФункции

Функция ЗапасДоступен(Выборка, Запас)
	
	Возврат Выборка.НомерОчереди > Запас.НомерОчереди
		Или (Выборка.НомерОчереди = Запас.НомерОчереди
			И Выборка.ПорядокНормативногоГрафика >= Запас.ПорядокНормативногоГрафика
			И Выборка.КонтрольОграниченияЗацикливания = 0);
	
КонецФункции

Процедура ПоместитьРезультатРаспределенияЗапасовВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, РезультатРаспределения, РассчитыватьИзменения)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПустоеНазначение", Справочники.Назначения.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойИдентификатор", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	Запрос.УстановитьПараметр("ТипЗаписиЗакрытиеПотребности", ТипЗаписиРаспределениеЗапасовЗакрытиеПотребности());
	Запрос.УстановитьПараметр("ТипЗаписиТребуетсяПеремещение", ТипЗаписиРаспределениеЗапасовТребуетсяПеремещение());
	Запрос.УстановитьПараметр("ТипЗаписиТребуетсяПотребление", ТипЗаписиРаспределениеЗапасовТребуетсяПотребление());
	Запрос.УстановитьПараметр("ТипЗаписиРезерв", ТипЗаписиРаспределениеЗапасовРезерв());
	Запрос.УстановитьПараметр("ТипЗаписиЗамена", ТипЗаписиРаспределениеЗапасовЗамена());
	Запрос.УстановитьПараметр("ТипЗаписиРаспределениеЗапасовНеОбеспечивать", ТипЗаписиРаспределениеЗапасовНеОбеспечивать());
	Запрос.УстановитьПараметр("РассчитыватьИзменения", РассчитыватьИзменения);
	Запрос.Текст = ""
		+ ТекстЗапросаПоместитьТаблицуЗначенийВоВременнуюТаблицу("РезультатРаспределения", РезультатРаспределения.Колонки,,, "ИндексСтроки")
		+ ОбщегоНазначения.РазделительПакетаЗапросов()
		+ "ВЫБРАТЬ
		|	Таблица.Номенклатура КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад КАК Склад,
		|	Таблица.Назначение КАК Назначение,
		|	Таблица.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|	Таблица.КлючСвязиПеремещение КАК КлючСвязиПеремещение,
		|	Таблица.ЭтоПродукция КАК ЭтоПродукция,
		|	МАКСИМУМ(Таблица.Этап) КАК Этап,
		|	МАКСИМУМ(Таблица.ИндексСтроки) КАК ИндексСтроки,
		|	СУММА(Таблица.КОбеспечению) КАК КОбеспечению,
		|	СУММА(Таблица.Запланировано) КАК Запланировано,
		|	СУММА(Таблица.Заказано) КАК Заказано,
		|	СУММА(Таблица.РаспределеноИзНаличияНаСкладеДо) КАК РаспределеноИзНаличияНаСкладеДо,
		|	СУММА(Таблица.РаспределеноИзНаличияНаСкладеПосле) КАК РаспределеноИзНаличияНаСкладеПосле,
		|	СУММА(Таблица.КоличествоКПроизводству) КАК КоличествоКПроизводству,
		|	СУММА(Таблица.КОбеспечениюРазность) КАК КОбеспечениюРазность,
		|	СУММА(Таблица.ЗапланированоРазность) КАК ЗапланированоРазность,
		|	СУММА(Таблица.ЗамененоРазность) КАК ЗамененоРазность
		|ПОМЕСТИТЬ РасчетИзменений
		|ИЗ
		|	(ВЫБРАТЬ
		|		План.ИндексСтроки КАК ИндексСтроки,
		|		План.Номенклатура КАК Номенклатура,
		|		План.Характеристика КАК Характеристика,
		|		План.Склад КАК Склад,
		|		План.Назначение КАК Назначение,
		|		План.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|		План.Этап КАК Этап,
		|		ВЫБОР
		|			КОГДА План.ИсходнаяПотребность
		|			ТОГДА План.КлючНоменклатура
		|			ИНАЧЕ План.КлючСвязиПеремещение
		|		КОНЕЦ КАК КлючСвязиПеремещение,
		|		План.ЭтоПродукция КАК ЭтоПродукция,
		|		План.КОбеспечению КАК КОбеспечению,
		|		План.Заменено КАК Заменено,
		|		План.РаспределеноИзНаличияНаСкладе КАК РаспределеноИзНаличияНаСкладеДо,
		|		0 КАК РаспределеноИзНаличияНаСкладеПосле,
		|		План.Запланировано КАК КоличествоКПроизводству,
		|		План.Запланировано КАК Запланировано,
		|		План.Заказано КАК Заказано,
		|		ВЫБОР
		|			КОГДА План.ИсходнаяПотребность
		|			ТОГДА 0
		|			ИНАЧЕ План.КОбеспечению
		|		КОНЕЦ КАК КОбеспечениюРазность,
		|		План.ЗапланированоПереместить КАК ЗапланированоРазность,
		|		План.Заменено КАК ЗамененоРазность
		|	ИЗ
		|		НоменклатурныйПлан КАК План
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-1 КАК ИндексСтроки,
		|		Резервы.Номенклатура КАК Номенклатура,
		|		Резервы.Характеристика КАК Характеристика,
		|		Резервы.Склад КАК Склад,
		|		План.Назначение КАК Назначение,
		|		План.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|		План.Этап КАК Этап,
		|		ВЫБОР
		|			КОГДА Резервы.КлючСвязиАналог <> &ПустойИдентификатор // Для строк-аналогов поле заполняется при расчете обеспечения
		|			ТОГДА Резервы.КлючСвязиАналог
		|			ИНАЧЕ План.КлючНоменклатура
		|		КОНЕЦ                         КАК КлючСвязиПеремещение,
		|		План.ЭтоПродукция КАК ЭтоПродукция,
		|		0 КАК КОбеспечению,
		|		ВЫБОР
		|			КОГДА Резервы.ТипЗаписи = &ТипЗаписиЗамена
		|			ТОГДА -Резервы.Распределено
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК Заменено,
		|		0 КАК РаспределеноИзНаличияНаСкладеДо,
		|		ВЫБОР
		|			КОГДА Резервы.ЗаказНаПоступление = НЕОПРЕДЕЛЕНО
		|				И Резервы.ТипЗаписи = &ТипЗаписиРезерв
		|				ТОГДА Резервы.Распределено
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК РаспределеноИзНаличияНаСкладеПосле,
		|		ВЫБОР
		|			КОГДА Резервы.ТипЗаписи В (&ТипЗаписиЗакрытиеПотребности, &ТипЗаписиТребуетсяПеремещение)
		|			ТОГДА -Резервы.Распределено
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК КоличествоКПроизводству,
		|		0 КАК Запланировано,
		|		0 КАК Заказано,
		|		ВЫБОР
		|			КОГДА Резервы.ТипЗаписи = &ТипЗаписиТребуетсяПотребление
		|			ТОГДА -Резервы.Распределено
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК КОбеспечениюРазность,
		|		ВЫБОР
		|			КОГДА Резервы.ТипЗаписи = &ТипЗаписиТребуетсяПеремещение
		|			ТОГДА -Резервы.Распределено
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК ЗапланированоРазность,
		|		ВЫБОР
		|			КОГДА Резервы.ТипЗаписи = &ТипЗаписиЗамена
		|			ТОГДА -Резервы.Распределено
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК ЗамененоРазность
		|	ИЗ
		|		РезультатРаспределения КАК Резервы
		|			ЛЕВОЕ СОЕДИНЕНИЕ НоменклатурныйПлан КАК План
		|			ПО Резервы.ИндексСтроки = План.ИндексСтроки) КАК Таблица
		|
		|СГРУППИРОВАТЬ ПО
		|	Таблица.Назначение,
		|	Таблица.ЗаказНаПроизводство,
		|	Таблица.Склад,
		|	Таблица.Характеристика,
		|	Таблица.КлючСвязиПеремещение,
		|	Таблица.Номенклатура,
		|	Таблица.ЭтоПродукция
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	Характеристика,
		|	Склад,
		|	Назначение,
		|	ЗаказНаПроизводство
		|;
		|ВЫБРАТЬ
		|	РасчетИзменений.Номенклатура КАК Номенклатура,
		|	РасчетИзменений.Характеристика КАК Характеристика,
		|	РасчетИзменений.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|	РасчетИзменений.КлючСвязиПеремещение КАК КлючСвязиПеремещение,
		|	РасчетИзменений.КОбеспечениюРазность <> 0
		|		ИЛИ РасчетИзменений.ЗапланированоРазность <> 0
		|		ИЛИ РасчетИзменений.ЗамененоРазность <> 0 КАК ЕстьИзменения
		|ПОМЕСТИТЬ ТаблицаИзменений
		|ИЗ
		|	РасчетИзменений КАК РасчетИзменений
		|
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	План.Номенклатура,
		|	План.Характеристика,
		|	План.ЗаказНаПроизводство,
		|	План.КлючСвязиПотребности,
		|	ИСТИНА
		|ИЗ
		|	НоменклатурныйПлан КАК План
		|ГДЕ 
		|	План.ЭтоАналог И План.КлючСвязиПеремещение = &ПустойИдентификатор И План.КлючСвязиПотребности <> &ПустойИдентификатор
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	Характеристика,
		|	ЗаказНаПроизводство,
		|	КлючСвязиПеремещение,
		|	ЕстьИзменения
		|;
		|
		|
		|ВЫБРАТЬ
		|
		|	План.ИндексСтроки КАК ИндексСтроки,
		|
		|	Резервы.Номенклатура          КАК Номенклатура,
		|	Резервы.Характеристика        КАК Характеристика,
		|	Резервы.Склад                 КАК Склад,
		|	План.Назначение               КАК Назначение,
		|	План.ЗаказНаПроизводство      КАК ЗаказНаПроизводство,
		|	Резервы.КлючНоменклатура      КАК КлючНоменклатура,
		|	Резервы.КлючПартия            КАК КлючПартия,
		|	ВЫБОР
		|		КОГДА Резервы.ТипЗаписи В (&ТипЗаписиЗамена, &ТипЗаписиРезерв, &ТипЗаписиТребуетсяПотребление)
		|			И План.Склад = Резервы.Склад
		|			ТОГДА План.Этап
		|	КОНЕЦ                         КАК Этап,
		|	План.Подразделение            КАК Подразделение,
		|	План.НазначениеСтруктуры      КАК НазначениеСтруктуры,
		|	ВЫБОР
		|		КОГДА Резервы.КлючСвязиПеремещение <> &ПустойИдентификатор // Для строк-аналогов поле заполняется при расчете обеспечения
		|		ТОГДА Резервы.КлючСвязиПеремещение
		|		ИНАЧЕ План.КлючНоменклатура
		|	КОНЕЦ                         КАК КлючСвязиПеремещение,
		|	ВЫБОР
		|		КОГДА Резервы.КлючНабор <> &ПустойИдентификатор // Первичная потребность строки аналога
		|		ТОГДА &ПустойИдентификатор
		|		КОГДА Резервы.ТипЗаписи В (&ТипЗаписиТребуетсяПотребление, &ТипЗаписиТребуетсяПеремещение)
		|		ТОГДА Резервы.КлючПартия
		|		ИНАЧЕ &ПустойИдентификатор
		|	КОНЕЦ                         КАК КлючНабор,
		|	Резервы.КлючНабор КАК КлючНаборПотребностиАналога,
		|
		|	Резервы.ДатаПоступления    КАК ДатаПоступления,
		|	Резервы.ЗаказНаПоступление КАК ЗаказНаПоступление,
		|
		|	Резервы.ТипЗаписи             КАК ТипЗаписи,
		|	ВЫБОР
		|		КОГДА Резервы.ТипЗаписи В (&ТипЗаписиРезерв, &ТипЗаписиЗамена)
		|		ТОГДА &ПустойИдентификатор
		|		ИНАЧЕ План.КлючНоменклатура
		|	КОНЕЦ                         КАК КлючСвязиСтрокаСпецификации,
		|
		|	ISNULL(МестоПартииВСтруктуреЗаказа.Уровень, План.Уровень) КАК Уровень,
		|	ISNULL(МестоПартииВСтруктуреЗаказа.ДлительностьДоВыпуска, План.ДлительностьДоВыпуска) + Резервы.ДлительностьПеремещения КАК ДлительностьДоВыпуска, // берем по партии без учета этапа
		|	ISNULL(МестоПартииВСтруктуреЗаказа.ИдентификаторВГруппеИзделий, План.ИдентификаторВГруппеИзделий) КАК ИдентификаторВГруппеИзделий,
		|	ВЫБОР
		|		КОГДА МестоПартииВСтруктуреЗаказа.Партия ЕСТЬ НЕ NULL ТОГДА
		|			ЭтапВыпуска.Ссылка
		|		ИНАЧЕ
		|			NULL
		|	КОНЕЦ КАК ЭтапВыпуска,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЭтапВыпуска.ПартияПроизводства) КАК КлючПартияВыпуска,
		|	ВЫБОР
		|		КОГДА МестоПартииВСтруктуреЗаказа.Партия ЕСТЬ НЕ NULL ТОГДА
		|			ЭтапВыпуска.Подразделение
		|		ИНАЧЕ
		|			NULL
		|	КОНЕЦ КАК ПодразделениеВыпуска,
		|
		|	Резервы.РазрешениеНаЗамену КАК РазрешениеНаЗамену,
		|	ВЫБОР
		|		КОГДА Резервы.ТипЗаписи = &ТипЗаписиТребуетсяПотребление
		|			И Резервы.РазрешениеНаЗамену <> ЗНАЧЕНИЕ(Документ.РазрешениеНаЗаменуМатериалов.ПустаяСсылка)
		|			И Резервы.Склад = План.Склад
		|			ТОГДА Резервы.КоличествоНаЕдиницуПартииЗапуска
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоНаЕдиницуПартииЗапуска,
		|	ВЫБОР
		|		КОГДА Резервы.ТипЗаписи = &ТипЗаписиТребуетсяПотребление
		|			И Резервы.РазрешениеНаЗамену <> ЗНАЧЕНИЕ(Документ.РазрешениеНаЗаменуМатериалов.ПустаяСсылка)
		|			И Резервы.Склад = План.Склад
		|			ТОГДА План.Спецификация
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
		|	КОНЕЦ КАК Спецификация,
		|
		|	ВЫБОР
		|		КОГДА Резервы.ТипЗаписи = &ТипЗаписиЗамена
		|			ТОГДА Резервы.Распределено
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Заменено,
		|	ВЫБОР
		|		КОГДА Резервы.ТипЗаписи = &ТипЗаписиТребуетсяПеремещение
		|		И ИСТИНА В
		|			(ВЫБРАТЬ
		|				ИСТИНА
		|			ИЗ
		|				ТаблицаИзменений КАК ТаблицаИзменений
		|			ГДЕ
		|				ТаблицаИзменений.Номенклатура = Резервы.Номенклатура
		|				И ТаблицаИзменений.Характеристика = Резервы.Характеристика
		|				И ТаблицаИзменений.ЗаказНаПроизводство = План.ЗаказНаПроизводство
		|				И (ТаблицаИзменений.КлючСвязиПеремещение = План.КлючНоменклатура 
		|					ИЛИ ТаблицаИзменений.КлючСвязиПеремещение = Резервы.КлючНоменклатура 
		|					ИЛИ ТаблицаИзменений.КлючСвязиПеремещение = Резервы.КлючСвязиПеремещение)
		|				И ТаблицаИзменений.ЕстьИзменения)
		|			ТОГДА Резервы.Распределено
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Запланировано,
		|	ВЫБОР
		|		КОГДА Резервы.ТипЗаписи = &ТипЗаписиТребуетсяПотребление
		|			И ИСТИНА В
		|			(ВЫБРАТЬ
		|				ИСТИНА
		|			ИЗ
		|				ТаблицаИзменений КАК ТаблицаИзменений
		|			ГДЕ
		|				ТаблицаИзменений.Номенклатура = Резервы.Номенклатура
		|				И ТаблицаИзменений.Характеристика = Резервы.Характеристика
		|				И ТаблицаИзменений.ЗаказНаПроизводство = План.ЗаказНаПроизводство
		|				И (ТаблицаИзменений.КлючСвязиПеремещение = План.КлючНоменклатура 
		|					ИЛИ ТаблицаИзменений.КлючСвязиПеремещение = Резервы.КлючНоменклатура 
		|					ИЛИ ТаблицаИзменений.КлючСвязиПеремещение = Резервы.КлючСвязиПеремещение)
		|				И ТаблицаИзменений.ЕстьИзменения)
		|			ТОГДА Резервы.Распределено
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Требуется,
		|	ВЫБОР
		|		КОГДА Резервы.ТипЗаписи = &ТипЗаписиРаспределениеЗапасовНеОбеспечивать
		|			ТОГДА Резервы.Распределено
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НеОбеспечивать,
		|
		|	ВЫБОР
		|		КОГДА МестоПартииВСтруктуреЗаказа.Партия ЕСТЬ НЕ NULL
		|				И Резервы.ТипЗаписи = &ТипЗаписиРезерв
		|				И Резервы.Назначение <> &ПустоеНазначение
		|			ТОГДА Резервы.Распределено
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РаспределеноИзПартийОбособленно,
		|	ВЫБОР
		|		КОГДА МестоПартииВСтруктуреЗаказа.Партия ЕСТЬ НЕ NULL
		|				И Резервы.ТипЗаписи = &ТипЗаписиРезерв
		|			И Резервы.Назначение = &ПустоеНазначение 
		|			ТОГДА Резервы.Распределено
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РаспределеноИзПартий,
		|	ВЫБОР
		|		КОГДА МестоПартииВСтруктуреЗаказа.Партия ЕСТЬ NULL
		|				И Резервы.ТипЗаписи = &ТипЗаписиРезерв
		|				И Резервы.Назначение <> &ПустоеНазначение
		|			ТОГДА Резервы.Распределено
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РаспределеноИзЗапасовОбособленно,
		|	ВЫБОР
		|		КОГДА МестоПартииВСтруктуреЗаказа.Партия ЕСТЬ NULL
		|				И Резервы.ТипЗаписи = &ТипЗаписиРезерв
		|				И Резервы.Назначение = &ПустоеНазначение
		|			ТОГДА Резервы.Распределено
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК РаспределеноИзЗапасов
		|
		|ПОМЕСТИТЬ РаспределениеЗапасов
		|ИЗ
		|	РезультатРаспределения КАК Резервы
		|
		|		ЛЕВОЕ СОЕДИНЕНИЕ НоменклатурныйПлан КАК План
		|		ПО Резервы.ИндексСтроки = План.ИндексСтроки
		|
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК ЭтапВыпуска
		|		ПО Резервы.ЗаказНаПоступление = ЭтапВыпуска.Ссылка
		|			И План.ЗаказНаПроизводство = ЭтапВыпуска.Распоряжение // выпуск по заказу
		|			И План.КлючПартия <> УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЭтапВыпуска.ПартияПроизводства) // исключаем промежуточные полуфабрикаты
		|
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПартииВСтруктуреЗаказа КАК МестоПартииВСтруктуреЗаказа
		|		ПО ЭтапВыпуска.ПартияПроизводства = МестоПартииВСтруктуреЗаказа.Партия
		|
		|ГДЕ 
		|	Резервы.ТипЗаписи <> &ТипЗаписиЗакрытиеПотребности
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	Характеристика,
		|	Склад,
		|	Назначение,
		|	ЗаказНаПроизводство
		|;
		|
		|УНИЧТОЖИТЬ РезультатРаспределения
		|;
		|";
		
	Запрос.УстановитьПараметр("РезультатРаспределения", РезультатРаспределения);
