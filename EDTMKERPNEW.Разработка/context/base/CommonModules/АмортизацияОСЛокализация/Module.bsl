	Запрос.УстановитьПараметр("ДатаВводаВЭксплуатациюНУ", Параметры.ДатаВводаВЭксплуатациюНУ);
	Запрос.УстановитьПараметр("ДокументВводаВЭксплуатациюНУ", Параметры.ДокументВводаВЭксплуатациюНУ);

	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаИсточникИПолучатель = Результат[Результат.ВГраница()-3].Выгрузить();
	
	Выборка = Результат[Результат.ВГраница()-2].Выбрать();
	Если Выборка.Следующий() Тогда
		ПараметрыДляРасчета.АмортизацияНУНаНачалоПериода = Выборка.АмортизацияНУ;
	Иначе
		ПараметрыДляРасчета.АмортизацияНУНаНачалоПериода = 0;
	КонецЕсли;
	
	Выборка = Результат[Результат.ВГраница()-1].Выбрать();
	Если Выборка.Следующий() Тогда
		ПараметрыДляРасчета.ДатаВводаВЭксплуатациюНУ = Выборка.ДатаВводаВЭксплуатациюНУ;
	КонецЕсли;
	
	ПараметрыЗаПериодНУ = Результат[Результат.ВГраница()].Выгрузить();

	НомерСтроки = 1;
	Для Каждого ДанныеСтроки Из ПараметрыЗаПериодНУ Цикл
		ДанныеСтроки.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация", Параметры.Организация);
	ПараметрыРасчета.Вставить("ОсновноеСредство", Параметры.ОсновноеСредство);
	ПараметрыРасчета.Вставить("ДатаВводаВЭксплуатациюНУ", ПараметрыДляРасчета.ДатаВводаВЭксплуатациюНУ);
	ПараметрыРасчета.Вставить("АмортизацияНУНаНачалоПериода", ПараметрыДляРасчета.АмортизацияНУНаНачалоПериода);
	ПараметрыРасчета.Вставить("АмортизацияДо2009", ПараметрыДляРасчета.АмортизацияДо2009);
	ПараметрыРасчета.Вставить("ФактическийСрокИспользованияДо2009", ПараметрыДляРасчета.ФактическийСрокИспользованияДо2009);
	ПараметрыРасчета.Вставить("ЭтоАрендованныеОС", УчетАрендованныхОС.ОсновноеСредствоПолученоВАренду(Параметры.ОсновноеСредство, Параметры.Дата));

	ТаблицыРасчета = Новый Структура;
	ТаблицыРасчета.Вставить("ПараметрыЗаПериодНУ", ПараметрыЗаПериодНУ);

	ЗначенияПараметровРасчетаИзменений = Новый Соответствие;

	Выборка = Результат[Результат.ВГраница()-4].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		// Стоимость исходных ОС при разукомплектации и объединении
		ЗначенияПараметров = Новый Структура;
		ЗначенияПараметров.Вставить("Стоимость", 0);
		ЗначенияПараметров.Вставить("СтоимостьРегл", 0);
		ЗначенияПараметров.Вставить("СтоимостьНУ", 0);
		ЗначенияПараметров.Вставить("СтоимостьЦФ", 0);
		ЗначенияПараметров.Вставить("СтоимостьПР", 0);
		ЗначенияПараметров.Вставить("Амортизация", 0);
		ЗначенияПараметров.Вставить("АмортизацияРегл", 0);
		ЗначенияПараметров.Вставить("АмортизацияНУ", 0);
		ЗначенияПараметров.Вставить("АмортизацияЦФ", 0);
		ЗначенияПараметров.Вставить("АмортизацияПР", 0);
		ЗначенияПараметров.Вставить("ОбесценениеУпр", 0);
		ЗначенияПараметров.Вставить("ОбесценениеРегл", 0);
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодУпр", 0);  
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодРегл", 0);
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодПР", 0);
		ЗначенияПараметров.Вставить("АмортизацияЗаПериодНУ", 0);
		
		ЗаполнитьЗначенияСвойств(ЗначенияПараметров, Выборка);
		
		ЗначенияПараметровРасчетаИзменений.Вставить(Выборка.ОсновноеСредство, ЗначенияПараметров);
		
	КонецЦикла;
	
	АмортизацияЗаПериодНУ = 0;
	
	Для Каждого ДанныеСтроки Из ПараметрыЗаПериодНУ Цикл
		
		Если НЕ ДанныеСтроки.НеРассчитыватьАмортизациюНУ Тогда
			
			ДанныеСтроки.АмортизацияНУ = ПараметрыРасчета.АмортизацияНУНаНачалоПериода + АмортизацияЗаПериодНУ;
			
			ЗначенияПараметров = Документы.АмортизацияОС2_4.РассчитатьСтоимостьАмортизациюПоДаннымДокумента(
				ДанныеСтроки, ЗначенияПараметровРасчетаИзменений, ТаблицаИсточникИПолучатель);
			
			ДанныеСтроки.СтоимостьНУ = ЗначенияПараметров.СтоимостьНУ;
		
			ДанныеСтроки.АмортизацияНУИзменение = ЗначенияПараметров.АмортизацияНУИзменение;
			
			Если НЕ ДанныеСтроки.ЭтоИзменения Тогда
			
				Результат = Документы.АмортизацияОС2_4.РассчитатьАмортизациюПоТаблице(ТаблицыРасчета, ПараметрыРасчета, ДанныеСтроки.НомерСтроки);
				
				СтрокаАмортизация = Результат.РезультатРасчетаНУ[0];
				
				ДанныеСтроки.АмортизацияНУ = СтрокаАмортизация.АмортизацияНУ;
				
			Иначе
	
				ДанныеСтроки.АмортизацияНУ = 0;
				
			КонецЕсли;
			
			ЗначенияПараметров.АмортизацияЗаПериодНУ = ЗначенияПараметров.АмортизацияЗаПериодНУ + ДанныеСтроки.АмортизацияНУ;
				
		КонецЕсли;
			
		АмортизацияЗаПериодНУ = АмортизацияЗаПериодНУ + ДанныеСтроки.АмортизацияНУ;
		
	КонецЦикла;
	
	КолонкиСуммирования = Новый Массив;
	КолонкиСуммирования.Добавить("АмортизацияНУ");
	КолонкиСуммирования.Добавить("АмортизацияНУИзменение");
	КолонкиСуммирования.Добавить("АмортизацияПРИзменение");
	КолонкиСуммирования.Добавить("АмортизационнаяПремия");

	Документы.АмортизацияОС2_4.СгруппироватьПараметрыЗаПериод(
		ПараметрыЗаПериодНУ, 
		КолонкиСуммирования, 
		Ложь);	
	
	ПараметрыДляРасчета.Вставить("ПараметрыЗаПериодНУ", ПараметрыЗаПериодНУ);

	ОбщегоНазначенияУТ.УничтожитьВременныеТаблицы(Параметры.МенеджерВременныхТаблиц,, ИспользуемыеВТ);
	
КонецПроцедуры

//-- Локализация

#Область ФормаДокумента

Процедура ПриСозданииНаСервере(Форма) Экспорт

	//++ Локализация
	
	Если НЕ ПолучитьФункциональнуюОпцию("УправлениеПредприятием") 
		//++ НЕ УТКА
		ИЛИ НЕ ПравоДоступа("Просмотр", Метаданные.РегистрыБухгалтерии.Международный) 
		//-- НЕ УТКА
		Тогда
		Форма.Элементы.ФормаПроводкиМеждУчета.Видимость = Ложь;
	КонецЕсли; 
	
	//-- Локализация
	
КонецПроцедуры

#КонецОбласти

#Область ФормаРасчетАмортизации

Процедура ДополнитьСлужебныеПараметрыФормыРасчетАмортизации(Знач СлужебныеПараметры) Экспорт

	//++ Локализация
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	АмортизацияОС2_4.Ссылка КАК Ссылка,
	|	АмортизацияОС2_4.Организация КАК Организация,
	|	АмортизацияОС2_4.НомерПакета,
	|	АмортизацияОС2_4.Дата КАК Дата
	|ИЗ
	|	Документ.АмортизацияОС2_4 КАК АмортизацияОС2_4
	|ГДЕ
	|	АмортизацияОС2_4.Ссылка В(&СписокДокументов)
	|	И НЕ АмортизацияОС2_4.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АмортизацияОС.Ссылка,
	|	АмортизацияОС.Организация,
	|	0,
	|	АмортизацияОС.Дата КАК Дата
	|ИЗ
	|	Документ.АмортизацияОС КАК АмортизацияОС
	|ГДЕ
	|	АмортизацияОС.Ссылка В(&СписокДокументов)
	|	И НЕ АмортизацияОС.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Организация";
	
	СлужебныеПараметры.Вставить("ТекстЗапроса", ТекстЗапроса);
	
	СлужебныеПараметры.СобытияЗаписи.Добавить("Запись_АмортизацияОС");
	СлужебныеПараметры.ТипыДокументов.Добавить("ДокументСсылка.АмортизацияОС");
	
	//-- Локализация
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти