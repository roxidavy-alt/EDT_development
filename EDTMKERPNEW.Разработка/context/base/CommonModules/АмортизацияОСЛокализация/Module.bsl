	|	ЕСТЬNULL(ПараметрыАмортизацииОСБУ.КоэффициентАмортизацииБУ, 0) КАК ГодоваяНормаАмортизацииБУ,
	|	ЕСТЬNULL(ПараметрыАмортизацииОСБУ.КоэффициентУскорения, 0) КАК КоэффициентУскоренияБУ,
