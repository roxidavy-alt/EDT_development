		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ЗначенияПараметровЭтогоДня.ПериодСледующее, ДАТАВРЕМЯ(1,1,1)) <> ДАТАВРЕМЯ(1,1,1)
		|
