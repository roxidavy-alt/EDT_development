&НаКлиенте
Процедура Разр_ДобавитьПоШтрихкодуВместо(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИмяСобытияОповещения", "ЯрлыкКоробаСчитанПередачаСырья");
	ПараметрыФормы.Вставить("ТекстПодсказки", "Сканируйте штрихкод ярлыка короба.");

	ОткрытьФорму(
		"ОбщаяФорма.Разр_ВводШтрихкодаОдиночный",
		ПараметрыФормы,
		ЭтаФорма
	);

КонецПроцедуры

&НаКлиенте
Процедура Разр_ДобавитьПоШтрихкодамВместо(Команда)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИмяСобытияОповещения", "ЯрлыкиКоробаСчитаныПередачаСырья");
	ПараметрыФормы.Вставить("ТекстПодсказки", "Укажите количество и сканируйте штрихкоды ярлыков коробов.");

	ОткрытьФорму(
		"ОбщаяФорма.Разр_ВводШтрихкодаМассовый",
		ПараметрыФормы,
		ЭтаФорма
	);

КонецПроцедуры

&НаКлиенте
Функция Разр_ПодготовитьДанныеЯрлыкаКПередаче(ДанныеЯрлыка)

	Если ДанныеЯрлыка = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Характеристика = Неопределено;

	Если Не ДанныеЯрлыка.Свойство("Характеристика", Характеристика) Тогда
		Возврат Истина;
	КонецЕсли;

	ХарактеристикаСтерильно =
		Разр_ЗаполнениеТЧПоЯрлыкамСервер.ПолучитьХарактеристикуСтерильно();

	Если Не ЗначениеЗаполнено(ХарактеристикаСтерильно)
		Или Характеристика <> ХарактеристикаСтерильно Тогда
		Возврат Истина;
	КонецЕсли;

	ХарактеристикаНаСтерилизацию =
		Разр_ЗаполнениеТЧПоЯрлыкамСервер.ПолучитьХарактеристикуНаСтерилизацию();

	Если Не ЗначениеЗаполнено(ХарактеристикаНаСтерилизацию) Тогда
		ПоказатьПредупреждение(, "Не найдена характеристика ""На стерилизацию"".");
		Возврат Ложь;
	КонецЕсли;

	ДанныеЯрлыка.Характеристика = ХарактеристикаНаСтерилизацию;
	//ДанныеЯрлыка.Назначение = Неопределено;

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура Разр_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)

	Настройки = Разр_ЗаполнениеТЧПоЯрлыкамКлиент.НастройкиПоУмолчанию();

	// Здесь можно переопределить имена ТЧ для конкретного документа
	Настройки.ИмяТЧНоменклатуры = "Товары";
	Настройки.ИмяТЧШтрихкодов = "Разр_Штрихкоды";
	Настройки.ИмяТЧСерий = "Серии";
	Настройки.ИмяСобытияОповещения = ИмяСобытия;
	
	Настройки.ПоляИзЯрлыкаВСтроку.Добавить("ЗаказКлиента");
	// Строки с разными спецификациями не должны объединяться.
	Настройки.КлючевыеПоляСтрок.Добавить("ЗаказКлиента");
	//Настройки.КлючевыеПоляСтрок.Добавить("Назначение");
	
	Если ИмяСобытия = "ЯрлыкКоробаСчитанПередачаСырья" Тогда
		
		Если Не Разр_ПодготовитьДанныеЯрлыкаКПередаче(Параметр) Тогда
			Возврат;
		КонецЕсли;

		Результат = Разр_ЗаполнениеТЧПоЯрлыкамКлиент.ДобавитьНоменклатуруПоЯрлыку(
			Объект,
			Параметр,
			Настройки
		);

		Если Результат.Изменено Тогда
			Модифицированность = Истина;
		КонецЕсли;

	ИначеЕсли ИмяСобытия = "ЯрлыкиКоробаСчитаныПередачаСырья" Тогда

		Если Параметр = Неопределено 
			Или Не Параметр.Свойство("Ярлыки") Тогда

			ПоказатьПредупреждение(, "Не получены данные массового сканирования.");
			Возврат;

		КонецЕсли;
		
		Для Каждого ДанныеЯрлыка Из Параметр.Ярлыки Цикл

			Если Не Разр_ПодготовитьДанныеЯрлыкаКПередаче(ДанныеЯрлыка) Тогда
				Возврат;
			КонецЕсли;

		КонецЦикла;
		
		Результат = Разр_ЗаполнениеТЧПоЯрлыкамКлиент.ДобавитьНоменклатурыПоЯрлыкам(
			Объект,
			Параметр.Ярлыки,
			Настройки
		);

		Если Результат.Изменено Тогда
			Модифицированность = Истина;
		КонецЕсли;

	КонецЕсли;
    ОбновитьДоступностьТЧ_ТОвары();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьТЧ_ТОвары()
    Элементы.Товары.ТолькоПросмотр = Объект.Разр_Штрихкоды.Количество() > 0;
КонецПроцедуры // ОбновитьДоступностьТЧ_ТОвары()

&НаКлиенте
Процедура Разр_ПриОткрытииПосле(Отказ)
	ОбновитьДоступностьТЧ_ТОвары();
КонецПроцедуры

&НаКлиенте
Процедура Разр_Разр_ШтрихкодыПриИзмененииВместо(Элемент)
	ОбновитьДоступностьТЧ_ТОвары();
КонецПроцедуры

&НаКлиенте
Процедура Разр_ОчиститьТабличныеЧастиВместо(Команда)
	Оповещение = Новый ОписаниеОповещения(
		"ПослеВопросаОчиститьЗаполнениеПоШтрихкодам",
		ЭтаФорма
	);

	ПоказатьВопрос(
		Оповещение,
		"Очистить штрихкоды и товары, заполненные по штрихкодам?",
		РежимДиалогаВопрос.ДаНет
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОчиститьЗаполнениеПоШтрихкодам(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Объект.Разр_Штрихкоды.Очистить();
	Объект.Товары.Очистить();
	Объект.Серии.Очистить();

	Модифицированность = Истина;
	
	ОбновитьДоступностьТЧ_ТОвары();

КонецПроцедуры



