	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		ТекстОшибки = "В ярлыке не заполнена номенклатура.";
		Возврат Ложь;
	КонецЕсли;
	
	
	//Если Не Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Продукция стерильная") 
	//	И НЕ Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Полуфабрикат стерильный") Тогда
	//	ТекстОшибки = "У номенклатуры не установлен признак: Продукция стерильная или Полуфабрикат стерильный";
	//	Возврат Ложь;
	//КонецЕсли;	
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеДопРеквизитаУстановлено(Номенклатура,ИдентификаторДляФормул,ИмяЗначенияСвойства)
	
	Свойство = Номенклатура.ДополнительныеРеквизиты.Найти(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул",ИдентификаторДляФормул));
	Если Свойство = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Значение = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(ИмяЗначенияСвойства,,,Свойство);
	
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // ЗначениеДопРеквизитаУстановлено()
