Функция НайтиХарактеристикуПоВидуНоменклатуры(
	НаименованиеВидаНоменклатуры,
	НаименованиеХарактеристики
) Экспорт

	НаименованиеВидаНоменклатуры = СокрЛП(Строка(НаименованиеВидаНоменклатуры));
	НаименованиеХарактеристики = СокрЛП(Строка(НаименованиеХарактеристики));

	Если ПустаяСтрока(НаименованиеВидаНоменклатуры)
		Или ПустаяСтрока(НаименованиеХарактеристики) Тогда

		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();

	КонецЕсли;

	ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоНаименованию(
		НаименованиеВидаНоменклатуры,
		Истина
	);

	Если Не ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		Возврат Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Характеристика = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(
		НаименованиеХарактеристики,
		Истина,
		Неопределено,
		ВидНоменклатуры
	);

	Возврат Характеристика;

КонецФункции

Функция ПолучитьХарактеристикуСтерильно() Экспорт

	Возврат НайтиХарактеристикуПоВидуНоменклатуры(
		"Продукция стерильная",
		"Стерильно"
	);

КонецФункции