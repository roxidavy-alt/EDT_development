////////////////////////////////////////////////////////////////////////////////
// Публичные процедуры и функции

Функция НастройкиПоУмолчанию() Экспорт

	Настройки = Новый Структура;

	// Имена табличных частей документа
	Настройки.Вставить("ИмяТЧНоменклатуры", "Товары");
	Настройки.Вставить("ИмяТЧШтрихкодов", "Разр_Штрихкоды");
	Настройки.Вставить("ИмяТЧСерий", "Серии");
	Настройки.Вставить("ИмяСобытияОповещения", "");

	// Имена полей
	Настройки.Вставить("ПолеШтрихкод", "Штрихкод");
	Настройки.Вставить("ПолеКоличество", "Количество");
	Настройки.Вставить("ПолеКоличествоУпаковок", "КоличествоУпаковок");
	Настройки.Вставить("ПолеУпаковка", "Упаковка");

	// Сколько упаковок добавляет один ярлык
	Настройки.Вставить("КоличествоУпаковокЗаЯрлык", 1);

	// Показывать сообщения пользователю
	Настройки.Вставить("СообщатьПользователю", Истина);

	// Останавливать массовую загрузку при первой ошибке
	Настройки.Вставить("ОстанавливатьМассовоеПриОшибке", Ложь);

	// Поля, по которым ищем уже существующую строку в основной ТЧ
	КлючевыеПоляСтрок = Новый Массив;
	КлючевыеПоляСтрок.Добавить("Номенклатура");
	КлючевыеПоляСтрок.Добавить("Характеристика");
	КлючевыеПоляСтрок.Добавить("Упаковка");
	КлючевыеПоляСтрок.Добавить("Серия");
	//КлючевыеПоляСтрок.Добавить("Назначение");
	//КлючевыеПоляСтрок.Добавить("ЗаказКлиента");
	Настройки.Вставить("КлючевыеПоляСтрок", КлючевыеПоляСтрок);

	// Поля, которые переносим из данных ярлыка в строку основной ТЧ
	ПоляИзЯрлыкаВСтроку = Новый Массив;
	ПоляИзЯрлыкаВСтроку.Добавить("Номенклатура");
	ПоляИзЯрлыкаВСтроку.Добавить("Характеристика");
	ПоляИзЯрлыкаВСтроку.Добавить("Упаковка");
	ПоляИзЯрлыкаВСтроку.Добавить("Серия");
	//ПоляИзЯрлыкаВСтроку.Добавить("Назначение");
	//ПоляИзЯрлыкаВСтроку.Добавить("ЗаказКлиента");
	ПоляИзЯрлыкаВСтроку.Добавить("АналитикаУчетаНоменклатуры");
	Настройки.Вставить("ПоляИзЯрлыкаВСтроку", ПоляИзЯрлыкаВСтроку);

	// Поля, которые переносим из шапки документа в строку основной ТЧ
	ПоляИзОбъектаВСтроку = Новый Соответствие;
	ПоляИзОбъектаВСтроку.Вставить("Склад", "Склад");
	Настройки.Вставить("ПоляИзОбъектаВСтроку", ПоляИзОбъектаВСтроку);

	// Константные значения для новой строки основной ТЧ
	ПоляКонстантыВСтроку = Новый Соответствие;
	ПоляКонстантыВСтроку.Вставить("СтатусУказанияСерий", 2);
	ПоляКонстантыВСтроку.Вставить("СтатусУказанияСерийНаСкладах", 2);
	Настройки.Вставить("ПоляКонстантыВСтроку", ПоляКонстантыВСтроку);

	// Поля, по которым ищем строку в ТЧ Серии
	КлючевыеПоляСерий = Новый Массив;
	КлючевыеПоляСерий.Добавить("Номенклатура");
	КлючевыеПоляСерий.Добавить("Характеристика");
	КлючевыеПоляСерий.Добавить("Серия");
	КлючевыеПоляСерий.Добавить("Назначение");
	КлючевыеПоляСерий.Добавить("Склад");
	Настройки.Вставить("КлючевыеПоляСерий", КлючевыеПоляСерий);

	// Поля из ярлыка в ТЧ Серии
	ПоляИзЯрлыкаВСерию = Новый Массив;
	ПоляИзЯрлыкаВСерию.Добавить("Номенклатура");
	ПоляИзЯрлыкаВСерию.Добавить("Характеристика");
	ПоляИзЯрлыкаВСерию.Добавить("Серия");
	ПоляИзЯрлыкаВСерию.Добавить("Назначение");
	Настройки.Вставить("ПоляИзЯрлыкаВСерию", ПоляИзЯрлыкаВСерию);

	// Поля из шапки документа в ТЧ Серии
	ПоляИзОбъектаВСерию = Новый Соответствие;
	ПоляИзОбъектаВСерию.Вставить("Склад", "Склад");
	Настройки.Вставить("ПоляИзОбъектаВСерию", ПоляИзОбъектаВСерию);

	Возврат Настройки;

КонецФункции

Функция ДобавитьНоменклатурыПоЯрлыкам(ОбъектФормы, Ярлыки, Настройки) Экспорт

	РезультатОбщий = НовыйРезультат();
	РезультатОбщий.Изменено = Ложь;
	РезультатОбщий.КоличествоОбработано = 0;
	РезультатОбщий.КоличествоОшибок = 0;

	Если Ярлыки = Неопределено Тогда
		ВернутьОшибку(РезультатОбщий, "Не передан список ярлыков.", Настройки);
		Возврат РезультатОбщий;
	КонецЕсли;

	Для Каждого ДанныеЯрлыка Из Ярлыки Цикл

		Результат = ДобавитьНоменклатуруПоЯрлыку(
			ОбъектФормы,
			ДанныеЯрлыка,
			Настройки
		);

		Если Результат.Изменено Тогда
			РезультатОбщий.Изменено = Истина;
			РезультатОбщий.КоличествоОбработано = РезультатОбщий.КоличествоОбработано + 1;
		КонецЕсли;

		Если Результат.Ошибка Тогда
			РезультатОбщий.КоличествоОшибок = РезультатОбщий.КоличествоОшибок + 1;

			Если Настройки.ОстанавливатьМассовоеПриОшибке Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат РезультатОбщий;

КонецФункции

Функция ДобавитьНоменклатуруПоЯрлыку(ОбъектФормы, ДанныеЯрлыка, Настройки) Экспорт

	Результат = НовыйРезультат();

	Если ДанныеЯрлыка = Неопределено Тогда
		ВернутьОшибку(Результат, "Не получены данные ярлыка.", Настройки);
		Возврат Результат;
	КонецЕсли;

	Штрихкод = "";
	Если Не ПолучитьСвойствоОбъекта(ДанныеЯрлыка, "Штрихкод", Штрихкод) Тогда
		ВернутьОшибку(Результат, "В данных ярлыка отсутствует штрихкод.", Настройки);
		Возврат Результат;
	КонецЕсли;

	Штрихкод = СокрЛП(Строка(Штрихкод));

	Если ПустаяСтрока(Штрихкод) Тогда
		ВернутьОшибку(Результат, "В данных ярлыка пустой штрихкод.", Настройки);
		Возврат Результат;
	КонецЕсли;

	Если ШтрихкодУжеДобавлен(ОбъектФормы, Штрихкод, Настройки) Тогда

		ВернутьОшибку(
			Результат,
			"Этот штрихкод уже добавлен в документ." + Символы.ПС
			+ "Штрихкод: " + Штрихкод,
			Настройки
		);

		Возврат Результат;

	КонецЕсли;

	Номенклатура = Неопределено;
	Если Не ПолучитьСвойствоОбъекта(ДанныеЯрлыка, "Номенклатура", Номенклатура) Тогда
		ВернутьОшибку(Результат, "В данных ярлыка отсутствует номенклатура.", Настройки);
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		ВернутьОшибку(Результат, "В ярлыке не заполнена номенклатура.", Настройки);
		Возврат Результат;
	КонецЕсли;

	ТабличнаяЧасть = Неопределено;
	Если Не ПолучитьСвойствоОбъекта(ОбъектФормы, Настройки.ИмяТЧНоменклатуры, ТабличнаяЧасть) Тогда

		ВернутьОшибку(
			Результат,
			"В документе не найдена табличная часть """ + Настройки.ИмяТЧНоменклатуры + """.",
			Настройки
		);

		Возврат Результат;

	КонецЕсли;

	ДобавитьШтрихкодВТЧ(ОбъектФормы, Штрихкод, Настройки);
	
	ПереопределенныеЗначенияСтроки = ПолучитьПереопределенныеЗначенияПолейСтроки(
	ОбъектФормы,
	ДанныеЯрлыка,
	Настройки
	);
	
	СтрокаНоменклатуры = НайтиСтрокуНоменклатуры(
		ТабличнаяЧасть,
		ДанныеЯрлыка,
		Настройки,
		ПереопределенныеЗначенияСтроки
	);

	Если СтрокаНоменклатуры <> Неопределено Тогда

		УвеличитьКоличествоСтроки(
			СтрокаНоменклатуры,
			ДанныеЯрлыка,
			Настройки
		);

		СинхронизироватьСтрокуСерии(
			ОбъектФормы,
			СтрокаНоменклатуры,
			ДанныеЯрлыка,
			Настройки
		);

		Результат.Изменено = Истина;
		Результат.ТекстСообщения = "Количество увеличено: " + Строка(Номенклатура);

		Если Настройки.СообщатьПользователю Тогда
			Сообщить(Результат.ТекстСообщения);
		КонецЕсли;

		Возврат Результат;

	КонецЕсли;

	НоваяСтрока = ТабличнаяЧасть.Добавить();

	ЗаполнитьНовуюСтрокуНоменклатуры(
		НоваяСтрока,
		ОбъектФормы,
		ДанныеЯрлыка,
		Настройки,
		ПереопределенныеЗначенияСтроки
	);

	УвеличитьКоличествоСтроки(
		НоваяСтрока,
		ДанныеЯрлыка,
		Настройки
	);

	СинхронизироватьСтрокуСерии(
		ОбъектФормы,
		НоваяСтрока,
		ДанныеЯрлыка,
		Настройки
	);

	Результат.Изменено = Истина;
	Результат.ТекстСообщения = "Добавлена номенклатура: " + Строка(Номенклатура);

	Если Настройки.СообщатьПользователю Тогда
		Сообщить(Результат.ТекстСообщения);
	КонецЕсли;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Работа со строками основной табличной части

Функция НайтиСтрокуНоменклатуры(ТабличнаяЧасть, ДанныеЯрлыка, Настройки, ПереопределенныеЗначенияСтроки)

	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл

		Если СтрокаСоответствуетЯрлыку(
			СтрокаТЧ,
			ДанныеЯрлыка,
			Настройки.КлючевыеПоляСтрок,
			ПереопределенныеЗначенияСтроки
		) Тогда

			Возврат СтрокаТЧ;

		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ЗаполнитьНовуюСтрокуНоменклатуры(СтрокаТЧ, ОбъектФормы, ДанныеЯрлыка, Настройки,ПереопределенныеЗначенияСтроки)

	// Сначала обычное заполнение из ярлыка.
	Для Каждого ИмяПоля Из Настройки.ПоляИзЯрлыкаВСтроку Цикл

		ЗначениеПоля = Неопределено;

		Если ПолучитьСвойствоОбъекта(ДанныеЯрлыка, ИмяПоля, ЗначениеПоля) Тогда
			УстановитьСвойствоОбъекта(СтрокаТЧ, ИмяПоля, ЗначениеПоля);
		КонецЕсли;

	КонецЦикла;

	// Поля из шапки документа.
	Для Каждого ЭлементСоответствия Из Настройки.ПоляИзОбъектаВСтроку Цикл

		ИмяПоляСтроки = ЭлементСоответствия.Ключ;
		ИмяПоляОбъекта = ЭлементСоответствия.Значение;

		ЗначениеПоля = Неопределено;

		Если ПолучитьСвойствоОбъекта(ОбъектФормы, ИмяПоляОбъекта, ЗначениеПоля) Тогда
			УстановитьСвойствоОбъекта(СтрокаТЧ, ИмяПоляСтроки, ЗначениеПоля);
		КонецЕсли;

	КонецЦикла;

	// Константные значения.
	Для Каждого ЭлементСоответствия Из Настройки.ПоляКонстантыВСтроку Цикл

		УстановитьСвойствоОбъекта(
			СтрокаТЧ,
			ЭлементСоответствия.Ключ,
			ЭлементСоответствия.Значение
		);

	КонецЦикла;

	// А теперь применяем переопределения.
	// Они имеют приоритет над обычным заполнением.
	Для Каждого ЭлементПереопределения Из ПереопределенныеЗначенияСтроки Цикл

		УстановитьСвойствоОбъекта(
			СтрокаТЧ,
			ЭлементПереопределения.Ключ,
			ЭлементПереопределения.Значение
		);

	КонецЦикла;

	ЗаполнитьЗаказПереработчикуЕслиВозможно(СтрокаТЧ, ДанныеЯрлыка);

КонецПроцедуры

Процедура УвеличитьКоличествоСтроки(СтрокаТЧ, ДанныеЯрлыка, Настройки)

	КоличествоУпаковок = 0;

	Если Не ПолучитьСвойствоОбъекта(
		СтрокаТЧ,
		Настройки.ПолеКоличествоУпаковок,
		КоличествоУпаковок
	) Тогда

		КоличествоУпаковок = 0;

	КонецЕсли;

	Если КоличествоУпаковок = Неопределено Тогда
		КоличествоУпаковок = 0;
	КонецЕсли;

	КоличествоУпаковок = КоличествоУпаковок + Настройки.КоличествоУпаковокЗаЯрлык;

	УстановитьСвойствоОбъекта(
		СтрокаТЧ,
		Настройки.ПолеКоличествоУпаковок,
		КоличествоУпаковок
	);

	Количество = РассчитатьКоличествоПоУпаковке(
		СтрокаТЧ,
		ДанныеЯрлыка,
		Настройки,
		КоличествоУпаковок
	);

	УстановитьСвойствоОбъекта(
		СтрокаТЧ,
		Настройки.ПолеКоличество,
		Количество
	);

КонецПроцедуры

Функция РассчитатьКоличествоПоУпаковке(СтрокаТЧ, ДанныеЯрлыка, Настройки, КоличествоУпаковок)

	КоэффициентУпаковки = 1;

	// Лучше, если форма сканирования уже передаст КоэффициентУпаковки в ДанныеЯрлыка.
	Если ПолучитьСвойствоОбъекта(ДанныеЯрлыка, "КоэффициентУпаковки", КоэффициентУпаковки) Тогда

		Если ЗначениеЗаполнено(КоэффициентУпаковки) Тогда
			Возврат КоличествоУпаковок * КоэффициентУпаковки;
		КонецЕсли;

	КонецЕсли;

	Упаковка = Неопределено;

	Если ПолучитьСвойствоОбъекта(СтрокаТЧ, Настройки.ПолеУпаковка, Упаковка)
		И ЗначениеЗаполнено(Упаковка) Тогда

		Попытка
			КоэффициентУпаковки = Упаковка.Числитель;
		Исключение
			КоэффициентУпаковки = 1;
		КонецПопытки;

	КонецЕсли;

	Возврат КоличествоУпаковок * КоэффициентУпаковки;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Работа с табличной частью штрихкодов

Функция ШтрихкодУжеДобавлен(ОбъектФормы, Штрихкод, Настройки)

	Если ПустаяСтрока(Настройки.ИмяТЧШтрихкодов) Тогда
		Возврат Ложь;
	КонецЕсли;

	ТЧШтрихкодов = Неопределено;

	Если Не ПолучитьСвойствоОбъекта(
		ОбъектФормы,
		Настройки.ИмяТЧШтрихкодов,
		ТЧШтрихкодов
	) Тогда

		// Если в конкретном документе нет ТЧ штрихкодов —
		// считаем, что проверять дубли негде.
		Возврат Ложь;

	КонецЕсли;

	Для Каждого СтрокаШтрихкода Из ТЧШтрихкодов Цикл

		ШтрихкодВСтроке = "";

		Если ПолучитьСвойствоОбъекта(
			СтрокаШтрихкода,
			Настройки.ПолеШтрихкод,
			ШтрихкодВСтроке
		) Тогда

			Если СокрЛП(Строка(ШтрихкодВСтроке)) = Штрихкод Тогда
				Возврат Истина;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьШтрихкодВТЧ(ОбъектФормы, Штрихкод, Настройки)

	Если ПустаяСтрока(Настройки.ИмяТЧШтрихкодов) Тогда
		Возврат;
	КонецЕсли;

	ТЧШтрихкодов = Неопределено;

	Если Не ПолучитьСвойствоОбъекта(
		ОбъектФормы,
		Настройки.ИмяТЧШтрихкодов,
		ТЧШтрихкодов
	) Тогда

		Возврат;

	КонецЕсли;

	НоваяСтрокаШтрихкода = ТЧШтрихкодов.Добавить();

	УстановитьСвойствоОбъекта(
		НоваяСтрокаШтрихкода,
		Настройки.ПолеШтрихкод,
		Штрихкод
	);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Работа с табличной частью серий

Процедура СинхронизироватьСтрокуСерии(ОбъектФормы, СтрокаНоменклатуры, ДанныеЯрлыка, Настройки)

	Если ПустаяСтрока(Настройки.ИмяТЧСерий) Тогда
		Возврат;
	КонецЕсли;

	ТЧСерий = Неопределено;

	Если Не ПолучитьСвойствоОбъекта(
		ОбъектФормы,
		Настройки.ИмяТЧСерий,
		ТЧСерий
	) Тогда

		Возврат;

	КонецЕсли;

	СтрокаСерии = НайтиСтрокуСерии(
		ТЧСерий,
		ОбъектФормы,
		ДанныеЯрлыка,
		Настройки
	);

	Если СтрокаСерии = Неопределено Тогда

		СтрокаСерии = ТЧСерий.Добавить();

		ЗаполнитьНовуюСтрокуСерии(
			СтрокаСерии,
			ОбъектФормы,
			ДанныеЯрлыка,
			Настройки
		);

	КонецЕсли;

	Количество = 0;

	Если ПолучитьСвойствоОбъекта(
		СтрокаНоменклатуры,
		Настройки.ПолеКоличество,
		Количество
	) Тогда

		УстановитьСвойствоОбъекта(
			СтрокаСерии,
			Настройки.ПолеКоличество,
			Количество
		);

	КонецЕсли;

КонецПроцедуры

Функция НайтиСтрокуСерии(ТЧСерий, ОбъектФормы, ДанныеЯрлыка, Настройки)

	Для Каждого СтрокаСерии Из ТЧСерий Цикл

		Если СтрокаСерииСоответствуетЯрлыку(
			СтрокаСерии,
			ОбъектФормы,
			ДанныеЯрлыка,
			Настройки.КлючевыеПоляСерий
		) Тогда

			Возврат СтрокаСерии;

		КонецЕсли;

	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ЗаполнитьНовуюСтрокуСерии(СтрокаСерии, ОбъектФормы, ДанныеЯрлыка, Настройки)

	// Поля из ярлыка
	Для Каждого ИмяПоля Из Настройки.ПоляИзЯрлыкаВСерию Цикл

		ЗначениеПоля = Неопределено;

		Если ПолучитьСвойствоОбъекта(ДанныеЯрлыка, ИмяПоля, ЗначениеПоля) Тогда
			УстановитьСвойствоОбъекта(СтрокаСерии, ИмяПоля, ЗначениеПоля);
		КонецЕсли;

	КонецЦикла;

	// Поля из шапки документа
	Для Каждого ЭлементСоответствия Из Настройки.ПоляИзОбъектаВСерию Цикл

		ИмяПоляСтроки = ЭлементСоответствия.Ключ;
		ИмяПоляОбъекта = ЭлементСоответствия.Значение;

		ЗначениеПоля = Неопределено;

		Если ПолучитьСвойствоОбъекта(ОбъектФормы, ИмяПоляОбъекта, ЗначениеПоля) Тогда
			УстановитьСвойствоОбъекта(СтрокаСерии, ИмяПоляСтроки, ЗначениеПоля);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Универсальная работа со свойствами

Функция ПолучитьСвойствоОбъекта(Источник, ИмяСвойства, ЗначениеСвойства)

	ЗначениеСвойства = Неопределено;

	Если Источник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ПустаяСтрока(ИмяСвойства) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Источник) = Тип("Структура") Тогда
		Возврат Источник.Свойство(ИмяСвойства, ЗначениеСвойства);
	КонецЕсли;

	Попытка
		ЗначениеСвойства = Источник[ИмяСвойства];
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция УстановитьСвойствоОбъекта(Приемник, ИмяСвойства, ЗначениеСвойства)

	Если Приемник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ПустаяСтрока(ИмяСвойства) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Приемник[ИмяСвойства] = ЗначениеСвойства;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция СтрокаСоответствуетЯрлыку(
	СтрокаТЧ,
	ДанныеЯрлыка,
	КлючевыеПоля,
	ПереопределенныеЗначенияСтроки
)

	КоличествоИспользованныхПолей = 0;

	Для Каждого ИмяПоля Из КлючевыеПоля Цикл

		ЗначениеСтроки = Неопределено;
		ЗначениеЯрлыка = Неопределено;

		Если Не ПолучитьСвойствоОбъекта(СтрокаТЧ, ИмяПоля, ЗначениеСтроки) Тогда
			Продолжить;
		КонецЕсли;

		Если ПереопределенныеЗначенияСтроки <> Неопределено Тогда

			ЗначениеПереопределения = ПереопределенныеЗначенияСтроки.Получить(ИмяПоля);

			Если ЗначениеПереопределения <> Неопределено Тогда
				ЗначениеЯрлыка = ЗначениеПереопределения;
			Иначе
				Если Не ПолучитьСвойствоОбъекта(ДанныеЯрлыка, ИмяПоля, ЗначениеЯрлыка) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;

		Иначе

			Если Не ПолучитьСвойствоОбъекта(ДанныеЯрлыка, ИмяПоля, ЗначениеЯрлыка) Тогда
				Продолжить;
			КонецЕсли;

		КонецЕсли;

		КоличествоИспользованныхПолей = КоличествоИспользованныхПолей + 1;

		Если ЗначениеСтроки <> ЗначениеЯрлыка Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат КоличествоИспользованныхПолей > 0;

КонецФункции

Функция СтрокаСерииСоответствуетЯрлыку(СтрокаСерии, ОбъектФормы, ДанныеЯрлыка, КлючевыеПоля)

	КоличествоИспользованныхПолей = 0;

	Для Каждого ИмяПоля Из КлючевыеПоля Цикл

		ЗначениеСтроки = Неопределено;
		ОжидаемоеЗначение = Неопределено;

		Если Не ПолучитьСвойствоОбъекта(СтрокаСерии, ИмяПоля, ЗначениеСтроки) Тогда
			Продолжить;
		КонецЕсли;

		Если ПолучитьСвойствоОбъекта(ДанныеЯрлыка, ИмяПоля, ОжидаемоеЗначение) Тогда

			// Значение нашли в ярлыке.

		ИначеЕсли ПолучитьСвойствоОбъекта(ОбъектФормы, ИмяПоля, ОжидаемоеЗначение) Тогда

			// Например, Склад берём из шапки документа.

		Иначе

			Продолжить;

		КонецЕсли;

		КоличествоИспользованныхПолей = КоличествоИспользованныхПолей + 1;

		Если ЗначениеСтроки <> ОжидаемоеЗначение Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат КоличествоИспользованныхПолей > 0;

КонецФункции

Функция ЕстьСвойствоОбъекта(Источник, ИмяСвойства)

	ЗначениеСвойства = Неопределено;
	Возврат ПолучитьСвойствоОбъекта(Источник, ИмяСвойства, ЗначениеСвойства);

КонецФункции

Процедура ЗаполнитьЗаказПереработчикуЕслиВозможно(СтрокаТЧ, ДанныеЯрлыка)

	Если Не ЕстьСвойствоОбъекта(СтрокаТЧ, "ЗаказПереработчику") Тогда
		Возврат;
	КонецЕсли;

	ЭтапПроизводства = Неопределено;

	Если Не ПолучитьСвойствоОбъекта(ДанныеЯрлыка, "ЭтапПроизводства", ЭтапПроизводства) Тогда
		Возврат;
	КонецЕсли;

	Если ЭтапПроизводства = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаказПереработчику = Неопределено;

	Если ПолучитьСвойствоОбъекта(ЭтапПроизводства, "ЗаказПереработчику", ЗаказПереработчику) Тогда

		УстановитьСвойствоОбъекта(
			СтрокаТЧ,
			"ЗаказПереработчику",
			ЗаказПереработчику
		);

	КонецЕсли;

КонецПроцедуры

Функция ПолучитьПереопределенныеЗначенияПолейСтроки(ОбъектФормы, ДанныеЯрлыка, Настройки)

	ПереопределенныеЗначения = Новый Соответствие;

	Правила = ПолучитьПравилаПереопределенияПолейСтроки(
		ОбъектФормы,
		ДанныеЯрлыка,
		Настройки
	);

	Для Каждого Правило Из Правила Цикл

		ИмяПоляСтроки = "";
		Способ = "";
		ЗначениеПоля = Неопределено;
		ЗначениеПолучено = Ложь;

		Если Не Правило.Свойство("ИмяПоляСтроки", ИмяПоляСтроки) Тогда
			Продолжить;
		КонецЕсли;

		Если Не Правило.Свойство("Способ", Способ) Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеПоля = ВычислитьЗначениеПереопределения(
			Правило,
			ОбъектФормы,
			ДанныеЯрлыка,
			Настройки,
			ЗначениеПолучено
		);

		Если ЗначениеПолучено Тогда
			ПереопределенныеЗначения.Вставить(ИмяПоляСтроки, ЗначениеПоля);
		КонецЕсли;

	КонецЦикла;

	Возврат ПереопределенныеЗначения;

КонецФункции

Функция ПолучитьПравилаПереопределенияПолейСтроки(ОбъектФормы, ДанныеЯрлыка, Настройки)

	Правила = Новый Массив;

	// Внешние правила, если когда-нибудь захочешь передавать их через Настройки.
	Если Настройки.Свойство("ПереопределенияПолейСтроки") Тогда

		Для Каждого Правило Из Настройки.ПереопределенияПолейСтроки Цикл
			Правила.Добавить(Правило);
		КонецЦикла;

	КонецЕсли;

	// Внутренние правила общего модуля.
	// Обработку оповещения при этом менять не надо.

	Если ЭтоЗаполнениеВыходныхИзделийОтчетаПереработчика(ОбъектФормы, Настройки) Тогда

		Правило = Новый Структура;
		Правило.Вставить("ИмяПоляСтроки", "Характеристика");

		// Было: "ХарактеристикаПоНаименованию"
		// Теперь ищем характеристику по владельцу ВидыНоменклатуры + наименование.
		Правило.Вставить("Способ", "ХарактеристикаПоВидуНоменклатуры");

		Правило.Вставить("ВидНоменклатурыНаименование", "Продукция стерильная");
		Правило.Вставить("ХарактеристикаНаименование", "Стерильно");

		Правило.Вставить("Обязательное", Истина);

		Правила.Добавить(Правило);

	КонецЕсли;

	Возврат Правила;

КонецФункции

Функция ВычислитьЗначениеПереопределения(
	Правило,
	ОбъектФормы,
	ДанныеЯрлыка,
	Настройки,
	ЗначениеПолучено
)

	ЗначениеПолучено = Ложь;

	Способ = "";
	Правило.Свойство("Способ", Способ);

	Если Способ = "Константа" Тогда

		Если Правило.Свойство("Значение") Тогда
			ЗначениеПолучено = Истина;
			Возврат Правило.Значение;
		КонецЕсли;

	ИначеЕсли Способ = "ИзПоляЯрлыка" Тогда

		ИмяПоляЯрлыка = "";

		Если Правило.Свойство("ИмяПоляЯрлыка", ИмяПоляЯрлыка) Тогда

			ЗначениеПоля = Неопределено;

			Если ПолучитьСвойствоОбъекта(ДанныеЯрлыка, ИмяПоляЯрлыка, ЗначениеПоля) Тогда
				ЗначениеПолучено = Истина;
				Возврат ЗначениеПоля;
			КонецЕсли;

		КонецЕсли;

	ИначеЕсли Способ = "ИзПоляОбъекта" Тогда

		ИмяПоляОбъекта = "";

		Если Правило.Свойство("ИмяПоляОбъекта", ИмяПоляОбъекта) Тогда

			ЗначениеПоля = Неопределено;

			Если ПолучитьСвойствоОбъекта(ОбъектФормы, ИмяПоляОбъекта, ЗначениеПоля) Тогда
				ЗначениеПолучено = Истина;
				Возврат ЗначениеПоля;
			КонецЕсли;

		КонецЕсли;

	ИначеЕсли Способ = "ХарактеристикаПоНаименованию" Тогда

		НаименованиеХарактеристики = ПолучитьНаименованиеИзПравила(
			Правило,
			ДанныеЯрлыка
		);

		Если ПустаяСтрока(НаименованиеХарактеристики) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Номенклатура = Неопределено;
		ИмяПоляНоменклатуры = "Номенклатура";

		Правило.Свойство("ИмяПоляНоменклатуры", ИмяПоляНоменклатуры);

		ПолучитьСвойствоОбъекта(
			ДанныеЯрлыка,
			ИмяПоляНоменклатуры,
			Номенклатура
		);

		Характеристика = Разр_ЗаполнениеТЧПоЯрлыкамСервер.НайтиХарактеристикуНоменклатурыПоНаименованию(
			Номенклатура,
			НаименованиеХарактеристики
		);

		Если ЗначениеЗаполнено(Характеристика) Тогда
			ЗначениеПолучено = Истина;
			Возврат Характеристика;
		КонецЕсли;

		Если Правило.Свойство("Обязательное") И Правило.Обязательное Тогда
			ПоказатьПредупреждение(, 
				"Не найдена характеристика по наименованию: " + НаименованиеХарактеристики);
		КонецЕсли;
	ИначеЕсли Способ = "ХарактеристикаПоВидуНоменклатуры" Тогда

	ВидНоменклатурыНаименование = "";
	ХарактеристикаНаименование = "";

	Правило.Свойство(
		"ВидНоменклатурыНаименование",
		ВидНоменклатурыНаименование
	);

	Правило.Свойство(
		"ХарактеристикаНаименование",
		ХарактеристикаНаименование
	);

	Характеристика = Разр_ЗаполнениеТЧПоЯрлыкамСервер.НайтиХарактеристикуПоВидуНоменклатуры(
		ВидНоменклатурыНаименование,
		ХарактеристикаНаименование
	);

	Если ЗначениеЗаполнено(Характеристика) Тогда
		ЗначениеПолучено = Истина;
		Возврат Характеристика;
	КонецЕсли;

	Если Правило.Свойство("Обязательное") И Правило.Обязательное Тогда

		ПоказатьПредупреждение(
			,
			"Не найдена характеристика """ + ХарактеристикаНаименование + """"
			+ Символы.ПС
			+ "Вид номенклатуры: " + ВидНоменклатурыНаименование
		);

	КонецЕсли;	

	ИначеЕсли Способ = "Алгоритм" Тогда

		КодПравила = "";

		Если Правило.Свойство("КодПравила", КодПравила) Тогда

			Возврат ВычислитьПроизвольноеЗначениеПоКодуПравила(
				КодПравила,
				ОбъектФормы,
				ДанныеЯрлыка,
				Настройки,
				ЗначениеПолучено
			);

		КонецЕсли;

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьНаименованиеИзПравила(Правило, ДанныеЯрлыка)

	Наименование = "";

	// Вариант 1: наименование указано прямо в правиле.
	Если Правило.Свойство("Наименование", Наименование) Тогда
		Возврат СокрЛП(Строка(Наименование));
	КонецЕсли;

	// Вариант 2: наименование нужно взять из поля данных ярлыка.
	ИмяПоляНаименования = "";

	Если Правило.Свойство("ИмяПоляНаименования", ИмяПоляНаименования) Тогда

		ЗначениеПоля = Неопределено;

		Если ПолучитьСвойствоОбъекта(ДанныеЯрлыка, ИмяПоляНаименования, ЗначениеПоля) Тогда
			Возврат СокрЛП(Строка(ЗначениеПоля));
		КонецЕсли;

	КонецЕсли;

	Возврат "";

КонецФункции 

Функция ВычислитьПроизвольноеЗначениеПоКодуПравила(
	КодПравила,
	ОбъектФормы,
	ДанныеЯрлыка,
	Настройки,
	ЗначениеПолучено
)

	ЗначениеПолучено = Ложь;

	Если КодПравила = "ХарактеристикаВыходногоИзделияОтчетаПереработчика2_5" Тогда

		// Здесь можно написать вообще любую логику.
		// Например, получить наименование из этапа, из номенклатуры,
		// из реквизита шапки или найти по таблице соответствий.

		Номенклатура = Неопределено;

		Если Не ПолучитьСвойствоОбъекта(ДанныеЯрлыка, "Номенклатура", Номенклатура) Тогда
			Возврат Неопределено;
		КонецЕсли;

		НаименованиеХарактеристики = "Стерильно";

		Характеристика = Разр_ЗаполнениеТЧПоЯрлыкамСервер.ПолучитьХарактеристикуСтерильно();

		Если ЗначениеЗаполнено(Характеристика) Тогда
			ЗначениеПолучено = Истина;
			Возврат Характеристика;
		КонецЕсли;

	КонецЕсли;

	Возврат Неопределено;

КонецФункции


Функция ЭтоЗаполнениеВыходныхИзделийОтчетаПереработчика(ОбъектФормы, Настройки)

	ИмяСобытияОповещения = "";

	Если Не Настройки.Свойство("ИмяСобытияОповещения", ИмяСобытияОповещения) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ИмяСобытияОповещения = "ЯрлыкКоробаСчитанОтчетПереработчика"
		Или ИмяСобытияОповещения = "ЯрлыкиКоробаСчитаныОтчетПереработчика";

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Результаты и ошибки

Функция НовыйРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Изменено", Ложь);
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("КоличествоОбработано", 0);
	Результат.Вставить("КоличествоОшибок", 0);
	Результат.Вставить("ТекстСообщения", "");

	Возврат Результат;

КонецФункции

Процедура ВернутьОшибку(Результат, ТекстОшибки, Настройки)

	Результат.Ошибка = Истина;
	Результат.ТекстОшибки = ТекстОшибки;

	Если Настройки.СообщатьПользователю Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;

КонецПроцедуры